{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "shaftbreaker:spore",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/shaftbreaker_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 6
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 6,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "4 + variable.particle_random_1 * 4"
      },
      "minecraft:particle_initial_speed": 0.05,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(variable.particle_age * 60 + variable.particle_random_2 * 360) * 0.06",
          0.01,
          "math.cos(variable.particle_age * 50 + variable.particle_random_3 * 360) * 0.06"
        ]
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": "#00ff8a50",
            "0.2": "#ffff8a50",
            "0.8": "#ffe05a3c",
            "1.0": "#00e05a3c"
          },
          "interpolant": "variable.particle_age / variable.particle_lifetime"
        }
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.05,
          0.05
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            48,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      }
    }
  }
}