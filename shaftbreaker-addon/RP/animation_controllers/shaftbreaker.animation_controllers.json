  "controller.animation.shaftbreaker.crouch": {
   "initial_state": "off",
   "states": {
    "off": {
     "transitions": [
      {
       "on": "query.property('shaftbreaker:pose') == 1"
      }
     ],
     "blend_transition": 0.35
    },
    "on": {
     "animations": [
      {
       "crouch_stalk": "(query.property('shaftbreaker:state') == 'stalk' || query.property('shaftbreaker:state') == 'search' || query.property('shaftbreaker:state') == 'retreat' || query.property('shaftbreaker:state') == 'peek_l' || query.property('shaftbreaker:state') == 'peek_r') ? 1.0 : 0.0"
      },
      {
       "crouch_run": "(query.property('shaftbreaker:state') == 'hunt' || query.property('shaftbreaker:state') == 'threat' || query.property('shaftbreaker:state') == 'stagger' || query.property('shaftbreaker:state') == 'break') ? 1.0 : 0.0"
      },
      {
       "crouch_full": "(query.property('shaftbreaker:state') == 'watch' || query.property('shaftbreaker:state') == 'dormant' || query.property('shaftbreaker:state') == 'scream' || query.property('shaftbreaker:state') == 'vanish') ? 1.0 : 0.0"
      }
     ],
     "transitions": [
      {
       "off": "query.property('shaftbreaker:pose') != 1"
      }
     ],
     "blend_transition": 0.35
    }
   }
  },
  "controller.animation.shaftbreaker.attack": {
   "initial_state": "default",
   "states": {
    "default": {
     "transitions": [
      {
       "lunge": "query.property('shaftbreaker:attack') == 1 || query.is_delayed_attacking"
      },
      {
       "heavy": "query.property('shaftbreaker:attack') == 2"
      },
      {
       "false_lunge": "query.property('shaftbreaker:attack') == 3"
      }
     ],
     "blend_transition": 0.15
    },
    "lunge": {
     "animations": [
      "frenzy_lunge"
     ],
     "on_entry": [
      "variable.attacking = 1.0;"
     ],
     "on_exit": [
      "variable.attacking = 0.0;"
     ],
     "transitions": [
      {
       "default": "query.all_animations_finished"
      }
     ],
     "blend_transition": 0.2
    },
    "heavy": {
     "animations": [
      "heavy_strike"
     ],
     "on_entry": [
      "variable.attacking = 1.0;"
     ],
     "on_exit": [
      "variable.attacking = 0.0;"
     ],
     "transitions": [
      {
       "default": "query.all_animations_finished"
      }
     ],
     "blend_transition": 0.2
    },
    "false_lunge": {
     "animations": [
      "false_lunge"
     ],
     "on_entry": [
      "variable.attacking = 1.0;"
     ],
     "on_exit": [
      "variable.attacking = 0.0;"
     ],
     "transitions": [
      {
       "default": "query.all_animations_finished"
      }
     ],
     "blend_transition": 0.2
    }
   }
  },
  "controller.animation.shaftbreaker.look": {
   "initial_state": "look",
   "states": {
    "look": {
     "animations": [
      "look_at"
     ],
     "transitions": [
      {
       "none": "query.property('shaftbreaker:state') == 'death' || query.property('shaftbreaker:state') == 'vanish' || query.property('shaftbreaker:state') == 'climb'"
      }
     ],
     "blend_transition": 0.3
    },
    "none": {
     "transitions": [
      {
       "look": "!(query.property('shaftbreaker:state') == 'death' || query.property('shaftbreaker:state') == 'vanish' || query.property('shaftbreaker:state') == 'climb')"
      }
     ],
     "blend_transition": 0.3
    }
   }
  },
  "controller.animation.shaftbreaker.tilt": {
