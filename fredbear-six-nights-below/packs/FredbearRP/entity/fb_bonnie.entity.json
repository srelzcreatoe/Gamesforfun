{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "fb:bonnie",
      "materials": {
        "default": "entity_alphatest",
        "eyes": "creaking_eyes"
      },
      "textures": {
        "default": "textures/entity/fb/bonnie",
        "eyes": "textures/entity/fb/bonnie_eyes",
        "withered": "textures/entity/fb/bonnie_withered"
      },
      "geometry": {
        "default": "geometry.fb.bonnie"
      },
      "scripts": {
        "pre_animation": [
          "variable.fb_anim = query.property('fb:anim');",
          "variable.fb_eyes = query.property('fb:eyes');",
          "variable.fb_hidden = query.property('fb:hidden');",
          "variable.fb_variant = query.property('fb:variant');",
          "variable.fb_ly = math.lerp(variable.fb_ly, query.property('fb:look_yaw'), 0.06);",
          "variable.fb_lp = math.lerp(variable.fb_lp, query.property('fb:look_pitch'), 0.06);",
          "variable.fb_lt = math.lerp(variable.fb_lt, query.property('fb:look_tilt'), 0.05);"
        ],
        "animate": [
          "pose_controller",
          "look_at"
        ]
      },
      "animations": {
        "pose_controller": "controller.animation.fb.bonnie",
        "look_at": "animation.fb.bonnie.look_at",
        "attack": "animation.fb.bonnie.attack",
        "walk": "animation.fb.bonnie.walk",
        "pose_watch": "animation.fb.bonnie.pose_watch",
        "perform_rhythm_once": "animation.fb.bonnie.perform_rhythm_once",
        "run": "animation.fb.bonnie.run",
        "perform_solo_once": "animation.fb.bonnie.perform_solo_once",
        "pose_powered_down": "animation.fb.bonnie.pose_powered_down",
        "threat": "animation.fb.bonnie.threat",
        "crawl": "animation.fb.bonnie.crawl",
        "idle": "animation.fb.bonnie.idle",
        "stalk": "animation.fb.bonnie.stalk"
      },
      "render_controllers": [
        "controller.render.fb.withered",
        "controller.render.fb.eyes"
      ]
    }
  }
}
