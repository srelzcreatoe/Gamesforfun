{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "fb:fredbear_echo",
      "materials": {
        "default": "entity_alphatest",
        "eyes": "creaking_eyes"
      },
      "textures": {
        "default": "textures/entity/fb/fredbear_echo",
        "eyes": "textures/entity/fb/fredbear_echo_eyes"
      },
      "geometry": {
        "default": "geometry.fb.fredbear"
      },
      "scripts": {
        "pre_animation": [
          "variable.fb_anim = query.property('fb:anim');",
          "variable.fb_eyes = query.property('fb:eyes');",
          "variable.fb_hidden = query.property('fb:hidden');"
        ],
        "animate": [
          "pose_controller"
        ]
      },
      "animations": {
        "pose_controller": "controller.animation.fb.pose",
        "hide_prop": "animation.fb.hide_prop",
        "idle": "animation.fb.idle",
        "perform": "animation.fb.perform.fredbear",
        "walk": "animation.fb.walk",
        "stalk": "animation.fb.stalk",
        "crawl": "animation.fb.crawl",
        "look": "animation.fb.look",
        "pause": "animation.fb.pause",
        "threat": "animation.fb.threat",
        "attack": "animation.fb.attack",
        "retreat": "animation.fb.retreat",
        "dormant": "animation.fb.dormant",
        "music": "animation.fb.music"
      },
      "render_controllers": [
        "controller.render.fb.animatronic",
        "controller.render.fb.eyes"
      ]
    }
  }
}
