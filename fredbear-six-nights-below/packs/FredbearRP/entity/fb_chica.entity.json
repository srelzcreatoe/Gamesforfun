{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "fb:chica",
      "materials": {
        "default": "entity_alphatest",
        "eyes": "creaking_eyes"
      },
      "textures": {
        "default": "textures/entity/fb/chica",
        "eyes": "textures/entity/fb/chica_eyes",
        "withered": "textures/entity/fb/chica_withered"
      },
      "geometry": {
        "default": "geometry.fb.chica"
      },
      "scripts": {
        "pre_animation": [
          "variable.fb_anim = query.property('fb:anim');",
          "variable.fb_eyes = query.property('fb:eyes');",
          "variable.fb_hidden = query.property('fb:hidden');",
          "variable.fb_variant = query.property('fb:variant');",
          "variable.fb_ly = math.lerp(variable.fb_ly, query.property('fb:look_yaw'), 0.06);",
          "variable.fb_lp = math.lerp(variable.fb_lp, query.property('fb:look_pitch'), 0.06);",
          "variable.fb_lt = math.lerp(variable.fb_lt, query.property('fb:look_tilt'), 0.05);"
        ],
        "animate": [
          "pose_controller",
          "look_at"
        ]
      },
      "animations": {
        "pose_controller": "controller.animation.fb.chica",
        "look_at": "animation.fb.chica.look_at",
        "crawl": "animation.fb.chica.crawl",
        "dormant": "animation.fb.chica.dormant",
        "idle": "animation.fb.chica.idle",
        "jumpscare": "animation.fb.chica.jumpscare",
        "perform_present": "animation.fb.chica.perform_present",
        "perform_present_once": "animation.fb.chica.perform_present_once",
        "perform_sing_once": "animation.fb.chica.perform_sing_once",
        "pose_showman": "animation.fb.chica.pose_showman",
        "pose_stare": "animation.fb.chica.pose_stare",
        "run": "animation.fb.chica.run",
        "stalk": "animation.fb.chica.stalk",
        "threat": "animation.fb.chica.threat",
        "walk": "animation.fb.chica.walk"
      },
      "render_controllers": [
        "controller.render.fb.withered",
        "controller.render.fb.eyes"
      ]
    }
  }
}
