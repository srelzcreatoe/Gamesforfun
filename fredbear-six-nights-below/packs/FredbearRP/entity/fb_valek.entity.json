{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "fb:valek",
      "materials": {
        "default": "entity_alphatest",
        "eyes": "creaking_eyes"
      },
      "textures": {
        "default": "textures/entity/fb/valek",
        "eyes": "textures/entity/fb/valek_eyes"
      },
      "geometry": {
        "default": "geometry.fb.valek"
      },
      "scripts": {
        "pre_animation": [
          "variable.fb_anim = query.property('fb:anim');",
          "variable.fb_eyes = query.property('fb:eyes');",
          "variable.fb_hidden = query.property('fb:hidden');",
          "variable.fb_variant = query.property('fb:variant');",
          "variable.fb_ly = math.lerp(variable.fb_ly, query.property('fb:look_yaw'), 0.06);",
          "variable.fb_lp = math.lerp(variable.fb_lp, query.property('fb:look_pitch'), 0.06);",
          "variable.fb_lt = math.lerp(variable.fb_lt, query.property('fb:look_tilt'), 0.05);"
        ],
        "animate": [
          "pose_controller",
          "look_at"
        ]
      },
      "animations": {
        "pose_controller": "controller.animation.fb.valek",
        "look_at": "animation.fb.valek.look_at",
        "crawl": "animation.fb.valek.crawl",
        "dormant": "animation.fb.valek.dormant",
        "hurry": "animation.fb.valek.hurry",
        "idle": "animation.fb.valek.idle",
        "jumpscare": "animation.fb.valek.jumpscare",
        "perform": "animation.fb.valek.perform",
        "stalk": "animation.fb.valek.stalk",
        "threat": "animation.fb.valek.threat",
        "walk": "animation.fb.valek.walk"
      },
      "render_controllers": [
        "controller.render.fb.valek",
        "controller.render.fb.eyes"
      ]
    }
  }
