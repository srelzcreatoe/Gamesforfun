{
  "namespace": "server_form",
  "main_screen_content": {
    "size": [
      "100%",
      "100%"
    ]
  },
  "long_form": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "fb_default_long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [
            "100% - 15px",
            10
          ],
          "$title_max_size": [
            "100% - 15px",
            10
          ],
          "size": [
            225,
            200
          ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.long_form_panel",
          "layer": 2,
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#title_text - '§k§r§k§r§m') = #title_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "fb_cam_form@server_form.fb_cam_form": {
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§k§r§k§r§m') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "fb_cam_form": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "fb_cam_form_map": {
          "type": "panel",
          "size": [
            193.5,
            103.5
          ],
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [
            -2,
            -2
          ],
          "layer": 10,
          "controls": [
            {
              "fb_cam_form_map_image": {
                "type": "image",
                "texture": "textures/ui/fb/cam_map",
                "size": [
                  "100%",
                  "100%"
                ],
                "layer": 1
              }
            },
            {
              "fb_cam_form_live": {
                "type": "label",
                "text": "#form_text",
                "color": [
                  1,
                  1,
                  1
                ],
                "shadow": true,
                "layer": 3,
                "anchor_from": "top_left",
                "anchor_to": "bottom_left",
                "offset": [
                  1,
                  -2
                ],
                "size": [
                  "default",
                  10
                ]
              }
            },
            {
              "fb_cam_form_buttons@server_form.fb_cam_form_buttons": {}
            }
          ]
        }
      }
    ]
  },
