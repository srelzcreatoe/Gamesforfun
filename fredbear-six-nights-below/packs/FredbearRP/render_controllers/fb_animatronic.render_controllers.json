{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.fb.animatronic": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": "!variable.fb_hidden"
        }
      ]
    },
    "controller.render.fb.eyes": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.eyes"
        }
      ],
      "textures": [
        "Texture.eyes"
      ],
      "ignore_lighting": true,
      "part_visibility": [
        {
          "*": "variable.fb_eyes && !variable.fb_hidden"
        }
      ]
    }
  }
}
