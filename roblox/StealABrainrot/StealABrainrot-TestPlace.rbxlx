	brainrot("CoccodrilloTacorito", "Coccodrillo Tacorito", "Mythic", 600000, 2600, rgb(230, 200, 140), rgb(60, 170, 60), 1.4, "Walk", TACO),
	blocky("RobotinoRobloxino", "Robotino Robloxino", "Mythic", 700000, 2950, rgb(160, 165, 175), rgb(60, 220, 255), 1.35),
	blocky("NonnaMattarella", "Nonna Mattarella", "Mythic", 700000, 3000, rgb(30, 30, 35), rgb(160, 25, 35), 1.25),
	brainrot("RattoSchiaffone", "Ratto Schiaffone", "Mythic", 850000, 3500, rgb(30, 30, 35), rgb(170, 60, 230), 1.4),
	blocky("RhinoToasterino", "Rhino Toasterino", "Mythic", 950000, 3900, rgb(200, 205, 215), rgb(210, 150, 70), 1.3),
	blocky("BombombiniGusini", "Bombombini Gusini", "Mythic", 1050000, 4300, rgb(245, 245, 245), rgb(130, 135, 145), 0.9, "Fly"),
	brainrot("FrigoCamelo", "Frigo Camelo", "Mythic", 1200000, 4800, rgb(235, 235, 240), rgb(210, 150, 80), 1.4),
	blocky("GorilloWatermelondrillo", "Gorillo Watermelondrillo", "Mythic", 1400000, 5500, rgb(70, 70, 75), rgb(60, 160, 60), 1.45),

	-- Brainrot God
	brainrot("GattoPizzanave", "Gatto Pizzanave", "Brainrot God", 2000000, 8000, rgb(240, 170, 70), rgb(150, 150, 160), 1, "Fly"),
	blocky("EspressoSignora", "Espresso Signora", "Brainrot God", 2500000, 9800, rgb(245, 245, 245), rgb(110, 60, 30), 1.3),
	blocky("OrcaleroOrcala", "Orcalero Orcala", "Brainrot God", 3000000, 11500, rgb(25, 25, 30), rgb(245, 245, 245), 1.4),
	brainrot("PiccioneMacchina", "Piccione Macchina", "Brainrot God", 3500000, 13000, rgb(140, 140, 150), rgb(60, 160, 120), 1.4, "Drive"),
	blocky("EspressinoMotorino", "Espressino Motorino", "Brainrot God", 3800000, 14000, rgb(245, 245, 245), rgb(210, 30, 40), 1.25, "Drive"),
	blocky("StatutinoLibertino", "Statutino Libertino", "Brainrot God", 4200000, 15500, rgb(110, 190, 160), rgb(255, 170, 40), 1.45),
	blocky("GattatinoNeonino", "Gattatino Neonino", "Brainrot God", 4500000, 16500, rgb(60, 30, 90), rgb(255, 60, 200), 1.3),
	brainrot("TacoplanoBombardino", "Tacoplano Bombardino", "Brainrot God", 5000000, 18000, rgb(130, 130, 140), rgb(240, 200, 60), 0.75, "Fly", TACO),
	blocky("SqualoRobuxiano", "Squalo Robuxiano", "Brainrot God", 6000000, 21000, rgb(60, 170, 90), rgb(240, 190, 50), 1.4),
	blocky("GirafaCelestre", "Girafa Celestre", "Brainrot God", 7000000, 23500, rgb(245, 200, 90), rgb(240, 240, 250), 1.6),
	brainrot("CocofantoElefanto", "Cocofanto Elefanto", "Brainrot God", 8000000, 26000, rgb(120, 70, 35), rgb(150, 150, 160), 1.5),
	blocky("TrenostruzzoTurbo3000", "Trenostruzzo Turbo 3000", "Brainrot God", 9000000, 29000, rgb(40, 40, 45), rgb(220, 40, 40), 1.2, "Drive"),
	blocky("BanhammeroGiustiziere", "Banhammero Giustiziere", "Brainrot God", 10000000, 32000, rgb(30, 30, 35), rgb(220, 30, 40), 1.5),
	blocky("CanelitoCannolito", "Canelito Cannolito", "Brainrot God", 13500000, 41000, rgb(234, 208, 162), rgb(216, 50, 43), 1.2, "Skate"),

	-- Secret
	brainrot("SpaghettiTualetti", "Spaghetti Tualetti", "Secret", 15000000, 50000, rgb(245, 245, 245), rgb(250, 210, 80), 1.5, "Hop"),
	blocky("OofosauroRex", "Oofosauro Rex", "Secret", 18000000, 58000, rgb(245, 205, 48), rgb(13, 105, 172), 1.6),
	blocky("GraipussMedussi", "Graipuss Medussi", "Secret", 20000000, 64000, rgb(120, 50, 170), rgb(90, 170, 60), 1.4, "Fly"),
	brainrot("TacoritaBicicleta", "Tacorita Bicicleta", "Secret", 25000000, 75000, rgb(240, 200, 60), rgb(40, 110, 230), 1.4, "Drive", TACO),
	blocky("LosTralaleritos", "Los Tralaleritos", "Secret", 28000000, 82000, rgb(40, 130, 230), rgb(240, 190, 50), 1.4),
	blocky("SpaghettoneSqualone", "Spaghettone Squalone", "Secret", 30000000, 88000, rgb(225, 185, 90), rgb(245, 245, 245), 1.1, "Fly"),
	blocky("ChicleteiraBicicleteira", "Chicleteira Bicicleteira", "Secret", 32000000, 95000, rgb(255, 120, 180), rgb(220, 40, 50), 1.4, "Drive"),
	brainrot("LaVacaSaturnoSaturnita", "La Vaca Saturno Saturnita", "Secret", 35000000, 110000, rgb(245, 150, 50), rgb(240, 200, 40), 1.5),
	blocky("NuclearoDinossauro", "Nuclearo Dinossauro", "Secret", 40000000, 120000, rgb(40, 90, 40), rgb(170, 255, 60), 1.7),
	blocky("GalatticoGuestone", "Galattico Guestone", "Secret", 45000000, 130000, rgb(50, 30, 110), rgb(255, 120, 220), 1.7),
	blocky("DragonCannelloni", "Dragon Cannelloni", "Secret", 50000000, 140000, rgb(245, 220, 150), rgb(210, 50, 40), 1.3, "Fly"),
	blocky("BenjiniSkatini", "Benjini Skatini", "Secret", 58000000, 155000, rgb(29, 29, 34), rgb(228, 197, 142), 1.6, "Skate"),
	blocky("GregginiRicciolini", "Greggini Ricciolini", "Secret", 62000000, 162000, rgb(246, 246, 248), rgb(31, 24, 20), 1.6, "Skate"),
	brainrot("SessantaSette", "67", "Secret", 67000000, 167000, rgb(40, 140, 240), rgb(250, 250, 250), 1.8),
	blocky("LaGrandeCombinasion", "La Grande Combinasion", "Secret", 80000000, 190000, rgb(40, 130, 230), rgb(240, 190, 50), 1.9),
	blocky("StrawberryElephant", "Strawberry Elephant", "Secret", 100000000, 230000, rgb(225, 40, 55), rgb(80, 170, 60), 1.8),
	blocky("AdminoSupremo", "Admino Supremo", "Secret", 150000000, 300000, rgb(200, 30, 40), rgb(255, 210, 60), 1.7, "Walk", SEASON),

	-- OG: rarer than any Secret. The weekly limited brainrots, which also turn
	-- up on the conveyor on a tiny chance of their own (OGChance).
	blocky("KorbloxoScheletrino", "Korbloxo Scheletrino", "OG", 250000000, 500000, rgb(40, 50, 110), rgb(120, 200, 255), 1.2, "Walk", LIMITED),
	blocky("ValkyrioPolpetto", "Valkyrio Polpetto", "OG", 400000000, 750000, rgb(130, 70, 40), rgb(200, 205, 215), 1.25, "Walk", LIMITED),
	blocky("HeadlessoZuccone", "Headlesso Zuccone", "OG", 600000000, 1000000, rgb(30, 30, 35), rgb(255, 130, 20), 1.35, "Walk", LIMITED),
	blocky("DominussoCappuccinoso", "Dominusso Cappuccinoso", "OG", 800000000, 1300000, rgb(30, 35, 60), rgb(240, 190, 60), 1.35, "Walk", LIMITED),
	blocky("SparklinoFedorino", "Sparklino Fedorino", "OG", 1200000000, 2000000, rgb(245, 245, 240), rgb(140, 60, 200), 1.4, "Walk", LIMITED),
}

-- Lucky blocks walk home like brainrots (hopping) and earn nothing; their
-- owner opens them in their base for a random brainrot. The first three can
-- turn up on the conveyor (ConveyorWeight); the Secret one is Robux only.
local function luckyBlock(
	id: string,
	displayName: string,
	rarity: string,
	price: number,
	color: Color3,
	accent: Color3,
	odds: { [string]: number }
): Brainrot
	return table.freeze({
		Id = id,
		Kind = "LuckyBlock" :: Kind,
		DisplayName = displayName,
		Rarity = rarity,
		Price = price,
		IncomePerSecond = 0,
		BodyShape = "Block" :: BodyShape,
		BodyColor = color,
		AccentColor = accent,
		Scale = 1,
		Motion = "Hop" :: Motion,
		Tags = table.freeze({}),
		BlockBuilt = false,
		Exclusive = false,
		Odds = table.freeze(odds),
	})
end

local LuckyBlocks: { Brainrot } = {
	luckyBlock("LuckyBlock", "Lucky Block", "Epic", 25000, rgb(255, 200, 40), rgb(255, 255, 255), {
		Rare = 40,
		Epic = 35,
		Legendary = 20,
		Mythic = 5,
	}),
	luckyBlock("MythicLuckyBlock", "Mythic Lucky Block", "Mythic", 400000, rgb(255, 60, 90), rgb(255, 220, 230), {
		Legendary = 50,
		Mythic = 40,
		["Brainrot God"] = 9,
		Secret = 1,
	}),
	luckyBlock("GodLuckyBlock", "Brainrot God Lucky Block", "Brainrot God", 5000000, rgb(255, 120, 255), rgb(120, 240, 255), {
		Mythic = 55,
		["Brainrot God"] = 40,
		Secret = 5,
	}),
	luckyBlock("SecretLuckyBlock", "Secret Lucky Block", "Secret", 50000000, rgb(25, 25, 30), rgb(255, 255, 255), {
		["Brainrot God"] = 70,
		Secret = 30,
	}),
}
-- How often each lucky block turns up on the conveyor (relative), and the
-- chance for any conveyor spawn to be a lucky block.
local LuckyBlockWeights: { [string]: number } = table.freeze({
	LuckyBlock = 80,
	MythicLuckyBlock = 17,
	GodLuckyBlock = 3,
})
local LUCKY_BLOCK_CHANCE = 0.05

local ById: { [string]: Brainrot } = {}
local ByRarity: { [string]: { Brainrot } } = {}
local RarityByName: { [string]: Rarity } = {}

for _, rarity in Rarities do
	RarityByName[rarity.Name] = rarity
	ByRarity[rarity.Name] = {}
end
-- What the conveyor, lucky blocks and fusing can give (and what the Index
-- pages need): everything but the exclusive brainrots.
local Obtainable: { Brainrot } = {}
local DropsByRarity: { [string]: { Brainrot } } = {}
for _, rarity in Rarities do
	DropsByRarity[rarity.Name] = {}
end
for _, definition in Brainrots do
	ById[definition.Id] = definition
	table.insert(ByRarity[definition.Rarity], definition)
	if not definition.Exclusive then
		table.insert(Obtainable, definition)
		table.insert(DropsByRarity[definition.Rarity], definition)
	end
end
-- The OG finds: the Limited brainrots, which the conveyor can still spawn on
-- a tiny chance of its own (OG_CHANCE per spawn, raised by luck boosts).
local OGFinds: { Brainrot } = {}
for _, definition in Brainrots do
	if definition.Rarity == "OG" then
		table.insert(OGFinds, definition)
	end
end
-- About one every 2-3 hours in a server (a spawn every 2.5 seconds).
local OG_CHANCE = 1 / 4000
-- Lucky blocks can be saved, bought and stolen like brainrots, but aren't in
-- Brainrots, ByRarity or the Index.
for _, definition in LuckyBlocks do
	ById[definition.Id] = definition
end

local Mutations: { Mutation } = {
	{ Name = "Gold", Chance = 0.06, Multiplier = 1.5, Color = rgb(255, 205, 50) },
	{ Name = "Diamond", Chance = 0.025, Multiplier = 2, Color = rgb(110, 225, 255) },
	{ Name = "Rainbow", Chance = 0.006, Multiplier = 5, Color = rgb(255, 110, 220) },
	-- Only during their events.
	{ Name = "Bloodrot", Chance = 0, Multiplier = 3, Color = rgb(200, 20, 40) },
	{ Name = "Galaxy", Chance = 0, Multiplier = 4, Color = rgb(150, 80, 255) },
	{ Name = "Lava", Chance = 0, Multiplier = 3.5, Color = rgb(255, 100, 20) },
	{ Name = "Frozen", Chance = 0, Multiplier = 2.5, Color = rgb(170, 230, 255) },
	{ Name = "Taco", Chance = 0, Multiplier = 3, Color = rgb(255, 185, 50) },
	{ Name = "Lucky", Chance = 0, Multiplier = 2.5, Color = rgb(60, 235, 120) },
	{ Name = "Cash", Chance = 0, Multiplier = 3, Color = rgb(170, 255, 90) },
	{ Name = "Storm", Chance = 0, Multiplier = 4, Color = rgb(110, 170, 255) },
	{ Name = "Heist", Chance = 0, Multiplier = 3.5, Color = rgb(255, 215, 70) },
	{ Name = "Boss", Chance = 0, Multiplier = 5, Color = rgb(255, 80, 40) },
	-- ADMIN ABUSE only, and rarely even then.
	{ Name = "Admin", Chance = 0, Multiplier = 7, Color = rgb(255, 40, 70) },
}

local MutationByName: { [string]: Mutation } = {}
for _, mutation in Mutations do
	MutationByName[mutation.Name] = mutation
end

local Traits: { Trait } = {
	{ Name = "Fire", Chance = 0.03, Multiplier = 2, Scale = 1, Color = rgb(255, 120, 30), Icon = "🔥" },
	{ Name = "Tiny", Chance = 0.03, Multiplier = 1.5, Scale = 0.6, Color = rgb(140, 255, 200), Icon = "🐜" },
	{ Name = "Giant", Chance = 0.02, Multiplier = 3, Scale = 1.6, Color = rgb(255, 210, 80), Icon = "🗿" },
	{ Name = "Glitched", Chance = 0.006, Multiplier = 6, Scale = 1, Color = rgb(60, 255, 240), Icon = "👾" },
	{ Name = "Nyan", Chance = 0.003, Multiplier = 8, Scale = 1, Color = rgb(255, 120, 220), Icon = "🌈" },
}

local TraitByName: { [string]: Trait } = {}
for _, trait in Traits do
	TraitByName[trait.Name] = trait
end

-- Saved brainrots are "Id", "Id:Mutation", "Id::Trait" or "Id:Mutation:Trait".
-- A brainrot in a base also saves its hat and how long it has been levelling
-- up: "Id:Mutation:Trait:Hat:Seconds" (see encodeFull).
local ENTRY_PATTERN = "^(%w+):?(%w*):?(%w*):?(%w*):?(%d*)$"

local function encode(brainrotId: string, mutationName: string?, traitName: string?): string
	if traitName then
		return brainrotId .. ":" .. (mutationName or "") .. ":" .. traitName
	end
	return if mutationName then brainrotId .. ":" .. mutationName else brainrotId
end

-- Like encode, plus the brainrot's hat and level time (whole seconds).
local function encodeFull(brainrotId: string, mutationName: string?, traitName: string?, hatName: string?, seconds: number?): string
	local whole = math.max(0, math.floor(seconds or 0))
	if (hatName == nil or hatName == "") and whole == 0 then
		return encode(brainrotId, mutationName, traitName)
	end
	return string.format("%s:%s:%s:%s:%d", brainrotId, mutationName or "", traitName or "", hatName or "", whole)
end

local function decode(entry: string): (Brainrot?, Mutation?, Trait?)
	local brainrotId, mutationName, traitName = string.match(entry, ENTRY_PATTERN)
	if brainrotId == nil then
		return nil, nil, nil
	end
	local mutation = if mutationName and mutationName ~= "" then MutationByName[mutationName] else nil
	local trait = if traitName and traitName ~= "" then TraitByName[traitName] else nil
	return ById[brainrotId], mutation, trait
end

-- The hat (a name, or nil) and level seconds saved with an entry.
local function decodeExtras(entry: string): (string?, number)
	local _, _, _, hatName, seconds = string.match(entry, ENTRY_PATTERN)
	return if hatName and hatName ~= "" then hatName else nil, tonumber(seconds) or 0
end

-- The entry without its hat and level ("Id:Mutation:Trait").
local function plainEntry(entry: string): string
	local brainrotId, mutationName, traitName = string.match(entry, ENTRY_PATTERN)
	if brainrotId == nil then
		return entry
	end
	return encode(brainrotId, if mutationName ~= "" then mutationName else nil, if traitName ~= "" then traitName else nil)
end

-- Income and price multiplier from a mutation and a trait together.
local function multiplier(mutation: Mutation?, trait: Trait?): number
	return (if mutation then mutation.Multiplier else 1) * (if trait then trait.Multiplier else 1)
end

local function isLuckyBlock(definition: Brainrot): boolean
	return definition.Kind == "LuckyBlock"
end

-- "Fire Gold Tim Cheese"
local function fullName(definition: Brainrot, mutation: Mutation?, trait: Trait?): string
	local name = definition.DisplayName
	if mutation then
		name = mutation.Name .. " " .. name
	end
	if trait then
		name = trait.Name .. " " .. name
	end
	return name
end

local function hasTag(definition: Brainrot, tag: string): boolean
	return table.find(definition.Tags, tag) ~= nil
end

return table.freeze({
	Mutations = table.freeze(Mutations),
	MutationByName = table.freeze(MutationByName),
	Traits = table.freeze(Traits),
	TraitByName = table.freeze(TraitByName),
	LuckyBlocks = table.freeze(LuckyBlocks),
	LuckyBlockWeights = LuckyBlockWeights,
	LuckyBlockChance = LUCKY_BLOCK_CHANCE,
	encode = encode,
	encodeFull = encodeFull,
	decode = decode,
	decodeExtras = decodeExtras,
	plainEntry = plainEntry,
	multiplier = multiplier,
	isLuckyBlock = isLuckyBlock,
	fullName = fullName,
	hasTag = hasTag,
	Rarities = table.freeze(Rarities),
	Brainrots = table.freeze(Brainrots),
	Obtainable = table.freeze(Obtainable),
	ById = table.freeze(ById),
	ByRarity = table.freeze(ByRarity),
	DropsByRarity = table.freeze(DropsByRarity),
	OGFinds = table.freeze(OGFinds),
	OGChance = OG_CHANCE,
	RarityByName = table.freeze(RarityByName),
})
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="269">
        <Properties>
          <string name="Name">ExtrasConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Settings for the features the original game doesn't have: brainrot levels
-- and hats, guard brainrots, pets, revenge, bounties, crews, the season pass,
-- the weekly limited shop, boss raids and bank heists. Shared by the server
-- scripts and the client UI.

local FeatureConfig = require(script.Parent:WaitForChild("FeatureConfig"))

type Reward = FeatureConfig.Reward

local rgb = Color3.fromRGB

local ExtrasConfig = {}

--------------------------------------------------------------------------------
-- Brainrot levels: a brainrot on its pedestal (or earning offline) levels up
-- over time, each level adding income. A stolen brainrot starts over at 1.
--------------------------------------------------------------------------------

-- Minutes on a pedestal to reach each level (level 1 is where it starts).
ExtrasConfig.LevelMinutes = table.freeze({ 0, 5, 15, 30, 60, 100, 150, 210, 280, 360 })
ExtrasConfig.MaxLevel = #ExtrasConfig.LevelMinutes
ExtrasConfig.IncomePerLevel = 0.1

function ExtrasConfig.levelOf(seconds: number): number
	local minutes = seconds / 60
	local level = 1
	for index, needed in ExtrasConfig.LevelMinutes do
		if minutes >= needed then
			level = index
		end
	end
	return level
end

function ExtrasConfig.levelMultiplier(level: number): number
	return 1 + ExtrasConfig.IncomePerLevel * (math.clamp(level, 1, ExtrasConfig.MaxLevel) - 1)
end

-- Seconds still needed for the next level (nil at the top level).
function ExtrasConfig.secondsToNextLevel(seconds: number): number?
	local level = ExtrasConfig.levelOf(seconds)
	local nextMinutes = ExtrasConfig.LevelMinutes[level + 1]
	if nextMinutes == nil then
		return nil
	end
	return math.max(0, nextMinutes * 60 - seconds)
end

--------------------------------------------------------------------------------
-- Hats: worn by a brainrot for extra income. Won from the season pass, boss
-- raids and Hat Crates. A hat goes back to its owner when the brainrot is
-- sold, stolen, traded or fused.
--------------------------------------------------------------------------------

export type Hat = {
	Name: string,
	DisplayName: string,
	-- Extra income for the brainrot wearing it.
	Bonus: number,
	-- How likely a random hat (crate, boss drop) is this one.
	Weight: number,
	Color: Color3,
	Icon: string,
}

ExtrasConfig.Hats = table.freeze({
	table.freeze({ Name = "PartyHat", DisplayName = "Party Hat", Bonus = 0.05, Weight = 30, Color = rgb(255, 90, 170), Icon = "🥳" }),
	table.freeze({ Name = "ChefHat", DisplayName = "Chef Hat", Bonus = 0.07, Weight = 24, Color = rgb(245, 245, 245), Icon = "🍝" }),
	table.freeze({ Name = "CowboyHat", DisplayName = "Cowboy Hat", Bonus = 0.1, Weight = 18, Color = rgb(170, 110, 60), Icon = "🤠" }),
	table.freeze({ Name = "TopHat", DisplayName = "Top Hat", Bonus = 0.12, Weight = 12, Color = rgb(35, 35, 40), Icon = "🎩" }),
	table.freeze({ Name = "VikingHelmet", DisplayName = "Viking Helmet", Bonus = 0.15, Weight = 8, Color = rgb(190, 195, 205), Icon = "⚔️" }),
	table.freeze({ Name = "WizardHat", DisplayName = "Wizard Hat", Bonus = 0.18, Weight = 5, Color = rgb(90, 60, 200), Icon = "🧙" }),
	table.freeze({ Name = "Halo", DisplayName = "Halo", Bonus = 0.22, Weight = 2.5, Color = rgb(255, 235, 120), Icon = "😇" }),
	table.freeze({ Name = "Crown", DisplayName = "Crown", Bonus = 0.25, Weight = 1, Color = rgb(255, 205, 50), Icon = "👑" }),
} :: { Hat })

local hatByName: { [string]: Hat } = {}
for _, hat in ExtrasConfig.Hats do
	hatByName[hat.Name] = hat
end
ExtrasConfig.HatByName = table.freeze(hatByName)

-- A random hat by weight; `roll` is a number from 0 to 1.
function ExtrasConfig.randomHat(roll: number): Hat
	local total = 0
	for _, hat in ExtrasConfig.Hats do
		total += hat.Weight
	end
	local left = roll * total
	for _, hat in ExtrasConfig.Hats do
		left -= hat.Weight
		if left <= 0 then
			return hat
		end
	end
	return ExtrasConfig.Hats[1]
end

--------------------------------------------------------------------------------
-- Guard brainrots: one brainrot per base stands guard in front of its door,
-- pacing across it. When someone who isn't the owner (or in their crew) comes
-- close, it shouts ("!"), then charges and knocks them back; a thief it
-- catches drops what they carry. Then it rests a while.
--
-- Balanced so stealing still works: it's slower than a walking player (only
-- a thief carrying a brainrot is slower than it), gives a moment's warning,
-- never chases far from its post, ignores cloaked players, rests after every
-- hit, and a slap dazes it for a few seconds.
--------------------------------------------------------------------------------

-- How far in front of the door it stands, and how far either side it paces.
ExtrasConfig.GuardPostDistance = 7
ExtrasConfig.GuardPatrolWidth = 5
-- It notices intruders this close to its post, and never chases further.
ExtrasConfig.GuardRadius = 14
ExtrasConfig.GuardLeash = 20
-- The "!" before it charges.
ExtrasConfig.GuardWindupSeconds = 0.8
-- (Players walk at 16, or 11 carrying a brainrot.)
ExtrasConfig.GuardChaseSpeed = 13
ExtrasConfig.GuardPatrolSpeed = 4
ExtrasConfig.GuardHitDistance = 4
ExtrasConfig.GuardKnockback = 60
ExtrasConfig.GuardStunSeconds = 1
-- A slap glove dazes it this long.
ExtrasConfig.GuardDazeSeconds = 6
-- Seconds between hits, by the guard's rarity. The Super Guard pass halves it.
ExtrasConfig.GuardCooldowns = table.freeze({
	Common = 24,
	Rare = 22,
	Epic = 20,
	Legendary = 18,
	Mythic = 16,
	["Brainrot God"] = 14,
	Secret = 12,
	OG = 10,
} :: { [string]: number })
ExtrasConfig.SuperGuardCooldownMultiplier = 0.5

--------------------------------------------------------------------------------
-- Pets: brainrots from your base follow you around, each making you faster:
-- the fastest one in full, the others a quarter each, up to PetSpeedCap.
-- Everyone starts with one pet slot; more cost Cash (the Pets button), and
-- each costs a lot more than the last.
--------------------------------------------------------------------------------

ExtrasConfig.PetSpeedBonus = table.freeze({
	Common = 1,
	Rare = 1.5,
	Epic = 2,
	Legendary = 2.5,
	Mythic = 3,
	["Brainrot God"] = 3.5,
	Secret = 4,
	OG = 5,
} :: { [string]: number })
ExtrasConfig.PetSpeedCap = 8
ExtrasConfig.PetExtraSpeedShare = 0.25
-- The price of each pet slot (the first is free).
ExtrasConfig.PetSlotPrices = table.freeze({ 0, 1_000_000, 25_000_000, 500_000_000, 10_000_000_000, 100_000_000_000 } :: { number })
ExtrasConfig.MaxPetSlots = #ExtrasConfig.PetSlotPrices

-- Walk speed from a set of pets (their rarities).
function ExtrasConfig.petSpeed(rarities: { string }): number
	local bonuses: { number } = {}
	for _, rarity in rarities do
		table.insert(bonuses, ExtrasConfig.PetSpeedBonus[rarity] or 1)
	end
	table.sort(bonuses, function(a, b)
		return a > b
	end)
	local total = 0
	for index, bonus in bonuses do
		total += if index == 1 then bonus else bonus * ExtrasConfig.PetExtraSpeedShare
	end
	return math.min(total, ExtrasConfig.PetSpeedCap)
end

-- Height of a pet in studs (its model is shrunk to this).
ExtrasConfig.PetHeight = 2.8

--------------------------------------------------------------------------------
-- Revenge: someone steals from you, you get a minute to get them back.
--------------------------------------------------------------------------------

ExtrasConfig.RevengeSeconds = 60
ExtrasConfig.RevengeSpeedBonus = 6
-- Stealing from your thief during revenge pays this many seconds of your income.
ExtrasConfig.RevengeIncomeSeconds = 120
ExtrasConfig.RevengeMinCash = 500

--------------------------------------------------------------------------------
-- Bounties: the server's top thief has a price on their head.
--------------------------------------------------------------------------------

-- Steals this session before a bounty appears.
ExtrasConfig.BountyMinSteals = 3
-- Bounty: this much, plus this many seconds of the holder's income per steal.
ExtrasConfig.BountyBase = 1000
ExtrasConfig.BountyIncomeSecondsPerSteal = 20
ExtrasConfig.BountyMaxIncomeSeconds = 600

--------------------------------------------------------------------------------
-- Crews: team up with other players in the server.
--------------------------------------------------------------------------------

ExtrasConfig.CrewMaxSize = 4
-- Extra income for each other crew member in the server.
ExtrasConfig.CrewBoostPerMember = 0.05
ExtrasConfig.CrewInviteSeconds = 30
ExtrasConfig.CrewNames = table.freeze({
	"Brainrot Bandits",
	"Tung Tung Squad",
	"Pizza Mafia",
	"Noob Army",
	"Sahur Syndicate",
	"Crocodilo Crew",
	"Taco Gang",
	"Guest Legion",
	"Bacon Brigade",
	"Oof Society",
	"Lirili Legends",
	"Cappuccino Club",
})
ExtrasConfig.CrewColors = table.freeze({
	rgb(255, 80, 80),
	rgb(255, 170, 40),
	rgb(250, 230, 60),
	rgb(80, 220, 110),
	rgb(60, 200, 255),
	rgb(90, 120, 255),
	rgb(190, 90, 255),
	rgb(255, 110, 200),
})

--------------------------------------------------------------------------------
-- Season pass: play to earn XP, climb 30 tiers. Everyone gets the free
-- rewards; the Season Pass game pass adds the premium ones.
--------------------------------------------------------------------------------

ExtrasConfig.SeasonDays = 28
-- Season 1 starts on this date (UTC); a new one starts every SeasonDays.
ExtrasConfig.SeasonEpoch = 1767225600 -- 2026-01-01
ExtrasConfig.TierXP = 150
ExtrasConfig.PlaytimeXPPerMinute = 2
-- XP for each thing you do (the Activity kinds GameplayManager reports).
ExtrasConfig.ActivityXP = table.freeze({
	Buy = 4,
	BuyEpic = 10,
	Steal = 25,
	Collect = 1,
	OpenBlock = 15,
	Lock = 3,
	Upgrade = 8,
	Catch = 15,
	Fuse = 20,
	Trade = 10,
	Rebirth = 150,
	Slap = 2,
	Spin = 5,
	Secret = 100,
	Quest = 40,
	Revenge = 30,
	Bounty = 60,
	BossHit = 1,
	BossWin = 60,
	Heist = 20,
} :: { [string]: number })

local function cash(minutes: number, min: number): Reward
	local reward: Reward = { Kind = "Cash", Minutes = minutes, Min = min }
	return table.freeze(reward)
end
local function spins(count: number): Reward
	local reward: Reward = { Kind = "Spins", Count = count }
	return table.freeze(reward)
end
local function boost(minutes: number): Reward
	local reward: Reward = { Kind = "Boost", Seconds = minutes * 60 }
	return table.freeze(reward)
end
local function block(id: string): Reward
	local reward: Reward = { Kind = "Block", Id = id }
	return table.freeze(reward)
end
local function brainrot(id: string): Reward
	local reward: Reward = { Kind = "Brainrot", Id = id }
	return table.freeze(reward)
end
local function hat(name: string): Reward
	local reward: Reward = { Kind = "Hat", Hat = name }
	return table.freeze(reward)
end

-- Tier N: { Free, Premium }.
ExtrasConfig.SeasonTiers = table.freeze({
	{ cash(5, 1000), cash(15, 3000) },
	{ spins(1), hat("CowboyHat") },
	{ cash(10, 2000), spins(3) },
	{ hat("PartyHat"), block("LuckyBlock") },
	{ block("LuckyBlock"), boost(20) },
	{ cash(15, 3000), cash(30, 6000) },
	{ boost(10), hat("TopHat") },
	{ spins(2), block("MythicLuckyBlock") },
	{ cash(20, 4000), spins(5) },
	{ hat("ChefHat"), brainrot("GuestiGuacanini") },
	{ block("LuckyBlock"), cash(45, 9000) },
	{ cash(25, 5000), hat("VikingHelmet") },
	{ spins(2), boost(30) },
	{ boost(15), block("MythicLuckyBlock") },
	{ block("MythicLuckyBlock"), hat("WizardHat") },
	{ cash(30, 6000), cash(60, 12000) },
	{ hat("CowboyHat"), block("GodLuckyBlock") },
	{ spins(3), spins(5) },
	{ cash(40, 8000), hat("Halo") },
	{ block("MythicLuckyBlock"), brainrot("OrcaleroOrcala") },
	{ boost(20), cash(90, 18000) },
	{ cash(50, 10000), boost(45) },
	{ hat("TopHat"), block("GodLuckyBlock") },
	{ spins(3), hat("Crown") },
	{ block("GodLuckyBlock"), spins(8) },
	{ cash(60, 12000), cash(120, 25000) },
	{ hat("VikingHelmet"), block("SecretLuckyBlock") },
	{ boost(30), boost(60) },
	{ cash(90, 18000), cash(180, 40000) },
	{ block("GodLuckyBlock"), brainrot("AdminoSupremo") },
} :: { { Reward } })
ExtrasConfig.SeasonTierCount = #ExtrasConfig.SeasonTiers

-- The current season number (1, 2, ...) and when it ends (os.time()).
function ExtrasConfig.season(now: number): (number, number)
	local length = ExtrasConfig.SeasonDays * 86400
	local number = math.max(0, (now - ExtrasConfig.SeasonEpoch) // length) + 1
	return number, ExtrasConfig.SeasonEpoch + number * length
end

function ExtrasConfig.tierOf(xp: number): number
	return math.clamp(xp // ExtrasConfig.TierXP, 0, ExtrasConfig.SeasonTierCount)
end

--------------------------------------------------------------------------------
-- Weekly limited brainrots: one famous-Roblox-limited brainrot is on sale
-- (for Robux) each week, then it's gone until it comes round again. They're
-- OG, rarer and stronger than any Secret, and the conveyor spawns one only
-- very rarely (BrainrotConfig.OGChance).
--------------------------------------------------------------------------------

export type Limited = {
	Id: string,
	-- MonetizationConfig.ProductIds key.
	Product: string,
	Robux: number,
}

ExtrasConfig.LimitedRotation = table.freeze({
	table.freeze({ Id = "KorbloxoScheletrino", Product = "LimitedKorbloxo", Robux = 799 }),
	table.freeze({ Id = "ValkyrioPolpetto", Product = "LimitedValkyrio", Robux = 999 }),
	table.freeze({ Id = "HeadlessoZuccone", Product = "LimitedHeadless", Robux = 1299 }),
	table.freeze({ Id = "DominussoCappuccinoso", Product = "LimitedDominus", Robux = 1499 }),
	table.freeze({ Id = "SparklinoFedorino", Product = "LimitedSparkle", Robux = 1999 }),
} :: { Limited })
-- Weeks start on Mondays at 00:00 UTC.
ExtrasConfig.LimitedWeekEpoch = 1767571200 -- Monday 2026-01-05

-- This week's limited brainrot and when the week ends (os.time()).
function ExtrasConfig.currentLimited(now: number): (Limited, number)
	local week = (now - ExtrasConfig.LimitedWeekEpoch) // (7 * 86400)
	local rotation = ExtrasConfig.LimitedRotation
	local index = week % #rotation + 1
	return rotation[index], ExtrasConfig.LimitedWeekEpoch + (week + 1) * 7 * 86400
end

--------------------------------------------------------------------------------
-- Boss raids: a giant brainrot rampages around the middle of the map.
-- Everyone clicks (or slaps) it. Each boss is a random tier: harder ones are
-- bigger and tougher, attack faster with more attacks (stomps, aimed lasers,
-- grabbing and throwing players, meteor rain, jump slams) and rage below
-- BossRageFraction health, but drop better loot: lucky blocks for the top
-- raiders (and on Hard and Mega for everyone who helped), Cash and hats.
--------------------------------------------------------------------------------

ExtrasConfig.BossIds = table.freeze({
	"LaVacaSaturnoSaturnita",
	"SessantaSette",
	"NuclearoDinossauro",
	"StrawberryElephant",
	"OofosauroRex",
	"TralaleroTralala",
	"BombardiroCrocodilo",
	"TungTungTungSahur",
})
-- A Normal boss; tiers scale these.
ExtrasConfig.BossHeight = 26
ExtrasConfig.BossSpeed = 7
ExtrasConfig.BossHealthPerPlayer = 450
ExtrasConfig.BossMinHealth = 900
ExtrasConfig.BossClickDamage = 5
ExtrasConfig.BossClickCooldown = 0.12
ExtrasConfig.BossSlapDamage = 45
ExtrasConfig.BossClickRange = 60
ExtrasConfig.BossStompRadius = 22
ExtrasConfig.BossStompKnockback = 75

export type BossTier = {
	Name: string,
	-- Shown on the health bar and in the announcement.
	Label: string,
	Colour: Color3,
	-- How often it's picked, against the other tiers.
	Weight: number,
	-- Multipliers for health, size and walking speed.
	Health: number,
	Size: number,
	Speed: number,
	-- Seconds between attacks, and which it can use.
	AttackSeconds: number,
	Attacks: { string },
	-- Lucky blocks for the top raiders (1st, 2nd, 3rd), one for everyone else
	-- who helped (or none), and a multiplier for the helpers' Cash.
	Prizes: { string },
	EveryonePrize: string?,
	CashMultiplier: number,
}

ExtrasConfig.BossTiers = table.freeze({
	table.freeze({
		Name = "Easy",
		Label = "🟢 EASY",
		Colour = Color3.fromRGB(90, 220, 90),
		Weight = 30,
		Health = 0.6,
		Size = 0.85,
		Speed = 0.85,
		AttackSeconds = 8,
		Attacks = table.freeze({ "Stomp", "Laser" }),
		Prizes = table.freeze({ "MythicLuckyBlock", "LuckyBlock", "LuckyBlock" }),
		EveryonePrize = nil,
		CashMultiplier = 1,
	}),
	table.freeze({
		Name = "Normal",
		Label = "🟡 NORMAL",
		Colour = Color3.fromRGB(255, 210, 60),
		Weight = 35,
		Health = 1,
		Size = 1,
		Speed = 1,
		AttackSeconds = 6.5,
		Attacks = table.freeze({ "Stomp", "Laser", "Throw" }),
		Prizes = table.freeze({ "GodLuckyBlock", "MythicLuckyBlock", "MythicLuckyBlock" }),
		EveryonePrize = nil,
		CashMultiplier = 1.5,
	}),
	table.freeze({
		Name = "Hard",
		Label = "🟠 HARD",
		Colour = Color3.fromRGB(255, 130, 30),
		Weight = 25,
		Health = 1.8,
		Size = 1.2,
		Speed = 1.15,
		AttackSeconds = 5,
		Attacks = table.freeze({ "Stomp", "Laser", "Throw", "Meteors", "Slam" }),
		Prizes = table.freeze({ "GodLuckyBlock", "GodLuckyBlock", "MythicLuckyBlock" }),
		EveryonePrize = "MythicLuckyBlock",
		CashMultiplier = 2,
	}),
	table.freeze({
		Name = "Mega",
		Label = "💀 MEGA",
		Colour = Color3.fromRGB(200, 60, 255),
		Weight = 10,
		Health = 3,
		Size = 1.5,
		Speed = 1.3,
		AttackSeconds = 4,
		Attacks = table.freeze({ "Stomp", "Laser", "Throw", "Meteors", "Slam", "Laser" }),
		Prizes = table.freeze({ "SecretLuckyBlock", "GodLuckyBlock", "GodLuckyBlock" }),
		EveryonePrize = "MythicLuckyBlock",
		CashMultiplier = 3,
	}),
} :: { BossTier })
ExtrasConfig.BossTierByName = {} :: { [string]: BossTier }
for _, tier in ExtrasConfig.BossTiers do
	ExtrasConfig.BossTierByName[tier.Name] = tier
end
table.freeze(ExtrasConfig.BossTierByName)

-- Below this much health it rages: attacks and walks this much faster.
ExtrasConfig.BossRageFraction = 0.3
ExtrasConfig.BossRageSpeedup = 1.4
-- Laser: a red line shows where it'll fire, then a beam knocks back anyone in it.
ExtrasConfig.BossLaserWindup = 1.2
ExtrasConfig.BossLaserRange = 90
ExtrasConfig.BossLaserWidth = 3.5
ExtrasConfig.BossLaserKnockback = 60
-- Throw: a red ring under someone; whoever's still in it gets grabbed and thrown.
ExtrasConfig.BossThrowWindup = 1
ExtrasConfig.BossThrowRange = 40
ExtrasConfig.BossThrowRadius = 7
ExtrasConfig.BossThrowStrength = 150
-- Meteors: red circles, then a meteor lands on each.
ExtrasConfig.BossMeteorCount = 6
ExtrasConfig.BossMeteorWindup = 1.5
ExtrasConfig.BossMeteorRadius = 8
ExtrasConfig.BossMeteorKnockback = 70
-- Slam: it leaps onto someone (they see the ring where it'll land).
ExtrasConfig.BossSlamWindup = 1.4
ExtrasConfig.BossSlamRadius = 26
ExtrasConfig.BossSlamKnockback = 95
-- Everyone who helped (at least BossMinShare of the damage) gets Cash worth
-- BossCashMinutes of their income (times the tier's multiplier) and a
-- BossHatChance chance of a random hat.
ExtrasConfig.BossMinShare = 0.02
ExtrasConfig.BossCashMinutes = 4
ExtrasConfig.BossMinCash = 2500
ExtrasConfig.BossHatChance = 0.35

--------------------------------------------------------------------------------
-- Bank heists: the vault opens. Grab loot from the piles (cash, gold bars or
-- the odd pile of diamonds, each worth more and heavier to carry) and get it
-- to your base. Security lasers sweep the vault: touch one and you're zapped
-- back (dropping your bag). In the last minute the alarm goes off: faster
-- lasers, double loot. The best robber wins a lucky block.
--------------------------------------------------------------------------------

export type HeistLoot = {
	Name: string,
	Label: string,
	Colour: Color3,
	-- How often a pile holds it, against the others.
	Weight: number,
	-- Worth this many seconds of your income (at least Min).
	IncomeSeconds: number,
	Min: number,
	-- Walk speed while carrying it.
	Speed: number,
}

ExtrasConfig.HeistLoot = table.freeze({
	table.freeze({ Name = "Cash", Label = "💵 Cash Bag", Colour = Color3.fromRGB(110, 190, 80), Weight = 60, IncomeSeconds = 45, Min = 800, Speed = -3 }),
	table.freeze({ Name = "Gold", Label = "🟨 Gold Bars", Colour = Color3.fromRGB(255, 200, 40), Weight = 30, IncomeSeconds = 90, Min = 2000, Speed = -5 }),
	table.freeze({ Name = "Diamond", Label = "💎 Diamonds", Colour = Color3.fromRGB(90, 230, 255), Weight = 10, IncomeSeconds = 180, Min = 5000, Speed = -6 }),
} :: { HeistLoot })
ExtrasConfig.HeistGrabSeconds = 1.2
ExtrasConfig.HeistRespawnSeconds = 6
-- Security lasers: bars at leg height (jump over them) sweeping the vault.
ExtrasConfig.HeistLaserCount = 3
ExtrasConfig.HeistLaserSpeed = 7
ExtrasConfig.HeistLaserKnockback = 45
-- The alarm: the last this many seconds of the heist.
ExtrasConfig.HeistAlarmSeconds = 60
ExtrasConfig.HeistAlarmLaserSpeed = 13
ExtrasConfig.HeistAlarmMultiplier = 2
-- Whoever banks the most loot wins this.
ExtrasConfig.HeistTopPrize = "MythicLuckyBlock"

--------------------------------------------------------------------------------
-- Walk speed from these features: each sets its own player attribute and the
-- walk speed adds them up (GameplayManager and GearManager).
--------------------------------------------------------------------------------

ExtrasConfig.SpeedAttributes = table.freeze({ "RevengeSpeed", "PetSpeed", "LootSpeed" })

function ExtrasConfig.speedBonusOf(player: Player): number
	local total = 0
	for _, name in ExtrasConfig.SpeedAttributes do
		total += tonumber(player:GetAttribute(name)) or 0
	end
	return math.clamp(total, -10, 20)
end

return table.freeze(ExtrasConfig)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="270">
        <Properties>
          <string name="Name">FeatureConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Tuning for the extra systems: index rewards, rebirth requirements, upgrades,
-- base skins, income boosts, the spin wheel, daily and playtime rewards,
-- codes, quests, badges, fusing, trading and Admin Abuse. Read by the server
-- scripts that run them and by the client menus that show them.

local BrainrotConfig = require(script.Parent:WaitForChild("BrainrotConfig"))
local NumberFormat = require(script.Parent:WaitForChild("NumberFormat"))

local rgb = Color3.fromRGB

-- What a reward gives. Cash rewards scale with the player's income so they
-- stay worth having: `Minutes` of income, at least `Min`.
export type Reward = {
	Kind: "Cash" | "Spins" | "Block" | "Brainrot" | "Boost" | "Hat",
	Minutes: number?,
	Min: number?,
	Count: number?,
	-- A lucky block or brainrot Id (Block, Brainrot).
	Id: string?,
	-- Cash Boost length (Boost).
	Seconds: number?,
	-- A hat's name (ExtrasConfig.Hats), or "Random".
	Hat: string?,
}

export type SpinPrize = {
	Name: string,
	Reward: Reward,
	Weight: number,
	Color: Color3,
}

export type QuestInfo = {
	Id: string,
	-- What counts, as reported by the Activity event (see GameplayManager).
	Activity: string,
	Target: number,
	Text: string,
	Reward: Reward,
}

export type BaseSkin = {
	Name: string,
	-- Cash price, or nil when it's sold for Robux (ProductKey).
	Price: number?,
	ProductKey: string?,
	Wall: Color3,
	WallMaterial: Enum.Material,
	Floor: Color3,
	FloorMaterial: Enum.Material,
	Trim: Color3,
	-- Animated on the client: "Rainbow" cycles colours, "Galaxy" twinkles.
	Effect: string?,
}

local function cash(minutes: number, min: number): Reward
	local reward: Reward = { Kind = "Cash", Minutes = minutes, Min = min }
	return table.freeze(reward)
end
local function spins(count: number): Reward
	local reward: Reward = { Kind = "Spins", Count = count }
	return table.freeze(reward)
end
local function block(id: string): Reward
	local reward: Reward = { Kind = "Block", Id = id }
	return table.freeze(reward)
end
local function brainrot(id: string): Reward
	local reward: Reward = { Kind = "Brainrot", Id = id }
	return table.freeze(reward)
end
local function boost(seconds: number): Reward
	local reward: Reward = { Kind = "Boost", Seconds = seconds }
	return table.freeze(reward)
end

local FeatureConfig = {}

--------------------------------------------------------------------------------
-- Index: finding every brainrot of a rarity (or every brainrot in a
-- mutation) pays out once and adds a permanent income bonus.
--------------------------------------------------------------------------------

FeatureConfig.IndexRewards = table.freeze({
	["Common"] = table.freeze({ Bonus = 0.05, Cash = 5000 }),
	["Rare"] = table.freeze({ Bonus = 0.05, Cash = 25000 }),
	["Epic"] = table.freeze({ Bonus = 0.1, Cash = 150000 }),
	["Legendary"] = table.freeze({ Bonus = 0.1, Cash = 1000000 }),
	["Mythic"] = table.freeze({ Bonus = 0.15, Cash = 5000000 }),
	["Brainrot God"] = table.freeze({ Bonus = 0.2, Cash = 25000000 }),
	["Secret"] = table.freeze({ Bonus = 0.25, Cash = 100000000 }),
})
-- Index pages for mutations: every brainrot in that mutation.
FeatureConfig.MutationIndex = table.freeze({ "Gold", "Diamond", "Rainbow" })
FeatureConfig.MutationIndexRewards = table.freeze({
	Gold = table.freeze({ Bonus = 0.1, Cash = 2000000 }),
	Diamond = table.freeze({ Bonus = 0.15, Cash = 10000000 }),
	Rainbow = table.freeze({ Bonus = 0.3, Cash = 50000000 }),
})

--------------------------------------------------------------------------------
-- Rebirths: besides the Cash, each rebirth needs these brainrots in your
-- base (any mutation or trait). You keep them. Past the list, the last
-- entry repeats.
--------------------------------------------------------------------------------

FeatureConfig.RebirthRequirements = table.freeze({
	table.freeze({ "TungTungTungSahur", "TrippiTroppi" }),
	table.freeze({ "BrrBrrPatapim", "CappuccinoAssassino" }),
	table.freeze({ "ChimpanziniBananini", "BallerinaCappuccina" }),
	table.freeze({ "Cioccolatone", "PeperoncinoFigo" }),
	table.freeze({ "BombardiroCrocodilo", "TralaleroTralala" }),
	table.freeze({ "RattoSchiaffone", "CoccodrilloTacorito" }),
	table.freeze({ "GattoPizzanave" }),
	table.freeze({ "PiccioneMacchina", "TacoplanoBombardino" }),
	table.freeze({ "SpaghettiTualetti" }),
	table.freeze({ "TacoritaBicicleta", "SessantaSette" }),
})

function FeatureConfig.getRebirthRequirement(rebirths: number): { string }
	local list = FeatureConfig.RebirthRequirements
	return list[math.clamp(rebirths + 1, 1, #list)]
end

--------------------------------------------------------------------------------
-- Upgrades
--------------------------------------------------------------------------------

-- Walk speed: each level adds SpeedPerLevel (and a little carry speed).
FeatureConfig.SpeedPerLevel = 2
FeatureConfig.CarrySpeedPerLevel = 0.5
FeatureConfig.SpeedCosts = table.freeze({ 5000, 20000, 80000, 300000, 1000000, 3500000, 12000000, 40000000, 130000000, 400000000 })

-- Pedestals: each level above 1 adds PedestalBonus to what the brainrot on it earns.
FeatureConfig.PedestalBonus = 0.25
FeatureConfig.PedestalCosts = table.freeze({ 5000, 60000, 750000, 9000000 })
FeatureConfig.PedestalColors = table.freeze({
	rgb(90, 230, 110),
	rgb(70, 160, 255),
	rgb(190, 90, 255),
	rgb(255, 200, 40),
})

function FeatureConfig.maxPedestalLevel(): number
	return #FeatureConfig.PedestalCosts + 1
end

-- Base skins recolour the walls, floors and neon trim of your base.
FeatureConfig.BaseSkins = table.freeze({
	table.freeze({
		Name = "Classic",
		Price = 0,
		Wall = rgb(92, 97, 112),
		WallMaterial = Enum.Material.Plastic,
		Floor = rgb(184, 186, 194),
		FloorMaterial = Enum.Material.Plastic,
		Trim = rgb(255, 255, 255),
		Effect = "Classic",
	}),
	table.freeze({
		Name = "Candy",
		Price = 250000,
		Wall = rgb(255, 170, 210),
		WallMaterial = Enum.Material.SmoothPlastic,
		Floor = rgb(255, 235, 245),
		FloorMaterial = Enum.Material.SmoothPlastic,
		Trim = rgb(120, 230, 255),
	}),
	table.freeze({
		Name = "Jungle",
		Price = 1000000,
		Wall = rgb(90, 130, 60),
		WallMaterial = Enum.Material.Grass,
		Floor = rgb(120, 85, 50),
		FloorMaterial = Enum.Material.WoodPlanks,
		Trim = rgb(180, 255, 80),
	}),
	table.freeze({
		Name = "Ice",
		Price = 2500000,
		Wall = rgb(170, 220, 255),
		WallMaterial = Enum.Material.Ice,
		Floor = rgb(225, 245, 255),
		FloorMaterial = Enum.Material.Glacier,
		Trim = rgb(90, 200, 255),
	}),
	table.freeze({
		Name = "Lava",
		Price = 10000000,
		Wall = rgb(60, 40, 40),
		WallMaterial = Enum.Material.Basalt,
		Floor = rgb(90, 50, 40),
		FloorMaterial = Enum.Material.CrackedLava,
		Trim = rgb(255, 110, 20),
	}),
	table.freeze({
		Name = "Gold",
		Price = 50000000,
		Wall = rgb(230, 180, 50),
		WallMaterial = Enum.Material.Metal,
		Floor = rgb(255, 225, 120),
		FloorMaterial = Enum.Material.DiamondPlate,
		Trim = rgb(255, 245, 170),
	}),
	table.freeze({
		Name = "Galaxy",
		ProductKey = "GalaxySkin",
		Wall = rgb(40, 20, 80),
		WallMaterial = Enum.Material.Glass,
		Floor = rgb(25, 15, 55),
		FloorMaterial = Enum.Material.Glass,
		Trim = rgb(190, 110, 255),
		Effect = "Galaxy",
	}),
	table.freeze({
		Name = "Rainbow",
		ProductKey = "RainbowSkin",
		Wall = rgb(250, 250, 250),
		WallMaterial = Enum.Material.SmoothPlastic,
		Floor = rgb(245, 245, 245),
		FloorMaterial = Enum.Material.SmoothPlastic,
		Trim = rgb(255, 80, 80),
		Effect = "Rainbow",
	}),
} :: { BaseSkin })

local skinByName: { [string]: BaseSkin } = {}
for _, skin in FeatureConfig.BaseSkins do
	skinByName[skin.Name] = skin
end
FeatureConfig.SkinByName = table.freeze(skinByName)

--------------------------------------------------------------------------------
-- Income boosts
--------------------------------------------------------------------------------

-- +10% for each friend in the server, up to +50%.
FeatureConfig.FriendBoost = 0.1
FeatureConfig.MaxFriendBoost = 0.5
-- Roblox Premium members earn more and get an extra daily spin.
FeatureConfig.PremiumBoost = 0.1
FeatureConfig.PremiumDailySpins = 1
-- The VIP game pass: more income and another free spin every day.
FeatureConfig.VipBoost = 0.15
FeatureConfig.VipDailySpins = 1
-- Your Roblox group: members earn more and can open the Group Chest once.
-- 0 turns the group perks off. This is the SNATCH THE BRAINROT community:
-- https://www.roblox.com/communities/737518183/SNATCH-THE-BRAINROT
FeatureConfig.GroupId = 737518183
FeatureConfig.GroupBoost = 0.1
FeatureConfig.GroupChest = block("MythicLuckyBlock")

-- The base lock lasts this much longer with the Long Lock game pass.
FeatureConfig.LongLockMultiplier = 2

--------------------------------------------------------------------------------
-- Spin wheel: one free spin a day, more from spin packs, playtime, quests and
-- daily rewards.
--------------------------------------------------------------------------------

FeatureConfig.SpinPrizes = table.freeze({
	table.freeze({ Name = "Cash", Reward = cash(5, 2500), Weight = 30, Color = rgb(60, 200, 90) }),
	table.freeze({ Name = "Lucky Block", Reward = block("LuckyBlock"), Weight = 18, Color = rgb(255, 200, 40) }),
	table.freeze({ Name = "2x Cash 10m", Reward = boost(10 * 60), Weight = 12, Color = rgb(40, 170, 255) }),
	table.freeze({ Name = "Big Cash", Reward = cash(20, 10000), Weight = 15, Color = rgb(30, 150, 70) }),
	table.freeze({ Name = "+1 Spin", Reward = spins(1), Weight = 10, Color = rgb(255, 130, 40) }),
	table.freeze({ Name = "Mythic Block", Reward = block("MythicLuckyBlock"), Weight = 8, Color = rgb(255, 60, 90) }),
	table.freeze({ Name = "Legendary!", Reward = brainrot("ChimpanziniBananini"), Weight = 5, Color = rgb(190, 90, 255) }),
	table.freeze({ Name = "GOD BLOCK", Reward = block("GodLuckyBlock"), Weight = 2, Color = rgb(255, 110, 255) }),
} :: { SpinPrize })

--------------------------------------------------------------------------------
-- Daily login streak (7 days, then it starts over). Miss a day and the
-- streak resets.
--------------------------------------------------------------------------------

FeatureConfig.DailyRewards = table.freeze({
	cash(10, 1000),
	spins(1),
	block("LuckyBlock"),
	cash(30, 5000),
	spins(2),
	block("MythicLuckyBlock"),
	block("GodLuckyBlock"),
} :: { Reward })

--------------------------------------------------------------------------------
-- Playtime gifts: minutes played today (UTC) to unlock each one.
--------------------------------------------------------------------------------

FeatureConfig.PlaytimeRewards = table.freeze({
	table.freeze({ Minutes = 3, Reward = cash(3, 500) }),
	table.freeze({ Minutes = 8, Reward = spins(1) }),
	table.freeze({ Minutes = 15, Reward = block("LuckyBlock") }),
	table.freeze({ Minutes = 25, Reward = cash(15, 5000) }),
	table.freeze({ Minutes = 40, Reward = boost(15 * 60) }),
	table.freeze({ Minutes = 60, Reward = block("MythicLuckyBlock") }),
})

--------------------------------------------------------------------------------
-- Codes (case doesn't matter). Each works once per player.
--------------------------------------------------------------------------------

FeatureConfig.Codes = table.freeze({
	BRAINROT = cash(5, 5000),
	LUCKY = block("LuckyBlock"),
	SPIN = spins(2),
	TUNGTUNG = brainrot("TungTungTungSahur"),
	RELEASE = boost(15 * 60),
} :: { [string]: Reward })

--------------------------------------------------------------------------------
-- Daily quests: three a day from this pool, plus a bonus for finishing all.
--------------------------------------------------------------------------------

FeatureConfig.QuestsPerDay = 3
FeatureConfig.QuestBonus = block("MythicLuckyBlock")
FeatureConfig.Quests = table.freeze({
	table.freeze({ Id = "Buy5", Activity = "Buy", Target = 5, Text = "Buy 5 brainrots", Reward = cash(10, 2000) }),
	table.freeze({ Id = "BuyEpic", Activity = "BuyEpic", Target = 1, Text = "Buy an Epic or better", Reward = spins(1) }),
	table.freeze({ Id = "Steal2", Activity = "Steal", Target = 2, Text = "Steal 2 brainrots", Reward = block("LuckyBlock") }),
	table.freeze({ Id = "Collect15", Activity = "Collect", Target = 15, Text = "Collect cash 15 times", Reward = cash(8, 1500) }),
	table.freeze({ Id = "Open1", Activity = "OpenBlock", Target = 1, Text = "Open a Lucky Block", Reward = cash(15, 3000) }),
	table.freeze({ Id = "Slap5", Activity = "Slap", Target = 5, Text = "Slap 5 players", Reward = cash(5, 1000) }),
	table.freeze({ Id = "Lock3", Activity = "Lock", Target = 3, Text = "Lock your base 3 times", Reward = cash(5, 1000) }),
	table.freeze({ Id = "Fuse1", Activity = "Fuse", Target = 1, Text = "Fuse brainrots once", Reward = block("LuckyBlock") }),
	table.freeze({ Id = "Spin1", Activity = "Spin", Target = 1, Text = "Spin the wheel", Reward = cash(5, 1000) }),
	table.freeze({ Id = "Upgrade1", Activity = "Upgrade", Target = 1, Text = "Upgrade a pedestal", Reward = spins(1) }),
	table.freeze({ Id = "Trade1", Activity = "Trade", Target = 1, Text = "Finish a trade", Reward = block("LuckyBlock") }),
	table.freeze({ Id = "Catch1", Activity = "Catch", Target = 1, Text = "Stop a thief", Reward = cash(10, 2000) }),
} :: { QuestInfo })

local questById: { [string]: QuestInfo } = {}
for _, quest in FeatureConfig.Quests do
	questById[quest.Id] = quest
end
FeatureConfig.QuestById = table.freeze(questById)

--------------------------------------------------------------------------------
-- Badges: create them in the Creator Dashboard and paste their IDs here
-- (0 = not created yet, skipped).
--------------------------------------------------------------------------------

FeatureConfig.Badges = table.freeze({
	Welcome = 0,
	FirstSteal = 0,
	FirstRebirth = 0,
	Rebirth5 = 0,
	LuckyOpener = 0,
	FirstFuse = 0,
	FirstTrade = 0,
	SecretOwner = 0,
	Millionaire = 0,
	IndexMaster = 0,
	WeekStreak = 0,
})

--------------------------------------------------------------------------------
-- Tutorial: finishing it pays this much.
--------------------------------------------------------------------------------

FeatureConfig.TutorialReward = 1000
FeatureConfig.TutorialSteps = table.freeze({
	"Buy a brainrot from the red carpet!",
	"Step on the green pad in front of it to collect Cash!",
	"Press the red button in your base to lock your door!",
})

--------------------------------------------------------------------------------
-- Fusing and trading
--------------------------------------------------------------------------------

-- Three brainrots of one rarity become one of the next rarity up. If all three
-- share a mutation the result keeps it.
FeatureConfig.FuseCount = 3
FeatureConfig.FuseSeconds = 3
-- Most brainrots each side can offer in one trade.
FeatureConfig.MaxTradeItems = 4
FeatureConfig.TradeCountdownSeconds = 5
FeatureConfig.TradeRequestSeconds = 20

--------------------------------------------------------------------------------
-- Admin Abuse: sometimes an event is replaced by this. Players listed in
-- AdminUserIds can start it by chatting "/abuse", and any event with
-- "/event <name>" (see GameplayManager's admin event commands).
--------------------------------------------------------------------------------

FeatureConfig.AdminAbuseChance = 0.1
FeatureConfig.AdminUserIds = table.freeze({} :: { number })

-- Settings players can change (saved).
FeatureConfig.DefaultSettings = table.freeze({ Music = 0.6, Sfx = 1, LowGraphics = false })

-- Cash from a Cash reward for a player earning `income` per second.
function FeatureConfig.cashAmount(reward: Reward, income: number): number
	return math.max(reward.Min or 0, math.floor(income * 60 * (reward.Minutes or 0)))
end

-- Short text for a reward: "$12.5K", "+2 Spins", "Lucky Block", ...
-- Without `income`, Cash rewards say how many minutes of income they are.
function FeatureConfig.describeReward(reward: Reward, income: number?): string
	if reward.Kind == "Cash" then
		if income then
			return NumberFormat.cash(FeatureConfig.cashAmount(reward, income))
		end
		return string.format("%d min of Cash", reward.Minutes or 0)
	elseif reward.Kind == "Spins" then
		local count = reward.Count or 1
		return string.format("+%d Spin%s", count, if count == 1 then "" else "s")
	elseif reward.Kind == "Boost" then
		return string.format("2x Cash %d min", (reward.Seconds or 0) // 60)
	elseif reward.Kind == "Hat" then
		local name = reward.Hat or "Random"
		if name == "Random" then
			return "Random Hat"
		end
		-- "TopHat" -> "Top Hat" (ExtrasConfig has the display names; it needs this module).
		return (string.gsub(name, "(%l)(%u)", "%1 %2"))
	end
	local definition = if reward.Id then BrainrotConfig.ById[reward.Id] else nil
	return if definition then definition.DisplayName else "???"
end

return table.freeze(FeatureConfig)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="271">
        <Properties>
          <string name="Name">GameConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Gameplay tuning shared by GameplayManager and the client HUD.

-- Share: the part of each rarity's spawns that comes from the brainrots with
-- the tag (when that rarity has any), however big the roster grows.
export type TagBoost = { Tag: string, Share: number }

export type GameEvent = {
	Name: string,
	Mutation: string?,
	ChanceMultiplier: number?,
	MutationChance: number?,
	TagBoost: TagBoost?,
	Luck: number?,
	CashRain: boolean?,
	Sky: string?,
	Particles: string?,
	-- Admin Abuse: every conveyor brainrot gets a mutation, prices are
	-- multiplied by PriceMultiplier, and traits are TraitLuck times likelier.
	AllMutated: boolean?,
	PriceMultiplier: number?,
	TraitLuck: number?,
	AdminAbuse: boolean?,
	-- A giant boss brainrot to beat together (RaidManager).
	Boss: boolean?,
	-- The bank vault opens (RaidManager).
	Heist: boolean?,
}

local EVENTS: { GameEvent } = {
	table.freeze({ Name = "Gold Rush", Mutation = "Gold", ChanceMultiplier = 5, Sky = "Gold", Particles = "Sparkles" }),
	table.freeze({ Name = "Diamond Storm", Mutation = "Diamond", ChanceMultiplier = 6, Sky = "Diamond", Particles = "Crystals" }),
	table.freeze({ Name = "Rainbow Party", Mutation = "Rainbow", ChanceMultiplier = 10, Sky = "Rainbow", Particles = "Confetti" }),
	table.freeze({ Name = "Blood Moon", Mutation = "Bloodrot", MutationChance = 0.12, Sky = "Blood", Particles = "Embers" }),
	table.freeze({ Name = "Galaxy Night", Mutation = "Galaxy", MutationChance = 0.08, Sky = "Galaxy", Particles = "Stars" }),
	table.freeze({ Name = "Lava Rain", Mutation = "Lava", MutationChance = 0.1, Sky = "Lava", Particles = "Meteors" }),
	table.freeze({ Name = "Frost Storm", Mutation = "Frozen", MutationChance = 0.14, Sky = "Frost", Particles = "Snow" }),
	table.freeze({
		Name = "Taco Tuesday",
		TagBoost = table.freeze({ Tag = "Taco", Share = 0.5 }),
		Mutation = "Taco",
		MutationChance = 0.1,
		Sky = "Taco",
		Particles = "Tacos",
	}),
	table.freeze({ Name = "Lucky Hour", Luck = 3, Mutation = "Lucky", MutationChance = 0.1, Sky = "Lucky", Particles = "Clovers" }),
	table.freeze({ Name = "Cash Rain", CashRain = true, Mutation = "Cash", MutationChance = 0.1, Sky = "Cash", Particles = "Cash" }),
	table.freeze({ Name = "Boss Raid", Boss = true, Mutation = "Boss", MutationChance = 0.05, Sky = "Boss", Particles = "Embers" }),
	table.freeze({ Name = "Bank Heist", Heist = true, Mutation = "Heist", MutationChance = 0.08, Sky = "Heist", Particles = "Cash" }),
}

-- Replaces a normal event now and then (FeatureConfig.AdminAbuseChance), or
-- starts when an admin chats "/abuse" (or "/event admin").
local ADMIN_ABUSE: GameEvent = table.freeze({
	Name = "ADMIN ABUSE",
	Luck = 10,
	CashRain = true,
	AllMutated = true,
	PriceMultiplier = 0.5,
	TraitLuck = 5,
	AdminAbuse = true,
	Sky = "Admin",
	Particles = "Confetti",
})

local GameConfig = {
	-- Conveyor
	ConveyorSpawnIntervalSeconds = 2.5,
	ConveyorSpeedStudsPerSecond = 10,
	MaxConveyorBrainrots = 24,
	-- A bought brainrot walks to its buyer's base this fast (studs per second).
	-- Until it walks through the door, other players can buy it off its buyer.
	BrainrotWalkSpeed = 8,
	-- Long walks speed up so none takes longer than this.
	MaxWalkSeconds = 25,

	-- Interaction
	PromptDistance = 10,
	-- Extra studs the server allows on top of PromptDistance for lag.
	InteractionTolerance = 6,
	StealHoldSeconds = 1.2,

	-- Stealing
	DefaultWalkSpeed = 16,
	CarryWalkSpeed = 11,
	CarryTimeoutSeconds = 90,
	-- Extra studs per check a thief may move before the steal counts as a teleport.
	CarrySpeedToleranceStuds = 8,
	CatchDistance = 6,

	-- Guaranteed spawns: when a timer runs out, the next conveyor brainrot is
	-- of that rarity. Listed from rarest; a natural spawn also resets its timer.
	GuaranteedRarities = table.freeze({
		table.freeze({ Rarity = "Secret", IntervalSeconds = 45 * 60 }),
		table.freeze({ Rarity = "Brainrot God", IntervalSeconds = 20 * 60 }),
		table.freeze({ Rarity = "Mythic", IntervalSeconds = 10 * 60 }),
		table.freeze({ Rarity = "Legendary", IntervalSeconds = 4 * 60 }),
	}),

	-- Bases: 8 pedestals on each of 4 floors. A floor opens at this many rebirths.
	SlotsPerFloor = 8,
	FloorUnlockRebirths = table.freeze({ 0, 1, 2, 3 }),

	-- Base lock
	LockDurationSeconds = 60,

	-- Collect pads and offline cash: brainrots fill the pad in front of them
	-- with Cash; stepping on the pad collects it. While you're away they keep
	-- earning this fraction of their income, for up to OfflineMaxHours.
	OfflineIncomeFraction = 1,
	OfflineMaxHours = 8,
	OfflineMinSeconds = 60,

	-- Events: every few minutes one runs for a few minutes. Each can make a
	-- mutation more common (ChanceMultiplier) or give an event-only mutation a
	-- chance (MutationChance), boost brainrots with a tag (TagBoost), make rare
	-- brainrots more common (Luck), or rain Cash (CashRain). Sky and Particles
	-- choose what players see.
	EventMinGapSeconds = 5 * 60,
	EventMaxGapSeconds = 8 * 60,
	EventDurationSeconds = 3 * 60,
	Events = table.freeze(EVENTS),
	AdminAbuseEvent = ADMIN_ABUSE,
	-- Cash Rain: coins land around the map; each is worth this many seconds of
	-- the collector's income (at least CashRainMinCoin).
	CashRainCoinsPerWave = 12,
	CashRainWaveSeconds = 10,
	CashRainCoinIncomeSeconds = 20,
	CashRainMinCoin = 150,

	-- Day and night, and weather that changes every few minutes.
	DayLengthSeconds = 10 * 60,
	WeatherMinSeconds = 3 * 60,
	WeatherMaxSeconds = 5 * 60,
	Weather = table.freeze({
		table.freeze({ Name = "Clear", Weight = 5 }),
		table.freeze({ Name = "Rain", Weight = 2 }),
		table.freeze({ Name = "Snow", Weight = 1 }),
		table.freeze({ Name = "Thunderstorm", Weight = 1 }),
		table.freeze({ Name = "Fog", Weight = 1 }),
	}),
	-- Mutations the weather brings: Storm brainrots in thunderstorms, Frozen
	-- ones while it snows.
	WeatherMutations = table.freeze({
		Storm = table.freeze({ Weather = "Thunderstorm", Chance = 0.06 }),
		Frozen = table.freeze({ Weather = "Snow", Chance = 0.05 }),
	}) :: { [string]: { Weather: string, Chance: number } },
	-- During ADMIN ABUSE, this share of the conveyor gets the Admin mutation.
	AdminMutationChance = 0.03,

	-- Economy
	SellRefundFraction = 0.5,
	StarterBrainrotId = "NoobiniPizzanini",
	RebirthBaseCost = 100000,
	RebirthCostGrowth = 2.5,
	RebirthIncomeBonus = 0.5,
}

function GameConfig.getRebirthCost(rebirths: number): number
	return math.floor(GameConfig.RebirthBaseCost * GameConfig.RebirthCostGrowth ^ rebirths)
end

function GameConfig.getRebirthIncomeMultiplier(rebirths: number): number
	return 1 + GameConfig.RebirthIncomeBonus * rebirths
end

-- How many floors of a base are open at this many rebirths.
function GameConfig.getUnlockedFloors(rebirths: number): number
	local floors = 0
	for floor, needed in GameConfig.FloorUnlockRebirths do
		if rebirths >= needed then
			floors = floor
		end
	end
	return math.max(floors, 1)
end

return table.freeze(GameConfig)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="272">
        <Properties>
          <string name="Name">GearConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Gear sold for Cash at the Gear Shop stall. Owned gear is saved and given back
-- every time you spawn. GearManager on the server makes each tool work.
-- Troll items are bought with Robux in the Shop (see MonetizationConfig) and
-- come with a few charges each.

export type Gear = {
	Id: string,
	DisplayName: string,
	-- 0 = everyone gets it for free.
	Price: number,
	Description: string,
	Color: Color3,
	Order: number,
}

export type TrollItem = {
	Id: string,
	DisplayName: string,
	Description: string,
	Color: Color3,
}

local Gear: { Gear } = {
	{
		Id = "Slap",
		DisplayName = "Slap",
		Price = 0,
		Description = "A giant slap glove on a stick. A slapped thief drops the brainrot!",
		Color = Color3.fromRGB(150, 70, 255),
		Order = 1,
	},
	{
		Id = "SpeedCoil",
		DisplayName = "Speed Coil",
		Price = 7500,
		Description = "Run much faster while you hold it (not while carrying a brainrot).",
		Color = Color3.fromRGB(60, 200, 255),
		Order = 2,
	},
	{
		Id = "GravityCoil",
		DisplayName = "Gravity Coil",
		Price = 20000,
		Description = "Jump three times higher while you hold it.",
		Color = Color3.fromRGB(170, 90, 255),
		Order = 3,
	},
	{
		Id = "InvisibilityCloak",
		DisplayName = "Invisibility Cloak",
		Price = 100000,
		Description = "Click to turn invisible for 8 seconds. Grabbing a brainrot reveals you.",
		Color = Color3.fromRGB(120, 130, 150),
		Order = 4,
	},
}

local TrollItems: { TrollItem } = {
	{
		Id = "FreezeRay",
		DisplayName = "Freeze Ray",
		Description = "Freeze the player in front of you solid. Frozen thieves drop their brainrot!",
		Color = Color3.fromRGB(120, 220, 255),
	},
	{
		Id = "SpikeTrap",
		DisplayName = "Spike Trap",
		Description = "Put down a spike trap. Whoever steps on it gets stuck and drops their brainrot.",
		Color = Color3.fromRGB(170, 175, 185),
	},
	{
		Id = "LandMine",
		DisplayName = "Land Mine",
		Description = "Hide a land mine. It launches whoever steps on it sky high!",
		Color = Color3.fromRGB(220, 50, 40),
	},
	{
		Id = "BoogieBomb",
		DisplayName = "Boogie Bomb",
		Description = "Everyone around you can't stop dancing for a few seconds!",
		Color = Color3.fromRGB(255, 90, 200),
	},
}

local TrollItemById: { [string]: TrollItem } = {}
for _, item in TrollItems do
	TrollItemById[item.Id] = table.freeze(item)
end

local ById: { [string]: Gear } = {}
for _, gear in Gear do
	ById[gear.Id] = table.freeze(gear)
end

return table.freeze({
	Gear = table.freeze(Gear),
	ById = table.freeze(ById),
	SlapCooldownSeconds = 0.8,
	SlapRange = 8,
	SlapKnockback = 70,
	SpeedCoilBonus = 12,
	GravityCoilJumpHeight = 22,
	DefaultJumpHeight = 7.2,
	CloakSeconds = 8,
	CloakCooldownSeconds = 30,
	-- Buying needs you to be this close to the Gear Shop counter.
	ShopDistance = 30,

	TrollItems = table.freeze(TrollItems),
	TrollItemById = table.freeze(TrollItemById),
	ItemCooldownSeconds = 1.5,
	FreezeRange = 45,
	FreezeSeconds = 4,
	SpikeStunSeconds = 3,
	MineLaunchSpeed = 110,
	MineStunSeconds = 2,
	BoogieRadius = 22,
	BoogieSeconds = 4,
	-- Placed traps and mines: how long they stay, how many each player can
	-- have out and how close someone has to step.
	TrapLifetimeSeconds = 120,
	MaxTrapsPerPlayer = 3,
	TrapTriggerRadius = 3.5,
})
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="273">
        <Properties>
          <string name="Name">HatAnchors</string>
          <string name="Source"><![CDATA[--!strict
-- Generated by tools/build_hat_anchors.py. Do not edit.
-- Where each brainrot's hat goes: on its Body or Head piece, at X/Y/Z
-- fractions of that piece's size from its centre (Y is the hat's base),
-- Width a fraction of the brainrot's height.

export type Anchor = { Piece: string, X: number, Y: number, Z: number, Width: number }

local HatAnchors: { [string]: Anchor } = {
	AdminoSupremo = { Piece = "Head", X = 0.0, Y = 0.357, Z = 0.042, Width = 0.22 },
	AeroplaninoPaninino = { Piece = "Body", X = 0.0, Y = 0.125, Z = 0.008, Width = 0.22 },
	BaconiniCroccantini = { Piece = "Head", X = 0.0, Y = 0.409, Z = 0.0, Width = 0.257 },
	BaconinoCapellino = { Piece = "Body", X = 0.0, Y = 0.469, Z = 0.0, Width = 0.22 },
	BallerinaCappuccina = { Piece = "Body", X = 0.004, Y = 0.5, Z = 0.008, Width = 0.228 },
	BananitaDolphinita = { Piece = "Body", X = -0.022, Y = 0.5, Z = 0.192, Width = 0.257 },
	BanhammeroGiustiziere = { Piece = "Body", X = 0.0, Y = 0.463, Z = 0.0, Width = 0.45 },
	BenjiniSkatini = { Piece = "Head", X = 0.039, Y = 0.455, Z = -0.011, Width = 0.342 },
	BloxyColino = { Piece = "Body", X = 0.0, Y = 0.257, Z = 0.0, Width = 0.352 },
	BlueberriniOctopusini = { Piece = "Body", X = 0.0, Y = 0.426, Z = -0.002, Width = 0.426 },
	BombardiroCrocodilo = { Piece = "Body", X = -0.016, Y = 0.433, Z = -0.188, Width = 0.417 },
	BombombiniGusini = { Piece = "Head", X = 0.0, Y = 0.409, Z = -0.167, Width = 0.318 },
	BonecaAmbalabu = { Piece = "Body", X = -0.006, Y = 0.5, Z = -0.06, Width = 0.314 },
	BrrBrrPatapim = { Piece = "Body", X = 0.021, Y = 0.471, Z = 0.016, Width = 0.373 },
	BuilderinoMattoncino = { Piece = "Head", X = 0.0, Y = 0.5, Z = 0.033, Width = 0.263 },
