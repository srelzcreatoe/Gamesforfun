local shopFrame, shopBody = modal("Shop", "SHOP", Vector2.new(640, 460))
create("UIGridLayout", {
	CellSize = UDim2.new(0.5, -8, 0.5, -8),
	CellPadding = UDim2.fromOffset(12, 12),
	SortOrder = Enum.SortOrder.LayoutOrder,
