      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">BrainrotConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Every brainrot that can appear on the conveyor, and the rarity tiers.
-- Brainrots are built from parts. To use a custom model instead, put a Model
-- named after the brainrot's Id in ReplicatedStorage.BrainrotModels; it is
-- cloned and placed with its pivot at the brainrot's feet.

export type BodyShape = "Ball" | "Block"

export type Rarity = {
	Name: string,
	Color: Color3,
	-- Relative spawn chance on the conveyor.
	Weight: number,
	Glow: boolean,
}

export type Brainrot = {
	Id: string,
	DisplayName: string,
	Rarity: string,
	Price: number,
	IncomePerSecond: number,
	BodyShape: BodyShape,
	BodyColor: Color3,
	AccentColor: Color3,
	Scale: number,
}

local Rarities: { Rarity } = {
	{ Name = "Common", Color = Color3.fromRGB(210, 210, 210), Weight = 60, Glow = false },
	{ Name = "Rare", Color = Color3.fromRGB(70, 150, 255), Weight = 26, Glow = false },
	{ Name = "Epic", Color = Color3.fromRGB(175, 90, 255), Weight = 10, Glow = false },
	{ Name = "Legendary", Color = Color3.fromRGB(255, 190, 40), Weight = 3.4, Glow = true },
	{ Name = "Mythic", Color = Color3.fromRGB(255, 60, 90), Weight = 0.6, Glow = true },
}

local function brainrot(
	id: string,
	displayName: string,
	rarity: string,
	price: number,
	incomePerSecond: number,
	bodyShape: BodyShape,
	bodyColor: Color3,
	accentColor: Color3,
	scale: number
): Brainrot
	return table.freeze({
		Id = id,
		DisplayName = displayName,
		Rarity = rarity,
		Price = price,
		IncomePerSecond = incomePerSecond,
		BodyShape = bodyShape,
		BodyColor = bodyColor,
		AccentColor = accentColor,
		Scale = scale,
	})
end

local rgb = Color3.fromRGB

local Brainrots: { Brainrot } = {
	brainrot("NoobiniPizzanini", "Noobini Pizzanini", "Common", 25, 1, "Ball", rgb(255, 200, 120), rgb(220, 60, 40), 0.9),
	brainrot("LiriliLarila", "Lirili Larila", "Common", 60, 2, "Block", rgb(120, 180, 90), rgb(240, 240, 240), 1),
	brainrot("TimCheese", "Tim Cheese", "Common", 120, 3, "Block", rgb(255, 215, 60), rgb(200, 150, 40), 0.9),
	brainrot("Fluriflura", "Fluriflura", "Common", 200, 4, "Ball", rgb(255, 150, 200), rgb(255, 255, 255), 0.9),
	brainrot("TrippiTroppi", "Trippi Troppi", "Rare", 500, 8, "Ball", rgb(90, 160, 255), rgb(255, 180, 120), 1),
	brainrot("TungTungTungSahur", "Tung Tung Tung Sahur", "Rare", 900, 12, "Block", rgb(170, 120, 70), rgb(90, 60, 30), 1.1),
	brainrot("BonecaAmbalabu", "Boneca Ambalabu", "Rare", 1400, 16, "Ball", rgb(140, 200, 120), rgb(60, 60, 60), 1),
	brainrot("BrrBrrPatapim", "Brr Brr Patapim", "Epic", 3500, 38, "Block", rgb(110, 170, 80), rgb(150, 100, 60), 1.15),
	brainrot("CappuccinoAssassino", "Cappuccino Assassino", "Epic", 6000, 55, "Ball", rgb(120, 80, 50), rgb(40, 40, 40), 1.1),
	brainrot("BananitaDolphinita", "Bananita Dolphinita", "Epic", 8000, 70, "Ball", rgb(255, 230, 80), rgb(90, 170, 255), 1.1),
	brainrot("ChimpanziniBananini", "Chimpanzini Bananini", "Legendary", 25000, 180, "Block", rgb(255, 220, 60), rgb(120, 80, 40), 1.2),
	brainrot("BallerinaCappuccina", "Ballerina Cappuccina", "Legendary", 40000, 260, "Ball", rgb(255, 180, 210), rgb(120, 80, 50), 1.2),
	brainrot("BombardiroCrocodilo", "Bombardiro Crocodilo", "Mythic", 120000, 800, "Block", rgb(80, 140, 80), rgb(150, 150, 160), 1.35),
	brainrot("TralaleroTralala", "Tralalero Tralala", "Mythic", 250000, 1500, "Ball", rgb(80, 170, 255), rgb(255, 255, 255), 1.4),
}

local ById: { [string]: Brainrot } = {}
local ByRarity: { [string]: { Brainrot } } = {}
local RarityByName: { [string]: Rarity } = {}

for _, rarity in Rarities do
	RarityByName[rarity.Name] = rarity
	ByRarity[rarity.Name] = {}
end
for _, definition in Brainrots do
	ById[definition.Id] = definition
	table.insert(ByRarity[definition.Rarity], definition)
end

return table.freeze({
	Rarities = table.freeze(Rarities),
	Brainrots = table.freeze(Brainrots),
	ById = table.freeze(ById),
	ByRarity = table.freeze(ByRarity),
	RarityByName = table.freeze(RarityByName),
})
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">GameConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Gameplay tuning shared by GameplayManager and the client HUD.

local GameConfig = {
	-- Conveyor
	ConveyorSpawnIntervalSeconds = 2.5,
	ConveyorSpeedStudsPerSecond = 10,
	MaxConveyorBrainrots = 24,
	WalkToBaseSeconds = 1.5,

	-- Interaction
	PromptDistance = 10,
	-- Extra studs the server allows on top of PromptDistance for lag.
	InteractionTolerance = 6,
	StealHoldSeconds = 1.2,

	-- Stealing
	DefaultWalkSpeed = 16,
	CarryWalkSpeed = 11,
	CarryTimeoutSeconds = 90,
	-- Extra studs per check a thief may move before the steal counts as a teleport.
	CarrySpeedToleranceStuds = 8,
	CatchDistance = 6,

	-- Base lock
	LockDurationSeconds = 60,

	-- Economy
	SellRefundFraction = 0.5,
	StarterBrainrotId = "NoobiniPizzanini",
	RebirthBaseCost = 100000,
	RebirthCostGrowth = 2.5,
	RebirthIncomeBonus = 0.5,
}

function GameConfig.getRebirthCost(rebirths: number): number
	return math.floor(GameConfig.RebirthBaseCost * GameConfig.RebirthCostGrowth ^ rebirths)
end

function GameConfig.getRebirthIncomeMultiplier(rebirths: number): number
	return 1 + GameConfig.RebirthIncomeBonus * rebirths
end

return table.freeze(GameConfig)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">MonetizationConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Robux products and game passes. Read by DataAndMonetizationManager on the
-- server and by the shop UI on the client, so the IDs only live here.
-- Replace every ID with the real ones from the Creator Dashboard.

local NumberFormat = require(script.Parent:WaitForChild("NumberFormat"))

export type ShopProduct = {
	Key: string,
	ProductId: number,
	DisplayName: string,
	Description: string,
	-- Upload the matching image from ProductIcons/ and paste its image ID here
	-- to show it in the shop. 0 uses the product's own icon once the product
	-- exists, or a coloured tile with IconText until then.
	IconAssetId: number,
	IconText: string,
	IconColor: Color3,
}

local ProductIds = table.freeze({
	SmallCashBundle = 100001,
	MediumCashBundle = 100002,
	EMPLaserOverrider = 100003,
	ServerRarityBoost = 100004,
})

local GamePasses: { [string]: number } = table.freeze({
	VIP = 200001,
	DoubleCash = 200002,
})

local SMALL_CASH_BUNDLE_AMOUNT = 5000
local MEDIUM_CASH_BUNDLE_AMOUNT = 25000
local LASER_BYPASS_DURATION_SECONDS = 30
local SERVER_RARITY_BOOST_DURATION_SECONDS = 15 * 60
local SERVER_RARITY_BOOST_MULTIPLIER = 2

local ShopProducts: { ShopProduct } = {
	{
		Key = "SmallCashBundle",
		ProductId = ProductIds.SmallCashBundle,
		DisplayName = "Small Cash Bundle",
		Description = string.format("+%s Cash instantly", NumberFormat.commas(SMALL_CASH_BUNDLE_AMOUNT)),
		IconAssetId = 0,
		IconText = "$",
		IconColor = Color3.fromRGB(46, 204, 113),
	},
	{
		Key = "MediumCashBundle",
		ProductId = ProductIds.MediumCashBundle,
		DisplayName = "Medium Cash Bundle",
		Description = string.format("+%s Cash instantly", NumberFormat.commas(MEDIUM_CASH_BUNDLE_AMOUNT)),
		IconAssetId = 0,
		IconText = "$$$",
		IconColor = Color3.fromRGB(26, 160, 220),
	},
	{
		Key = "EMPLaserOverrider",
		ProductId = ProductIds.EMPLaserOverrider,
		DisplayName = "EMP Laser Overrider",
		Description = string.format("Walk through every laser door for %d seconds", LASER_BYPASS_DURATION_SECONDS),
		IconAssetId = 0,
		IconText = "EMP",
		IconColor = Color3.fromRGB(60, 90, 220),
	},
	{
		Key = "ServerRarityBoost",
		ProductId = ProductIds.ServerRarityBoost,
		DisplayName = "Server Rarity Boost",
		Description = string.format(
			"x%d rare brainrot chance for the whole server for %d minutes",
			SERVER_RARITY_BOOST_MULTIPLIER,
			SERVER_RARITY_BOOST_DURATION_SECONDS // 60
		),
		IconAssetId = 0,
		IconText = "x2",
		IconColor = Color3.fromRGB(200, 60, 200),
	},
}

return table.freeze({
	ProductIds = ProductIds,
	GamePasses = GamePasses,
	SmallCashBundleAmount = SMALL_CASH_BUNDLE_AMOUNT,
	MediumCashBundleAmount = MEDIUM_CASH_BUNDLE_AMOUNT,
	LaserBypassDurationSeconds = LASER_BYPASS_DURATION_SECONDS,
	ServerRarityBoostDurationSeconds = SERVER_RARITY_BOOST_DURATION_SECONDS,
	ServerRarityBoostMultiplier = SERVER_RARITY_BOOST_MULTIPLIER,
	DoubleCashIncomeMultiplier = 2,
	ShopProducts = table.freeze(ShopProducts),
})
]]></string>
        </Properties>
