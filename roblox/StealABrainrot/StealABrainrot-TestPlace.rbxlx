	Palette = { 0xe2d782, 0xf4db00, 0xecd200, 0xe5c900, 0xe3c500, 0xd3c060, 0xe2c300, 0xe0c200, 0xe1c100, 0xdfc100, 0xdebd00, 0xd9ba00, 0xcfb547, 0xd9b600, 0xd6b600, 0xd6b300, 0xd4b400, 0xd3b200, 0xd3b100, 0xd3b000, 0xd3ad00, 0xd0ad00, 0xc4a430, 0xd2a900, 0xcea900, 0xcda200, 0xca9c00, 0xc69500, 0xc38e00, 0xbc8401, 0xb48009, 0xa96e05, 0x763015, 0x6c240e, 0x5a1f0f, 0x53190a, 0x421206, 0x2e0b04, 0x290803, 0x1f0703 },
