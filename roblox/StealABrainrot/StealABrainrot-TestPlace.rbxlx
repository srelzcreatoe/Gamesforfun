      <Item class="ModuleScript" referent="277">
        <Properties>
          <string name="Name">NumberFormat</string>
          <string name="Source"><![CDATA[--!strict
-- Number and time formatting shared by server billboards and the client HUD.

local NumberFormat = {}

local SUFFIXES = { "K", "M", "B", "T", "Qa", "Qi" }

function NumberFormat.commas(value: number): string
	local whole = tostring(math.floor(math.abs(value)))
	local formatted = whole:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	return if value < 0 then "-" .. formatted else formatted
end

function NumberFormat.abbreviate(value: number): string
	local magnitude = math.abs(value)
	if magnitude < 1000 then
		return tostring(math.floor(value))
	end
	local index = 0
	while magnitude >= 1000 and index < #SUFFIXES do
		magnitude /= 1000
		index += 1
	end
	local text = if magnitude < 10 then string.format("%.2f", magnitude) else string.format("%.1f", magnitude)
	text = text:gsub("%.?0+$", "")
	return (if value < 0 then "-" else "") .. text .. SUFFIXES[index]
end

function NumberFormat.cash(value: number): string
	return "$" .. NumberFormat.abbreviate(value)
end

function NumberFormat.duration(seconds: number): string
	local total = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", total // 60, total % 60)
end

return table.freeze(NumberFormat)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="278">
        <Properties>
          <string name="Name">Sounds</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Sounds (client only)

	Plays the background music playlist (in order, over and over) and the
	sound effects listed in AudioConfig. Sound effects that fail to load on
	this device fall back to a built-in Roblox sound; a music track that
	doesn't load, or stops partway, is skipped.
]]

local ContentProvider = game:GetService("ContentProvider")
local Debris = game:GetService("Debris")
local SoundService = game:GetService("SoundService")

local AudioConfig = require(script.Parent:WaitForChild("AudioConfig"))

-- A track that hasn't loaded after this long is skipped.
local TRACK_LOAD_TIMEOUT_SECONDS = 12
-- A playing track that hasn't moved for this long is moved on from.
local TRACK_STALL_SECONDS = 5
-- If no track will load at all, try again this often.
local TRACK_RETRY_SECONDS = 30

local Sounds = {}

local folder = Instance.new("Folder")
folder.Name = "GameSounds"
folder.Parent = SoundService

local effectsGroup = Instance.new("SoundGroup")
effectsGroup.Name = "Effects"
effectsGroup.Volume = 1
effectsGroup.Parent = folder

local musicGroup = Instance.new("SoundGroup")
musicGroup.Name = "Music"
musicGroup.Volume = 1
musicGroup.Parent = folder

local templates: { [string]: Sound } = {}
for name, info in AudioConfig.Sounds do
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = "rbxassetid://" .. tostring(info.Id)
	sound.Volume = info.Volume
	sound.SoundGroup = effectsGroup
	sound.Parent = folder
	templates[name] = sound
end

-- Swap sounds that can't be downloaded for the built-in fallback.
task.spawn(function()
	local list: { Instance } = {}
	for _, sound in templates do
		table.insert(list, sound)
	end
	pcall(function()
		ContentProvider:PreloadAsync(list, function(contentId: string, status: Enum.AssetFetchStatus)
			if status == Enum.AssetFetchStatus.Failure then
				for _, sound in templates do
					if sound.SoundId == contentId then
						sound.SoundId = AudioConfig.FallbackSound
					end
				end
			end
		end)
	end)
end)

-- Plays a sound effect from AudioConfig.Sounds by name.
function Sounds.play(name: string)
	local template: Sound? = templates[name]
	if template == nil then
		return
	end
	local sound = template:Clone()
	sound.Parent = folder
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	Debris:AddItem(sound, 10)
	sound:Play()
end

--------------------------------------------------------------------------------
-- Music
--------------------------------------------------------------------------------

-- The playlist plays in order, one track after another, and starts over from
-- the first when it runs out. A watchdog makes sure it never just stops: a
-- track that doesn't load, or stops moving (even without Ended firing), is
-- moved on from, and if nothing will load it keeps trying.

local music = Instance.new("Sound")
music.Name = "BackgroundMusic"
music.Volume = AudioConfig.MusicVolume
music.SoundGroup = musicGroup
music.Parent = folder

local musicEnabled = true
-- The Settings slider's music volume (set further down).
local savedMusicVolume = 1
local function musicVolumeOr1(): number
	return if savedMusicVolume > 0 then savedMusicVolume else 1
end
local musicStarted = false
local trackIndex = 0
-- Tracks in a row that didn't load; after a whole playlist of them it waits.
local failuresInARow = 0
local trackStartedAt = 0
local lastPosition = -1
local lastMovedAt = 0

local function playTrack(index: number)
	local tracks = AudioConfig.Music
	if #tracks == 0 then
		return
	end
	trackIndex = (index - 1) % #tracks + 1
	music.SoundId = "rbxassetid://" .. tostring(tracks[trackIndex])
	music.TimePosition = 0
	music:Play()
	trackStartedAt = os.clock()
	lastPosition = -1
	lastMovedAt = trackStartedAt
end

local function playNextTrack()
	playTrack(trackIndex + 1)
end

music.Ended:Connect(function()
	failuresInARow = 0
	if musicStarted and musicEnabled then
		playNextTrack()
	end
end)

task.spawn(function()
	while true do
		task.wait(1)
		local now = os.clock()
		if not (musicStarted and musicEnabled) then
			-- Paused on purpose: that isn't stuck.
			lastMovedAt = now
		elseif not music.IsLoaded then
			-- After a whole playlist that wouldn't load, wait longer between tries.
			local limit = if failuresInARow >= #AudioConfig.Music then TRACK_RETRY_SECONDS else TRACK_LOAD_TIMEOUT_SECONDS
			if now - trackStartedAt >= limit then
				failuresInARow += 1
				playNextTrack()
			end
		else
			local position = music.TimePosition
			if position ~= lastPosition then
				lastPosition = position
				lastMovedAt = now
				if position > 0 then
					failuresInARow = 0
				end
			elseif now - lastMovedAt >= TRACK_STALL_SECONDS then
				-- It stopped or got stuck without finishing: carry on.
				playNextTrack()
			end
		end
	end
end)

function Sounds.startMusic()
	if musicStarted then
		return
	end
	musicStarted = true
	if musicEnabled then
		playTrack(1)
	end
end

function Sounds.isMusicEnabled(): boolean
	return musicEnabled
end

function Sounds.setMusicEnabled(enabled: boolean)
	musicEnabled = enabled
	musicGroup.Volume = if enabled then musicVolumeOr1() else 0
	if enabled and musicStarted and not music.IsPlaying then
		if music.SoundId == "" then
			playTrack(1)
		else
			music:Resume()
		end
	elseif not enabled then
		music:Pause()
	end
end

-- Volume sliders (Settings), 0..1. Music at 0 pauses the track.
function Sounds.setMusicVolume(volume: number)
	savedMusicVolume = math.clamp(volume, 0, 1)
	Sounds.setMusicEnabled(savedMusicVolume > 0)
end

function Sounds.setEffectsVolume(volume: number)
	effectsGroup.Volume = math.clamp(volume, 0, 1)
end

-- A sound effect that repeats until the returned function is called.
function Sounds.loop(name: string, intervalSeconds: number): () -> ()
	local running = true
	task.spawn(function()
		while running do
			Sounds.play(name)
			task.wait(intervalSeconds)
		end
	end)
	return function()
		running = false
	end
end

return table.freeze(Sounds)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="279">
        <Properties>
          <string name="Name">TemplateModels</string>
          <string name="Source"><![CDATA[--!strict
--[[
	TemplateModels

	The imported brainrot models: GameplayManager turns each import into a
	template in ReplicatedStorage.BrainrotModels (standing on the origin, facing
	-Z, with a Height attribute). build copies one onto a brainrot's Root at the
	brainrot's height, every part held by a Weld named "Pose" whose C0
	BrainrotVisuals animates. Used for brainrots on the map and guards (on the
	server) and for pets (on each client).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TemplateModels = {}

-- The box around some parts, in world space.
function TemplateModels.bounds(parts: { BasePart }): (Vector3, Vector3)
	local low = Vector3.new(math.huge, math.huge, math.huge)
	local high = -low
	for _, part in parts do
		local half = part.Size / 2
		for _, corner in
			{
				Vector3.new(-1, -1, -1),
				Vector3.new(-1, -1, 1),
				Vector3.new(-1, 1, -1),
				Vector3.new(-1, 1, 1),
				Vector3.new(1, -1, -1),
				Vector3.new(1, -1, 1),
				Vector3.new(1, 1, -1),
				Vector3.new(1, 1, 1),
			}
		do
			local point = part.CFrame:PointToWorldSpace(half * corner)
			low = low:Min(point)
			high = high:Max(point)
		end
	end
	return low, high
end

-- A brainrot's imported template, if it has one.
function TemplateModels.get(brainrotId: string): Model?
	local folder = ReplicatedStorage:FindFirstChild("BrainrotModels")
	local template = if folder then folder:FindFirstChild(brainrotId) else nil
	if template and template:IsA("Model") and #template:GetChildren() > 0 then
		return template
	end
	return nil
end

-- Copies a template at `targetHeight` onto `root` (the brainrot's feet) and
-- parents it to `model`. Moving pieces get their joint (Hip) and phase:
-- block-built ones from their Pivot attribute, legs of the others at the top
-- middle of the leg. Returns the height.
function TemplateModels.build(model: Model, root: BasePart, template: Model, targetHeight: number): number
	local clone = template:Clone()
	local height = tonumber(template:GetAttribute("Height")) or 1
	local scale = targetHeight / math.max(height, 0.01)
	for _, part in clone:GetDescendants() do
		if part:IsA("BasePart") then
			local rest = part.CFrame
			local offset = CFrame.new(rest.Position * scale) * rest.Rotation
			part.Size *= scale
			part.Anchored = false
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.Massless = true
			part.CFrame = root.CFrame * offset
			local weld = Instance.new("Weld")
			weld.Name = "Pose"
			weld.Part0 = root
			weld.Part1 = part
			weld.C0 = offset
			weld.Parent = part
			local pivot = part:GetAttribute("Pivot")
			if typeof(pivot) == "Vector3" then
				-- A block-built brainrot's moving piece turns about its joint,
				-- in the root's space.
				part:SetAttribute("Hip", pivot * scale)
				part:SetAttribute("LegPhase", if part:GetAttribute("PiecePhase") == 1 then 1 else 0)
			elseif string.sub(part.Name, 1, 3) == "Leg" then
				-- The hip: the top middle of the leg, in the root's space.
				local _, top = TemplateModels.bounds({ part })
				part:SetAttribute("Hip", Vector3.new(offset.X, top.Y - root.Position.Y, offset.Z))
				part:SetAttribute("LegPhase", if part.Name == "Leg2" then 1 else 0)
			end
		end
	end
	clone.Parent = model
	return targetHeight
end

return table.freeze(TemplateModels)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="280">
        <Properties>
          <string name="Name">UIKit</string>
          <string name="Source"><![CDATA[--!strict
--[[
	UIKit (client only)

	The building blocks of every menu, so they all look the same: chunky
	glossy buttons with a thick black outline that bounce when you touch them,
	outlined FredokaOne text, rounded panels, the big square side buttons with
	a wiggling Higgsfield icon, and pop-up windows (only one open at a time,
	whichever script made it).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local AssetLoader = require(script.Parent:WaitForChild("AssetLoader"))
local BrainrotConfig = require(script.Parent:WaitForChild("BrainrotConfig"))
local NumberFormat = require(script.Parent:WaitForChild("NumberFormat"))
local Sounds = require(script.Parent:WaitForChild("Sounds"))

local UIKit = {}

UIKit.Font = Enum.Font.FredokaOne
UIKit.Colors = table.freeze({
	Panel = Color3.fromRGB(30, 32, 52),
	PanelLight = Color3.fromRGB(48, 52, 82),
	PanelDark = Color3.fromRGB(22, 23, 38),
	Text = Color3.new(1, 1, 1),
	Muted = Color3.fromRGB(190, 196, 225),
	Cash = Color3.fromRGB(80, 255, 110),
	Income = Color3.fromRGB(255, 230, 70),
	Buy = Color3.fromRGB(46, 204, 113),
	Close = Color3.fromRGB(235, 70, 70),
	Disabled = Color3.fromRGB(95, 98, 118),
	Owned = Color3.fromRGB(46, 204, 113),
	Gold = Color3.fromRGB(255, 200, 40),
	Outline = Color3.fromRGB(20, 20, 30),
})

function UIKit.create(className: string, properties: { [string]: any }, children: { Instance }?): Instance
	local instance = Instance.new(className)
	for key, value in properties do
		(instance :: any)[key] = value
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	return instance
end
local create = UIKit.create

function UIKit.corner(radius: number): Instance
	return create("UICorner", { CornerRadius = UDim.new(0, radius) })
end

function UIKit.round(): Instance
	return create("UICorner", { CornerRadius = UDim.new(0.5, 0) })
end

function UIKit.stroke(color: Color3, thickness: number): Instance
	return create("UIStroke", { Color = color, Thickness = thickness, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

-- Lighter at the top, like the original's glossy buttons.
function UIKit.gloss(): Instance
	return create("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190)),
		Rotation = 90,
	})
end

function UIKit.padding(pixels: number): Instance
	local amount = UDim.new(0, pixels)
	return create("UIPadding", { PaddingLeft = amount, PaddingRight = amount, PaddingTop = amount, PaddingBottom = amount })
end

-- Outlined, auto-scaling text. `OutlineThickness` (not a real property) sets
-- the black outline.
function UIKit.label(properties: { [string]: any }): TextLabel
	local defaults: { [string]: any } = {
		BackgroundTransparency = 1,
		Font = UIKit.Font,
		TextColor3 = UIKit.Colors.Text,
		TextScaled = true,
	}
	for key, value in properties do
		defaults[key] = value
	end
	local outlineThickness = properties.OutlineThickness or 2
	defaults.OutlineThickness = nil
	local textLabel = create("TextLabel", defaults) :: TextLabel
	create("UITextSizeConstraint", { MaxTextSize = properties.TextSize or 32 }).Parent = textLabel
	create("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = outlineThickness }).Parent = textLabel
	return textLabel
end

-- Bigger on hover, squished while pressed, a springy pop when released.
function UIKit.addBounce(target: GuiButton, hoverScale: number)
	local scale = Instance.new("UIScale")
	scale.Parent = target
	local function tweenTo(value: number, seconds: number, style: Enum.EasingStyle)
		TweenService:Create(scale, TweenInfo.new(seconds, style, Enum.EasingDirection.Out), { Scale = value }):Play()
	end
	local hovering = false
	target.MouseEnter:Connect(function()
		hovering = true
		tweenTo(hoverScale, 0.15, Enum.EasingStyle.Back)
	end)
	target.MouseLeave:Connect(function()
		hovering = false
		tweenTo(1, 0.15, Enum.EasingStyle.Quad)
	end)
	target.MouseButton1Down:Connect(function()
		tweenTo(0.88, 0.08, Enum.EasingStyle.Quad)
	end)
	target.MouseButton1Up:Connect(function()
		tweenTo(if hovering then hoverScale else 1, 0.35, Enum.EasingStyle.Elastic)
	end)
	target.Activated:Connect(function()
		scale.Scale = 0.9
		tweenTo(if hovering then hoverScale else 1, 0.4, Enum.EasingStyle.Elastic)
	end)
end

function UIKit.button(text: string, color: Color3, properties: { [string]: any }): TextButton
	local defaults: { [string]: any } = {
		BackgroundColor3 = color,
		AutoButtonColor = true,
		Font = UIKit.Font,
		Text = text,
		TextColor3 = UIKit.Colors.Text,
		TextScaled = true,
	}
	for key, value in properties do
		defaults[key] = value
	end
	local textButton = create("TextButton", defaults, {
		UIKit.corner(10),
		UIKit.stroke(Color3.new(0, 0, 0), 2),
		UIKit.gloss(),
		create("UIPadding", {
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
			PaddingTop = UDim.new(0, 4),
			PaddingBottom = UDim.new(0, 4),
		}),
		create("UITextSizeConstraint", { MaxTextSize = 28 }),
	}) :: TextButton
	textButton.Activated:Connect(function()
		Sounds.play("Click")
	end)
	UIKit.addBounce(textButton, 1.05)
	return textButton
end

-- Greys a button out (or back) without losing its colour.
function UIKit.setEnabled(target: GuiButton, enabled: boolean, color: Color3)
	target.BackgroundColor3 = if enabled then color else UIKit.Colors.Disabled
	target.AutoButtonColor = enabled
end

function UIKit.setImage(imageLabel: ImageLabel, image: EditableImage?): boolean
	if image == nil then
		return false
	end
	imageLabel.ImageContent = Content.fromObject(image)
	imageLabel.Visible = true
	return true
end

-- A progress bar: returns the frame and a function to set it (0..1, text).
function UIKit.progressBar(color: Color3, properties: { [string]: any }): (Frame, (fraction: number, text: string) -> ())
	local back = create("Frame", {
		BackgroundColor3 = UIKit.Colors.PanelDark,
	}, { UIKit.corner(10), UIKit.stroke(Color3.new(0, 0, 0), 2) }) :: Frame
	for key, value in properties do
		(back :: any)[key] = value
	end
	local fill = create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = color,
	}, { UIKit.corner(10), UIKit.gloss() }) :: Frame
	fill.Parent = back
	local text = UIKit.label({ Name = "Text", Size = UDim2.fromScale(1, 1), Text = "", TextSize = 20, ZIndex = 2 })
	text.Parent = back
	return back, function(fraction: number, value: string)
		fill.Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1)
		text.Text = value
	end
end

--------------------------------------------------------------------------------
-- Side buttons: big square glossy blocks with a thick outline, a shadow, a
-- bobbing icon and a bold label. A red "!" dot shows when something waits.
--------------------------------------------------------------------------------

UIKit.SideSize = 96
UIKit.SideGap = 22

-- Pixels the side columns keep clear: Roblox's top bar and the Cash, income
-- and boost labels at the bottom.
local SIDE_RESERVED_HEIGHT = 230
local SIDE_CENTRE_OFFSET = -69
local SIDE_COLUMN_HEIGHT = 3 * UIKit.SideSize + 2 * UIKit.SideGap

-- How much the side columns are scaled down on this screen.
local function sideFactor(viewport: Vector2): number
	return math.clamp(math.min((viewport.Y - SIDE_RESERVED_HEIGHT) / SIDE_COLUMN_HEIGHT, viewport.X / 1280), 0.5, 1)
end
local wiggleIcons: { ImageLabel } = {}

function UIKit.sideColumn(parent: Instance, name: string, count: number, properties: { [string]: any }): Frame
	local column = create("Frame", {
		Name = name,
		Size = UDim2.fromOffset(UIKit.SideSize, count * UIKit.SideSize + (count - 1) * UIKit.SideGap),
		BackgroundTransparency = 1,
	}, {
		create("UIListLayout", { Padding = UDim.new(0, UIKit.SideGap), SortOrder = Enum.SortOrder.LayoutOrder }),
	}) :: Frame
	for key, value in properties do
		(column :: any)[key] = value
	end
	column.Parent = parent
	return column
end

function UIKit.sideButton(column: Instance, name: string, text: string, color: Color3, iconName: string, order: number, fallback: string?): TextButton
	-- A holder so the shadow and the icon can stick out of the button.
	local holder = create("Frame", {
		Name = name .. "Holder",
		Size = UDim2.fromOffset(UIKit.SideSize, UIKit.SideSize),
		BackgroundTransparency = 1,
		LayoutOrder = order,
	}) :: Frame

	create("Frame", {
		Name = "Shadow",
		Position = UDim2.fromOffset(0, 6),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		ZIndex = 1,
	}, { UIKit.corner(18) }).Parent = holder

	local dark = color:Lerp(Color3.new(0, 0, 0), 0.35)
	local square = create("TextButton", {
		Name = name,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false,
		Text = "",
		ZIndex = 2,
	}, {
		UIKit.corner(18),
		create("UIStroke", { Color = UIKit.Colors.Outline, Thickness = 4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
		create("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, color:Lerp(Color3.new(1, 1, 1), 0.25)),
				ColorSequenceKeypoint.new(0.55, color),
				ColorSequenceKeypoint.new(1, dark),
			}),
			Rotation = 90,
		}),
	}) :: TextButton

	create("Frame", {
		Name = "Shine",
		Position = UDim2.new(0, 7, 0, 6),
		Size = UDim2.new(1, -14, 0.36, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.72,
		ZIndex = 3,
	}, { UIKit.corner(12) }).Parent = square

	local icon = create("ImageLabel", {
		Name = "Icon",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.38, 0),
		Size = UDim2.fromOffset(82, 82),
		BackgroundTransparency = 1,
		Rotation = -8,
		ZIndex = 4,
		Visible = false,
	}) :: ImageLabel
	icon.Parent = square
	local hasIcon = UIKit.setImage(icon, AssetLoader.getUIIcon(iconName))
	if hasIcon then
		table.insert(wiggleIcons, icon)
	elseif fallback then
		-- An emoji stands in until the icon is packed.
		UIKit.label({
			Name = "IconText",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.36, 0),
			Size = UDim2.fromOffset(56, 56),
			Text = fallback,
			TextSize = 50,
			ZIndex = 4,
		}).Parent = square
		hasIcon = true
	end

	-- The label stays inside the button (long words shrink to fit).
	UIKit.label({
		Name = "Label",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 4),
		Size = if hasIcon then UDim2.new(1, -10, 0, 28) else UDim2.new(1, -10, 1, -8),
		Text = text,
		TextSize = if hasIcon then 26 else 30,
		OutlineThickness = 3,
		ZIndex = 5,
	}).Parent = square

	-- The "something's waiting" dot.
	local dot = UIKit.label({
		Name = "Alert",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -6, 0, 6),
		Size = UDim2.fromOffset(30, 30),
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromRGB(235, 40, 60),
		Text = "!",
		TextSize = 24,
		ZIndex = 6,
		Visible = false,
	})
	UIKit.round().Parent = dot
	create("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }).Parent = dot
	dot.Parent = square

	square.Activated:Connect(function()
		Sounds.play("Click")
	end)
	UIKit.addBounce(square, 1.1)
	square.Parent = holder
	holder.Parent = column
	return square
end

function UIKit.setAlert(square: GuiObject, on: boolean)
	local dot = square:FindFirstChild("Alert")
	if dot and dot:IsA("GuiObject") then
		dot.Visible = on
	end
end

-- Icons bob and wiggle, each a little out of step; alert dots pulse.
RunService.RenderStepped:Connect(function()
	local t = os.clock()
	for index, icon in wiggleIcons do
		local phase = t * 2.2 + index * 1.3
		icon.Rotation = -8 + math.sin(phase) * 6
		icon.Position = UDim2.new(0.5, 0, 0.38, -3 + math.sin(phase * 1.3) * 3)
	end
end)

--------------------------------------------------------------------------------
-- Windows: one open at a time across every script.
--------------------------------------------------------------------------------

local modals: { Frame } = {}

-- Windows are always laid out at their design size and scaled down as a
-- whole to fit the screen, so everything in them fits on any screen.
-- Roblox's top bar takes this much of the screen.
local TOP_BAR_HEIGHT = 58

local function viewportSize(): Vector2
	local camera = Workspace.CurrentCamera
	local size = if camera then camera.ViewportSize else nil
	return if typeof(size) == "Vector2" and size.Y > 1 then size else Vector2.new(1280, 760)
end

-- Windows fit between the two pairs of side button columns (which would
-- otherwise cover their edges) and under Roblox's top bar.
local function fitScale(frame: Frame): number
	local viewport = viewportSize()
	local size = frame.Size
	local sides = 16 + (2 * UIKit.SideSize + 20) * sideFactor(viewport) + 12
	local width = viewport.X - 2 * sides
	return math.min(1, width / size.X.Offset, (viewport.Y - TOP_BAR_HEIGHT) * 0.92 / size.Y.Offset)
end

local function refit(frame: Frame)
	local scale = frame:FindFirstChild("FitScale") :: UIScale?
	if scale then
		scale.Scale = fitScale(frame)
	end
end

function UIKit.modal(parent: Instance, name: string, title: string, accent: Color3, size: Vector2): (Frame, Frame)
	local frame = create("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundColor3 = UIKit.Colors.Panel,
		Visible = false,
	}, {
		UIKit.corner(18),
		UIKit.stroke(Color3.new(0, 0, 0), 4),
		create("UIScale", { Name = "FitScale" }),
	}) :: Frame
	refit(frame)

	create("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 62),
		BackgroundColor3 = accent,
	}, { UIKit.corner(18), UIKit.gloss() }).Parent = frame

	UIKit.label({
		Name = "Title",
		Position = UDim2.fromOffset(20, 8),
		Size = UDim2.new(1, -90, 0, 46),
		Text = title,
		TextSize = 40,
		TextXAlignment = Enum.TextXAlignment.Left,
		OutlineThickness = 3,
	}).Parent = frame

	local closeButton = UIKit.button("X", UIKit.Colors.Close, {
		Name = "CloseButton",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 9),
		Size = UDim2.fromOffset(44, 44),
	})
	closeButton.Parent = frame
	closeButton.Activated:Connect(function()
		frame.Visible = false
	end)

	local body = create("Frame", {
		Name = "Body",
		Position = UDim2.fromOffset(16, 74),
		Size = UDim2.new(1, -32, 1, -90),
		BackgroundTransparency = 1,
	}) :: Frame
	body.Parent = frame
	frame.Parent = parent
	table.insert(modals, frame)
	return frame, body
end

-- Opens a window (closing any other) or closes it. Returns true if it opened.
function UIKit.toggleModal(frame: Frame): boolean
	local open = not frame.Visible
	for _, other in modals do
		other.Visible = false
	end
	frame.Visible = open
	local scale = frame:FindFirstChild("FitScale") :: UIScale?
	if open and scale then
		Sounds.play("Open")
		-- A little pop as it opens.
		local target = fitScale(frame)
		scale.Scale = target * 0.85
		TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = target }):Play()
	end
	return open
end

function UIKit.openModal(frame: Frame)
	if not frame.Visible then
		UIKit.toggleModal(frame)
	end
end

-- Tabs across the top of a window body: returns the page frames by name.
function UIKit.tabs(body: Frame, names: { string }, accent: Color3): ({ [string]: Frame }, (name: string) -> ())
	local bar = create("Frame", {
		Name = "Tabs",
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	}) :: Frame
	bar.Parent = body
	local pages: { [string]: Frame } = {}
	local buttons: { [string]: TextButton } = {}
	local function select(name: string)
		for pageName, page in pages do
			page.Visible = pageName == name
			buttons[pageName].BackgroundColor3 = if pageName == name then accent else UIKit.Colors.PanelLight
		end
	end
	for order, name in names do
		local tab = UIKit.button(name, UIKit.Colors.PanelLight, {
			Name = name .. "Tab",
			Size = UDim2.new(1 / #names, -8, 1, 0),
			LayoutOrder = order,
		})
		tab.Parent = bar
		buttons[name] = tab
		local page = create("Frame", {
			Name = name,
			Position = UDim2.fromOffset(0, 50),
			Size = UDim2.new(1, 0, 1, -50),
			BackgroundTransparency = 1,
			Visible = false,
		}) :: Frame
		page.Parent = body
		pages[name] = page
		tab.Activated:Connect(function()
			select(name)
		end)
	end
	select(names[1])
	return pages, select
end

-- Confetti bursting from a point on the screen (0..1 each way).
function UIKit.confetti(parent: Instance, origin: Vector2, count: number)
	for _ = 1, count do
		local piece = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(origin.X, origin.Y),
			Size = UDim2.fromOffset(math.random(8, 14), math.random(12, 20)),
			BackgroundColor3 = Color3.fromHSV(math.random(), 0.8, 1),
			Rotation = math.random(0, 360),
			ZIndex = 50,
		}) :: Frame
		piece.Parent = parent
		local angle = math.random() * math.pi * 2
		local distance = 0.15 + math.random() * 0.35
		local target = UDim2.fromScale(origin.X + math.cos(angle) * distance, origin.Y + math.sin(angle) * distance + 0.25)
		local tween = TweenService:Create(piece, TweenInfo.new(1.2 + math.random() * 0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = target,
			Rotation = piece.Rotation + math.random(-360, 360),
			BackgroundTransparency = 1,
		})
		tween.Completed:Connect(function()
			piece:Destroy()
		end)
		tween:Play()
	end
end

--------------------------------------------------------------------------------
-- Pop-up messages: GameClient shows them; any script can ask.
--------------------------------------------------------------------------------

local toastHandler: ((message: string, kind: string) -> ())? = nil

function UIKit.setToastHandler(handler: (message: string, kind: string) -> ())
	toastHandler = handler
end

function UIKit.toast(message: string, kind: string)
	local handler = toastHandler
	if handler then
		handler(message, kind)
	end
end

--------------------------------------------------------------------------------
-- Small screens: shrinks HUD pieces (not the windows, which fit themselves).
--------------------------------------------------------------------------------

function UIKit.autoScale(target: GuiObject, designHeight: number?)
	local scale = Instance.new("UIScale")
	scale.Name = "ScreenScale"
	scale.Parent = target
	local function update()
		local camera = Workspace.CurrentCamera
		local size = if camera then camera.ViewportSize else nil
		local viewport = if typeof(size) == "Vector2" then size else Vector2.new(1280, 760)
		if viewport.Y <= 1 then
			return
		end
		scale.Scale = math.clamp(math.min(viewport.Y / (designHeight or 760), viewport.X / 1280), 0.5, 1)
	end
	update()
	local camera = Workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	end
end

-- Places a column of side buttons: as big as fits between the top bar and
-- the Cash in the bottom-left corner (never covering it), and a little above
-- the middle of the screen. `slot` 0 is at the screen edge, 1 next to it.
-- Every column is placed as if it had three buttons, so all of them are the
-- same size and a shorter one lines up with the top buttons of the others.
function UIKit.placeSideColumn(column: Frame, onRight: boolean, slot: number)
	local scale = Instance.new("UIScale")
	scale.Name = "ScreenScale"
	scale.Parent = column
	local function update()
		local camera = Workspace.CurrentCamera
		local size = if camera then camera.ViewportSize else nil
		local viewport = if typeof(size) == "Vector2" then size else Vector2.new(1280, 760)
		if viewport.Y <= 1 then
			return
		end
		local factor = sideFactor(viewport)
		scale.Scale = factor
		local x = 16 + slot * (UIKit.SideSize + 20) * factor
		local top = SIDE_CENTRE_OFFSET - SIDE_COLUMN_HEIGHT * factor / 2
		column.AnchorPoint = Vector2.new(if onRight then 1 else 0, 0)
		column.Position = if onRight then UDim2.new(1, -x, 0.5, top) else UDim2.new(0, x, 0.5, top)
	end
	update()
	local camera = Workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	end
end

-- Grid cells for `columns` columns that exactly fill a scrolling list
-- `width` pixels wide (clear of its scroll bar), with `gap` between them.
function UIKit.gridCells(width: number, columns: number, gap: number, scrollBar: number): number
	return math.floor((width - scrollBar - 4 - (columns - 1) * gap) / columns)
end

-- Changes a window's design size (see UIKit.modal), e.g. to fit its content.
function UIKit.resizeModal(frame: Frame, size: Vector2)
	frame.Size = UDim2.fromOffset(size.X, size.Y)
	refit(frame)
end

-- The size of a window's Body at its design size.
function UIKit.bodySize(frame: Frame): Vector2
	return Vector2.new(frame.Size.X.Offset - 32, frame.Size.Y.Offset - 90)
end

-- Windows follow the screen size.
do
	local function refitAll()
		for _, frame in modals do
			refit(frame)
		end
	end
	local camera = Workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(refitAll)
	end
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		local newCamera = Workspace.CurrentCamera
		if newCamera then
			newCamera:GetPropertyChangedSignal("ViewportSize"):Connect(refitAll)
			refitAll()
		end
	end)
end

--------------------------------------------------------------------------------
-- Brainrot pictures: a still 3D model in a ViewportFrame.
--------------------------------------------------------------------------------

-- A lucky block for previews: a cube with "?" marks is too fiddly in a
-- viewport, so a coloured cube with glowing edges.
local function luckyBlockModel(definition: BrainrotConfig.Brainrot, height: number): Model
	local model = Instance.new("Model")
	local cube = Instance.new("Part")
	cube.Size = Vector3.one * height * 0.8
	cube.Color = definition.BodyColor
	cube.Material = Enum.Material.SmoothPlastic
	cube.Anchored = true
	cube.CFrame = CFrame.identity
	cube.Parent = model
	for _, axis in { Vector3.xAxis, Vector3.yAxis, Vector3.zAxis } do
		local band = Instance.new("Part")
		band.Size = (Vector3.one - axis * 0.9) * height * 0.82
		band.Color = definition.AccentColor
		band.Material = Enum.Material.Neon
		band.Anchored = true
		band.Transparency = 0.2
		band.CFrame = CFrame.identity
		band.Parent = model
	end
	model.PrimaryPart = cube
	return model
end

-- A still copy of a brainrot, `height` studs tall and centred on the origin:
-- its imported model if there is one, else the blocky model.
function UIKit.previewModel(brainrotId: string, height: number): Model?
	local definition = BrainrotConfig.ById[brainrotId]
	if definition and BrainrotConfig.isLuckyBlock(definition) then
		return luckyBlockModel(definition, height)
	end
	local templates = ReplicatedStorage:FindFirstChild("BrainrotModels")
	local template = if templates then templates:FindFirstChild(brainrotId) else nil
	if template and template:IsA("Model") and #template:GetChildren() > 0 then
		local clone = template:Clone()
		local scale = height / math.max(tonumber(template:GetAttribute("Height")) or 1, 0.01)
		for _, part in clone:GetDescendants() do
			if part:IsA("BasePart") then
				local rest = part.CFrame
				part.Size *= scale
				part.CFrame = CFrame.new(rest.Position * scale - Vector3.new(0, height / 2, 0)) * rest.Rotation
				part.Anchored = true
			end
		end
		clone.WorldPivot = CFrame.identity
		return clone
	end
	return AssetLoader.createBrainrotModel(brainrotId, nil, height)
end

-- A ViewportFrame showing a brainrot (filled in the background).
function UIKit.brainrotViewport(brainrotId: string, background: Color3, properties: { [string]: any }): ViewportFrame
	local viewport = create("ViewportFrame", {
		BackgroundColor3 = background,
		Ambient = Color3.fromRGB(200, 200, 200),
		LightColor = Color3.new(1, 1, 1),
		LightDirection = Vector3.new(-0.4, -1, 0.6),
	}, { UIKit.corner(10) }) :: ViewportFrame
	for key, value in properties do
		(viewport :: any)[key] = value
	end
	task.spawn(function()
		local model = UIKit.previewModel(brainrotId, 4)
		if model == nil or viewport.Parent == nil then
			return
		end
		model.Parent = viewport
		local camera = Instance.new("Camera")
		camera.FieldOfView = 40
		camera.CFrame = CFrame.lookAt(Vector3.new(0, 0.6, -8.5), Vector3.zero)
		camera.Parent = viewport
		viewport.CurrentCamera = camera
	end)
	return viewport
end

-- A card for a brainrot entry ("Id:Mutation:Trait"): picture, name, rarity
-- and income. Returns the card as a button.
function UIKit.brainrotCard(entry: string, properties: { [string]: any }): TextButton
	local definition, mutation, trait = BrainrotConfig.decode(entry)
	local rarity = if definition then BrainrotConfig.RarityByName[definition.Rarity] else nil
	local rarityColour = if rarity then rarity.Color else Color3.new(1, 1, 1)
	local card = create("TextButton", {
		Name = "Card",
		BackgroundColor3 = UIKit.Colors.PanelLight,
		AutoButtonColor = true,
		Text = "",
	}, { UIKit.corner(12), UIKit.stroke(if mutation then mutation.Color else rarityColour, 3) }) :: TextButton
	for key, value in properties do
		(card :: any)[key] = value
	end
	if definition then
		UIKit.brainrotViewport(definition.Id, rarityColour:Lerp(Color3.new(0, 0, 0), 0.55), {
			Name = "Preview",
			Position = UDim2.new(0, 6, 0, 6),
			Size = UDim2.new(1, -12, 0.52, 0),
		}).Parent = card
		UIKit.label({
			Name = "BrainrotName",
			Position = UDim2.new(0, 4, 0.56, 0),
			Size = UDim2.new(1, -8, 0.15, 0),
			Text = BrainrotConfig.fullName(definition, mutation, trait),
			TextSize = 18,
		}).Parent = card
		UIKit.label({
			Name = "Rarity",
			Position = UDim2.new(0, 4, 0.71, 0),
			Size = UDim2.new(1, -8, 0.13, 0),
			Text = definition.Rarity,
			TextColor3 = rarityColour,
			TextSize = 16,
		}).Parent = card
		local income = definition.IncomePerSecond * BrainrotConfig.multiplier(mutation, trait)
		UIKit.label({
			Name = "Income",
			Position = UDim2.new(0, 4, 0.84, 0),
			Size = UDim2.new(1, -8, 0.13, 0),
			Text = if BrainrotConfig.isLuckyBlock(definition) then "Lucky Block" else NumberFormat.cash(income) .. "/s",
			TextColor3 = UIKit.Colors.Income,
			TextSize = 16,
		}).Parent = card
	end
	return card
end

return UIKit
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="281">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="282">
      <Properties>
        <string name="Name">CompanionManager</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
	CompanionManager
	Location: ServerScriptService (Script)

	Guards and pets, picked from the brainrots in a player's base:
	  * Guard: stands guard in front of the base's door, pacing across it.
	    When someone who isn't the owner (or in their crew) comes close, it
	    shouts ("!"), then charges and knocks them back; a thief it catches
	    drops what they carry. Then it rests (ExtrasConfig.GuardCooldowns,
	    halved by the Super Guard pass). It's slower than a walking player,
	    never chases far from its post, ignores cloaked players, and a slap
	    dazes it, so stealing still works.
	  * Pets: brainrots that follow their owner around (each client draws
	    them), making them faster (ExtrasConfig.petSpeed). Everyone has one
	    pet slot; more are bought with Cash (ExtrasConfig.PetSlotPrices).
	The brainrots stay on their pedestals and keep earning either way. All of
	it is saved (progress "Companions") and ends when the brainrot leaves the
	base.

	Remote: ReplicatedStorage.Remotes.Companion (RemoteFunction)
	  (action, slot) with action "Guard", "Unguard", "Pet", "Unpet" -> (ok, message)
	  ("BuySlot") -> (ok, message): the next pet slot
	  ("State") -> (true, nil, { Guard = slot?, Pets = { slot, ... }, PetSlots = n })
	Player attributes: GuardSlot (0 = none), PetCapacity (pet slots owned),
	  PetBaseSlots, PetEntries and PetHats (comma lists, one per pet),
	  PetSpeed
	Guard models live in Workspace.Map.Brainrots (State "Guard") with the
	  attributes OwnerUserId, GuardReadyAt (server time), GuardAlert and
	  GuardDazedUntil.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BrainrotConfig = require(Shared:WaitForChild("BrainrotConfig"))
local ExtrasConfig = require(Shared:WaitForChild("ExtrasConfig"))
local GearConfig = require(Shared:WaitForChild("GearConfig"))
local NumberFormat = require(Shared:WaitForChild("NumberFormat"))
local TemplateModels = require(Shared:WaitForChild("TemplateModels"))

local LOG_PREFIX = "[CompanionManager]"
local TICK_SECONDS = 0.1
-- Height in studs of a brainrot with Scale 1 (as in GameplayManager).
local FIGURE_HEIGHT = 5.2
local REQUEST_COOLDOWN_SECONDS = 0.4
-- Guards only watch the ground floor of their base.
local GUARD_FLOOR_TOLERANCE = 7

type Companions = { Guard: string?, Pets: { string }, PetSlots: number }

type Guard = {
	Owner: Player,
	Slot: number,
	Entry: string,
	Model: Model,
	Root: BasePart,
	Status: TextLabel,
	-- Its post in front of the door, facing out, and which way is "across".
	Post: CFrame,
	Across: Vector3,
	Interior: BasePart,
	LaserZone: BasePart,
	ReadyAt: number,
	Cooldown: number,
	DazedUntil: number,
	-- Who it's about to charge, and when it charges.
	Target: Player?,
	ChargeAt: number,
	Patrol: number,
}

local dataApi = ServerStorage:WaitForChild("DataAndMonetization")
local gameplayApi = ServerStorage:WaitForChild("Gameplay")
local gearApi = ServerStorage:WaitForChild("Gear")
local getProgressFunction = dataApi:WaitForChild("GetProgress") :: BindableFunction
local setProgressFunction = dataApi:WaitForChild("SetProgress") :: BindableFunction
local ownsGamePassFunction = dataApi:WaitForChild("OwnsGamePass") :: BindableFunction
local spendCashFunction = dataApi:WaitForChild("SpendCash") :: BindableFunction
local describeOccupantsFunction = gameplayApi:WaitForChild("DescribeOccupants") :: BindableFunction
local slotsChangedEvent = gameplayApi:WaitForChild("SlotsChanged") :: BindableEvent
local forceDropEvent = gameplayApi:WaitForChild("ForceDrop") :: BindableEvent
local activityEvent = gameplayApi:WaitForChild("Activity") :: BindableEvent
local knockbackFunction = gearApi:WaitForChild("Knockback") :: BindableFunction
local slapSwingEvent = gearApi:WaitForChild("SlapSwing") :: BindableEvent

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local notifyEvent = remotes:WaitForChild("Notify") :: RemoteEvent
local playSoundEvent = remotes:WaitForChild("PlaySound") :: RemoteEvent

local companionFunction = Instance.new("RemoteFunction")
companionFunction.Name = "Companion"
companionFunction.Parent = remotes

local map = Workspace:WaitForChild("Map")
local plotsFolder = map:WaitForChild("Plots")
local brainrotsFolder = map:WaitForChild("Brainrots")

local guards: { [Player]: Guard } = {}
-- Each player's pets: the base slot and entry of each, in order.
local petSlots: { [Player]: { number } } = {}
local saved: { [Player]: Companions } = {}
local lastRequest: { [Player]: number } = {}

--------------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------------

local function notify(player: Player, message: string, kind: string, sound: string?)
	notifyEvent:FireClient(player, message, kind, sound)
end

local function getRoot(player: Player): BasePart?
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 then
		return root
	end
	return nil
end

local function flat(vector: Vector3): Vector3
	return Vector3.new(vector.X, 0, vector.Z)
end

local function sameCrew(a: Player, b: Player): boolean
	local crew = a:GetAttribute("CrewId")
	return crew ~= nil and b:GetAttribute("CrewId") == crew
end

local function plotOf(player: Player): Model?
	for _, plot in plotsFolder:GetChildren() do
		if plot:IsA("Model") and plot:GetAttribute("OwnerUserId") == player.UserId then
			return plot
		end
	end
	return nil
end

-- The brainrots in the player's base by slot.
local function describe(player: Player): { [number]: { [string]: any } }?
	local result = describeOccupantsFunction:Invoke(player)
	if typeof(result) ~= "table" then
		return nil
	end
	local bySlot: { [number]: { [string]: any } } = {}
	for _, info in result do
		if typeof(info) == "table" and typeof(info.Slot) == "number" then
			bySlot[info.Slot] = info
		end
	end
	return bySlot
end

local function saveCompanions(player: Player)
	local companions = saved[player]
	if companions == nil then
		return
	end
	setProgressFunction:Invoke(player, "Companions", {
		Guard = companions.Guard,
		Pets = table.clone(companions.Pets),
		PetSlots = companions.PetSlots,
	})
end

local function brainrotName(entry: string?): string
	local definition = if entry then BrainrotConfig.decode(entry) else nil
	return if definition then definition.DisplayName else "It"
end

--------------------------------------------------------------------------------
-- Guards
--------------------------------------------------------------------------------

local function removeGuard(player: Player)
	local guard = guards[player]
	guards[player] = nil
	if guard then
		guard.Model:Destroy()
	end
	player:SetAttribute("GuardSlot", 0)
end

-- In front of the door, facing out (towards anyone coming).
local function guardPost(plot: Model): (CFrame?, Vector3?, BasePart?, BasePart?)
	local laserZone = plot:FindFirstChild("LaserZone")
	local interior = plot:FindFirstChild("Interior")
	local floor = plot:FindFirstChild("Floor")
	if not (laserZone and laserZone:IsA("BasePart") and interior and interior:IsA("BasePart") and floor and floor:IsA("BasePart")) then
		return nil, nil, nil, nil
	end
	local inward = flat(interior.Position - laserZone.Position)
	inward = if inward.Magnitude > 0.01 then inward.Unit else Vector3.zAxis
	local groundY = floor.Position.Y + floor.Size.Y / 2
	local position = Vector3.new(laserZone.Position.X, groundY, laserZone.Position.Z) - inward * ExtrasConfig.GuardPostDistance
	return CFrame.lookAt(position, position - inward), inward:Cross(Vector3.yAxis), interior, laserZone
end

local function buildGuardModel(player: Player, info: { [string]: any }): (Model?, BasePart?, TextLabel?)
	local definition, mutation, trait = BrainrotConfig.decode(info.Entry)
	if definition == nil then
		return nil, nil, nil
	end
	local height = FIGURE_HEIGHT * definition.Scale * (if trait then trait.Scale else 1)
	local model = Instance.new("Model")
	model.Name = "Guard_" .. player.UserId
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.one
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Parent = model
	model.PrimaryPart = root
	-- The imported model if there is one (else each client builds it).
	local template = TemplateModels.get(definition.Id)
	if template then
		TemplateModels.build(model, root, template, height)
	end
	model:SetAttribute("BrainrotId", definition.Id)
	model:SetAttribute("FigureHeight", height)
	model:SetAttribute("CustomModel", template ~= nil)
	model:SetAttribute("Rarity", definition.Rarity)
	model:SetAttribute("Mutation", if mutation then mutation.Name else nil)
	model:SetAttribute("Trait", if trait then trait.Name else nil)
	model:SetAttribute("Motion", definition.Motion)
	model:SetAttribute("State", "Guard")
	model:SetAttribute("Hat", info.Hat)
	model:SetAttribute("OwnerUserId", player.UserId)
	model:SetAttribute("GuardReadyAt", 0)

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "GuardInfo"
	billboard.Adornee = root
	billboard.Size = UDim2.fromScale(6, 1.5)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, height + 1.4, 0)
	billboard.MaxDistance = 90
	billboard.LightInfluence = 0
	local status = Instance.new("TextLabel")
	status.Name = "Status"
	status.BackgroundTransparency = 1
	status.Size = UDim2.fromScale(1, 1)
	status.Font = Enum.Font.FredokaOne
	status.TextScaled = true
	status.TextColor3 = Color3.fromRGB(120, 220, 255)
	status.Text = "🛡️ GUARD"
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = status
	status.Parent = billboard
	billboard.Parent = root
	return model, root, status
end

local function setGuard(player: Player, slot: number, info: { [string]: any }): boolean
	removeGuard(player)
	local plot = plotOf(player)
	if plot == nil then
		return false
	end
	local post, across, interior, laserZone = guardPost(plot)
	if post == nil or across == nil or interior == nil or laserZone == nil then
		return false
	end
	local model, root, status = buildGuardModel(player, info)
	if model == nil or root == nil or status == nil then
		return false
	end
	root.CFrame = post
	local superGuard = ownsGamePassFunction:Invoke(player, "SuperGuard") == true
	local cooldown = (ExtrasConfig.GuardCooldowns[info.Rarity] or 20) * (if superGuard then ExtrasConfig.SuperGuardCooldownMultiplier else 1)
	guards[player] = {
		Owner = player,
		Slot = slot,
		Entry = info.Entry,
		Model = model,
		Root = root,
		Status = status,
		Post = post,
		Across = across,
		Interior = interior,
		LaserZone = laserZone,
		ReadyAt = 0,
		Cooldown = cooldown,
		DazedUntil = 0,
		Target = nil,
		ChargeAt = 0,
		Patrol = math.random() * math.pi * 2,
	}
	player:SetAttribute("GuardSlot", slot)
	model.Parent = brainrotsFolder
	return true
end

local function hit(guard: Guard, target: Player, targetRoot: BasePart)
	local owner = guard.Owner
	local now = Workspace:GetServerTimeNow()
	guard.ReadyAt = now + guard.Cooldown
	guard.Target = nil
	guard.Model:SetAttribute("GuardReadyAt", guard.ReadyAt)
	guard.Model:SetAttribute("GuardHit", now)
	-- Away from the guard, and away from the door.
	local direction = flat(targetRoot.Position - guard.Root.Position)
	local outward = guard.Post.LookVector
	direction = (if direction.Magnitude > 0.1 then direction.Unit else outward) + outward * 0.6
	knockbackFunction:Invoke(target, direction, ExtrasConfig.GuardKnockback, ExtrasConfig.GuardStunSeconds)
	playSoundEvent:FireClient(target, "Slap")
	playSoundEvent:FireClient(owner, "Slap")
	local guardName = brainrotName(guard.Entry)
	if target:GetAttribute("Carrying") == true then
		forceDropEvent:Fire(target, string.format("%s's guard %s caught you! You dropped the brainrot.", owner.DisplayName, guardName), owner)
		notify(owner, string.format("Your guard %s caught %s stealing!", guardName, target.DisplayName), "Success", "Notify")
		activityEvent:Fire(owner, "Catch", 1)
	else
		notify(target, string.format("%s's guard %s knocked you away from the base! Slap it to daze it.", owner.DisplayName, guardName), "Warning")
		notify(owner, string.format("Your guard %s knocked %s away from your base!", guardName, target.DisplayName), "Info")
	end
end

-- Someone the guard should go after: not the owner or their crew, not
-- cloaked, on the ground floor and close to its post (or a thief anywhere
-- near, carrying a brainrot).
local function intruderNear(guard: Guard): (Player?, BasePart?)
	local owner = guard.Owner
	local post = guard.Post.Position
	local best, found, foundRoot = math.huge, nil, nil
	for _, other in Players:GetPlayers() do
		if other == owner or sameCrew(other, owner) or other:GetAttribute("Cloaked") == true then
			continue
		end
		local root = getRoot(other)
		if root == nil or math.abs(root.Position.Y - post.Y) > GUARD_FLOOR_TOLERANCE then
			continue
		end
		local fromPost = flat(root.Position - post).Magnitude
		local reach = if other:GetAttribute("Carrying") == true then ExtrasConfig.GuardLeash else ExtrasConfig.GuardRadius
		if fromPost <= reach and fromPost < best then
			best, found, foundRoot = fromPost, other, root
		end
	end
	return found, foundRoot
end

local function stepGuard(guard: Guard, dt: number)
	local now = Workspace:GetServerTimeNow()
	local post = guard.Post.Position
	local position = guard.Root.Position
	local dazed = now < guard.DazedUntil
	local ready = now >= guard.ReadyAt and not dazed

	-- Spot someone, shout, then charge after the wind-up.
	local target: Player? = nil
	local targetRoot: BasePart? = nil
	if ready then
		local spotted, spottedRoot = intruderNear(guard)
		if spotted and spottedRoot then
			if guard.Target ~= spotted then
				guard.Target = spotted
				guard.ChargeAt = now + ExtrasConfig.GuardWindupSeconds
				guard.Model:SetAttribute("GuardAlert", now)
				playSoundEvent:FireClient(spotted, "Alarm")
			end
			target, targetRoot = spotted, spottedRoot
		else
			guard.Target = nil
		end
	else
		guard.Target = nil
	end
	local charging = target ~= nil and now >= guard.ChargeAt

	-- Where to go: after the intruder (on a leash), or pacing across the door.
	local goal: Vector3
	local speed: number
	if dazed then
		goal, speed = position, 0
	elseif charging and targetRoot then
		goal = Vector3.new(targetRoot.Position.X, post.Y, targetRoot.Position.Z)
		local leash = goal - post
		if leash.Magnitude > ExtrasConfig.GuardLeash then
			goal = post + leash.Unit * ExtrasConfig.GuardLeash
		end
		speed = ExtrasConfig.GuardChaseSpeed
	elseif target then
		-- Winding up: stands still, facing them.
		goal, speed = position, 0
	else
		guard.Patrol += dt * ExtrasConfig.GuardPatrolSpeed / math.max(ExtrasConfig.GuardPatrolWidth, 0.1)
		goal = post + guard.Across * math.sin(guard.Patrol) * ExtrasConfig.GuardPatrolWidth
		speed = ExtrasConfig.GuardChaseSpeed * 0.6
	end
	local offset = flat(goal - position)
	local distance = offset.Magnitude
	local facing = if target and targetRoot then flat(targetRoot.Position - position) else offset
	if distance > 0.2 and speed > 0 then
		local nextPosition = Vector3.new(position.X, post.Y, position.Z) + offset.Unit * math.min(distance, speed * dt)
		local look = if facing.Magnitude > 0.05 then facing.Unit else guard.Post.LookVector
		guard.Root.CFrame = CFrame.lookAt(nextPosition, nextPosition + look)
	elseif facing.Magnitude > 0.05 and not dazed then
		guard.Root.CFrame = CFrame.lookAt(position, position + facing.Unit)
	end

	if charging and target and targetRoot then
		local gap = flat(targetRoot.Position - guard.Root.Position).Magnitude
		if gap <= ExtrasConfig.GuardHitDistance then
			hit(guard, target, targetRoot)
		end
	end

	local text, colour
	if dazed then
		text, colour = string.format("😵 %ds", math.ceil(guard.DazedUntil - now)), Color3.fromRGB(255, 220, 90)
	elseif now < guard.ReadyAt then
		text, colour = string.format("💤 %ds", math.ceil(guard.ReadyAt - now)), Color3.fromRGB(200, 200, 210)
	elseif target then
		text, colour = "❗", Color3.fromRGB(255, 80, 80)
	else
		text, colour = "🛡️ GUARD", Color3.fromRGB(120, 220, 255)
	end
	if guard.Status.Text ~= text then
		guard.Status.Text = text
		guard.Status.TextColor3 = colour
	end
end

-- A slap glove swung at someone else's guard dazes it.
slapSwingEvent.Event:Connect(function(playerArg: any)
	if typeof(playerArg) ~= "Instance" or not playerArg:IsA("Player") then
		return
	end
	local slapper = playerArg :: Player
	local root = getRoot(slapper)
	if root == nil then
		return
	end
	for owner, guard in guards do
		if owner == slapper or sameCrew(owner, slapper) then
			continue
		end
		local offset = flat(guard.Root.Position - root.Position)
		if offset.Magnitude <= GearConfig.SlapRange + 2 and (offset.Magnitude < 1 or root.CFrame.LookVector:Dot(offset.Unit) > 0.2) then
			local now = Workspace:GetServerTimeNow()
			guard.DazedUntil = now + ExtrasConfig.GuardDazeSeconds
			guard.Target = nil
			guard.Model:SetAttribute("GuardDazedUntil", guard.DazedUntil)
			notify(slapper, string.format("You dazed %s's guard for %ds. Go go go!", owner.DisplayName, ExtrasConfig.GuardDazeSeconds), "Success")
			notify(owner, string.format("%s dazed your guard!", slapper.DisplayName), "Warning")
		end
	end
end)

--------------------------------------------------------------------------------
-- Pets
--------------------------------------------------------------------------------

-- Tells every client what to draw and sets the speed bonus.
local function publishPets(player: Player, occupants: { [number]: { [string]: any } }?)
	local slots: { number } = petSlots[player] or {}
	local entries, hats, rarities = {}, {}, {}
	for _, slot in slots do
		local info = if occupants then occupants[slot] else nil
		if info then
			table.insert(entries, info.Entry)
			table.insert(hats, if typeof(info.Hat) == "string" then info.Hat else "")
			table.insert(rarities, info.Rarity)
		end
	end
	local companions = saved[player]
	player:SetAttribute("PetCapacity", if companions then companions.PetSlots else 1)
	player:SetAttribute("PetBaseSlots", if #slots > 0 then table.concat(slots, ",") else nil)
	player:SetAttribute("PetEntries", if #entries > 0 then table.concat(entries, ",") else nil)
	player:SetAttribute("PetHats", if #hats > 0 then table.concat(hats, ",") else nil)
	player:SetAttribute("PetSpeed", if #rarities > 0 then ExtrasConfig.petSpeed(rarities) else 0)
end

local function clearPets(player: Player)
	petSlots[player] = {}
	publishPets(player, nil)
end

--------------------------------------------------------------------------------
-- Keeping up with the base
--------------------------------------------------------------------------------

-- Finds where a saved companion is now: the same slot if it still holds the
-- same brainrot, else any free slot with one like it.
local function findSlot(occupants: { [number]: { [string]: any } }, entry: string?, preferred: number?, taken: { [number]: boolean }): number?
	if entry == nil then
		return nil
	end
	if preferred and not taken[preferred] then
		local info = occupants[preferred]
		if info and info.Entry == entry then
			return preferred
		end
	end
	for slot, info in occupants do
		if info.Entry == entry and not taken[slot] then
			return slot
		end
	end
	return nil
end

local function refresh(player: Player)
	local occupants = describe(player)
	local companions = saved[player]
	if occupants == nil or companions == nil then
		return
	end
	local changed = false
	local taken: { [number]: boolean } = {}

	local guard = guards[player]
	local guardSlot = findSlot(occupants, companions.Guard, if guard then guard.Slot else nil, taken)
	if guardSlot then
		taken[guardSlot] = true
		local info = occupants[guardSlot]
		if guard == nil or guard.Slot ~= guardSlot then
			setGuard(player, guardSlot, info)
		else
			guard.Model:SetAttribute("Hat", info.Hat)
		end
	elseif companions.Guard then
		removeGuard(player)
		companions.Guard = nil
		changed = true
		notify(player, "Your guard left the base with its brainrot.", "Warning")
	end

	local oldSlots: { number } = petSlots[player] or {}
	local newSlots: { number } = {}
	local keptEntries: { string } = {}
	for index, entry in companions.Pets do
		local slot = findSlot(occupants, entry, oldSlots[index], taken)
		if slot then
			taken[slot] = true
			table.insert(newSlots, slot)
			table.insert(keptEntries, entry)
		else
			changed = true
			notify(player, string.format("Your pet %s went with its brainrot.", brainrotName(entry)), "Warning")
		end
	end
	companions.Pets = keptEntries
	petSlots[player] = newSlots
	publishPets(player, occupants)
	if changed then
		saveCompanions(player)
	end
end

local function onDataLoaded(player: Player)
	local stored = getProgressFunction:Invoke(player, "Companions")
	local pets: { string } = {}
	if typeof(stored) == "table" then
		if typeof(stored.Pets) == "table" then
			for _, entry in stored.Pets do
				if typeof(entry) == "string" and #pets < ExtrasConfig.MaxPetSlots then
					table.insert(pets, entry)
				end
			end
		elseif typeof(stored.Pet) == "string" then
			-- Saved before there could be several.
			table.insert(pets, stored.Pet)
		end
	end
	local owned = if typeof(stored) == "table" then math.floor(tonumber(stored.PetSlots) or 1) else 1
	owned = math.clamp(owned, 1, ExtrasConfig.MaxPetSlots)
	while #pets > owned do
		table.remove(pets)
	end
	saved[player] = {
		Guard = if typeof(stored) == "table" and typeof(stored.Guard) == "string" then stored.Guard else nil,
		Pets = pets,
		PetSlots = owned,
	}
	player:SetAttribute("GuardSlot", 0)
	clearPets(player)
	-- The base is filled right after the data loads.
	for _ = 1, 60 do
		if player.Parent ~= Players then
			return
		end
		if describe(player) ~= nil then
			refresh(player)
			return
		end
		task.wait(1)
	end
end

slotsChangedEvent.Event:Connect(function(player: any)
	if typeof(player) == "Instance" and player:IsA("Player") and saved[player] then
		refresh(player)
	end
end)

--------------------------------------------------------------------------------
-- Requests
--------------------------------------------------------------------------------

local function buySlot(player: Player, companions: Companions): (boolean, string?)
	local next = companions.PetSlots + 1
	local price = ExtrasConfig.PetSlotPrices[next]
	if price == nil then
		return false, "You have every pet slot!"
	end
	if spendCashFunction:Invoke(player, price) ~= true then
		return false, string.format("Pet slot %d costs %s.", next, NumberFormat.cash(price))
	end
	companions.PetSlots = next
	saveCompanions(player)
	publishPets(player, describe(player))
	return true, string.format("Pet slot %d unlocked! Pick another brainrot to follow you.", next)
end

companionFunction.OnServerInvoke = function(player: Player, action: any, slot: any): (boolean, string?, any)
	local companions = saved[player]
	if companions == nil then
		return false, "Still loading, try again in a moment."
	end
	if action == "State" then
		local guard = guards[player]
		return true, nil, { Guard = if guard then guard.Slot else nil, Pets = table.clone(petSlots[player] or {}), PetSlots = companions.PetSlots }
	end
	local now = os.clock()
	if now - (lastRequest[player] or 0) < REQUEST_COOLDOWN_SECONDS then
		return false, "Slow down!"
	end
	lastRequest[player] = now

	if action == "BuySlot" then
		return buySlot(player, companions)
	elseif action == "Unguard" then
		removeGuard(player)
		companions.Guard = nil
		saveCompanions(player)
		return true, "Your guard is off duty."
	elseif action == "Unpet" then
		local slots: { number } = petSlots[player] or {}
		local index = if typeof(slot) == "number" then table.find(slots, slot) else nil
		if index == nil then
			return false, "That brainrot isn't one of your pets."
		end
		local name = brainrotName(companions.Pets[index])
		table.remove(slots, index)
		table.remove(companions.Pets, index)
		saveCompanions(player)
		publishPets(player, describe(player))
		return true, string.format("%s went back to its pedestal.", name)
	end

	local occupants = describe(player)
	local info = if occupants and typeof(slot) == "number" then occupants[slot] else nil
	if info == nil then
		return false, "That brainrot isn't in your base."
	end
	if not info.Home then
		return false, "Wait until it's back on its pedestal."
	end
	local name = brainrotName(info.Entry)
	local slots: { number } = petSlots[player] or {}
	if action == "Guard" then
		if table.find(slots, slot) then
			return false, "That's one of your pets! Pick another brainrot to guard."
		end
		if not setGuard(player, slot, info) then
			return false, "Your base has no door to guard."
		end
		companions.Guard = info.Entry
		saveCompanions(player)
		return true, string.format("%s is guarding your base! It stands at the door and knocks away anyone who comes close.", name)
	elseif action == "Pet" then
		local guard = guards[player]
		if guard and guard.Slot == slot then
			return false, "That's your guard! Pick another brainrot as a pet."
		end
		if table.find(slots, slot) then
			return false, "It's already following you."
		end
		if #slots >= companions.PetSlots then
			local price = ExtrasConfig.PetSlotPrices[companions.PetSlots + 1]
			return false,
				if price
					then string.format("All %d pet slots are full. Put a pet back, or buy another slot for %s (Pets button).", companions.PetSlots, NumberFormat.cash(price))
					else "All your pet slots are full. Put a pet back first."
		end
		table.insert(slots, slot)
		table.insert(companions.Pets, info.Entry)
		petSlots[player] = slots
		saveCompanions(player)
		publishPets(player, occupants)
		return true, string.format("%s is following you! Walk speed +%s.", name, tostring(player:GetAttribute("PetSpeed")))
	end
	return false, nil
end

--------------------------------------------------------------------------------
-- Players and the loop
--------------------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	if player:GetAttribute("DataLoaded") == true then
		task.spawn(onDataLoaded, player)
		return
	end
	local connection: RBXScriptConnection? = nil
	connection = player:GetAttributeChangedSignal("DataLoaded"):Connect(function()
		if player:GetAttribute("DataLoaded") == true then
			if connection then
				connection:Disconnect()
			end
			onDataLoaded(player)
		end
	end)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(function(player: Player)
	removeGuard(player)
	saved[player] = nil
	petSlots[player] = nil
	lastRequest[player] = nil
end)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

task.spawn(function()
	local last = os.clock()
	while true do
		task.wait(TICK_SECONDS)
		local now = os.clock()
		local dt = math.min(now - last, 0.5)
		last = now
		for _, guard in guards do
			local ok, err = pcall(function()
				stepGuard(guard, dt)
			end)
			if not ok then
				warn(string.format("%s Guard failed: %s", LOG_PREFIX, tostring(err)))
			end
		end
	end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="283">
      <Properties>
        <string name="Name">DataAndMonetizationManager</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
	DataAndMonetizationManager
	Location: ServerScriptService (Script)

	Owns every player's persistent data (Cash, Steals, Rebirths, game passes,
	brainrots, gear, uncollected pad Cash), the leaderstats folder, and all Robux
	purchases for Snatch the Brainrot. It also measures how long a player was
	offline, for offline cash.

	Security model
	  * The in-memory profile on the server is the only source of truth. Clients
	    cannot write to it: there are no RemoteEvents here, leaderstats edits made
	    on a client never replicate, and the server API below lives in
	    ServerStorage, which clients cannot see.
	  * Session locking: a profile is locked to one server session while a player
	    is in it. A second server waits for the lock to be released (or steals it
	    after a timeout), and the old session can no longer write once its lock is
	    gone. This stops the classic "server hop before save" duplication exploit.
	  * Developer products are granted ONLY through ProcessReceipt. Each PurchaseId
	    is recorded inside the same DataStore write as the reward, so a receipt can
	    never be granted twice, and PurchaseGranted is returned only after that
	    write succeeds.
	  * PromptGamePassPurchaseFinished can be spoofed by exploit executors, so game
	    pass ownership is always re-verified with UserOwnsGamePassAsync.

	Server API (ServerStorage.DataAndMonetization), for other server scripts:
	  BindableFunction AddCash(player, amount) -> boolean
	  BindableFunction SpendCash(player, amount) -> boolean
	  BindableFunction AddRebirths(player, amount) -> boolean
	  BindableFunction AddSteals(player, amount) -> boolean
	  BindableFunction GetPlayerData(player) -> { Cash, Steals, Rebirths, OwnedGamePasses }?
	  BindableFunction GetBrainrots(player) -> { string }?
	  BindableFunction SetBrainrots(player, brainrotIds) -> boolean
	  BindableFunction GetPadCash(player) -> { number }?
	  BindableFunction SetPadCash(player, padCash) -> boolean
	  BindableFunction CollectPadCash(player, amount, padCashLeft) -> boolean
	  BindableFunction TakeOfflineSeconds(player) -> number
	  BindableFunction GetGear(player) -> { string }?
	  BindableFunction AddGear(player, gearId) -> boolean
	  BindableFunction GetItems(player) -> { [itemId]: charges }?
	  BindableFunction UseItemCharge(player, itemId) -> boolean
	  BindableFunction OwnsGamePass(player, gamePassIdOrName) -> boolean
	  BindableFunction IsLaserBypassActive(player) -> boolean
	  BindableFunction GetServerRarityMultiplier() -> number
	  BindableFunction GetProgress(player, key) -> value?   (a copy)
	  BindableFunction GetHats(player) -> { [hatName]: count }?
	  BindableFunction AddHat(player, hatName | "Random", count?) -> hatName?
	  BindableFunction TakeHat(player, hatName) -> boolean   (one off the pile)
	  BindableFunction GetSeason(player) -> { Id, XP }?   (this season's)
	  BindableFunction AddSeasonXP(player, amount) -> number?   (the new XP)
	  BindableEvent    HatCrateOpened(player, hatName)
	  BindableFunction SetProgress(player, key, value) -> boolean
	  BindableFunction SaveNow(player)   (saves soon, e.g. after a trade)
	  BindableEvent    EMPLaserOverriderPurchased(player, durationSeconds, endsAtServerTime)
	  BindableEvent    EMPLaserOverriderExpired(player)
	  BindableEvent    ServerRarityBoostChanged(multiplier, endsAtServerTime, purchaser?)
	  BindableEvent    GamePassOwnershipChanged(player, gamePassName, isOwned)
	  BindableEvent    ItemsChanged(player)
	  BindableEvent    ProgressChanged(player, key)

	Progress is a saved table for everything else (index, rewards, quests,
	upgrades, skins, settings...). Only server scripts write it and each key
	belongs to one script. Values may only hold strings, numbers, booleans and
	tables of those (arrays or string-keyed); see sanitizeProgressValue.

	Replicated state (read-only for clients, handy for UI):
	  Player attribute        DataLoaded (boolean)
	  Player attribute        LaserBypassEndsAt (Workspace:GetServerTimeNow() time)
	  Player attribute        OwnsGamePass_<Name> (boolean)
	  Player attribute        CashBoostEndsAt (Workspace:GetServerTimeNow() time)
	  ReplicatedStorage attr  ServerRarityMultiplier (number)
	  ReplicatedStorage attr  ServerRarityBoostEndsAt (Workspace:GetServerTimeNow() time, 0 = inactive)

	Only ONE script in the experience may assign MarketplaceService.ProcessReceipt.
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

--------------------------------------------------------------------------------
-- Configuration
--------------------------------------------------------------------------------

local LOG_PREFIX = "[DataAndMonetizationManager]"

local DATA_STORE_NAME = "BrainrotGame_v1"
local DATA_KEY_PREFIX = "Player_"
local SCHEMA_VERSION = 1

local AUTOSAVE_INTERVAL_SECONDS = 120
local AUTOSAVE_STAGGER_SECONDS = 0.5
local SESSION_LOCK_STALE_SECONDS = 600
local SESSION_LOCK_RETRY_SECONDS = 5
local SESSION_LOCK_MAX_RETRIES = 4
local LOAD_MAX_ATTEMPTS = 5
-- Studio fails fast so testing without API access doesn't stall on retries.
local STUDIO_LOAD_MAX_ATTEMPTS = 2
local AUTOSAVE_MAX_ATTEMPTS = 3
local RECEIPT_SAVE_MAX_ATTEMPTS = 3
local RELEASE_SAVE_MAX_ATTEMPTS = 3
local REQUEST_BUDGET_TIMEOUT_SECONDS = 10
local RECEIPT_PROFILE_WAIT_SECONDS = 20
local SHUTDOWN_TIMEOUT_SECONDS = 25

local MAX_CASH = 1e15
local MAX_REBIRTHS = 1e9
local MAX_PURCHASE_HISTORY = 100
local MAX_PURCHASE_ID_LENGTH = 128

-- In Studio without "Enable Studio Access to API Services", DataStores throw.
-- When true, Studio players get default data that is never saved instead of
-- being kicked. Live servers always kick when data cannot be loaded.
local ALLOW_UNSAVED_STUDIO_SESSIONS = true

-- Product IDs, game pass IDs and reward amounts live in the shared config so
-- the client shop uses the same values. Clients cannot change the server's copy.
local MonetizationConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MonetizationConfig"))
local ExtrasConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ExtrasConfig"))

local PRODUCT_IDS = MonetizationConfig.ProductIds
local SMALL_CASH_BUNDLE_AMOUNT = MonetizationConfig.SmallCashBundleAmount
local MEDIUM_CASH_BUNDLE_AMOUNT = MonetizationConfig.MediumCashBundleAmount
local LASER_BYPASS_DURATION_SECONDS = MonetizationConfig.LaserBypassDurationSeconds
local SERVER_RARITY_BOOST_DURATION_SECONDS = MonetizationConfig.ServerRarityBoostDurationSeconds
local SERVER_RARITY_BOOST_MULTIPLIER = MonetizationConfig.ServerRarityBoostMultiplier

-- Game passes whose ownership is tracked in OwnedGamePasses; names are used for
-- attributes and the server API.
local GAME_PASSES: { [string]: number } = MonetizationConfig.GamePasses

-- Brainrots a player owns, saved as a list of brainrot IDs.
local MAX_BRAINROTS = 64
-- "Id:Mutation:Trait:Hat:LevelSeconds"
local MAX_BRAINROT_ID_LENGTH = 96
-- Uncollected Cash on each collect pad, and owned gear IDs.
local MAX_PADS = 64
local MAX_GEAR = 32
local MAX_GEAR_ID_LENGTH = 32
-- Uses left of each Robux troll item.
local MAX_ITEM_CHARGES = 10000
local ITEM_CHARGES: { [string]: number } = MonetizationConfig.ItemCharges
-- Progress limits: top-level keys, nesting, entries per table, text length.
local MAX_PROGRESS_KEYS = 48
local MAX_PROGRESS_DEPTH = 4
local MAX_PROGRESS_ENTRIES = 512
local MAX_PROGRESS_STRING = 64
-- Robux lucky blocks and gifts waiting for a free pedestal.
local MAX_PENDING = 50

-- Delays before each ownership check after a game pass purchase prompt closes.
local GAME_PASS_VERIFY_DELAYS: { number } = { 0, 2, 5, 10 }

--------------------------------------------------------------------------------
-- Types
--------------------------------------------------------------------------------

type PlayerData = {
	Cash: number,
	Rebirths: number,
	Steals: number,
	OwnedGamePasses: { [string]: boolean },
	Brainrots: { string },
	PadCash: { number },
	Gear: { string },
	Items: { [string]: number },
	Progress: { [string]: any },
	PurchaseHistory: { string },
}

type SessionLock = {
	JobId: string,
	SessionId: string,
	LockedAt: number,
}

type SaveRecord = {
	SchemaVersion: number,
	Data: PlayerData,
	SessionLock: SessionLock?,
	LastSavedAt: number,
}

-- Loading   : DataStore read / lock acquisition in progress
-- Active    : loaded and locked; saves and purchases allowed
-- Unsaved   : Studio fallback with default data; nothing is ever written
-- Releasing : final save in progress
-- Released  : finished; no further reads or writes
type ProfileState = "Loading" | "Active" | "Unsaved" | "Releasing" | "Released"

type Profile = {
	Player: Player,
	UserId: number,
	Key: string,
	SessionId: string,
	State: ProfileState,
	Data: PlayerData,
	PlayerLeft: boolean,
	LockLost: boolean,
	MutexLocked: boolean,
	UnsavedPurchaseIds: { [string]: boolean },
	-- Seconds between the previous session's last save and this load.
	OfflineSeconds: number,
	CashValue: IntValue?,
	RebirthsValue: IntValue?,
	StealsValue: IntValue?,
}

type LoadResult = "Loaded" | "Failed" | "Aborted"

type ProductHandler = (profile: Profile) -> boolean

--------------------------------------------------------------------------------
-- State
--------------------------------------------------------------------------------

local profiles: { [Player]: Profile } = {}
local laserBypassEndsAt: { [Player]: number } = {}
local serverRarityBoostEndsAt = 0
local isShuttingDown = false

local gamePassNamesById: { [number]: string } = {}
for passName, passId in GAME_PASSES do
	gamePassNamesById[passId] = passName
end

local playerDataStore: DataStore? = nil
do
	local ok, result = pcall(function(): DataStore
		return DataStoreService:GetDataStore(DATA_STORE_NAME)
	end)
	if ok then
		playerDataStore = result
	else
		warn(string.format("%s Could not open DataStore '%s': %s", LOG_PREFIX, DATA_STORE_NAME, tostring(result)))
	end
end

--------------------------------------------------------------------------------
-- Server API instances (ServerStorage is invisible to clients)
--------------------------------------------------------------------------------

local apiFolder = Instance.new("Folder")
apiFolder.Name = "DataAndMonetization"

local function createBindableEvent(name: string): BindableEvent
	local bindable = Instance.new("BindableEvent")
	bindable.Name = name
	bindable.Parent = apiFolder
	return bindable
end

local empLaserPurchasedEvent = createBindableEvent("EMPLaserOverriderPurchased")
local empLaserExpiredEvent = createBindableEvent("EMPLaserOverriderExpired")
local serverRarityBoostChangedEvent = createBindableEvent("ServerRarityBoostChanged")
local gamePassOwnershipChangedEvent = createBindableEvent("GamePassOwnershipChanged")
local itemsChangedEvent = createBindableEvent("ItemsChanged")
local progressChangedEvent = createBindableEvent("ProgressChanged")
local hatCrateOpenedEvent = createBindableEvent("HatCrateOpened")

ReplicatedStorage:SetAttribute("ServerRarityMultiplier", 1)
ReplicatedStorage:SetAttribute("ServerRarityBoostEndsAt", 0)

--------------------------------------------------------------------------------
-- Validation and sanitising
--------------------------------------------------------------------------------

local function isFiniteNumber(value: any): boolean
	return typeof(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function toWholeNumber(value: any, maxValue: number): number
	if not isFiniteNumber(value) then
		return 0
	end
	return math.clamp(math.floor(value), 0, maxValue)
end

local function asPlayer(value: any): Player?
	if typeof(value) == "Instance" and value:IsA("Player") then
		return value
	end
	return nil
end

local function createDefaultData(): PlayerData
	return {
		Cash = 0,
		Rebirths = 0,
		Steals = 0,
		OwnedGamePasses = {},
		Brainrots = {},
		PadCash = {},
		Gear = {},
		Items = {},
		Progress = {},
		PurchaseHistory = {},
	}
end

-- Copies a Progress value keeping only what a DataStore can hold: finite
-- numbers, short strings, booleans, and tables that are either arrays or
-- string-keyed, not too deep or too big. Anything else is dropped.
local function sanitizeProgressValue(value: any, depth: number): any
	local kind = typeof(value)
	if kind == "boolean" then
		return value
	elseif kind == "number" then
		return if isFiniteNumber(value) then math.clamp(value, -MAX_CASH, MAX_CASH) else nil
	elseif kind == "string" then
		return if #value <= MAX_PROGRESS_STRING then value else nil
	elseif kind ~= "table" or depth > MAX_PROGRESS_DEPTH then
		return nil
	end
	local copy: { [any]: any } = {}
	if value[1] ~= nil then
		for _, item in ipairs(value) do
			if #copy >= MAX_PROGRESS_ENTRIES then
				break
			end
			local clean = sanitizeProgressValue(item, depth + 1)
			if clean ~= nil then
				table.insert(copy, clean)
			end
		end
	else
		local count = 0
		for key, item in value do
			if typeof(key) == "string" and #key <= MAX_PROGRESS_STRING and count < MAX_PROGRESS_ENTRIES then
				local clean = sanitizeProgressValue(item, depth + 1)
				if clean ~= nil then
					copy[key] = clean
					count += 1
				end
			end
		end
	end
	return copy
end

local function isValidProgressKey(key: any): boolean
	return typeof(key) == "string" and #key > 0 and #key <= 32
end

local function sanitizeProgress(raw: any): { [string]: any }
	local progress: { [string]: any } = {}
	if typeof(raw) ~= "table" then
		return progress
	end
	local count = 0
	for key, value in raw do
		if isValidProgressKey(key) and count < MAX_PROGRESS_KEYS then
			local clean = sanitizeProgressValue(value, 1)
			if clean ~= nil then
				progress[key] = clean
				count += 1
			end
		end
	end
	return progress
end

local function isValidBrainrotId(value: any): boolean
	return typeof(value) == "string" and #value > 0 and #value <= MAX_BRAINROT_ID_LENGTH
end

local function sanitizeBrainrotIds(raw: any): { string }
	local brainrotIds: { string } = {}
	if typeof(raw) == "table" then
		for _, brainrotId in ipairs(raw) do
			if #brainrotIds >= MAX_BRAINROTS then
				break
			end
			if isValidBrainrotId(brainrotId) then
				table.insert(brainrotIds, brainrotId)
			end
		end
	end
	return brainrotIds
end

local function isValidGearId(value: any): boolean
	return typeof(value) == "string" and #value > 0 and #value <= MAX_GEAR_ID_LENGTH
end

local function sanitizeGear(raw: any): { string }
	local gear: { string } = {}
	if typeof(raw) == "table" then
		for _, gearId in ipairs(raw) do
			if #gear >= MAX_GEAR then
				break
			end
			if isValidGearId(gearId) and table.find(gear, gearId) == nil then
				table.insert(gear, gearId)
			end
		end
	end
	return gear
end

local function sanitizeItems(raw: any): { [string]: number }
	local items: { [string]: number } = {}
	if typeof(raw) == "table" then
		for itemId, charges in raw do
			if typeof(itemId) == "string" and ITEM_CHARGES[itemId] ~= nil then
				local count = toWholeNumber(charges, MAX_ITEM_CHARGES)
				if count > 0 then
					items[itemId] = count
				end
			end
		end
	end
	return items
end

local function sanitizePadCash(raw: any): { number }
	local padCash: { number } = {}
	if typeof(raw) == "table" then
		for _, amount in ipairs(raw) do
			if #padCash >= MAX_PADS then
				break
			end
			table.insert(padCash, toWholeNumber(amount, MAX_CASH))
		end
	end
	return padCash
end

-- Accepts only a contiguous array of at most MAX_PADS finite, non-negative numbers.
local function validatePadCash(raw: any): { number }?
	if typeof(raw) ~= "table" then
		return nil
	end
	local count = 0
	for index, amount in raw do
		count += 1
		if typeof(index) ~= "number" or not isFiniteNumber(amount) or amount < 0 then
			return nil
		end
	end
	if count > MAX_PADS then
		return nil
	end
	local padCash: { number } = table.create(count)
	for index = 1, count do
		local amount = raw[index]
		if amount == nil then
			return nil
		end
		padCash[index] = toWholeNumber(amount, MAX_CASH)
	end
	return padCash
end

local function sanitizeData(raw: any): PlayerData
	if typeof(raw) ~= "table" then
		return createDefaultData()
	end

	local ownedGamePasses: { [string]: boolean } = {}
	local rawPasses = raw.OwnedGamePasses
	if typeof(rawPasses) == "table" then
		for passKey, owned in rawPasses do
			if typeof(passKey) == "string" and #passKey <= 32 and typeof(owned) == "boolean" then
				ownedGamePasses[passKey] = owned
			end
		end
	end

	local purchaseHistory: { string } = {}
	local rawHistory = raw.PurchaseHistory
	if typeof(rawHistory) == "table" then
		for _, purchaseId in ipairs(rawHistory) do
			if typeof(purchaseId) == "string" and #purchaseId > 0 and #purchaseId <= MAX_PURCHASE_ID_LENGTH then
				table.insert(purchaseHistory, purchaseId)
			end
		end
	end
	while #purchaseHistory > MAX_PURCHASE_HISTORY do
		table.remove(purchaseHistory, 1)
	end

	return {
		Cash = toWholeNumber(raw.Cash, MAX_CASH),
		Rebirths = toWholeNumber(raw.Rebirths, MAX_REBIRTHS),
		Steals = toWholeNumber(raw.Steals, MAX_REBIRTHS),
		OwnedGamePasses = ownedGamePasses,
		Brainrots = sanitizeBrainrotIds(raw.Brainrots),
		PadCash = sanitizePadCash(raw.PadCash),
		Gear = sanitizeGear(raw.Gear),
		Items = sanitizeItems(raw.Items),
		Progress = sanitizeProgress(raw.Progress),
		PurchaseHistory = purchaseHistory,
	}
end

local function sanitizeLock(raw: any): SessionLock?
	if typeof(raw) ~= "table" then
		return nil
	end
	if typeof(raw.JobId) ~= "string" or typeof(raw.SessionId) ~= "string" or not isFiniteNumber(raw.LockedAt) then
		return nil
	end
	return {
		JobId = raw.JobId,
		SessionId = raw.SessionId,
		LockedAt = raw.LockedAt,
	}
end

local function sanitizeRecord(raw: any): SaveRecord
	if typeof(raw) ~= "table" then
		return {
			SchemaVersion = SCHEMA_VERSION,
			Data = createDefaultData(),
			SessionLock = nil,
			LastSavedAt = 0,
		}
	end
	return {
		SchemaVersion = SCHEMA_VERSION,
		Data = sanitizeData(raw.Data),
		SessionLock = sanitizeLock(raw.SessionLock),
		LastSavedAt = if isFiniteNumber(raw.LastSavedAt) then raw.LastSavedAt else 0,
	}
end

local function copyDataForSave(data: PlayerData): PlayerData
	return {
		Cash = data.Cash,
		Rebirths = data.Rebirths,
		Steals = data.Steals,
		OwnedGamePasses = table.clone(data.OwnedGamePasses),
		Brainrots = table.clone(data.Brainrots),
		PadCash = table.clone(data.PadCash),
		Gear = table.clone(data.Gear),
		Items = table.clone(data.Items),
		-- Already clean; this deep-copies it.
		Progress = sanitizeProgress(data.Progress),
		PurchaseHistory = table.clone(data.PurchaseHistory),
	}
end

--------------------------------------------------------------------------------
-- Profile helpers
--------------------------------------------------------------------------------

local function isUsable(profile: Profile): boolean
	return profile.State == "Active" or profile.State == "Unsaved"
end

local function getUsableProfile(player: Player): Profile?
	local profile = profiles[player]
	if profile and isUsable(profile) then
		return profile
	end
	return nil
end

-- Serialises every yielding operation (saves, receipts, release) per profile.
local function acquireProfileMutex(profile: Profile)
	while profile.MutexLocked do
		task.wait()
	end
	profile.MutexLocked = true
end

local function releaseProfileMutex(profile: Profile)
	profile.MutexLocked = false
end

local function setCash(profile: Profile, amount: number)
	local sanitized = toWholeNumber(amount, MAX_CASH)
	profile.Data.Cash = sanitized
	local cashValue = profile.CashValue
	if cashValue and cashValue.Value ~= sanitized then
		cashValue.Value = sanitized
	end
end

local function setRebirths(profile: Profile, amount: number)
	local sanitized = toWholeNumber(amount, MAX_REBIRTHS)
	profile.Data.Rebirths = sanitized
	local rebirthsValue = profile.RebirthsValue
	if rebirthsValue and rebirthsValue.Value ~= sanitized then
		rebirthsValue.Value = sanitized
	end
end

local function setSteals(profile: Profile, amount: number)
	local sanitized = toWholeNumber(amount, MAX_REBIRTHS)
	profile.Data.Steals = sanitized
	local stealsValue = profile.StealsValue
	if stealsValue and stealsValue.Value ~= sanitized then
		stealsValue.Value = sanitized
	end
end

local function addCash(profile: Profile, amount: number): boolean
	if not isFiniteNumber(amount) or amount <= 0 then
		return false
	end
	setCash(profile, profile.Data.Cash + math.floor(amount))
	return true
end

local function spendCash(profile: Profile, amount: number): boolean
	if not isFiniteNumber(amount) or amount <= 0 then
		return false
	end
	local cost = math.ceil(amount)
	if profile.Data.Cash < cost then
		return false
	end
	setCash(profile, profile.Data.Cash - cost)
	return true
end

local function addRebirths(profile: Profile, amount: number): boolean
	if not isFiniteNumber(amount) or amount <= 0 then
		return false
	end
	setRebirths(profile, profile.Data.Rebirths + math.floor(amount))
	return true
end

local function setGamePassOwned(profile: Profile, passId: number, owned: boolean)
	local passKey = tostring(passId)
	local wasOwned = profile.Data.OwnedGamePasses[passKey] == true
	profile.Data.OwnedGamePasses[passKey] = owned

	local passName = gamePassNamesById[passId]
	if passName then
		profile.Player:SetAttribute("OwnsGamePass_" .. passName, owned)
		if wasOwned ~= owned then
			gamePassOwnershipChangedEvent:Fire(profile.Player, passName, owned)
		end
	end
end

local function hasProcessedPurchase(profile: Profile, purchaseId: string): boolean
	return table.find(profile.Data.PurchaseHistory, purchaseId) ~= nil
end

local function recordPurchase(profile: Profile, purchaseId: string)
	local history = profile.Data.PurchaseHistory
	table.insert(history, purchaseId)
	while #history > MAX_PURCHASE_HISTORY do
		table.remove(history, 1)
	end
	profile.UnsavedPurchaseIds[purchaseId] = true
end

local function snapshotProfiles(): { Profile }
	local list: { Profile } = {}
	for _, profile in profiles do
		table.insert(list, profile)
	end
	return list
end

--------------------------------------------------------------------------------
-- DataStore access
--------------------------------------------------------------------------------

local function waitForRequestBudget(requestType: Enum.DataStoreRequestType)
	local started = os.clock()
	while os.clock() - started < REQUEST_BUDGET_TIMEOUT_SECONDS do
		local ok, budget = pcall(function(): number
			return DataStoreService:GetRequestBudgetForRequestType(requestType)
		end)
		if not ok or budget > 0 then
			return
		end
		task.wait(0.5)
	end
end

local function getGdprUserIds(profile: Profile): { number }?
	-- Associates the key with the user for Roblox's right-to-erasure tooling.
	-- Local Studio test players have non-positive UserIds, which are rejected.
	if profile.UserId > 0 then
		return { profile.UserId }
	end
	return nil
end

local function onSessionLockLost(profile: Profile)
	if profile.LockLost then
		return
	end
	profile.LockLost = true
	profile.State = "Released"
	warn(string.format("%s Session lock for %d was taken by another server; this session will no longer save.", LOG_PREFIX, profile.UserId))
	task.defer(function()
		if profile.Player.Parent == Players then
			profile.Player:Kick("Your data was opened on another server. Please rejoin.")
		end
	end)
end

-- Caller must hold the profile mutex.
local function saveProfileAsync(profile: Profile, releaseLock: boolean, maxAttempts: number): boolean
	local store = playerDataStore
	if store == nil or profile.LockLost then
		return false
	end

	for attempt = 1, maxAttempts do
		waitForRequestBudget(Enum.DataStoreRequestType.UpdateAsync)

		local lockLost = false
		local writtenRecord: SaveRecord? = nil

		local ok, err = pcall(function()
			store:UpdateAsync(profile.Key, function(oldValue: any): (any, { number }?)
				lockLost = false
				writtenRecord = nil

				local currentLock = if typeof(oldValue) == "table" then sanitizeLock(oldValue.SessionLock) else nil
				if currentLock == nil or currentLock.SessionId ~= profile.SessionId then
					lockLost = true
					return nil, nil
				end

				local now = os.time()
				local record: SaveRecord = {
					SchemaVersion = SCHEMA_VERSION,
					Data = copyDataForSave(profile.Data),
					SessionLock = if releaseLock
						then nil
						else { JobId = game.JobId, SessionId = profile.SessionId, LockedAt = now },
					LastSavedAt = now,
				}
				writtenRecord = record
				return record, getGdprUserIds(profile)
			end)
		end)

		if ok then
			if lockLost then
				onSessionLockLost(profile)
				return false
			end
			local savedRecord = writtenRecord
			if savedRecord then
				for _, purchaseId in savedRecord.Data.PurchaseHistory do
					profile.UnsavedPurchaseIds[purchaseId] = nil
				end
				return true
			end
			warn(string.format("%s Save for %d returned without writing (attempt %d/%d).", LOG_PREFIX, profile.UserId, attempt, maxAttempts))
		else
			warn(string.format("%s Save for %d failed (attempt %d/%d): %s", LOG_PREFIX, profile.UserId, attempt, maxAttempts, tostring(err)))
		end

		if attempt < maxAttempts then
			task.wait(2 ^ (attempt - 1))
		end
	end

	return false
end

local function loadProfileAsync(profile: Profile): LoadResult
	local store = playerDataStore
	if store == nil then
		return "Failed"
	end

	local failedAttempts = 0
	local lockRetries = 0

	while true do
		if profile.PlayerLeft then
			return "Aborted"
		end

		-- After waiting long enough for the previous server to save and release,
		-- take the lock. That server's saves are rejected from then on, so its
		-- unsaved progress is dropped rather than duplicated.
		local forceSteal = lockRetries >= SESSION_LOCK_MAX_RETRIES
		local blockedByLock = false
		local loadedRecord: SaveRecord? = nil
		local offlineSeconds = 0

		waitForRequestBudget(Enum.DataStoreRequestType.UpdateAsync)

		local ok, err = pcall(function()
			store:UpdateAsync(profile.Key, function(oldValue: any): (any, { number }?)
				blockedByLock = false
				loadedRecord = nil
				offlineSeconds = 0

				local record = sanitizeRecord(oldValue)
				local now = os.time()
				local existingLock = record.SessionLock
				if
					existingLock
					and existingLock.SessionId ~= profile.SessionId
					and now - existingLock.LockedAt < SESSION_LOCK_STALE_SECONDS
					and not forceSteal
				then
					blockedByLock = true
					return nil, nil
				end

				-- Offline time runs from the previous session's last save.
				if record.LastSavedAt > 0 then
					offlineSeconds = math.max(0, now - record.LastSavedAt)
				end
				record.SessionLock = { JobId = game.JobId, SessionId = profile.SessionId, LockedAt = now }
				record.LastSavedAt = now
				loadedRecord = record
				return record, getGdprUserIds(profile)
			end)
		end)

		local record = loadedRecord
		if ok and record then
			if forceSteal then
				warn(string.format("%s Took over a session lock for %d that was not released in time.", LOG_PREFIX, profile.UserId))
			end
			profile.Data = record.Data
			profile.OfflineSeconds = offlineSeconds
			return "Loaded"
		elseif ok and blockedByLock then
			lockRetries += 1
			task.wait(SESSION_LOCK_RETRY_SECONDS)
		else
			failedAttempts += 1
			local maxAttempts = if RunService:IsStudio() then STUDIO_LOAD_MAX_ATTEMPTS else LOAD_MAX_ATTEMPTS
			warn(string.format("%s Load for %d failed (attempt %d/%d): %s", LOG_PREFIX, profile.UserId, failedAttempts, maxAttempts, tostring(err)))
			if failedAttempts >= maxAttempts then
				return "Failed"
			end
			task.wait(2 ^ (failedAttempts - 1))
		end
	end
end

local function releaseProfileAsync(profile: Profile)
	profile.PlayerLeft = true
	if profile.State == "Loading" then
		-- The loader sees PlayerLeft and releases the lock once it has it.
		return
	end

	acquireProfileMutex(profile)
	local ok, err = pcall(function()
		if profile.State == "Active" then
			profile.State = "Releasing"
			if not saveProfileAsync(profile, true, RELEASE_SAVE_MAX_ATTEMPTS) then
				warn(string.format("%s Final save for %d failed; the next server will take over the lock.", LOG_PREFIX, profile.UserId))
			end
		end
		profile.State = "Released"
	end)
	releaseProfileMutex(profile)

	if not ok then
		profile.State = "Released"
		warn(string.format("%s Error while releasing %d: %s", LOG_PREFIX, profile.UserId, tostring(err)))
	end
	if profiles[profile.Player] == profile then
		profiles[profile.Player] = nil
	end
end

local function autosaveProfileAsync(profile: Profile)
	acquireProfileMutex(profile)
	local ok, err = pcall(function()
		if profile.State == "Active" then
			saveProfileAsync(profile, false, AUTOSAVE_MAX_ATTEMPTS)
		end
	end)
	releaseProfileMutex(profile)
	if not ok then
		warn(string.format("%s Autosave error for %d: %s", LOG_PREFIX, profile.UserId, tostring(err)))
	end
end

--------------------------------------------------------------------------------
-- Game passes
--------------------------------------------------------------------------------

local function checkGamePassOwnershipAsync(userId: number, passId: number): boolean?
	-- A placeholder ID is some other creator's pass: owning that doesn't count.
	if not MonetizationConfig.isSetUp(passId) then
		return false
	end
	local ok, result = pcall(function(): boolean
		return MarketplaceService:UserOwnsGamePassAsync(userId, passId)
	end)
	if ok then
		return result == true
	end
	warn(string.format("%s UserOwnsGamePassAsync(%d, %d) failed: %s", LOG_PREFIX, userId, passId, tostring(result)))
	return nil
end

local function syncGamePassesAsync(profile: Profile)
	for _, passId in GAME_PASSES do
		local owned = checkGamePassOwnershipAsync(profile.UserId, passId)
		if not isUsable(profile) then
			return
		end
		if owned == nil then
			-- API unavailable: fall back to the ownership saved from a verified check.
			owned = profile.Data.OwnedGamePasses[tostring(passId)] == true
		end
		setGamePassOwned(profile, passId, owned == true)
	end
end

local function onGamePassPurchaseFinished(player: Player, passId: number, wasPurchased: boolean)
	if not wasPurchased or typeof(passId) ~= "number" or gamePassNamesById[passId] == nil then
		return
	end

	for _, delaySeconds in GAME_PASS_VERIFY_DELAYS do
		if delaySeconds > 0 then
			task.wait(delaySeconds)
		end
		if player.Parent ~= Players then
			return
		end
		if checkGamePassOwnershipAsync(player.UserId, passId) == true then
			local profile = getUsableProfile(player)
			if profile then
				setGamePassOwned(profile, passId, true)
			end
			return
		end
	end

	warn(string.format("%s Could not verify game pass %d for %d; ownership will sync on next join.", LOG_PREFIX, passId, player.UserId))
end

--------------------------------------------------------------------------------
-- Timed purchase effects
--------------------------------------------------------------------------------

local function isLaserBypassActive(player: Player): boolean
	local endsAt = laserBypassEndsAt[player]
	return endsAt ~= nil and Workspace:GetServerTimeNow() < endsAt
end

local function activateLaserBypass(player: Player): boolean
	local now = Workspace:GetServerTimeNow()
	local currentEnd = laserBypassEndsAt[player]
	local startFrom = if currentEnd and currentEnd > now then currentEnd else now
	local endsAt = startFrom + LASER_BYPASS_DURATION_SECONDS

	laserBypassEndsAt[player] = endsAt
	player:SetAttribute("LaserBypassEndsAt", endsAt)
	empLaserPurchasedEvent:Fire(player, LASER_BYPASS_DURATION_SECONDS, endsAt)

	task.delay(endsAt - now, function()
		-- A later purchase extends the timer and schedules its own expiry.
		if laserBypassEndsAt[player] ~= endsAt then
			return
		end
		laserBypassEndsAt[player] = nil
		if player.Parent == Players then
			player:SetAttribute("LaserBypassEndsAt", nil)
			empLaserExpiredEvent:Fire(player)
		end
	end)

	return true
end

local function getServerRarityMultiplier(): number
	if Workspace:GetServerTimeNow() < serverRarityBoostEndsAt then
		return SERVER_RARITY_BOOST_MULTIPLIER
	end
	return 1
end

local function activateServerRarityBoost(purchaser: Player): boolean
	local now = Workspace:GetServerTimeNow()
	local endsAt = math.max(serverRarityBoostEndsAt, now) + SERVER_RARITY_BOOST_DURATION_SECONDS
	serverRarityBoostEndsAt = endsAt

	ReplicatedStorage:SetAttribute("ServerRarityMultiplier", SERVER_RARITY_BOOST_MULTIPLIER)
	ReplicatedStorage:SetAttribute("ServerRarityBoostEndsAt", endsAt)
	serverRarityBoostChangedEvent:Fire(SERVER_RARITY_BOOST_MULTIPLIER, endsAt, purchaser)

	task.delay(endsAt - now, function()
		if serverRarityBoostEndsAt ~= endsAt then
			return
		end
		ReplicatedStorage:SetAttribute("ServerRarityMultiplier", 1)
		ReplicatedStorage:SetAttribute("ServerRarityBoostEndsAt", 0)
		serverRarityBoostChangedEvent:Fire(1, 0, nil)
	end)

	return true
end

--------------------------------------------------------------------------------
-- Developer products
--------------------------------------------------------------------------------

-- Adds uses of a troll item; the tools are handed out by GearManager.
local function addItemCharges(profile: Profile, itemId: string): boolean
	local charges = ITEM_CHARGES[itemId]
	if charges == nil then
		return false
	end
	local items = profile.Data.Items
	items[itemId] = math.min((items[itemId] or 0) + charges, MAX_ITEM_CHARGES)
	task.defer(function()
		itemsChangedEvent:Fire(profile.Player)
	end)
	return true
end

local function progressChanged(profile: Profile, key: string)
	task.defer(function()
		progressChangedEvent:Fire(profile.Player, key)
	end)
end

-- Cash Boost ends at an os.time(); clients get it in server time.
local function refreshCashBoostAttribute(profile: Profile)
	local endsAt = tonumber(profile.Data.Progress.CashBoostEndsAt) or 0
	local left = endsAt - os.time()
	profile.Player:SetAttribute("CashBoostEndsAt", if left > 0 then Workspace:GetServerTimeNow() + left else 0)
end

local function addCashBoost(profile: Profile, seconds: number): boolean
	local progress = profile.Data.Progress
	local endsAt = math.max(tonumber(progress.CashBoostEndsAt) or 0, os.time())
	progress.CashBoostEndsAt = endsAt + seconds
	refreshCashBoostAttribute(profile)
	progressChanged(profile, "CashBoostEndsAt")
	return true
end

-- A lucky block (or any brainrot entry) waiting for a free pedestal;
-- GameplayManager places it.
local function addPending(profile: Profile, entry: string): boolean
	local progress = profile.Data.Progress
	local pending = if typeof(progress.Pending) == "table" then progress.Pending else {}
	if #pending >= MAX_PENDING then
		return false
	end
	table.insert(pending, entry)
	progress.Pending = pending
	progressChanged(profile, "Pending")
	return true
end

local function addExtraSpins(profile: Profile, count: number): boolean
	local progress = profile.Data.Progress
	local spins = if typeof(progress.Spins) == "table" then progress.Spins else {}
	spins.Extra = math.clamp((tonumber(spins.Extra) or 0) + count, 0, 10000)
	progress.Spins = spins
	progressChanged(profile, "Spins")
	return true
end

local function grantSkin(profile: Profile, skin: string): boolean
	local progress = profile.Data.Progress
	local skins = if typeof(progress.Skins) == "table" then progress.Skins else {}
	local owned = if typeof(skins.Owned) == "table" then skins.Owned else {}
	if table.find(owned, skin) == nil then
		table.insert(owned, skin)
	end
	skins.Owned = owned
	skins.Equipped = skin
	progress.Skins = skins
	progressChanged(profile, "Skins")
	return true
end

-- Hats a player owns, by name (ExtrasConfig.Hats).
local MAX_HATS_EACH = 999

local function addHat(profile: Profile, hatName: string, count: number): string?
	if hatName == "Random" then
		hatName = ExtrasConfig.randomHat(math.random()).Name
	end
	if ExtrasConfig.HatByName[hatName] == nil or count < 1 then
		return nil
	end
	local progress = profile.Data.Progress
	local hats = if typeof(progress.Hats) == "table" then progress.Hats else {}
	hats[hatName] = math.clamp((tonumber(hats[hatName]) or 0) + math.floor(count), 0, MAX_HATS_EACH)
	progress.Hats = hats
	progressChanged(profile, "Hats")
	return hatName
end

-- This season's XP; a new season starts from 0.
local function getSeason(profile: Profile): { Id: number, XP: number }
	local seasonId = ExtrasConfig.season(os.time())
	local progress = profile.Data.Progress
	local saved = progress.Season
	if typeof(saved) ~= "table" or saved.Id ~= seasonId then
		saved = { Id = seasonId, XP = 0 }
		progress.Season = saved
	end
	saved.XP = math.max(0, tonumber(saved.XP) or 0)
	return saved
end

local function addSeasonXP(profile: Profile, amount: number): number
	local season = getSeason(profile)
	local cap = ExtrasConfig.TierXP * ExtrasConfig.SeasonTierCount
	season.XP = math.min(cap, season.XP + math.max(0, amount))
	progressChanged(profile, "Season")
	return season.XP
end

local PRODUCT_HANDLERS: { [number]: ProductHandler } = {
	[PRODUCT_IDS.SmallCashBundle] = function(profile: Profile): boolean
		return addCash(profile, SMALL_CASH_BUNDLE_AMOUNT)
	end,
	[PRODUCT_IDS.MediumCashBundle] = function(profile: Profile): boolean
		return addCash(profile, MEDIUM_CASH_BUNDLE_AMOUNT)
	end,
	[PRODUCT_IDS.EMPLaserOverrider] = function(profile: Profile): boolean
		return activateLaserBypass(profile.Player)
	end,
	[PRODUCT_IDS.ServerRarityBoost] = function(profile: Profile): boolean
		return activateServerRarityBoost(profile.Player)
	end,
	[PRODUCT_IDS.SpinPack] = function(profile: Profile): boolean
		return addExtraSpins(profile, MonetizationConfig.SpinPackSpins)
	end,
	[PRODUCT_IDS.CashBoost] = function(profile: Profile): boolean
		return addCashBoost(profile, MonetizationConfig.CashBoostSeconds)
	end,
	[PRODUCT_IDS.HatCrate] = function(profile: Profile): boolean
		local hatName = addHat(profile, "Random", 1)
		if hatName == nil then
			return false
		end
		task.defer(function()
			hatCrateOpenedEvent:Fire(profile.Player, hatName)
		end)
		return true
	end,
	[PRODUCT_IDS.SeasonTierSkip] = function(profile: Profile): boolean
		addSeasonXP(profile, ExtrasConfig.TierXP)
		return true
	end,
}
-- Each weekly limited brainrot has its own product, so a purchase always
-- gives the brainrot that was on sale when it was bought.
for _, limited in ExtrasConfig.LimitedRotation do
	local productId = PRODUCT_IDS[limited.Product]
	if productId then
		PRODUCT_HANDLERS[productId] = function(profile: Profile): boolean
			return addPending(profile, limited.Id)
		end
	end
end
for productKey, blockId in MonetizationConfig.LuckyBlockProducts do
	local productId = PRODUCT_IDS[productKey]
	if productId then
		PRODUCT_HANDLERS[productId] = function(profile: Profile): boolean
			return addPending(profile, blockId)
		end
	end
end
for productKey, skin in MonetizationConfig.SkinProducts do
	local productId = PRODUCT_IDS[productKey]
	if productId then
		PRODUCT_HANDLERS[productId] = function(profile: Profile): boolean
			return grantSkin(profile, skin)
		end
	end
end
for itemId in ITEM_CHARGES do
	local productId = PRODUCT_IDS[itemId]
	if productId then
		PRODUCT_HANDLERS[productId] = function(profile: Profile): boolean
			return addItemCharges(profile, itemId)
		end
	end
end

local function waitForActiveProfileAsync(player: Player, timeoutSeconds: number): Profile?
	local started = os.clock()
	while player.Parent == Players and os.clock() - started < timeoutSeconds do
		local profile = profiles[player]
		if profile then
			if profile.State == "Active" then
				return profile
			elseif profile.State ~= "Loading" then
				return nil
			end
		end
		task.wait(0.25)
	end
	return nil
end

local function processReceipt(receiptInfo: { [string]: any }): Enum.ProductPurchaseDecision
	local notProcessed = Enum.ProductPurchaseDecision.NotProcessedYet

	local playerId = receiptInfo.PlayerId
	local productId = receiptInfo.ProductId
	local purchaseId = receiptInfo.PurchaseId
	if
		typeof(playerId) ~= "number"
		or typeof(productId) ~= "number"
		or typeof(purchaseId) ~= "string"
		or #purchaseId == 0
		or #purchaseId > MAX_PURCHASE_ID_LENGTH
	then
		warn(string.format("%s Rejected malformed receipt.", LOG_PREFIX))
		return notProcessed
	end

	local handler = PRODUCT_HANDLERS[productId]
	if handler == nil then
		warn(string.format("%s No handler for product %d (purchase %s); leaving it unprocessed.", LOG_PREFIX, productId, purchaseId))
		return notProcessed
	end

	-- Roblox retries unprocessed receipts the next time the player joins.
	local player = Players:GetPlayerByUserId(playerId)
	if player == nil then
		return notProcessed
	end

	local profile = waitForActiveProfileAsync(player, RECEIPT_PROFILE_WAIT_SECONDS)
	if profile == nil then
		return notProcessed
	end

	acquireProfileMutex(profile)
	local ok, result = pcall(function(): Enum.ProductPurchaseDecision
		if profile.State ~= "Active" then
			return notProcessed
		end

		-- The reward and its PurchaseId are applied together, so a retry of a
		-- receipt that is already in the history only needs the save confirmed.
		if not hasProcessedPurchase(profile, purchaseId) then
			if not handler(profile) then
				warn(string.format("%s Handler for product %d declined purchase %s.", LOG_PREFIX, productId, purchaseId))
				return notProcessed
			end
			recordPurchase(profile, purchaseId)
		end

		if profile.UnsavedPurchaseIds[purchaseId] then
			saveProfileAsync(profile, false, RECEIPT_SAVE_MAX_ATTEMPTS)
		end

		if profile.UnsavedPurchaseIds[purchaseId] then
			return notProcessed
		end
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end)
	releaseProfileMutex(profile)

	if not ok then
		warn(string.format("%s Error processing purchase %s: %s", LOG_PREFIX, purchaseId, tostring(result)))
		return notProcessed
	end

	local decision: Enum.ProductPurchaseDecision = result
	if decision == Enum.ProductPurchaseDecision.PurchaseGranted then
		print(string.format("%s Granted product %d to %d (purchase %s).", LOG_PREFIX, productId, playerId, purchaseId))
	end
	return decision
end

--------------------------------------------------------------------------------
-- Leaderstats
--------------------------------------------------------------------------------

local function createLeaderstats(profile: Profile)
	local player = profile.Player
	local existing = player:FindFirstChild("leaderstats")
	if existing then
		existing:Destroy()
	end

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local cashValue = Instance.new("IntValue")
	cashValue.Name = "Cash"
	cashValue.Value = profile.Data.Cash
	cashValue.Parent = leaderstats

	local stealsValue = Instance.new("IntValue")
	stealsValue.Name = "Steals"
	stealsValue.Value = profile.Data.Steals
	stealsValue.Parent = leaderstats

	local rebirthsValue = Instance.new("IntValue")
	rebirthsValue.Name = "Rebirths"
	rebirthsValue.Value = profile.Data.Rebirths
	rebirthsValue.Parent = leaderstats

	profile.CashValue = cashValue
	profile.RebirthsValue = rebirthsValue
	profile.StealsValue = stealsValue

	-- Server scripts may also write these values directly; client-side edits
	-- never replicate, so only trusted server changes reach these handlers.
	cashValue.Changed:Connect(function(newValue: number)
		if isUsable(profile) and newValue ~= profile.Data.Cash then
			setCash(profile, newValue)
		end
	end)
	rebirthsValue.Changed:Connect(function(newValue: number)
		if isUsable(profile) and newValue ~= profile.Data.Rebirths then
			setRebirths(profile, newValue)
		end
	end)
	stealsValue.Changed:Connect(function(newValue: number)
		if isUsable(profile) and newValue ~= profile.Data.Steals then
			setSteals(profile, newValue)
		end
	end)

	leaderstats.Parent = player
end

--------------------------------------------------------------------------------
-- Player lifecycle
--------------------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	if profiles[player] then
		return
	end

	local profile: Profile = {
		Player = player,
		UserId = player.UserId,
		Key = DATA_KEY_PREFIX .. tostring(player.UserId),
		SessionId = HttpService:GenerateGUID(false),
		State = "Loading",
		Data = createDefaultData(),
		PlayerLeft = false,
		LockLost = false,
		MutexLocked = false,
		UnsavedPurchaseIds = {},
		OfflineSeconds = 0,
		CashValue = nil,
		RebirthsValue = nil,
		StealsValue = nil,
	}
	profiles[player] = profile

	local result = loadProfileAsync(profile)

	if result == "Aborted" then
		profile.State = "Released"
		profiles[player] = nil
		return
	elseif result == "Loaded" then
		profile.State = "Active"
		if profile.PlayerLeft or player.Parent ~= Players or isShuttingDown then
			releaseProfileAsync(profile)
			return
		end
	elseif ALLOW_UNSAVED_STUDIO_SESSIONS and RunService:IsStudio() then
		warn(string.format("%s Studio: using unsaved default data for %s. Enable Studio API access to test saving and purchases.", LOG_PREFIX, player.Name))
		profile.State = "Unsaved"
		profile.Data = createDefaultData()
		profile.OfflineSeconds = 0
		if profile.PlayerLeft then
			profile.State = "Released"
			profiles[player] = nil
			return
		end
	else
		profile.State = "Released"
		profiles[player] = nil
		player:Kick("We couldn't load your data. Please rejoin in a moment.")
		return
	end

	createLeaderstats(profile)
	refreshCashBoostAttribute(profile)
	player:SetAttribute("DataLoaded", true)
	task.spawn(syncGamePassesAsync, profile)
end

local function onPlayerRemoving(player: Player)
	laserBypassEndsAt[player] = nil
	local profile = profiles[player]
	if profile then
		releaseProfileAsync(profile)
	end
end

--------------------------------------------------------------------------------
-- Server API
--------------------------------------------------------------------------------

local function createBindableFunction(name: string, callback: (...any) -> ...any)
	local bindable = Instance.new("BindableFunction")
	bindable.Name = name
	bindable.OnInvoke = callback
	bindable.Parent = apiFolder
end

createBindableFunction("AddCash", function(playerArg: any, amount: any): boolean
	local player = asPlayer(playerArg)
	local profile = if player then getUsableProfile(player) else nil
	return profile ~= nil and addCash(profile, amount)
end)

createBindableFunction("SpendCash", function(playerArg: any, amount: any): boolean
	local player = asPlayer(playerArg)
	local profile = if player then getUsableProfile(player) else nil
	return profile ~= nil and spendCash(profile, amount)
end)

createBindableFunction("AddRebirths", function(playerArg: any, amount: any): boolean
	local player = asPlayer(playerArg)
	local profile = if player then getUsableProfile(player) else nil
	return profile ~= nil and addRebirths(profile, amount)
end)

createBindableFunction("AddSteals", function(playerArg: any, amount: any): boolean
	local player = asPlayer(playerArg)
	local profile = if player then getUsableProfile(player) else nil
	if profile == nil or not isFiniteNumber(amount) or amount <= 0 then
		return false
	end
	setSteals(profile, profile.Data.Steals + math.floor(amount))
	return true
end)

createBindableFunction("GetPlayerData", function(playerArg: any): { [string]: any }?
	local player = asPlayer(playerArg)
	local profile = if player then getUsableProfile(player) else nil
	if profile == nil then
		return nil
	end
	return {
		Cash = profile.Data.Cash,
		Rebirths = profile.Data.Rebirths,
		Steals = profile.Data.Steals,
		OwnedGamePasses = table.clone(profile.Data.OwnedGamePasses),
	}
end)

createBindableFunction("GetBrainrots", function(playerArg: any): { string }?
	local player = asPlayer(playerArg)
	local profile = if player then getUsableProfile(player) else nil
	if profile == nil then
		return nil
	end
	return table.clone(profile.Data.Brainrots)
end)

createBindableFunction("SetBrainrots", function(playerArg: any, brainrotIds: any): boolean
	local player = asPlayer(playerArg)
	local profile = if player then getUsableProfile(player) else nil
	if profile == nil or typeof(brainrotIds) ~= "table" then
		return false
	end
	-- Accept only a contiguous array of valid IDs.
	local count = 0
	for index, brainrotId in brainrotIds do
		count += 1
		if typeof(index) ~= "number" or not isValidBrainrotId(brainrotId) then
			return false
		end
	end
	if count > MAX_BRAINROTS then
		return false
	end
	local validated: { string } = table.create(count)
	for index = 1, count do
		local brainrotId = brainrotIds[index]
		if brainrotId == nil then
			return false
		end
		validated[index] = brainrotId
	end
	profile.Data.Brainrots = validated
	return true
end)

createBindableFunction("GetPadCash", function(playerArg: any): { number }?
	local player = asPlayer(playerArg)
	local profile = if player then getUsableProfile(player) else nil
	if profile == nil then
		return nil
	end
	return table.clone(profile.Data.PadCash)
end)

createBindableFunction("SetPadCash", function(playerArg: any, padCash: any): boolean
	local player = asPlayer(playerArg)
	local profile = if player then getUsableProfile(player) else nil
	local validated = validatePadCash(padCash)
	if profile == nil or validated == nil then
		return false
	end
	profile.Data.PadCash = validated
	return true
end)

-- Moves Cash from the pads to the player in one step, so a save can never
-- contain both the collected Cash and the pad it came from.
createBindableFunction("CollectPadCash", function(playerArg: any, amount: any, padCashLeft: any): boolean
	local player = asPlayer(playerArg)
	local profile = if player then getUsableProfile(player) else nil
	local validated = validatePadCash(padCashLeft)
	if profile == nil or validated == nil or not isFiniteNumber(amount) or amount <= 0 then
		return false
	end
	if not addCash(profile, amount) then
		return false
	end
	profile.Data.PadCash = validated
	return true
end)

-- Returns how long the player was offline before this session, once.
createBindableFunction("TakeOfflineSeconds", function(playerArg: any): number
	local player = asPlayer(playerArg)
	local profile = if player then getUsableProfile(player) else nil
	if profile == nil then
		return 0
	end
	local seconds = profile.OfflineSeconds
	profile.OfflineSeconds = 0
	return seconds
end)

createBindableFunction("GetGear", function(playerArg: any): { string }?
	local player = asPlayer(playerArg)
	local profile = if player then getUsableProfile(player) else nil
	if profile == nil then
		return nil
	end
	return table.clone(profile.Data.Gear)
end)

createBindableFunction("AddGear", function(playerArg: any, gearId: any): boolean
	local player = asPlayer(playerArg)
	local profile = if player then getUsableProfile(player) else nil
	if profile == nil or not isValidGearId(gearId) then
		return false
	end
	local gear = profile.Data.Gear
	if table.find(gear, gearId) then
		return true
	end
	if #gear >= MAX_GEAR then
		return false
	end
	table.insert(gear, gearId)
	return true
end)

createBindableFunction("GetItems", function(playerArg: any): { [string]: number }?
	local player = asPlayer(playerArg)
	local profile = if player then getUsableProfile(player) else nil
	if profile == nil then
		return nil
	end
	return table.clone(profile.Data.Items)
end)

-- Uses one charge of a troll item. Returns false when there is none left.
createBindableFunction("UseItemCharge", function(playerArg: any, itemId: any): boolean
	local player = asPlayer(playerArg)
	local profile = if player then getUsableProfile(player) else nil
	if profile == nil or typeof(itemId) ~= "string" then
		return false
	end
	local items = profile.Data.Items
	local charges = items[itemId]
	if charges == nil or charges <= 0 then
		return false
	end
	if charges > 1 then
		items[itemId] = charges - 1
	else
		items[itemId] = nil
	end
	return true
end)

createBindableFunction("OwnsGamePass", function(playerArg: any, gamePass: any): boolean
	local player = asPlayer(playerArg)
	local profile = if player then getUsableProfile(player) else nil
	if profile == nil then
		return false
	end
	local passId: number? = if typeof(gamePass) == "number"
		then gamePass
		elseif typeof(gamePass) == "string" then GAME_PASSES[gamePass]
		else nil
	return passId ~= nil and profile.Data.OwnedGamePasses[tostring(passId)] == true
end)

createBindableFunction("IsLaserBypassActive", function(playerArg: any): boolean
	local player = asPlayer(playerArg)
	return player ~= nil and isLaserBypassActive(player)
end)

createBindableFunction("GetServerRarityMultiplier", function(): number
	return getServerRarityMultiplier()
end)

createBindableFunction("GetProgress", function(playerArg: any, key: any): any
	local player = asPlayer(playerArg)
	local profile = if player then getUsableProfile(player) else nil
	if profile == nil or not isValidProgressKey(key) then
		return nil
	end
	-- A copy, so callers can't change saved data by accident.
	return sanitizeProgressValue(profile.Data.Progress[key], 1)
end)

createBindableFunction("SetProgress", function(playerArg: any, key: any, value: any): boolean
	local player = asPlayer(playerArg)
	local profile = if player then getUsableProfile(player) else nil
	if profile == nil or not isValidProgressKey(key) then
		return false
	end
	local progress = profile.Data.Progress
	if progress[key] == nil and value ~= nil then
		local count = 0
		for _ in progress do
			count += 1
		end
		if count >= MAX_PROGRESS_KEYS then
			return false
		end
	end
	progress[key] = if value == nil then nil else sanitizeProgressValue(value, 1)
	if key == "CashBoostEndsAt" then
		refreshCashBoostAttribute(profile)
	end
	progressChanged(profile, key)
	return true
end)

createBindableFunction("GetHats", function(playerArg: any): { [string]: number }?
	local player = asPlayer(playerArg)
	local profile = if player then getUsableProfile(player) else nil
	if profile == nil then
		return nil
	end
	local hats: { [string]: number } = {}
	local saved = profile.Data.Progress.Hats
	if typeof(saved) == "table" then
		for hatName, count in saved do
			if typeof(hatName) == "string" and ExtrasConfig.HatByName[hatName] and (tonumber(count) or 0) > 0 then
				hats[hatName] = tonumber(count) :: number
			end
		end
	end
	return hats
end)

createBindableFunction("AddHat", function(playerArg: any, hatName: any, count: any): string?
	local player = asPlayer(playerArg)
	local profile = if player then getUsableProfile(player) else nil
	if profile == nil or typeof(hatName) ~= "string" then
		return nil
	end
	return addHat(profile, hatName, math.clamp(math.floor(tonumber(count) or 1), 1, MAX_HATS_EACH))
end)

createBindableFunction("TakeHat", function(playerArg: any, hatName: any): boolean
	local player = asPlayer(playerArg)
	local profile = if player then getUsableProfile(player) else nil
	if profile == nil or typeof(hatName) ~= "string" then
		return false
	end
	local hats = profile.Data.Progress.Hats
	local have = if typeof(hats) == "table" then tonumber(hats[hatName]) or 0 else 0
	if have < 1 then
		return false
	end
	hats[hatName] = if have > 1 then have - 1 else nil
	progressChanged(profile, "Hats")
	return true
end)

createBindableFunction("GetSeason", function(playerArg: any): { Id: number, XP: number }?
	local player = asPlayer(playerArg)
	local profile = if player then getUsableProfile(player) else nil
	if profile == nil then
		return nil
	end
	local season = getSeason(profile)
	return { Id = season.Id, XP = season.XP }
end)

createBindableFunction("AddSeasonXP", function(playerArg: any, amount: any): number?
	local player = asPlayer(playerArg)
	local profile = if player then getUsableProfile(player) else nil
	if profile == nil or not isFiniteNumber(amount) then
		return nil
	end
	return addSeasonXP(profile, math.clamp(amount, 0, 100000))
end)

createBindableFunction("SaveNow", function(playerArg: any)
	local player = asPlayer(playerArg)
	local profile = if player then profiles[player] else nil
	if profile and profile.State == "Active" then
		task.spawn(autosaveProfileAsync, profile)
	end
end)

-- Parent last so WaitForChild("DataAndMonetization") implies every child exists.
apiFolder.Parent = ServerStorage

--------------------------------------------------------------------------------
-- Wiring
--------------------------------------------------------------------------------

MarketplaceService.ProcessReceipt = processReceipt
MarketplaceService.PromptGamePassPurchaseFinished:Connect(onGamePassPurchaseFinished)

-- Robux items still on a placeholder ID can't be bought yet (their Buy
-- buttons say so): say which, so they're easy to set up.
do
	local missing = MonetizationConfig.notSetUp()
	if #missing > 0 then
		warn(
			string.format(
				"%s %d Robux items still have placeholder IDs, so they can't be bought yet: %s. Create them in the Creator Dashboard (your experience > Monetization > Developer Products / Passes) and paste their IDs into ReplicatedStorage > Shared > MonetizationConfig.",
				LOG_PREFIX,
				#missing,
				table.concat(missing, ", ")
			)
		)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

task.spawn(function()
	while not isShuttingDown do
		task.wait(AUTOSAVE_INTERVAL_SECONDS)
		if isShuttingDown then
			break
		end
		for _, profile in snapshotProfiles() do
			if isShuttingDown then
				break
			end
			if profile.State == "Active" then
				task.spawn(autosaveProfileAsync, profile)
				task.wait(AUTOSAVE_STAGGER_SECONDS)
			end
		end
	end
end)

game:BindToClose(function()
	isShuttingDown = true
	for _, profile in snapshotProfiles() do
		task.spawn(releaseProfileAsync, profile)
	end

	local started = os.clock()
	while next(profiles) ~= nil and os.clock() - started < SHUTDOWN_TIMEOUT_SECONDS do
		task.wait(0.1)
	end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="284">
      <Properties>
        <string name="Name">FuseManager</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
	FuseManager
	Location: ServerScriptService (Script)

	The Fuse Machine (Workspace.Map.FuseMachine): stand at it and put in
	FeatureConfig.FuseCount brainrots of the same rarity from your base; out
	comes a random brainrot of the next rarity up. If all of them share a
	mutation, the new one keeps it. Lucky blocks and Secrets can't be fused.

	Remote (ReplicatedStorage.Remotes):
	  Fuse  RemoteFunction ({ slot, slot, slot }) -> (ok, message, resultEntry?)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BrainrotConfig = require(Shared:WaitForChild("BrainrotConfig"))
local FeatureConfig = require(Shared:WaitForChild("FeatureConfig"))

local FUSE_COOLDOWN_SECONDS = 1.5
-- How close to the machine you have to be.
local MACHINE_REACH = 24

local gameplayApi = ServerStorage:WaitForChild("Gameplay")
local describeSlotsFunction = gameplayApi:WaitForChild("DescribeSlots") :: BindableFunction
local takeBrainrotsFunction = gameplayApi:WaitForChild("TakeBrainrots") :: BindableFunction
local giveBrainrotFunction = gameplayApi:WaitForChild("GiveBrainrot") :: BindableFunction
local activityEvent = gameplayApi:WaitForChild("Activity") :: BindableEvent

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local fuseFunction = Instance.new("RemoteFunction")
fuseFunction.Name = "Fuse"

local rng = Random.new()
local lastFuse: { [Player]: number } = {}

local function machinePosition(): Vector3?
	local map = Workspace:FindFirstChild("Map")
	local machine = if map then map:FindFirstChild("FuseMachine") else nil
	local counter = if machine then machine:FindFirstChild("Counter") else nil
	return if counter and counter:IsA("BasePart") then counter.Position else nil
end

local function isNearMachine(player: Player): boolean
	local position = machinePosition()
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	return position ~= nil and root ~= nil and root:IsA("BasePart") and (root.Position - position).Magnitude <= MACHINE_REACH
end

local function nextRarity(rarityName: string): string?
	for index, rarity in BrainrotConfig.Rarities do
		if rarity.Name == rarityName then
			local following = BrainrotConfig.Rarities[index + 1]
			return if following then following.Name else nil
		end
	end
	return nil
end

-- What these entries fuse into, or why they can't be fused.
local function fuseResult(entries: { string }): (string?, string?)
	local rarity: string? = nil
	local mutationName: string? = nil
	local sameMutation = true
	for index, entry in entries do
		local definition, mutation = BrainrotConfig.decode(entry)
		if definition == nil or BrainrotConfig.isLuckyBlock(definition) then
			return nil, "Lucky blocks can't be fused. Open them first!"
		end
		if rarity == nil then
			rarity = definition.Rarity
		elseif rarity ~= definition.Rarity then
			return nil, "They all need to be the same rarity."
		end
		local name = if mutation then mutation.Name else nil
		if index == 1 then
			mutationName = name
		elseif name ~= mutationName then
			sameMutation = false
		end
	end
	local target = if rarity then nextRarity(rarity) else nil
	local choices = if target then BrainrotConfig.DropsByRarity[target] else nil
	if choices == nil or #choices == 0 then
		return nil, "Secrets and OGs are already the best. They can't be fused!"
	end
	local definition = choices[rng:NextInteger(1, #choices)]
	return BrainrotConfig.encode(definition.Id, if sameMutation then mutationName else nil), nil
end

fuseFunction.OnServerInvoke = function(player: Player, slots: any): (boolean, string?, string?)
	if player:GetAttribute("DataLoaded") ~= true or typeof(slots) ~= "table" then
		return false, nil, nil
	end
	local now = os.clock()
	if now - (lastFuse[player] or 0) < FUSE_COOLDOWN_SECONDS then
		return false, "The machine is still cooling down!", nil
	end
	if #slots ~= FeatureConfig.FuseCount then
		return false, string.format("Pick %d brainrots to fuse.", FeatureConfig.FuseCount), nil
	end
	if not isNearMachine(player) then
		return false, "Stand at the Fuse Machine to fuse.", nil
	end
	local entries = describeSlotsFunction:Invoke(player, slots)
	if typeof(entries) ~= "table" or #entries ~= #slots then
		return false, "Only brainrots sitting in your base can be fused.", nil
	end
	local result, problem = fuseResult(entries)
	if result == nil then
		return false, problem, nil
	end
	lastFuse[player] = now

	-- Take all three, then hand over the result (it lands on a freed pedestal).
	local taken = takeBrainrotsFunction:Invoke(player, slots)
	if typeof(taken) ~= "table" then
		return false, "Something changed, try again.", nil
	end
	if giveBrainrotFunction:Invoke(player, result) == nil then
		-- Couldn't place it: give the originals back.
		for _, entry in taken do
			giveBrainrotFunction:Invoke(player, entry)
		end
		return false, "Something went wrong, your brainrots are back.", nil
	end
	activityEvent:Fire(player, "Fuse", 1)
	local definition, mutation = BrainrotConfig.decode(result)
	local name = if definition then BrainrotConfig.fullName(definition, mutation, nil) else "???"
	return true, string.format("FUSED! You got %s!", name), result
end

Players.PlayerRemoving:Connect(function(player: Player)
	lastFuse[player] = nil
end)

fuseFunction.Parent = remotes
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="285">
      <Properties>
        <string name="Name">GameplayManager</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
	GameplayManager
	Location: ServerScriptService (Script)

	Runs the Snatch the Brainrot loop on the server:
	  * gives each player one of the bases in Workspace.Map.Plots
	  * spawns brainrots on the conveyor (rarer ones more often during a Server
	    Rarity Boost, one mutation far more often during a mutation event) that
	    players buy with Cash
	  * a bought brainrot walks from the conveyor to its buyer's base; until it
	    reaches the door, anyone else can buy it off them (the first buyer gets
	    their Cash back) and it turns around to walk to the new owner's base
	  * brainrots on their pedestals fill the collect pad in front of them with
	    Cash; the owner steps on the pad to collect it. Uncollected Cash is saved,
	    and brainrots keep earning while their owner is offline
	  * brainrots can be sold or stolen; a slapped thief drops what they carry
	  * each base has a laser door its owner can lock; the EMP Laser Overrider
	    lets its buyer walk through any locked door
	  * rebirths reset Cash (and the pads) for a permanent income bonus and open
	    the next floor of the base (4 floors of 8 pedestals)
	  * events every few minutes: mutation events (Gold Rush, Blood Moon, ...),
	    Taco Tuesday, Lucky Hour and Cash Rain (coins to collect), and now and
	    then ADMIN ABUSE (everything at once; admins can start it with /abuse)
	  * lucky blocks turn up on the conveyor (or are bought with Robux); their
	    owner opens them in their base for a random brainrot
	  * traits (Fire, Tiny, Giant, Glitched, Nyan) roll like mutations and
	    stack with them
	  * the Index: finding every brainrot of a rarity (or every Gold, Diamond
	    or Rainbow one) pays out and adds a permanent income bonus
	  * pedestal upgrades, base skins, income boosts (Cash Boost, friends,
	    Premium, group, Index), the base alarm, the Long Lock pass, and
	    brainrots each rebirth needs

	Every decision is made here. Clients only press ProximityPrompts and call the
	RequestRebirth remote, and each request is re-checked on the server
	(ownership, distance, Cash, free slots). Cash and saved data go through the
	DataAndMonetizationManager API in ServerStorage.

	Client-facing state:
	  ReplicatedStorage.Remotes.Notify (RemoteEvent, server -> client: message, kind, sound?)
	  ReplicatedStorage.Remotes.PlaySound (RemoteEvent, server -> client: sound)
	  ReplicatedStorage.Remotes.RequestRebirth (RemoteFunction)
	  Player attributes IncomePerSecond (number), Carrying (boolean)
	  Plot model attributes OwnerUserId (number, 0 = empty), LockEndsAt (server time)
	  ReplicatedStorage attributes EventName, EventMutation, EventEndsAt, EventSky,
	    EventParticles (the running event)
	  Workspace.Map.Coins (Cash Rain coins, attribute Spin for the client)
	  Brainrot model attributes BrainrotId, State, OwnerUserId, ...
	  ProximityPrompt attributes PromptKind ("Buy" | "Steal" | "Sell" | "Snipe"),
	    OwnerUserId, Carried, Walking, Snipeable (used by the client to hide
	    prompts that do not apply)

	  ReplicatedStorage.Remotes.LuckyReveal (server -> all clients:
	    ownerUserId, blockId, resultEntry, position)
	  ReplicatedStorage.Remotes.BaseAlarm (server -> victim: thief or nil, name)
	  Player attributes IncomeMultiplier, BoostInfo, Discovered ("," list)
	  Plot model attributes Alarm, Skin, SkinEffect; slot attribute Level
	  Brainrot model attributes Trait, Slot, LuckyBlock

	Server API for other scripts (ServerStorage.Gameplay):
	  BindableEvent    ForceDrop(player, message?, catcher?)  a thief drops their brainrot
	  BindableEvent    Activity(player, kind, amount)  for quests, badges and the
	    tutorial: Buy, BuyEpic, Steal, Collect, OpenBlock, Lock, Upgrade,
	    Catch, Fuse, Trade, Rebirth, Slap, Spin, Secret
	  BindableFunction GiveBrainrot(player, entry) -> "Placed" | "Pending" | nil
	  BindableFunction TakeBrainrots(player, slots) -> { entry }?  (for fusing)
	  BindableFunction TradeBrainrots(playerA, slotsA, playerB, slotsB) -> boolean
	  BindableFunction DescribeSlots(player, slots) -> { entry }?  (what's there)
	  BindableFunction GetIncome(player) -> number
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local BrainrotConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("BrainrotConfig"))
local ExtrasConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ExtrasConfig"))
local FeatureConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("FeatureConfig"))
local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))
local MonetizationConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MonetizationConfig"))
local NumberFormat = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("NumberFormat"))

local LOG_PREFIX = "[GameplayManager]"

-- Fixed numbers and look-up tables live in Tuning, and the objects this
-- script makes in Api, rather than in locals of their own: Studio compiles
-- scripts with full debug info, which allows only 200 locals at the top level
-- of a script, and this one is big.
local Tuning = {}

-- Height of a carried brainrot's feet above the thief's HumanoidRootPart.
Tuning.CARRY_HEIGHT = 3.2
-- Height in studs of a brainrot with Scale 1.
Tuning.FIGURE_HEIGHT = 5.2
Tuning.FAST_TICK_SECONDS = 0.1
Tuning.SLOW_TICK_SECONDS = 1
Tuning.REBIRTH_REQUEST_COOLDOWN_SECONDS = 1
-- Walking brainrots walk beside the conveyor this far from the carpet's end.
Tuning.LANE_INSET = 3
-- The pad in front of a pedestal, and the walkway between pads and door.
Tuning.PAD_OFFSET = 5.5
Tuning.PAD_REACH = 1
-- How far from the stairs a walking brainrot steps off onto the floor above.
Tuning.STAIR_EXIT_OFFSET = 4.75

--------------------------------------------------------------------------------
-- Types
--------------------------------------------------------------------------------

type Definition = BrainrotConfig.Brainrot
type Mutation = BrainrotConfig.Mutation
type Trait = BrainrotConfig.Trait
type NotifyKind = "Info" | "Success" | "Warning" | "Error"

type Visual = {
	Model: Model,
	Root: BasePart,
	PromptAttachment: Attachment,
	PriceLabel: TextLabel?,
	OwnerLabel: TextLabel?,
	IncomeLabel: TextLabel?,
}

type Pad = {
	Part: BasePart,
	Billboard: BillboardGui,
	Amount: TextLabel,
	Tag: TextLabel,
}

type Plot = {
	Index: number,
	Model: Model,
	Floor: BasePart,
	Interior: BasePart,
	LaserZone: BasePart,
	Carpet: BasePart?,
	Lasers: { BasePart },
	SpawnPoint: BasePart,
	Slots: { BasePart },
	Pads: { [number]: Pad },
	-- Uncollected Cash on each slot's pad (fractions carry over).
	PadCash: { number },
	OfflinePads: { [number]: boolean },
	Occupants: { [number]: Occupant },
	Reserved: { [number]: boolean },
	-- Stairs from floor N up to floor N + 1, and signs on locked floors.
	Stairs: { [number]: Stair },
	FloorSigns: { [number]: TextLabel },
	UnlockedFloors: number,
	-- Pedestal upgrade level of each slot (1 = not upgraded) and its glow ring.
	Levels: { number },
	LevelRings: { [number]: BasePart },
	-- Parts a base skin recolours, with their original look.
	SkinParts: { SkinPart },
	Owner: Player?,
	LockEndsAt: number,
	SignTitle: TextLabel,
	SignSubtitle: TextLabel,
	LockLabel: TextLabel,
}

type Walk = {
	-- Where to walk, with the height of the floor at each point. Between two
	-- points the height follows a straight line (up the stairs too), and a
	-- short ray only fine-tunes it onto each step, so a lag spike can never
	-- drop a brainrot onto the wrong floor.
	Points: { Vector3 },
	-- Start of the stretch it's walking now.
	Last: Vector3,
	Index: number,
	-- Reaching this point means it walked through its owner's door.
	DoorIndex: number,
	Entered: boolean,
	Speed: number,
	Height: number,
}

type SkinPart = { Part: BasePart, Kind: string, Color: Color3, Material: Enum.Material }

type Occupant = {
	Definition: Definition,
	Mutation: Mutation?,
	Trait: Trait?,
	Plot: Plot,
	SlotIndex: number,
	Model: Model,
	Root: BasePart,
	PromptAttachment: Attachment,
	StealPrompt: ProximityPrompt,
	SellPrompt: ProximityPrompt,
	SnipePrompt: ProximityPrompt?,
	UpgradePrompt: ProximityPrompt?,
	-- A lucky block being opened saves as what it will become.
	OpeningResult: string?,
	-- What its owner paid; the price for anyone buying it off them.
	Price: number,
	Walk: Walk?,
	Sniping: boolean,
	Carrier: Player?,
	PriceLabel: TextLabel?,
	OwnerLabel: TextLabel?,
	-- The hat it wears (ExtrasConfig.Hats) and how long it has been levelling
	-- up; both are saved with it (BrainrotConfig.encodeFull).
	Hat: string?,
	Seconds: number,
	IncomeLabel: TextLabel?,
	LevelLabel: TextLabel?,
}

type Carry = {
	Thief: Player,
	Occupant: Occupant,
	VictimPlot: Plot,
	TargetPlot: Plot,
	TargetSlot: number,
	StartedAt: number,
	LastPosition: Vector3,
	LastCheckedAt: number,
	Weld: WeldConstraint,
}

type ConveyorItem = {
	Definition: Definition,
	Mutation: Mutation?,
	Trait: Trait?,
	Price: number,
	Model: Model,
	Root: BasePart,
	PromptAttachment: Attachment,
	Tween: Tween,
	Sold: boolean,
}

type GameEvent = GameConfig.GameEvent

type Stair = { Bottom: Vector3, Top: Vector3 }

--------------------------------------------------------------------------------
-- Data API (ServerStorage.DataAndMonetization)
--------------------------------------------------------------------------------

-- Handles to the DataAndMonetization API, in one table to keep the number of
-- locals in this script down (Luau allows 200).
local DataApi: { [string]: any } = {}
do
	local folder = ServerStorage:WaitForChild("DataAndMonetization")
	for _, name in
		{
			"AddCash",
			"SpendCash",
			"AddRebirths",
			"AddSteals",
			"GetPlayerData",
			"GetBrainrots",
			"SetBrainrots",
			"GetPadCash",
			"SetPadCash",
			"CollectPadCash",
			"TakeOfflineSeconds",
			"IsLaserBypassActive",
			"GetServerRarityMultiplier",
			"GetProgress",
			"SetProgress",
			"GetHats",
			"AddHat",
			"TakeHat",
			"OwnsGamePass",
			"SaveNow",
			"ProgressChanged",
			"EMPLaserOverriderPurchased",
			"ServerRarityBoostChanged",
		}
	do
		DataApi[name] = folder:WaitForChild(name)
	end
end

local function addCash(player: Player, amount: number): boolean
	return DataApi.AddCash:Invoke(player, amount) == true
end

local function spendCash(player: Player, amount: number): boolean
	return DataApi.SpendCash:Invoke(player, amount) == true
end

local function getPlayerData(player: Player): { [string]: any }?
	local data = DataApi.GetPlayerData:Invoke(player)
	return if typeof(data) == "table" then data else nil
end

local function getProgress(player: Player, key: string): any
	return DataApi.GetProgress:Invoke(player, key)
end

local function setProgress(player: Player, key: string, value: any): boolean
	return DataApi.SetProgress:Invoke(player, key, value) == true
end

--------------------------------------------------------------------------------
-- Remotes and server API
--------------------------------------------------------------------------------

local Api = {}
Api.remotesFolder = Instance.new("Folder")
Api.remotesFolder.Name = "Remotes"

Api.notifyEvent = Instance.new("RemoteEvent")
Api.notifyEvent.Name = "Notify"
Api.notifyEvent.Parent = Api.remotesFolder

Api.playSoundEvent = Instance.new("RemoteEvent")
Api.playSoundEvent.Name = "PlaySound"
Api.playSoundEvent.Parent = Api.remotesFolder

Api.requestRebirthFunction = Instance.new("RemoteFunction")
Api.requestRebirthFunction.Name = "RequestRebirth"
Api.requestRebirthFunction.Parent = Api.remotesFolder

Api.luckyRevealEvent = Instance.new("RemoteEvent")
Api.luckyRevealEvent.Name = "LuckyReveal"
Api.luckyRevealEvent.Parent = Api.remotesFolder

Api.baseAlarmEvent = Instance.new("RemoteEvent")
Api.baseAlarmEvent.Name = "BaseAlarm"
Api.baseAlarmEvent.Parent = Api.remotesFolder

-- The client passes chat commands on too, in case the server doesn't hear them.
Api.chatCommandEvent = Instance.new("RemoteEvent")
Api.chatCommandEvent.Name = "ChatCommand"
Api.chatCommandEvent.Parent = Api.remotesFolder

Api.remotesFolder.Parent = ReplicatedStorage

-- Parented to ServerStorage once every function is set (see the end).
Api.gameplayApi = Instance.new("Folder")
Api.gameplayApi.Name = "Gameplay"
Api.forceDropEvent = Instance.new("BindableEvent")
Api.forceDropEvent.Name = "ForceDrop"
Api.forceDropEvent.Parent = Api.gameplayApi
Api.activityEvent = Instance.new("BindableEvent")
Api.activityEvent.Name = "Activity"
Api.activityEvent.Parent = Api.gameplayApi

local function reportActivity(player: Player, kind: string, amount: number?)
	Api.activityEvent:Fire(player, kind, amount or 1)
end

-- `sound` names an entry in AudioConfig.Sounds for the client to play.
local function notify(player: Player, message: string, kind: NotifyKind, sound: string?)
	Api.notifyEvent:FireClient(player, message, kind, sound)
end

local function playSound(player: Player, sound: string)
	Api.playSoundEvent:FireClient(player, sound)
end

--------------------------------------------------------------------------------
-- State
--------------------------------------------------------------------------------

local map = Workspace:WaitForChild("Map")
local plotsFolder = map:WaitForChild("Plots")
local conveyorFolder = map:WaitForChild("Conveyor")
local conveyorStart = conveyorFolder:WaitForChild("ConveyorStart") :: BasePart
local conveyorEnd = conveyorFolder:WaitForChild("ConveyorEnd") :: BasePart

local brainrotsFolder = Instance.new("Folder")
brainrotsFolder.Name = "Brainrots"
brainrotsFolder.Parent = map

local plots: { Plot } = {}
local plotByPlayer: { [Player]: Plot } = {}
local carries: { [Player]: Carry } = {}
local conveyorItems: { [ConveyorItem]: boolean } = {}
local conveyorItemCount = 0
local walkers: { [Occupant]: boolean } = {}
local lastRebirthRequest: { [Player]: number } = {}
local rng = Random.new()
local nextGuaranteedAt: { [string]: number } = {}
for _, rule in GameConfig.GuaranteedRarities do
	nextGuaranteedAt[rule.Rarity] = Workspace:GetServerTimeNow() + rule.IntervalSeconds
end
local activeEvent: GameEvent? = nil
local coinsFolder = Instance.new("Folder")
coinsFolder.Name = "Coins"
coinsFolder.Parent = map

-- Walking brainrots follow the ground: the baseplate, the conveyor and the bases.
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include
do
	local ground: { Instance } = { plotsFolder }
	local belt = conveyorFolder:FindFirstChild("Belt")
	if belt then
		table.insert(ground, belt)
	end
	local baseplate = Workspace:FindFirstChild("Baseplate")
	if baseplate then
		table.insert(ground, baseplate)
	end
	groundParams.FilterDescendantsInstances = ground
end

--------------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------------

local function getLiveCharacter(player: Player): (BasePart?, Humanoid?)
	local character = player.Character
	if character == nil then
		return nil, nil
	end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if rootPart == nil or not rootPart:IsA("BasePart") or humanoid == nil or humanoid.Health <= 0 then
		return nil, nil
	end
	return rootPart, humanoid
end

local function isPlayerNear(player: Player, position: Vector3): boolean
	local rootPart = getLiveCharacter(player)
	return rootPart ~= nil
		and (rootPart.Position - position).Magnitude <= GameConfig.PromptDistance + GameConfig.InteractionTolerance
end

local function isInsidePart(part: BasePart, position: Vector3): boolean
	local localPosition = part.CFrame:PointToObjectSpace(position)
	local halfSize = part.Size / 2
	return math.abs(localPosition.X) <= halfSize.X
		and math.abs(localPosition.Y) <= halfSize.Y
		and math.abs(localPosition.Z) <= halfSize.Z
end

local function isLocked(plot: Plot): boolean
	return Workspace:GetServerTimeNow() < plot.LockEndsAt
end

local function floorOf(slotIndex: number): number
	return (slotIndex - 1) // GameConfig.SlotsPerFloor + 1
end

-- Free pedestals are only handed out on floors the owner has opened.
local function findFreeSlot(plot: Plot): number?
	local limit = math.min(#plot.Slots, plot.UnlockedFloors * GameConfig.SlotsPerFloor)
	for index = 1, limit do
		if plot.Occupants[index] == nil and not plot.Reserved[index] then
			return index
		end
	end
	return nil
end

local function getSlotCFrame(plot: Plot, slotIndex: number): CFrame
	local slot = plot.Slots[slotIndex]
	local top = slot.Position + Vector3.new(0, slot.Size.Y / 2, 0)
	return CFrame.new(top) * plot.Floor.CFrame.Rotation
end

local function priceOf(definition: Definition, mutation: Mutation?, trait: Trait?): number
	return math.floor(definition.Price * BrainrotConfig.multiplier(mutation, trait))
end

local function incomeOf(definition: Definition, mutation: Mutation?, trait: Trait?): number
	return definition.IncomePerSecond * BrainrotConfig.multiplier(mutation, trait)
end

local function fullName(definition: Definition, mutation: Mutation?, trait: Trait?): string
	return BrainrotConfig.fullName(definition, mutation, trait)
end

local function entryOf(definition: Definition, mutation: Mutation?, trait: Trait?): string
	return BrainrotConfig.encode(definition.Id, if mutation then mutation.Name else nil, if trait then trait.Name else nil)
end

local function occupantEntry(occupant: Occupant): string
	return occupant.OpeningResult or entryOf(occupant.Definition, occupant.Mutation, occupant.Trait)
end

-- What a base brainrot saves as: its entry plus its hat and level time.
local function savedEntry(occupant: Occupant): string
	if occupant.OpeningResult then
		return occupant.OpeningResult
	end
	return BrainrotConfig.encodeFull(
		occupant.Definition.Id,
		if occupant.Mutation then occupant.Mutation.Name else nil,
		if occupant.Trait then occupant.Trait.Name else nil,
		occupant.Hat,
		occupant.Seconds
	)
end

local function getBrainrotIds(plot: Plot): { string }
	local brainrotIds: { string } = {}
	for index = 1, #plot.Slots do
		local occupant = plot.Occupants[index]
		if occupant then
			table.insert(brainrotIds, savedEntry(occupant))
		end
	end
	return brainrotIds
end

-- What the pedestal under a slot adds to its brainrot's income.
local function pedestalMultiplier(plot: Plot, slotIndex: number): number
	return 1 + FeatureConfig.PedestalBonus * ((plot.Levels[slotIndex] or 1) - 1)
end

-- Everything a base brainrot earns per second before the player's own
-- multipliers: its income, the pedestal, its level and its hat.
local function occupantIncome(occupant: Occupant): number
	local hat = if occupant.Hat then ExtrasConfig.HatByName[occupant.Hat] else nil
	return incomeOf(occupant.Definition, occupant.Mutation, occupant.Trait)
		* pedestalMultiplier(occupant.Plot, occupant.SlotIndex)
		* ExtrasConfig.levelMultiplier(ExtrasConfig.levelOf(occupant.Seconds))
		* (1 + if hat then hat.Bonus else 0)
end

Api.slotsChangedEvent = Instance.new("BindableEvent")
Api.slotsChangedEvent.Name = "SlotsChanged"
Api.slotsChangedEvent.Parent = Api.gameplayApi
Api.stolenEvent = Instance.new("BindableEvent")
Api.stolenEvent.Name = "Stolen"
Api.stolenEvent.Parent = Api.gameplayApi

-- A brainrot leaving its base (sold, stolen, fused, traded) gives its hat
-- back to whoever owned it.
local function returnHat(occupant: Occupant, owner: Player?)
	local hatName = occupant.Hat
	occupant.Hat = nil
	if hatName and owner and owner.Parent == Players then
		DataApi.AddHat:Invoke(owner, hatName, 1)
	end
end

local function saveBrainrots(plot: Plot): boolean
	local owner = plot.Owner
	if owner == nil then
		return false
	end
	local saved = DataApi.SetBrainrots:Invoke(owner, getBrainrotIds(plot)) == true
	-- Guards, pets and the Manage menu follow what's in the base.
	Api.slotsChangedEvent:Fire(owner)
	return saved
end

-- Income boosts that add up: friends in the server, Premium, the group and
-- the Index. Filled in as players join and find brainrots.
local friendsOf: { [Player]: { [number]: boolean } } = {}
local inGroup: { [Player]: boolean } = {}
local indexBonus: { [Player]: number } = {}

local function percent(value: number): string
	return string.format("+%d%%", math.floor(value * 100 + 0.5))
end

local getIncomeMultiplier: (player: Player) -> (number, { string })
do
	local function friendBoost(player: Player): number
		local count = 0
		local friends = friendsOf[player]
		if friends then
			for _, other in Players:GetPlayers() do
				if other ~= player and friends[other.UserId] then
					count += 1
				end
			end
		end
		return math.min(count * FeatureConfig.FriendBoost, FeatureConfig.MaxFriendBoost)
	end

	local function isPremium(player: Player): boolean
		return player.MembershipType == Enum.MembershipType.Premium
	end

	-- Everything that multiplies a player's income, and a line per boost for
	-- the HUD.
	getIncomeMultiplier = function(player: Player): (number, { string })
		local info: { string } = {}
		local data = getPlayerData(player)
		if data == nil then
			return 1, info
		end
		local rebirths = tonumber(data.Rebirths) or 0
		local passes = data.OwnedGamePasses
		local doubleCashId = MonetizationConfig.GamePasses.DoubleCash
		local hasDoubleCash = doubleCashId ~= nil and typeof(passes) == "table" and passes[tostring(doubleCashId)] == true
		local rebirthMultiplier = GameConfig.getRebirthIncomeMultiplier(rebirths)
		local multiplier = rebirthMultiplier
		if rebirths > 0 then
			table.insert(info, string.format("Rebirth %d: x%s", rebirths, tostring(rebirthMultiplier)))
		end
		if hasDoubleCash then
			multiplier *= MonetizationConfig.DoubleCashIncomeMultiplier
			table.insert(info, "2x Cash pass: x2")
		end
		local vipId = MonetizationConfig.GamePasses.VIP
		local isVip = vipId ~= nil and typeof(passes) == "table" and passes[tostring(vipId)] == true
		local boostEndsAt = tonumber(player:GetAttribute("CashBoostEndsAt")) or 0
		if boostEndsAt > Workspace:GetServerTimeNow() then
			multiplier *= MonetizationConfig.CashBoostMultiplier
			table.insert(info, "Cash Boost: x" .. tostring(MonetizationConfig.CashBoostMultiplier))
		end
		local bonus = 0
		local friends = friendBoost(player)
		if friends > 0 then
			bonus += friends
			table.insert(info, "Friends: " .. percent(friends))
		end
		if isPremium(player) then
			bonus += FeatureConfig.PremiumBoost
			table.insert(info, "Premium: " .. percent(FeatureConfig.PremiumBoost))
		end
		if isVip then
			bonus += FeatureConfig.VipBoost
			table.insert(info, "VIP: " .. percent(FeatureConfig.VipBoost))
		end
		if inGroup[player] then
			bonus += FeatureConfig.GroupBoost
			table.insert(info, "Group: " .. percent(FeatureConfig.GroupBoost))
		end
		local index = indexBonus[player] or 0
		if index > 0 then
			bonus += index
			table.insert(info, "Index: " .. percent(index))
		end
		-- Crewmates in the server (SocialManager sets CrewBoost).
		local crew = math.clamp(tonumber(player:GetAttribute("CrewBoost")) or 0, 0, 0.5)
		if crew > 0 then
			bonus += crew
			table.insert(info, "Crew: " .. percent(crew))
		end
		return multiplier * (1 + bonus), info
	end
end

local function setCarrying(player: Player, carrying: boolean)
	local _, humanoid = getLiveCharacter(player)
	if humanoid then
		local level = math.clamp(tonumber(player:GetAttribute("SpeedLevel")) or 0, 0, #FeatureConfig.SpeedCosts)
		local bonus = ExtrasConfig.speedBonusOf(player)
		humanoid.WalkSpeed = bonus
			+ if carrying
				then GameConfig.CarryWalkSpeed + level * FeatureConfig.CarrySpeedPerLevel
				else GameConfig.DefaultWalkSpeed + level * FeatureConfig.SpeedPerLevel
	end
	-- GearManager listens to this to re-apply coils once the carry ends.
	player:SetAttribute("Carrying", carrying)
end

--------------------------------------------------------------------------------
-- Index: the brainrots (and mutated ones) each player has ever had
--------------------------------------------------------------------------------

local discovered: { [Player]: { [string]: boolean } } = {}

local refreshIndex: (player: Player) -> ()
local discover: (player: Player, definition: Definition, mutation: Mutation?) -> ()
-- Keys of a set, sorted (saved lists stay in a stable order).
local sortedKeys: (set: { [string]: boolean }) -> { string }
do
	sortedKeys = function(set: { [string]: boolean }): { string }
		local list: { string } = {}
		for key in set do
			table.insert(list, key)
		end
		table.sort(list)
		return list
	end

	local function rarityComplete(found: { [string]: boolean }, rarityName: string): boolean
		local choices = BrainrotConfig.DropsByRarity[rarityName]
		if choices == nil or #choices == 0 then
			return false
		end
		for _, definition in choices do
			if not found[definition.Id] then
				return false
			end
		end
		return true
	end

	local function mutationComplete(found: { [string]: boolean }, mutationName: string): boolean
		for _, definition in BrainrotConfig.Obtainable do
			if not found[definition.Id .. ":" .. mutationName] then
				return false
			end
		end
		return #BrainrotConfig.Obtainable > 0
	end

	-- Works out the Index income bonus and pays out pages finished for the first time.
	refreshIndex = function(player: Player)
		local found = discovered[player]
		if found == nil then
			return
		end
		local savedClaims = getProgress(player, "IndexClaimed")
		local claimed: { [string]: boolean } = {}
		if typeof(savedClaims) == "table" then
			for _, key in savedClaims do
				if typeof(key) == "string" then
					claimed[key] = true
				end
			end
		end
		local bonus = 0
		local newlyClaimed = false
		local function check(key: string, complete: boolean, reward: { Bonus: number, Cash: number }, label: string)
			if not complete then
				return
			end
			bonus += reward.Bonus
			if not claimed[key] then
				claimed[key] = true
				newlyClaimed = true
				addCash(player, reward.Cash)
				notify(
					player,
					string.format("INDEX COMPLETE: %s! %s income forever and %s!", label, percent(reward.Bonus), NumberFormat.cash(reward.Cash)),
					"Success",
					"Rebirth"
				)
				reportActivity(player, "IndexComplete")
			end
		end
		for _, rarity in BrainrotConfig.Rarities do
			local reward = FeatureConfig.IndexRewards[rarity.Name]
			if reward then
				check(rarity.Name, rarityComplete(found, rarity.Name), reward, "every " .. rarity.Name)
			end
		end
		for _, mutationName in FeatureConfig.MutationIndex do
			local reward = FeatureConfig.MutationIndexRewards[mutationName]
			if reward then
				check("Mutation:" .. mutationName, mutationComplete(found, mutationName), reward, "every " .. mutationName .. " brainrot")
			end
		end
		if newlyClaimed then
			setProgress(player, "IndexClaimed", sortedKeys(claimed))
		end
		indexBonus[player] = bonus
		player:SetAttribute("Discovered", table.concat(sortedKeys(found), ","))
	end

	-- Adds a brainrot (and its mutated version) to the player's Index.
	discover = function(player: Player, definition: Definition, mutation: Mutation?)
		local found = discovered[player]
		if found == nil or BrainrotConfig.isLuckyBlock(definition) then
			return
		end
		local changed = false
		if not found[definition.Id] then
			found[definition.Id] = true
			changed = true
		end
		if mutation then
			local key = definition.Id .. ":" .. mutation.Name
			if not found[key] then
				found[key] = true
				changed = true
			end
		end
		if changed then
			setProgress(player, "Discovered", sortedKeys(found))
			refreshIndex(player)
		end
		if definition.Rarity == "Secret" then
			reportActivity(player, "Secret")
		end
	end
end

--------------------------------------------------------------------------------
-- Brainrot visuals
--------------------------------------------------------------------------------

local function addBodyPart(
	model: Model,
	root: BasePart,
	name: string,
	shape: Enum.PartType,
	size: Vector3,
	offset: Vector3,
	color: Color3,
	material: Enum.Material
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Shape = shape
	part.Size = size
	part.Color = color
	part.Material = material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CFrame = root.CFrame * CFrame.new(offset)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = part
	weld.Parent = part

	part.Parent = model
	return part
end

-- The simple block figure each client swaps for the brainrot's model (its
-- glow and effects are added there).
local function buildFigure(model: Model, root: BasePart, definition: Definition): number
	local s = definition.Scale
	local bodySize = if definition.BodyShape == "Ball" then Vector3.one * 2.8 * s else Vector3.new(2.6, 2.6, 2.2) * s
	local bodyShape = if definition.BodyShape == "Ball" then Enum.PartType.Ball else Enum.PartType.Block
	local white = Color3.new(1, 1, 1)
	local black = Color3.new(0.1, 0.1, 0.1)

	addBodyPart(model, root, "Body", bodyShape, bodySize, Vector3.new(0, 1.5 * s, 0), definition.BodyColor, Enum.Material.SmoothPlastic)
	addBodyPart(model, root, "Head", Enum.PartType.Ball, Vector3.one * 2.1 * s, Vector3.new(0, 3.7 * s, 0), definition.BodyColor, Enum.Material.SmoothPlastic)
	for _, side in { -1, 1 } do
		addBodyPart(model, root, "Eye", Enum.PartType.Ball, Vector3.one * 0.7 * s, Vector3.new(0.45 * side * s, 3.85 * s, -0.8 * s), white, Enum.Material.SmoothPlastic)
		addBodyPart(model, root, "Pupil", Enum.PartType.Ball, Vector3.one * 0.35 * s, Vector3.new(0.45 * side * s, 3.85 * s, -1.1 * s), black, Enum.Material.SmoothPlastic)
		addBodyPart(model, root, "Foot", Enum.PartType.Block, Vector3.new(0.8, 0.5, 1) * s, Vector3.new(0.6 * side * s, 0.25 * s, 0), definition.AccentColor, Enum.Material.SmoothPlastic)
	end
	addBodyPart(model, root, "Hat", Enum.PartType.Block, Vector3.new(1.3, 0.6, 1.3) * s, Vector3.new(0, 4.85 * s, 0), definition.AccentColor, Enum.Material.SmoothPlastic)
	return Tuning.FIGURE_HEIGHT * s
end

-- World-space box around some parts.
local function partsBounds(parts: { BasePart }): (Vector3, Vector3)
	local low = Vector3.new(math.huge, math.huge, math.huge)
	local high = -low
	for _, part in parts do
		local half = part.Size / 2
		for _, corner in
			{
				Vector3.new(-1, -1, -1),
				Vector3.new(-1, -1, 1),
				Vector3.new(-1, 1, -1),
				Vector3.new(-1, 1, 1),
				Vector3.new(1, -1, -1),
				Vector3.new(1, -1, 1),
				Vector3.new(1, 1, -1),
				Vector3.new(1, 1, 1),
			}
		do
			local point = part.CFrame:PointToWorldSpace(half * corner)
			low = low:Min(point)
			high = high:Max(point)
		end
	end
	return low, high
end

-- Imported models are copied onto a brainrot's root by TemplateModels.build
-- (shared with guards and pets).
local TemplateModels = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("TemplateModels"))

-- Brainrot models imported in Studio (File > Import 3D of
-- BrainrotModels/Import/BrainrotModels.glb) arrive as a "BrainrotModels"
-- model in Workspace with parts named "<Id>_Body", "<Id>_Leg1", "<Id>_Front"
-- and so on. This turns them into one template per brainrot in
-- ReplicatedStorage.BrainrotModels: standing on the origin, facing -Z (from
-- the Front and Top markers, whatever axes the importer used), with the
-- parts named Body/Leg1/Leg2 and a Height attribute. A Model named after a
-- brainrot's Id (made or imported by hand) works too.
--
-- Block-built brainrots (tools/blocky) are in the file as their body plus
-- each moving piece, named by kind and number ("<Id>_Arm3": the brainrot's
-- asset module has its Phase and Axis at Parts[3 + 1]), with an
-- "<Id>_Pivot3" marker at the joint it turns about and an "<Id>_Built" marker.
Tuning.MOVING_KINDS = { Leg = true, Arm = true, Wing = true, Tail = true, Head = true, Prop = true, Ear = true, Board = true } :: { [string]: boolean }
-- How far (as a share) an imported model's piece sizes can be from its
-- brainrot's (ModelShapes) and still count as it. The two most alike
-- brainrots are 0.1 apart.
Tuning.SHAPE_TOLERANCE = 0.05

local function prepareImportedModels(): (number, { string })
	local function isMarker(piece: string): boolean
		return piece == "Front" or piece == "Top" or piece == "Built" or string.match(piece, "^Pivot%d+$") ~= nil
	end
	local function isPiece(piece: string): boolean
		if piece == "Body" or isMarker(piece) then
			return true
		end
		local kind = string.match(piece, "^(%a+)%d+$")
		return kind ~= nil and Tuning.MOVING_KINDS[kind] == true
	end
	-- A block-built brainrot's pieces as its asset module lists them.
	local function assetParts(brainrotId: string): { any }?
		local assets = ReplicatedStorage:FindFirstChild("Assets")
		local folder = if assets then assets:FindFirstChild("Brainrots") else nil
		local module = if folder then folder:FindFirstChild(brainrotId) else nil
		if module == nil or not module:IsA("ModuleScript") then
			return nil
		end
		local ok, data = pcall(require, module)
		return if ok and typeof(data) == "table" and typeof(data.Parts) == "table" then data.Parts else nil
	end

	local containers: { Instance } = {}
	local function consider(container: Instance?)
		if container and container ~= map and not container:IsDescendantOf(map) and table.find(containers, container) == nil then
			table.insert(containers, container)
		end
	end
	-- Wherever the imports ended up (Workspace, ReplicatedStorage or
	-- ServerStorage, maybe in a folder), and whatever the importer named them:
	-- any model holding a part called "<Id>_Body" (or "<Id>_Front"). One brainrot imported on
	-- its own (BrainrotModels/Import/One/<Id>.glb) is a model too.
	for _, place in { Workspace, ReplicatedStorage, ServerStorage } :: { Instance } do
		consider(place:FindFirstChild("BrainrotModels", true))
		for _, descendant in place:GetDescendants() do
			-- (Its Front marker too, so an import that lost its body is tidied away.)
			local brainrotId = string.match(descendant.Name, "^(%w+)_Body$") or string.match(descendant.Name, "^(%w+)_Front$")
			if brainrotId and BrainrotConfig.ById[brainrotId] and descendant:IsA("BasePart") then
				local holder: Instance = descendant
				while holder.Parent and holder.Parent ~= place and not holder.Parent:IsA("Folder") do
					holder = holder.Parent
				end
				if holder ~= descendant then
					consider(holder)
				end
			end
		end
	end
	if #containers == 0 then
		return 0, {}
	end

	-- Each brainrot's pieces come from one import (they're placed apart). If
	-- an older import is still around too, the one made the way the brainrot
	-- is now (block-built, with a Built marker, or not) wins.
	local groups: { [string]: { [string]: BasePart } } = {}
	local groupBuilt: { [string]: boolean } = {}
	-- (Imported pieces named "<Id>_<Piece>", rather than a hand-made model.)
	local groupNamed: { [string]: boolean } = {}
	for _, container in containers do
		if container.Parent == nil then
			continue
		end
		local found: { [string]: { [string]: BasePart } } = {}
		local named: { [string]: boolean } = {}
		for _, descendant in container:GetDescendants() do
			if not descendant:IsA("BasePart") then
				continue
			end
			local brainrotId, piece = string.match(descendant.Name, "^(%w+)_(%a+%d*)")
			if brainrotId and piece and BrainrotConfig.ById[brainrotId] and isPiece(piece) then
				found[brainrotId] = found[brainrotId] or {}
				found[brainrotId][piece] = descendant
				named[brainrotId] = true
			else
				-- A hand-made model: a Model named after the brainrot.
				local ancestor = descendant:FindFirstAncestorWhichIsA("Model")
				while ancestor and ancestor ~= container and BrainrotConfig.ById[ancestor.Name] == nil do
					ancestor = ancestor.Parent and ancestor.Parent:FindFirstAncestorWhichIsA("Model")
				end
				if ancestor and ancestor ~= container then
					found[ancestor.Name] = found[ancestor.Name] or {}
					local key = descendant.Name
					while found[ancestor.Name][key] do
						key ..= "_"
					end
					found[ancestor.Name][key] = descendant
				end
			end
		end
		for brainrotId, pieces in found do
			-- (An import that lost its body doesn't count.)
			local body: BasePart?, front: BasePart?, top: BasePart? = pieces.Body, pieces.Front, pieces.Top
			local complete = body ~= nil or (front == nil and top == nil)
			local definition = BrainrotConfig.ById[brainrotId]
			local wanted = definition ~= nil and definition.BlockBuilt
			local builtMarker: BasePart? = pieces.Built
			local isBuilt = builtMarker ~= nil
			if complete and (groups[brainrotId] == nil or (isBuilt == wanted and groupBuilt[brainrotId] ~= wanted)) then
				groups[brainrotId] = pieces
				groupBuilt[brainrotId] = isBuilt
				groupNamed[brainrotId] = named[brainrotId] == true
			end
		end
	end

	-- A model can end up with another brainrot's name (the importer or an old
	-- import mixing them up), so each imported one's pieces and their sizes
	-- are checked against ModelShapes: one that's really another brainrot's is
	-- used for that one, and one that looks like none is left out.
	local ModelShapes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ModelShapes"))
	local function shapeError(pieces: { [string]: BasePart }, shape: { [string]: { number } }): number
		local body: BasePart? = pieces.Body
		if body == nil then
			return math.huge
		end
		local unit = math.max(body.Size.X, body.Size.Y, body.Size.Z)
		local worst, count = 0, 0
		for piece, part in pieces do
			if isMarker(piece) then
				continue
			end
			local want = shape[piece]
			if want == nil or unit <= 0 then
				return math.huge
			end
			count += 1
			local sizes = { part.Size.X / unit, part.Size.Y / unit, part.Size.Z / unit }
			table.sort(sizes, function(a: number, b: number): boolean
				return a > b
			end)
			for index = 1, 3 do
				worst = math.max(worst, math.abs(sizes[index] - want[index]) / math.max(want[index], 0.1))
			end
		end
		local expected = 0
		for _ in shape do
			expected += 1
		end
		return if count == expected then worst else math.huge
	end
	local checked: { [string]: { [string]: BasePart } } = {}
	local wrong: { string } = {}
	for brainrotId, pieces in groups do
		local shape = ModelShapes[brainrotId]
		if shape == nil or not groupNamed[brainrotId] or shapeError(pieces, shape) <= Tuning.SHAPE_TOLERANCE then
			checked[brainrotId] = pieces
		else
			table.insert(wrong, brainrotId)
		end
	end
	table.sort(wrong)
	-- (If most don't match, the importer must measure them differently: then
	-- the check can't be trusted, so the names are kept.)
	local namedCount = 0
	for brainrotId in groups do
		if groupNamed[brainrotId] then
			namedCount += 1
		end
	end
	if namedCount >= 4 and #wrong * 2 > namedCount then
		warn(string.format("%s Couldn't check the imported models' names (most don't match their shapes), so they're used as named.", LOG_PREFIX))
		for _, brainrotId in wrong do
			checked[brainrotId] = groups[brainrotId]
		end
		table.clear(wrong)
	end
	local renamed: { string } = {}
	local unknown: { string } = {}
	for _, brainrotId in wrong do
		local pieces = groups[brainrotId]
		local best, bestError = nil :: string?, Tuning.SHAPE_TOLERANCE
		for otherId, shape in ModelShapes do
			local miss = shapeError(pieces, shape)
			if miss <= bestError and checked[otherId] == nil then
				best, bestError = otherId, miss
			end
		end
		if best then
			checked[best] = pieces
			table.insert(renamed, string.format("%s (was named %s)", best, brainrotId))
		else
			table.insert(unknown, brainrotId)
		end
	end
	if #renamed > 0 then
		warn(string.format("%s Imported models with another brainrot's name, now used for the right one: %s.", LOG_PREFIX, table.concat(renamed, ", ")))
	end
	if #unknown > 0 then
		warn(
			string.format(
				"%s These imported models don't look like the brainrot they're named after, so those brainrots are built from blocks: %s. Delete the BrainrotModels import, import BrainrotModels/Import/BrainrotModels.glb again and save.",
				LOG_PREFIX,
				table.concat(unknown, ", ")
			)
		)
	end

	local folder = Instance.new("Folder")
	folder.Name = "BrainrotModels"
	local count = 0
	for brainrotId, pieces in checked do
		-- A block-built brainrot comes with a Built marker; an import of one
		-- without it is from before it was rebuilt from blocks, and one with it
		-- of a brainrot that isn't block-built any more is from when it was.
		local definition = BrainrotConfig.ById[brainrotId]
		local built: BasePart? = pieces.Built
		if definition and definition.BlockBuilt ~= (built ~= nil) then
			continue
		end
		local front, top = pieces.Front, pieces.Top
		local parts: { BasePart } = {}
		for piece, part in pieces do
			if not isMarker(piece) then
				table.insert(parts, part)
			end
		end
		if #parts == 0 then
			continue
		end
		local low, high = partsBounds(parts)
		local centre = (low + high) / 2
		local frame = CFrame.new(centre)
		if front and top then
			local up = (top.Position - centre).Unit
			local ahead = front.Position - centre
			ahead = (ahead - up * ahead:Dot(up)).Unit
			frame = CFrame.lookAt(centre, centre + ahead, up)
		end
		local template = Instance.new("Model")
		template.Name = brainrotId
		for _, part in parts do
			part.CFrame = frame:ToObjectSpace(part.CFrame)
		end
		low, high = partsBounds(parts)
		local feet = Vector3.new((low.X + high.X) / 2, low.Y, (low.Z + high.Z) / 2)
		-- Moving pieces of a block-built brainrot: their kind, joint, phase and axis.
		local assetInfo = if built then assetParts(brainrotId) else nil
		for piece, part in pieces do
			local kind, number = string.match(piece, "^(%a+)(%d+)$")
			local marker = if kind and number and Tuning.MOVING_KINDS[kind] then pieces["Pivot" .. number] else nil
			if marker then
				local info = if assetInfo then assetInfo[(tonumber(number) or 0) + 1] else nil
				part:SetAttribute("PieceKind", kind)
				part:SetAttribute("Pivot", frame:PointToObjectSpace(marker.Position) - feet)
				part:SetAttribute("PiecePhase", if typeof(info) == "table" and info.Phase == 1 then 1 else 0)
				part:SetAttribute("PieceAxis", if typeof(info) == "table" and typeof(info.Axis) == "string" then info.Axis else "Y")
			end
		end
		for piece, part in pieces do
			if isMarker(piece) then
				continue
			end
			part.CFrame -= feet
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			if isPiece(piece) then
				part.Name = piece
			end
			part.Parent = template
		end
		template:SetAttribute("Height", high.Y - low.Y)
		template.WorldPivot = CFrame.identity
		template.Parent = folder
		count += 1
	end
	for _, container in containers do
		container:Destroy()
	end
	folder.Parent = ReplicatedStorage
	-- Brainrots still without a model (the import lost them, or they're new).
	local missing: { string } = {}
	for _, definition in BrainrotConfig.Brainrots do
		if not BrainrotConfig.isLuckyBlock(definition) and folder:FindFirstChild(definition.Id) == nil then
			table.insert(missing, definition.Id)
		end
	end
	return count, missing
end

Tuning.RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 70, 70)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 190, 40)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(90, 255, 90)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(60, 200, 255)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(150, 90, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 80, 200)),
})
-- OG labels shine aqua, white and gold.
Tuning.OG_SHINE = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(60, 255, 215)),
	ColorSequenceKeypoint.new(0.45, Color3.fromRGB(255, 255, 255)),
	ColorSequenceKeypoint.new(0.55, Color3.fromRGB(255, 255, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 205, 60)),
})

-- A brainrot's label is sized in studs, so labels further away get smaller
-- instead of piling up on the screen. Line heights are given in pixels of
-- a label Tuning.INFO_DESIGN_WIDTH wide, which is Tuning.INFO_STUDS_WIDE studs across
-- (less than the gap between two pedestals).
Tuning.INFO_DESIGN_WIDTH = 260
Tuning.INFO_STUDS_WIDE = 8

local function addInfoLabel(parent: Instance, text: string, color: Color3, textSize: number, order: number, rainbow: boolean?): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.Text = text
	label.TextColor3 = if rainbow then Color3.new(1, 1, 1) else color
	label.TextScaled = true
	label.LayoutOrder = order
	label:SetAttribute("LineHeight", textSize + 6)

	-- Up close the text stops growing.
	local limit = Instance.new("UITextSizeConstraint")
	limit.MaxTextSize = math.floor(textSize * 1.5)
	limit.Parent = label

	local outline = Instance.new("UIStroke")
	outline.Color = Color3.new(0, 0, 0)
	outline.Thickness = 2
	outline.Parent = label

	if rainbow then
		local gradient = Instance.new("UIGradient")
		gradient.Color = Tuning.RAINBOW
		gradient.Parent = label
	end
	label.Parent = parent
	return label
end

-- Sizes a label and its lines (again after a line is removed).
local function layoutInfo(billboard: Instance?)
	if billboard == nil or not billboard:IsA("BillboardGui") then
		return
	end
	local total = 0
	for _, child in billboard:GetChildren() do
		if child:IsA("TextLabel") then
			total += tonumber(child:GetAttribute("LineHeight")) or 0
		end
	end
	if total <= 0 then
		return
	end
	billboard.Size = UDim2.fromScale(Tuning.INFO_STUDS_WIDE, Tuning.INFO_STUDS_WIDE * total / Tuning.INFO_DESIGN_WIDTH)
	for _, child in billboard:GetChildren() do
		if child:IsA("TextLabel") then
			child.Size = UDim2.fromScale(1, (tonumber(child:GetAttribute("LineHeight")) or 0) / total)
		end
	end
end

local buildLuckyBlock: (model: Model, root: BasePart, definition: Definition) -> number
local refreshOccupantInfo: (occupant: Occupant) -> ()
do
	-- A lucky block: a glossy cube with a "?" on every side and glowing edges,
	-- held by a Pose weld so BrainrotVisuals can make it hop and float.
	local LUCKY_BLOCK_SIZE = 3.4
	local LUCKY_EDGES: { { Vector3 } } = {
		-- Size and offset (in block sizes) of each of the 12 edges.
		{ Vector3.new(1, 0.08, 0.08), Vector3.new(0, 0.5, 0.5) },
		{ Vector3.new(1, 0.08, 0.08), Vector3.new(0, 0.5, -0.5) },
		{ Vector3.new(1, 0.08, 0.08), Vector3.new(0, -0.5, 0.5) },
		{ Vector3.new(1, 0.08, 0.08), Vector3.new(0, -0.5, -0.5) },
		{ Vector3.new(0.08, 1, 0.08), Vector3.new(0.5, 0, 0.5) },
		{ Vector3.new(0.08, 1, 0.08), Vector3.new(0.5, 0, -0.5) },
		{ Vector3.new(0.08, 1, 0.08), Vector3.new(-0.5, 0, 0.5) },
		{ Vector3.new(0.08, 1, 0.08), Vector3.new(-0.5, 0, -0.5) },
		{ Vector3.new(0.08, 0.08, 1), Vector3.new(0.5, 0.5, 0) },
		{ Vector3.new(0.08, 0.08, 1), Vector3.new(-0.5, 0.5, 0) },
		{ Vector3.new(0.08, 0.08, 1), Vector3.new(0.5, -0.5, 0) },
		{ Vector3.new(0.08, 0.08, 1), Vector3.new(-0.5, -0.5, 0) },
	}

	buildLuckyBlock = function(model: Model, root: BasePart, definition: Definition): number
		local size = LUCKY_BLOCK_SIZE
		local offset = CFrame.new(0, size / 2 + 0.2, 0)
		local body = Instance.new("Part")
		body.Name = "Body"
		body.Size = Vector3.one * size
		body.Color = definition.BodyColor
		body.Material = Enum.Material.SmoothPlastic
		body.Reflectance = 0.15
		body.TopSurface = Enum.SurfaceType.Smooth
		body.BottomSurface = Enum.SurfaceType.Smooth
		body.Anchored = false
		body.CanCollide = false
		body.CanQuery = false
		body.CanTouch = false
		body.Massless = true
		body.CFrame = root.CFrame * offset
		local weld = Instance.new("Weld")
		weld.Name = "Pose"
		weld.Part0 = root
		weld.Part1 = body
		weld.C0 = offset
		weld.Parent = body

		for _, face in Enum.NormalId:GetEnumItems() do
			local surface = Instance.new("SurfaceGui")
			surface.Name = "Mark"
			surface.Face = face
			surface.LightInfluence = 0
			surface.CanvasSize = Vector2.new(100, 100)
			local mark = Instance.new("TextLabel")
			mark.BackgroundTransparency = 1
			mark.Size = UDim2.fromScale(1, 1)
			mark.Font = Enum.Font.FredokaOne
			mark.Text = "?"
			mark.TextScaled = true
			mark.TextColor3 = definition.AccentColor
			local outline = Instance.new("UIStroke")
			outline.Thickness = 4
			outline.Color = definition.BodyColor:Lerp(Color3.new(0, 0, 0), 0.6)
			outline.Parent = mark
			mark.Parent = surface
			surface.Parent = body
		end

		for number, edge in LUCKY_EDGES do
			local trim = Instance.new("Part")
			trim.Name = "Edge" .. number
			trim.Size = edge[1] * size + Vector3.one * 0.02
			trim.Color = definition.AccentColor
			trim.Material = Enum.Material.Neon
			trim.Anchored = false
			trim.CanCollide = false
			trim.CanQuery = false
			trim.CanTouch = false
			trim.Massless = true
			trim.CFrame = body.CFrame * CFrame.new(edge[2] * size)
			local hold = Instance.new("WeldConstraint")
			hold.Part0 = body
			hold.Part1 = trim
			hold.Parent = trim
			trim.Parent = model
		end

		local light = Instance.new("PointLight")
		light.Color = definition.BodyColor
		light.Brightness = 1
		light.Range = 9
		light.Parent = body
		body.Parent = model
		model:SetAttribute("LuckyBlock", true)
		return size + 0.2
	end
end

-- The rarities a lucky block can open into, for its label: "Rare - Mythic".
local function luckyRange(definition: Definition): string
	local lowest, highest = math.huge, -math.huge
	for index, rarity in BrainrotConfig.Rarities do
		local odds = definition.Odds
		if odds and (odds[rarity.Name] or 0) > 0 then
			lowest = math.min(lowest, index)
			highest = math.max(highest, index)
		end
	end
	local low, high = BrainrotConfig.Rarities[lowest], BrainrotConfig.Rarities[highest]
	if low == nil or high == nil then
		return "???"
	end
	return if low == high then low.Name else low.Name .. " - " .. high.Name
end

-- `price` adds a price line (conveyor and walking brainrots); `ownerText` adds
-- a line saying whose base a walking brainrot is heading to.
local function buildBrainrot(definition: Definition, mutation: Mutation?, trait: Trait?, price: number?, ownerText: string?): Visual
	local rarity = BrainrotConfig.RarityByName[definition.Rarity]
	local isBlock = BrainrotConfig.isLuckyBlock(definition)

	local model = Instance.new("Model")
	model.Name = definition.Id
	-- Streams in and out as a whole, so clients never see half a brainrot.
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.one
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Massless = true
	root.CFrame = CFrame.identity
	root.Parent = model
	model.PrimaryPart = root

	local customModels = ReplicatedStorage:FindFirstChild("BrainrotModels")
	local template = if customModels and not isBlock then customModels:FindFirstChild(definition.Id) else nil
	if template and #template:GetChildren() == 0 then
		template = nil
	end
	local hasCustomModel = isBlock or (template ~= nil and template:IsA("Model"))
	local traitScale = if trait then trait.Scale else 1
	local height = if isBlock
		then buildLuckyBlock(model, root, definition)
		elseif template and template:IsA("Model") then TemplateModels.build(model, root, template, Tuning.FIGURE_HEIGHT * definition.Scale * traitScale)
		else buildFigure(model, root, definition)
	if not hasCustomModel and traitScale ~= 1 then
		height *= traitScale
	end

	-- Tells BrainrotVisuals on each client which 3D model to show, how tall,
	-- which effects to add and how to animate it (State).
	model:SetAttribute("BrainrotId", definition.Id)
	model:SetAttribute("FigureHeight", height)
	model:SetAttribute("CustomModel", hasCustomModel)
	model:SetAttribute("Rarity", definition.Rarity)
	model:SetAttribute("Mutation", if mutation then mutation.Name else nil)
	model:SetAttribute("Trait", if trait then trait.Name else nil)
	model:SetAttribute("Price", price)
	model:SetAttribute("Motion", definition.Motion)
	model:SetAttribute("State", "Idle")

	local promptAttachment = Instance.new("Attachment")
	promptAttachment.Name = "PromptAttachment"
	promptAttachment.Position = Vector3.new(0, height * 0.5, 0)
	promptAttachment.Parent = root

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Info"
	billboard.Adornee = root
	billboard.StudsOffsetWorldSpace = Vector3.new(0, height + 2.4, 0)
	billboard.MaxDistance = 80
	billboard.LightInfluence = 0

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.Parent = billboard

	local ownerLabel: TextLabel? = nil
	if ownerText then
		ownerLabel = addInfoLabel(billboard, ownerText, Color3.fromRGB(200, 230, 255), 16, -2)
	end
	if trait then
		addInfoLabel(billboard, trait.Icon .. " " .. trait.Name .. " x" .. tostring(trait.Multiplier), trait.Color, 20, -1, trait.Name == "Nyan")
	end
	if mutation then
		addInfoLabel(billboard, mutation.Name, mutation.Color, 20, 0, mutation.Name == "Rainbow")
	end
	addInfoLabel(billboard, definition.DisplayName, Color3.new(1, 1, 1), 22, 1)
	local rarityLabel = addInfoLabel(
		billboard,
		definition.Rarity,
		if rarity then rarity.Color else Color3.new(1, 1, 1),
		20,
		2,
		rarity ~= nil and rarity.Style == "Rainbow"
	)
	if rarity and rarity.Style == "Secret" then
		-- Black text with a white outline, like the original's Secrets.
		local outline = rarityLabel:FindFirstChildOfClass("UIStroke")
		if outline then
			outline.Color = Color3.new(1, 1, 1)
		end
	elseif rarity and rarity.Style == "OG" then
		rarityLabel.TextColor3 = Color3.new(1, 1, 1)
		local shine = Instance.new("UIGradient")
		shine.Color = Tuning.OG_SHINE
		shine.Parent = rarityLabel
	end
	local incomeLabel: TextLabel? = nil
	if isBlock then
		addInfoLabel(billboard, "Opens into " .. luckyRange(definition), Color3.fromRGB(255, 230, 70), 18, 3)
	else
		incomeLabel = addInfoLabel(billboard, NumberFormat.cash(incomeOf(definition, mutation, trait)) .. "/s", Color3.fromRGB(255, 230, 70), 20, 3)
	end
	local priceLabel: TextLabel? = nil
	if price then
		priceLabel = addInfoLabel(billboard, NumberFormat.cash(price), Color3.fromRGB(90, 255, 120), 22, 4)
	end
	layoutInfo(billboard)
	billboard.Parent = root

	return {
		Model = model,
		Root = root,
		PromptAttachment = promptAttachment,
		PriceLabel = priceLabel,
		OwnerLabel = ownerLabel,
		IncomeLabel = incomeLabel,
	}
end

Tuning.PROMPT_OFFSETS = {
	Upgrade = Vector2.new(0, 84),
	Open = Vector2.new(0, -84),
	Manage = Vector2.new(0, -84),
} :: { [string]: Vector2 }

-- Updates a base brainrot's label (income with its level, hat and pedestal)
-- and the Level and Hat attributes the clients show.
refreshOccupantInfo = function(occupant: Occupant)
	if BrainrotConfig.isLuckyBlock(occupant.Definition) then
		return
	end
	local level = ExtrasConfig.levelOf(occupant.Seconds)
	occupant.Model:SetAttribute("Level", level)
	occupant.Model:SetAttribute("Hat", occupant.Hat)
	local incomeLabel = occupant.IncomeLabel
	if incomeLabel then
		incomeLabel.Text = NumberFormat.cash(occupantIncome(occupant)) .. "/s"
	end
	local billboard = if incomeLabel then incomeLabel.Parent else nil
	if billboard == nil then
		return
	end
	local levelLabel = occupant.LevelLabel
	if levelLabel == nil then
		levelLabel = addInfoLabel(billboard, "", Color3.fromRGB(140, 230, 255), 18, 5)
		occupant.LevelLabel = levelLabel
		layoutInfo(billboard)
	end
	local hat = if occupant.Hat then ExtrasConfig.HatByName[occupant.Hat] else nil
	local text = string.format("⭐ Lv %d%s", level, if level >= ExtrasConfig.MaxLevel then " MAX" else "")
	if hat then
		text ..= "  " .. hat.Icon .. " +" .. math.floor(hat.Bonus * 100 + 0.5) .. "%"
	end
	;(levelLabel :: TextLabel).Text = text
end

local function createPrompt(
	attachment: Attachment,
	kind: string,
	actionText: string,
	objectText: string,
	holdDuration: number,
	keyCode: Enum.KeyCode,
	ownerUserId: number?
): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = holdDuration
	prompt.KeyboardKeyCode = keyCode
	prompt.MaxActivationDistance = GameConfig.PromptDistance
	prompt.RequiresLineOfSight = false
	-- The owner's prompts share a spot: stack them so none hides another.
	prompt.UIOffset = Tuning.PROMPT_OFFSETS[kind] or Vector2.zero
	prompt:SetAttribute("PromptKind", kind)
	prompt:SetAttribute("Carried", false)
	prompt:SetAttribute("Walking", false)
	if ownerUserId then
		prompt:SetAttribute("OwnerUserId", ownerUserId)
	end
	prompt.Parent = attachment
	return prompt
end

--------------------------------------------------------------------------------
-- Occupants (brainrots that belong to a base)
--------------------------------------------------------------------------------

local onStealTriggered: (occupant: Occupant, thief: Player) -> ()
local onSellTriggered: (occupant: Occupant, player: Player) -> ()
local onSnipeTriggered: (occupant: Occupant, player: Player) -> ()
local onUpgradeTriggered: (occupant: Occupant, player: Player) -> ()
local onOpenTriggered: (occupant: Occupant, player: Player) -> ()
-- Puts lucky blocks and gifts waiting for room onto free pedestals.
local placePending: (player: Player) -> ()

local function ownerText(player: Player): string
	return "Walking to " .. player.DisplayName .. "'s base"
end

-- Sets a flag the client uses to hide prompts (Walking, Carried) on every
-- prompt of a brainrot but the Snipe one.
local function setPromptFlag(occupant: Occupant, attribute: string, value: boolean)
	for _, child in occupant.PromptAttachment:GetChildren() do
		if child:IsA("ProximityPrompt") and child:GetAttribute("PromptKind") ~= "Snipe" then
			child:SetAttribute(attribute, value)
		end
	end
end

local function setOccupantCarried(occupant: Occupant, carried: boolean)
	setPromptFlag(occupant, "Carried", carried)
end

local function setOccupantOwner(occupant: Occupant, owner: Player)
	occupant.Model:SetAttribute("OwnerUserId", owner.UserId)
	occupant.Model:SetAttribute("Slot", occupant.SlotIndex)
	for _, child in occupant.PromptAttachment:GetChildren() do
		if child:IsA("ProximityPrompt") then
			child:SetAttribute("OwnerUserId", owner.UserId)
		end
	end
	local ownerLabel = occupant.OwnerLabel
	if ownerLabel then
		ownerLabel.Text = ownerText(owner)
	end
end

-- Ends a walk right where the brainrot is (it stays in its base's list).
local function stopWalking(occupant: Occupant)
	occupant.Walk = nil
	walkers[occupant] = nil
end

-- Called when a walking brainrot reaches its pedestal.
local function finishWalk(occupant: Occupant)
	stopWalking(occupant)
	occupant.Root.CFrame = getSlotCFrame(occupant.Plot, occupant.SlotIndex)
	occupant.Model:SetAttribute("State", "Idle")
	setPromptFlag(occupant, "Walking", false)
	local snipePrompt = occupant.SnipePrompt
	if snipePrompt then
		snipePrompt:Destroy()
		occupant.SnipePrompt = nil
	end
	local priceLabel = occupant.PriceLabel
	if priceLabel then
		priceLabel:Destroy()
	end
	local ownerLabel = occupant.OwnerLabel
	if ownerLabel then
		ownerLabel:Destroy()
	end
	occupant.PriceLabel = nil
	occupant.OwnerLabel = nil
	layoutInfo(occupant.Root:FindFirstChild("Info"))
end

-- Height of the walkable surface at (x, z), looking down from `above`.
local function surfaceAt(x: number, z: number, above: number, depth: number): number?
	local result = Workspace:Raycast(Vector3.new(x, above, z), Vector3.new(0, -depth, 0), groundParams)
	return if result then result.Position.Y else nil
end

-- The path from `from` to a pedestal: onto the walkway beside the conveyor,
-- along it to the base's carpet, up the carpet, through the door, up the
-- stairs to the pedestal's floor and past the pads to the pedestal. Every
-- point carries the floor height there. Returns the points and the index of
-- the door.
local function buildPath(plot: Plot, slotIndex: number, from: Vector3): ({ Vector3 }, number)
	local floorFrame = plot.Floor.CFrame
	local halfDepth = plot.Floor.Size.Z / 2
	local groundTop = plot.Floor.Position.Y + plot.Floor.Size.Y / 2
	local carpet = plot.Carpet
	local carpetLength = if carpet then carpet.Size.Z else 0
	local laneZ = -halfDepth - carpetLength + Tuning.LANE_INSET
	local slot = plot.Slots[slotIndex]
	local slotLocal = floorFrame:PointToObjectSpace(slot.Position)
	local slotTop = slot.Position.Y + slot.Size.Y / 2
	local fromLocal = floorFrame:PointToObjectSpace(from)
	local padZ = slotLocal.Z - Tuning.PAD_OFFSET

	local points: { Vector3 } = {}
	local function add(x: number, z: number, y: number)
		local world = floorFrame:PointToWorldSpace(Vector3.new(x, 0, z))
		table.insert(points, Vector3.new(world.X, y, world.Z))
	end
	-- Outside the base the ground is looked up (carpet, walkway, grass).
	local function addOutside(x: number, z: number)
		local world = floorFrame:PointToWorldSpace(Vector3.new(x, 0, z))
		local y = surfaceAt(world.X, world.Z, groundTop + 5, 12) or groundTop
		table.insert(points, Vector3.new(world.X, y, world.Z))
	end

	if fromLocal.Z < -halfDepth and math.abs(fromLocal.X) > 2 then
		-- Not on this base's carpet yet: walk beside the conveyor first.
		addOutside(fromLocal.X, laneZ)
		addOutside(0, laneZ)
	end
	addOutside(0, -halfDepth - 1)
	local doorIndex = #points
	add(0, -halfDepth + 2, groundTop)

	-- Upper floors: up each flight of stairs along the front wall, stepping
	-- off onto the floor above at the top.
	local floorTop = groundTop
	local climbed = false
	for floor = 1, floorOf(slotIndex) - 1 do
		local stair = plot.Stairs[floor]
		if stair then
			local bottom = floorFrame:PointToObjectSpace(stair.Bottom)
			local top = floorFrame:PointToObjectSpace(stair.Top)
			local exitZ = bottom.Z + Tuning.STAIR_EXIT_OFFSET
			local firstStep = surfaceAt(stair.Bottom.X, stair.Bottom.Z, stair.Bottom.Y + 1, 3) or floorTop + 1
			local nextFloor = surfaceAt(stair.Top.X, stair.Top.Z, stair.Top.Y + 1, 3) or stair.Top.Y - 0.5
			add(bottom.X, exitZ, floorTop)
			add(bottom.X, bottom.Z, firstStep)
			add(top.X, top.Z, nextFloor)
			add(top.X, exitZ, nextFloor)
			floorTop = nextFloor
			climbed = true
		end
	end
	if climbed then
		add(0, floorFrame:PointToObjectSpace(points[#points]).Z, floorTop)
	end
	floorTop = slotTop - slot.Size.Y
	add(0, padZ, floorTop)
	add(slotLocal.X, padZ, floorTop)
	add(slotLocal.X, slotLocal.Z, slotTop)
	return points, doorIndex
end

local function pathLength(from: Vector3, points: { Vector3 }): number
	local length = 0
	local last = from
	for _, point in points do
		local offset = point - last
		length += Vector3.new(offset.X, 0, offset.Z).Magnitude
		last = point
	end
	return length
end

local function startWalk(occupant: Occupant, from: Vector3)
	local points, doorIndex = buildPath(occupant.Plot, occupant.SlotIndex, from)
	local length = pathLength(from, points)
	occupant.Walk = {
		Points = points,
		Index = 1,
		DoorIndex = doorIndex,
		Entered = false,
		Speed = math.max(GameConfig.BrainrotWalkSpeed, length / GameConfig.MaxWalkSeconds),
		Height = from.Y,
		Last = from,
	}
	walkers[occupant] = true
	occupant.Model:SetAttribute("State", "Walking")
	setPromptFlag(occupant, "Walking", true)
	local snipePrompt = occupant.SnipePrompt
	if snipePrompt then
		snipePrompt:SetAttribute("Snipeable", true)
	end
end

-- The step or floor right under a walker whose path is at `pathHeight`. The
-- ray starts just above the path, so it can't start inside a step.
local function groundHeightAt(position: Vector3, pathHeight: number): number?
	local ground = surfaceAt(position.X, position.Z, pathHeight + 2.5, 5)
	if ground and ground >= pathHeight - 1.5 then
		return ground
	end
	return nil
end

-- Moves every walking brainrot a frame further along its path.
local function stepWalkers(dt: number)
	for occupant in walkers do
		local walk = occupant.Walk
		if walk == nil or occupant.Model.Parent == nil then
			walkers[occupant] = nil
			continue
		end
		local root = occupant.Root
		local position = root.Position
		local remaining = walk.Speed * dt
		while remaining > 0 do
			local target: Vector3? = walk.Points[walk.Index]
			if not target then
				break
			end
			local flat = Vector3.new(target.X - position.X, 0, target.Z - position.Z)
			local distance = flat.Magnitude
			if distance <= remaining then
				position = Vector3.new(target.X, position.Y, target.Z)
				remaining -= distance
				walk.Last = target
				if walk.Index == walk.DoorIndex and not walk.Entered then
					-- Through the door: it's safe in its owner's base now.
					walk.Entered = true
					local snipePrompt = occupant.SnipePrompt
					if snipePrompt then
						snipePrompt:SetAttribute("Snipeable", false)
					end
				end
				walk.Index += 1
			else
				position += flat.Unit * remaining
				remaining = 0
			end
		end

		if walk.Index > #walk.Points then
			finishWalk(occupant)
			continue
		end

		-- Height along the current stretch, then onto the step under it.
		local target = walk.Points[walk.Index]
		local last = walk.Last
		local stretch = Vector3.new(target.X - last.X, 0, target.Z - last.Z).Magnitude
		local left = Vector3.new(target.X - position.X, 0, target.Z - position.Z).Magnitude
		local progress = if stretch > 0.01 then math.clamp(1 - left / stretch, 0, 1) else 1
		local pathHeight = last.Y + (target.Y - last.Y) * progress
		local ground = groundHeightAt(position, pathHeight) or pathHeight
		walk.Height += (ground - walk.Height) * math.min(1, dt * 15)
		walk.Height = math.clamp(walk.Height, pathHeight - 1.5, pathHeight + 1.5)

		local standing = Vector3.new(position.X, walk.Height, position.Z)
		local facing = Vector3.new(target.X - standing.X, 0, target.Z - standing.Z)
		local rotation = root.CFrame.Rotation
		if facing.Magnitude > 0.05 then
			rotation = rotation:Lerp(CFrame.lookAt(Vector3.zero, facing), math.min(1, dt * 10))
		end
		root.CFrame = CFrame.new(standing) * rotation
	end
end

-- A pedestal's upgrade level shows as a glowing band around its foot.
local function updatePedestalLook(plot: Plot, slotIndex: number)
	local slot: BasePart? = plot.Slots[slotIndex]
	if slot == nil then
		return
	end
	local level = plot.Levels[slotIndex] or 1
	slot:SetAttribute("Level", level)
	local ring: BasePart? = plot.LevelRings[slotIndex]
	if level <= 1 then
		if ring then
			ring:Destroy()
			plot.LevelRings[slotIndex] = nil
		end
		return
	end
	if ring == nil then
		local newRing = Instance.new("Part")
		newRing.Name = "LevelRing"
		newRing.Anchored = true
		newRing.CanCollide = false
		newRing.CanQuery = false
		newRing.CanTouch = false
		newRing.CastShadow = false
		newRing.Material = Enum.Material.Neon
		newRing.Size = Vector3.new(slot.Size.X + 0.6, 0.4, slot.Size.Z + 0.6)
		newRing.CFrame = slot.CFrame * CFrame.new(0, -slot.Size.Y / 2 + 0.2, 0)
		local glow = Instance.new("PointLight")
		glow.Brightness = 1.2
		glow.Range = 7
		glow.Shadows = false
		glow.Parent = newRing
		newRing.Parent = slot
		plot.LevelRings[slotIndex] = newRing
		ring = newRing
	end
	local colour = FeatureConfig.PedestalColors[level - 1] or Color3.new(1, 1, 1)
	local liveRing = ring :: BasePart
	liveRing.Color = colour
	local glow = liveRing:FindFirstChildOfClass("PointLight")
	if glow then
		glow.Color = colour
	end
end

local function refreshUpgradePrompt(occupant: Occupant)
	local prompt = occupant.UpgradePrompt
	if prompt == nil then
		return
	end
	local level = occupant.Plot.Levels[occupant.SlotIndex] or 1
	local cost = FeatureConfig.PedestalCosts[level]
	local bonus = math.floor(FeatureConfig.PedestalBonus * 100 + 0.5)
	if cost == nil then
		prompt.ActionText = "Max Level"
		prompt.ObjectText = string.format("Pedestal Lv %d (+%d%% income)", level, bonus * (level - 1))
	else
		prompt.ActionText = "Upgrade " .. NumberFormat.cash(cost)
		prompt.ObjectText = string.format("Pedestal Lv %d → %d (+%d%% income)", level, level + 1, bonus * level)
	end
	prompt:SetAttribute("MaxLevel", cost == nil)
end

-- Puts a brainrot in a base. With `walkFrom` it walks there from that
-- position (and can be bought off its owner until it reaches the door).
local function placeOccupant(
	plot: Plot,
	slotIndex: number,
	definition: Definition,
	mutation: Mutation?,
	trait: Trait?,
	walkFrom: CFrame?,
	price: number?,
	hatName: string?,
	seconds: number?
): Occupant?
	local owner = plot.Owner
	if owner == nil or plot.Occupants[slotIndex] ~= nil then
		return nil
	end

	local paid = price or priceOf(definition, mutation, trait)
	local visual = buildBrainrot(
		definition,
		mutation,
		trait,
		if walkFrom then paid else nil,
		if walkFrom then ownerText(owner) else nil
	)
	visual.Model:SetAttribute("OwnerUserId", owner.UserId)
	visual.Model:SetAttribute("Slot", slotIndex)
	local refund = math.floor(priceOf(definition, mutation, trait) * GameConfig.SellRefundFraction)
	local name = fullName(definition, mutation, trait)

	local occupant: Occupant = {
		Definition = definition,
		Mutation = mutation,
		Trait = trait,
		Plot = plot,
		SlotIndex = slotIndex,
		Model = visual.Model,
		Root = visual.Root,
		PromptAttachment = visual.PromptAttachment,
		StealPrompt = createPrompt(visual.PromptAttachment, "Steal", "Steal", name, GameConfig.StealHoldSeconds, Enum.KeyCode.E, owner.UserId),
		SellPrompt = createPrompt(visual.PromptAttachment, "Sell", "Sell for " .. NumberFormat.cash(refund), name, 0.5, Enum.KeyCode.F, owner.UserId),
		SnipePrompt = nil,
		UpgradePrompt = createPrompt(visual.PromptAttachment, "Upgrade", "Upgrade", "Pedestal", 0.3, Enum.KeyCode.R, owner.UserId),
		OpeningResult = nil,
		Price = paid,
		Walk = nil,
		Sniping = false,
		Carrier = nil,
		PriceLabel = visual.PriceLabel,
		OwnerLabel = visual.OwnerLabel,
		Hat = if hatName and ExtrasConfig.HatByName[hatName] then hatName else nil,
		Seconds = math.max(0, seconds or 0),
		IncomeLabel = visual.IncomeLabel,
		LevelLabel = nil,
	}

	occupant.StealPrompt.Triggered:Connect(function(player: Player)
		onStealTriggered(occupant, player)
	end)
	occupant.SellPrompt.Triggered:Connect(function(player: Player)
		onSellTriggered(occupant, player)
	end)
	local upgradePrompt = occupant.UpgradePrompt :: ProximityPrompt
	upgradePrompt.Triggered:Connect(function(player: Player)
		onUpgradeTriggered(occupant, player)
	end)
	refreshUpgradePrompt(occupant)
	if BrainrotConfig.isLuckyBlock(definition) then
		local openPrompt = createPrompt(visual.PromptAttachment, "Open", "Open!", name, 0.6, Enum.KeyCode.E, owner.UserId)
		openPrompt.Triggered:Connect(function(player: Player)
			onOpenTriggered(occupant, player)
		end)
	else
		-- Hats, guard duty and pets: the client opens a menu for this one.
		createPrompt(visual.PromptAttachment, "Manage", "Manage", name, 0, Enum.KeyCode.G, owner.UserId)
	end

	if walkFrom then
		local snipePrompt = createPrompt(visual.PromptAttachment, "Snipe", "Buy " .. NumberFormat.cash(paid), name, 0, Enum.KeyCode.E, owner.UserId)
		snipePrompt:SetAttribute("Snipeable", false)
		snipePrompt.Triggered:Connect(function(player: Player)
			onSnipeTriggered(occupant, player)
		end)
		occupant.SnipePrompt = snipePrompt
		visual.Root.CFrame = walkFrom
		startWalk(occupant, walkFrom.Position)
	else
		visual.Root.CFrame = getSlotCFrame(plot, slotIndex)
	end

	plot.Occupants[slotIndex] = occupant
	refreshOccupantInfo(occupant)
	visual.Model.Parent = brainrotsFolder
	return occupant
end

local function destroyOccupant(occupant: Occupant)
	stopWalking(occupant)
	occupant.Model:Destroy()
end

--------------------------------------------------------------------------------
-- Buying a walking brainrot off its buyer
--------------------------------------------------------------------------------

onSnipeTriggered = function(occupant: Occupant, sniper: Player)
	local walk = occupant.Walk
	local ownerPlot = occupant.Plot
	local owner = ownerPlot.Owner
	if walk == nil or walk.Entered or occupant.Sniping or owner == nil or owner == sniper then
		return
	end
	if ownerPlot.Occupants[occupant.SlotIndex] ~= occupant then
		return
	end
	local sniperPlot = plotByPlayer[sniper]
	if sniperPlot == nil then
		notify(sniper, "You don't have a base yet.", "Error")
		return
	end
	if not isPlayerNear(sniper, occupant.PromptAttachment.WorldPosition) then
		return
	end
	local slotIndex = findFreeSlot(sniperPlot)
	if slotIndex == nil then
		notify(sniper, "Your base is full! Sell a brainrot first.", "Error")
		return
	end

	local price = occupant.Price
	local name = fullName(occupant.Definition, occupant.Mutation, occupant.Trait)
	occupant.Sniping = true
	sniperPlot.Reserved[slotIndex] = true
	local paid = spendCash(sniper, price)
	sniperPlot.Reserved[slotIndex] = nil
	occupant.Sniping = false
	if not paid then
		notify(sniper, string.format("You need %s to buy %s.", NumberFormat.cash(price), name), "Error")
		return
	end

	-- Anything could have changed while paying: if so, give the Cash back.
	local currentWalk = occupant.Walk
	if
		currentWalk == nil
		or currentWalk.Entered
		or occupant.Plot ~= ownerPlot
		or ownerPlot.Owner ~= owner
		or ownerPlot.Occupants[occupant.SlotIndex] ~= occupant
		or sniperPlot.Owner ~= sniper
		or sniperPlot.Occupants[slotIndex] ~= nil
	then
		addCash(sniper, price)
		return
	end

	ownerPlot.Occupants[occupant.SlotIndex] = nil
	if not saveBrainrots(ownerPlot) then
		ownerPlot.Occupants[occupant.SlotIndex] = occupant
		addCash(sniper, price)
		return
	end
	addCash(owner, price)

	occupant.Plot = sniperPlot
	occupant.SlotIndex = slotIndex
	sniperPlot.Occupants[slotIndex] = occupant
	saveBrainrots(sniperPlot)
	setOccupantOwner(occupant, sniper)
	refreshUpgradePrompt(occupant)
	startWalk(occupant, occupant.Root.Position)
	discover(sniper, occupant.Definition, occupant.Mutation)
	placePending(owner)

	notify(sniper, string.format("You bought %s off %s!", name, owner.DisplayName), "Success", "Purchase")
	notify(
		owner,
		string.format("%s bought your %s before it got home! You got %s back.", sniper.DisplayName, name, NumberFormat.cash(price)),
		"Error",
		"Sniped"
	)
end

--------------------------------------------------------------------------------
-- Stealing
--------------------------------------------------------------------------------

-- The base alarm rings while anyone carries a brainrot out of the base.
local function updateAlarm(plot: Plot)
	local active = false
	for _, carry in carries do
		if carry.VictimPlot == plot then
			active = true
			break
		end
	end
	if (plot.Model:GetAttribute("Alarm") == true) ~= active then
		plot.Model:SetAttribute("Alarm", active)
		local owner = plot.Owner
		if not active and owner then
			Api.baseAlarmEvent:FireClient(owner, nil, nil)
		end
	end
end

local function endCarry(carry: Carry, message: string?)
	local thief = carry.Thief
	if carries[thief] == carry then
		carries[thief] = nil
	end
	carry.TargetPlot.Reserved[carry.TargetSlot] = nil
	setCarrying(thief, false)

	local occupant = carry.Occupant
	occupant.Carrier = nil
	occupant.Root.Anchored = true
	carry.Weld:Destroy()

	local victimPlot = carry.VictimPlot
	if victimPlot.Occupants[occupant.SlotIndex] == occupant then
		occupant.Root.CFrame = getSlotCFrame(victimPlot, occupant.SlotIndex)
		occupant.Model:SetAttribute("State", "Idle")
		setOccupantCarried(occupant, false)
	else
		destroyOccupant(occupant)
	end

	if message then
		notify(thief, message, "Warning")
		local victim = victimPlot.Owner
		if victim then
			notify(victim, string.format("Your %s is back home.", fullName(occupant.Definition, occupant.Mutation, occupant.Trait)), "Success", "Returned")
		end
	end
	updateAlarm(victimPlot)
end

local function completeSteal(carry: Carry)
	local thief = carry.Thief
	local occupant = carry.Occupant
	local victimPlot = carry.VictimPlot
	local targetPlot = carry.TargetPlot
	local victim = victimPlot.Owner

	if victim == nil or targetPlot.Owner ~= thief or victimPlot.Occupants[occupant.SlotIndex] ~= occupant then
		endCarry(carry, nil)
		return
	end

	carries[thief] = nil
	targetPlot.Reserved[carry.TargetSlot] = nil
	setCarrying(thief, false)
	updateAlarm(victimPlot)

	-- Remove from the victim first: if the victim's data can no longer be
	-- written, the thief gets nothing rather than a duplicate.
	victimPlot.Occupants[occupant.SlotIndex] = nil
	destroyOccupant(occupant)
	if not saveBrainrots(victimPlot) then
		warn(string.format("%s Could not update %s's brainrots; steal cancelled.", LOG_PREFIX, victim.Name))
		return
	end

	-- A stolen brainrot starts over at level 1, and its hat falls off (back to
	-- its old owner).
	local hadHat = occupant.Hat
	returnHat(occupant, victim)
	placeOccupant(targetPlot, carry.TargetSlot, occupant.Definition, occupant.Mutation, occupant.Trait, nil, occupant.Price)
	saveBrainrots(targetPlot)
	DataApi.AddSteals:Invoke(thief, 1)
	discover(thief, occupant.Definition, occupant.Mutation)
	reportActivity(thief, "Steal")

	local name = fullName(occupant.Definition, occupant.Mutation, occupant.Trait)
	notify(thief, string.format("You stole %s!", name), "Success", "StealSuccess")
	notify(
		victim,
		string.format("%s stole your %s!%s", thief.DisplayName, name, if hadHat then " (You kept its hat.)" else ""),
		"Error",
		"Stolen"
	)
	Api.stolenEvent:Fire(thief, victim, occupantEntry(occupant))
	placePending(victim)
end

onStealTriggered = function(occupant: Occupant, thief: Player)
	local victimPlot = occupant.Plot
	local victim = victimPlot.Owner
	if victim == nil or victim == thief or occupant.Carrier ~= nil or occupant.Walk ~= nil or occupant.OpeningResult ~= nil then
		return
	end
	if victimPlot.Occupants[occupant.SlotIndex] ~= occupant then
		return
	end
	if carries[thief] then
		notify(thief, "You're already carrying a brainrot!", "Warning")
		return
	end
	local crew = thief:GetAttribute("CrewId")
	if crew ~= nil and victim:GetAttribute("CrewId") == crew then
		notify(thief, "That's your crewmate's brainrot!", "Warning")
		return
	end
	if thief:GetAttribute("CarryingLoot") == true then
		notify(thief, "Drop off your loot first!", "Warning")
		return
	end
	local thiefPlot = plotByPlayer[thief]
	if thiefPlot == nil then
		notify(thief, "You need a base to steal.", "Error")
		return
	end
	local rootPart, humanoid = getLiveCharacter(thief)
	if rootPart == nil or humanoid == nil or not isPlayerNear(thief, occupant.PromptAttachment.WorldPosition) then
		return
	end
	local targetSlot = findFreeSlot(thiefPlot)
	if targetSlot == nil then
		notify(thief, "Your base is full! Sell a brainrot first.", "Error")
		return
	end

	thiefPlot.Reserved[targetSlot] = true
	occupant.Carrier = thief
	occupant.Model:SetAttribute("State", "Carried")
	setOccupantCarried(occupant, true)

	local root = occupant.Root
	root.CFrame = rootPart.CFrame * CFrame.new(0, Tuning.CARRY_HEIGHT, 0)
	root.Anchored = false
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = rootPart
	weld.Part1 = root
	weld.Parent = root

	carries[thief] = {
		Thief = thief,
		Occupant = occupant,
		VictimPlot = victimPlot,
		TargetPlot = thiefPlot,
		TargetSlot = targetSlot,
		StartedAt = os.clock(),
		LastPosition = rootPart.Position,
		LastCheckedAt = os.clock(),
		Weld = weld,
	}
	setCarrying(thief, true)

	local name = fullName(occupant.Definition, occupant.Mutation, occupant.Trait)
	notify(thief, "Run it back to your base!", "Info", "Grab")
	notify(victim, string.format("%s is stealing your %s! Catch them!", thief.DisplayName, name), "Warning", "Alarm")
	victimPlot.Model:SetAttribute("Alarm", true)
	Api.baseAlarmEvent:FireClient(victim, thief, name)
end

onSellTriggered = function(occupant: Occupant, player: Player)
	local plot = occupant.Plot
	if
		plot.Owner ~= player
		or occupant.Carrier ~= nil
		or occupant.Walk ~= nil
		or occupant.OpeningResult ~= nil
		or plot.Occupants[occupant.SlotIndex] ~= occupant
	then
		return
	end
	if not isPlayerNear(player, occupant.PromptAttachment.WorldPosition) then
		return
	end

	plot.Occupants[occupant.SlotIndex] = nil
	if not saveBrainrots(plot) then
		plot.Occupants[occupant.SlotIndex] = occupant
		return
	end
	destroyOccupant(occupant)
	returnHat(occupant, player)

	local refund = math.floor(priceOf(occupant.Definition, occupant.Mutation, occupant.Trait) * GameConfig.SellRefundFraction)
	if refund > 0 then
		addCash(player, refund)
	end
	notify(
		player,
		string.format("Sold %s for %s", fullName(occupant.Definition, occupant.Mutation, occupant.Trait), NumberFormat.cash(refund)),
		"Success",
		"Sell"
	)
	placePending(player)
end

-- `catcher` is whoever made them drop it (a slap), for quests.
Api.forceDropEvent.Event:Connect(function(playerArg: any, message: any, catcher: any)
	if typeof(playerArg) ~= "Instance" or not playerArg:IsA("Player") then
		return
	end
	local carry = carries[playerArg]
	if carry then
		endCarry(carry, if typeof(message) == "string" then message else "You dropped the brainrot!")
		if typeof(catcher) == "Instance" and catcher:IsA("Player") and catcher ~= playerArg then
			reportActivity(catcher, "Catch")
		end
	end
end)

--------------------------------------------------------------------------------
-- Conveyor
--------------------------------------------------------------------------------

local function pickFromRarity(rarityName: string): Definition?
	local choices = BrainrotConfig.DropsByRarity[rarityName]
	if choices == nil or #choices == 0 then
		return nil
	end
	-- Events like Taco Tuesday make brainrots with a tag more likely.
	local event = activeEvent
	local boost = if event then event.TagBoost else nil
	if boost == nil then
		return choices[rng:NextInteger(1, #choices)]
	end
	local tagged: { Definition } = {}
	for _, definition in choices do
		if BrainrotConfig.hasTag(definition, boost.Tag) then
			table.insert(tagged, definition)
		end
	end
	if #tagged > 0 and rng:NextNumber() < boost.Share then
		return tagged[rng:NextInteger(1, #tagged)]
	end
	return choices[rng:NextInteger(1, #choices)]
end

local function resetGuaranteeTimer(rarityName: string)
	for _, rule in GameConfig.GuaranteedRarities do
		if rule.Rarity == rarityName then
			nextGuaranteedAt[rarityName] = Workspace:GetServerTimeNow() + rule.IntervalSeconds
		end
	end
end

local function rollDefinition(): Definition?
	-- A guaranteed spawn whose timer ran out wins over the random roll.
	local now = Workspace:GetServerTimeNow()
	for _, rule in GameConfig.GuaranteedRarities do
		if now >= (nextGuaranteedAt[rule.Rarity] or math.huge) then
			resetGuaranteeTimer(rule.Rarity)
			local guaranteed = pickFromRarity(rule.Rarity)
			if guaranteed then
				return guaranteed
			end
		end
	end

	local event = activeEvent
	local multiplier = (tonumber(DataApi.GetServerRarityMultiplier:Invoke()) or 1) * (if event and event.Luck then event.Luck else 1)
	-- OG finds: their own tiny chance on every spawn, raised by luck boosts.
	if #BrainrotConfig.OGFinds > 0 and rng:NextNumber() < BrainrotConfig.OGChance * multiplier then
		return BrainrotConfig.OGFinds[rng:NextInteger(1, #BrainrotConfig.OGFinds)]
	end
	local commonRarity = BrainrotConfig.Rarities[1]

	local totalWeight = 0
	local weights: { number } = {}
	for index, rarity in BrainrotConfig.Rarities do
		local weight = 0
		if #BrainrotConfig.DropsByRarity[rarity.Name] > 0 then
			weight = if rarity == commonRarity then rarity.Weight else rarity.Weight * multiplier
		end
		weights[index] = weight
		totalWeight += weight
	end
	if totalWeight <= 0 then
		return nil
	end

	local roll = rng:NextNumber(0, totalWeight)
	for index, rarity in BrainrotConfig.Rarities do
		roll -= weights[index]
		if roll <= 0 and weights[index] > 0 then
			resetGuaranteeTimer(rarity.Name)
			return pickFromRarity(rarity.Name)
		end
	end
	return pickFromRarity(commonRarity.Name)
end

local function mutationChance(mutation: Mutation): number
	local event = activeEvent
	if event and event.Mutation == mutation.Name then
		-- Event-only mutations get the event's own chance.
		if event.MutationChance then
			return event.MutationChance
		end
		return mutation.Chance * (event.ChanceMultiplier or 1)
	end
	-- The weather has variants too: Storm brainrots in thunderstorms, Frozen
	-- ones in the snow. ADMIN ABUSE can make Admin ones.
	local weatherChance = GameConfig.WeatherMutations[mutation.Name]
	if weatherChance and ReplicatedStorage:GetAttribute("Weather") == weatherChance.Weather then
		return weatherChance.Chance
	end
	if mutation.Name == "Admin" and event and event.AdminAbuse then
		return GameConfig.AdminMutationChance
	end
	return mutation.Chance
end

local function rollMutation(): Mutation?
	local roll = rng:NextNumber()
	for _, mutation in BrainrotConfig.Mutations do
		local chance = mutationChance(mutation)
		if roll < chance then
			return mutation
		end
		roll -= chance
	end
	-- Admin Abuse: everything gets a mutation.
	local event = activeEvent
	if event and event.AllMutated then
		local choices: { Mutation } = {}
		for _, mutation in BrainrotConfig.Mutations do
			if mutation.Chance > 0 or mutation.Name == event.Mutation then
				table.insert(choices, mutation)
			end
		end
		if #choices > 0 then
			return choices[rng:NextInteger(1, #choices)]
		end
	end
	return nil
end

local function rollTrait(): Trait?
	local event = activeEvent
	local luck = if event and event.TraitLuck then event.TraitLuck else 1
	local roll = rng:NextNumber()
	for _, trait in BrainrotConfig.Traits do
		local chance = trait.Chance * luck
		if roll < chance then
			return trait
		end
		roll -= chance
	end
	return nil
end

local function rollLuckyBlock(): Definition?
	local total = 0
	for _, weight in BrainrotConfig.LuckyBlockWeights do
		total += weight
	end
	local roll = rng:NextNumber(0, total)
	for _, definition in BrainrotConfig.LuckyBlocks do
		roll -= BrainrotConfig.LuckyBlockWeights[definition.Id] or 0
		if roll <= 0 and (BrainrotConfig.LuckyBlockWeights[definition.Id] or 0) > 0 then
			return definition
		end
	end
	return BrainrotConfig.ById.LuckyBlock
end

-- What a lucky block opens into: a rarity from its odds, then a brainrot of it.
local function rollFromOdds(odds: { [string]: number }): Definition?
	local total = 0
	for _, rarity in BrainrotConfig.Rarities do
		if #BrainrotConfig.DropsByRarity[rarity.Name] > 0 then
			total += odds[rarity.Name] or 0
		end
	end
	if total <= 0 then
		return nil
	end
	local roll = rng:NextNumber(0, total)
	for _, rarity in BrainrotConfig.Rarities do
		local weight = if #BrainrotConfig.DropsByRarity[rarity.Name] > 0 then odds[rarity.Name] or 0 else 0
		roll -= weight
		if roll <= 0 and weight > 0 then
			return pickFromRarity(rarity.Name)
		end
	end
	return nil
end

local function removeConveyorItem(item: ConveyorItem)
	if conveyorItems[item] then
		conveyorItems[item] = nil
		conveyorItemCount -= 1
	end
	item.Tween:Cancel()
	item.Model:Destroy()
end

local function onBuyTriggered(item: ConveyorItem, player: Player)
	if item.Sold or not conveyorItems[item] then
		return
	end
	local plot = plotByPlayer[player]
	if plot == nil then
		notify(player, "You don't have a base yet.", "Error")
		return
	end
	if not isPlayerNear(player, item.PromptAttachment.WorldPosition) then
		return
	end
	local slotIndex = findFreeSlot(plot)
	if slotIndex == nil then
		notify(player, "Your base is full! Sell a brainrot first.", "Error")
		return
	end

	local definition = item.Definition
	local name = fullName(definition, item.Mutation, item.Trait)
	item.Sold = true
	plot.Reserved[slotIndex] = true
	local paid = spendCash(player, item.Price)
	plot.Reserved[slotIndex] = nil

	if not paid then
		item.Sold = false
		notify(player, string.format("You need %s to buy %s.", NumberFormat.cash(item.Price), name), "Error")
		return
	end
	if plot.Owner ~= player then
		addCash(player, item.Price)
		item.Sold = false
		return
	end

	local fromCFrame = item.Root.CFrame
	removeConveyorItem(item)
	placeOccupant(plot, slotIndex, definition, item.Mutation, item.Trait, fromCFrame, item.Price)
	saveBrainrots(plot)
	notify(player, string.format("You bought %s! It's walking to your base.", name), "Success", "Purchase")
	discover(player, definition, item.Mutation)
	reportActivity(player, "Buy")
	local rarityIndex = 0
	for index, rarity in BrainrotConfig.Rarities do
		if rarity.Name == definition.Rarity then
			rarityIndex = index
		end
	end
	if rarityIndex >= 3 and not BrainrotConfig.isLuckyBlock(definition) then
		reportActivity(player, "BuyEpic")
	end
end

local function spawnConveyorBrainrot()
	local definition: Definition? = nil
	if rng:NextNumber() < BrainrotConfig.LuckyBlockChance then
		definition = rollLuckyBlock()
	end
	if definition == nil then
		definition = rollDefinition()
	end
	if definition == nil then
		return
	end
	local isBlock = BrainrotConfig.isLuckyBlock(definition)
	local mutation = if isBlock then nil else rollMutation()
	local trait = if isBlock then nil else rollTrait()
	local event = activeEvent
	local priceMultiplier = if event and event.PriceMultiplier then event.PriceMultiplier else 1
	local price = math.max(1, math.floor(priceOf(definition, mutation, trait) * priceMultiplier))

	local startPosition = conveyorStart.Position
	local endPosition = Vector3.new(conveyorEnd.Position.X, startPosition.Y, conveyorEnd.Position.Z)
	local direction = endPosition - startPosition
	if direction.Magnitude < 1 then
		return
	end
	local startCFrame = CFrame.lookAt(startPosition, endPosition)
	local endCFrame = startCFrame + direction

	local visual = buildBrainrot(definition, mutation, trait, price, nil)
	visual.Model:SetAttribute("State", "Conveyor")
	visual.Root.CFrame = startCFrame
	visual.Model.Parent = brainrotsFolder

	local tween = TweenService:Create(
		visual.Root,
		TweenInfo.new(direction.Magnitude / GameConfig.ConveyorSpeedStudsPerSecond, Enum.EasingStyle.Linear),
		{ CFrame = endCFrame }
	)

	local item: ConveyorItem = {
		Definition = definition,
		Mutation = mutation,
		Trait = trait,
		Price = price,
		Model = visual.Model,
		Root = visual.Root,
		PromptAttachment = visual.PromptAttachment,
		Tween = tween,
		Sold = false,
	}
	conveyorItems[item] = true
	conveyorItemCount += 1

	local prompt = createPrompt(
		visual.PromptAttachment,
		"Buy",
		"Buy " .. NumberFormat.cash(price),
		fullName(definition, mutation, trait),
		0,
		Enum.KeyCode.E,
		nil
	)
	prompt.Triggered:Connect(function(player: Player)
		onBuyTriggered(item, player)
	end)
	tween.Completed:Connect(function(playbackState: Enum.PlaybackState)
		if playbackState == Enum.PlaybackState.Completed and conveyorItems[item] then
			removeConveyorItem(item)
		end
	end)
	tween:Play()
	-- An OG is so rare that the whole server hears about it.
	if definition.Rarity == "OG" then
		for _, player in Players:GetPlayers() do
			notify(player, string.format("An OG %s is on the conveyor! It costs %s.", fullName(definition, mutation, trait), NumberFormat.cash(price)), "Success", "Event")
		end
	end
end

--------------------------------------------------------------------------------
-- Collect pads
--------------------------------------------------------------------------------

local function padCashList(plot: Plot): { number }
	local list: { number } = table.create(#plot.Slots)
	for index = 1, #plot.Slots do
		list[index] = math.floor(plot.PadCash[index] or 0)
	end
	return list
end

local function updatePadLabel(plot: Plot, index: number)
	local pad = plot.Pads[index]
	if pad == nil then
		return
	end
	local amount = math.floor(plot.PadCash[index] or 0)
	pad.Billboard.Enabled = plot.Owner ~= nil and (amount > 0 or plot.Occupants[index] ~= nil)
	pad.Amount.Text = NumberFormat.cash(amount)
	pad.Tag.Visible = plot.OfflinePads[index] == true and amount > 0
end

local function updatePadLabels(plot: Plot)
	for index in plot.Pads do
		updatePadLabel(plot, index)
	end
end

local function clearPads(plot: Plot)
	for index = 1, #plot.Slots do
		plot.PadCash[index] = 0
	end
	table.clear(plot.OfflinePads)
	updatePadLabels(plot)
end

local function isOnPad(pad: BasePart, position: Vector3): boolean
	local offset = pad.CFrame:PointToObjectSpace(position)
	return math.abs(offset.X) <= pad.Size.X / 2 + Tuning.PAD_REACH
		and math.abs(offset.Z) <= pad.Size.Z / 2 + Tuning.PAD_REACH
		and offset.Y >= -1
		and offset.Y <= 6
end

-- The owner standing on a pad collects its Cash.
local function collectPads(plot: Plot)
	local owner = plot.Owner
	local rootPart = if owner then getLiveCharacter(owner) else nil
	if owner == nil or rootPart == nil or not isInsidePart(plot.Interior, rootPart.Position) then
		return
	end
	for index, pad in plot.Pads do
		local amount = plot.PadCash[index] or 0
		local whole = math.floor(amount)
		if whole >= 1 and isOnPad(pad.Part, rootPart.Position) then
			local wasOffline = plot.OfflinePads[index]
			plot.PadCash[index] = amount - whole
			plot.OfflinePads[index] = nil
			if DataApi.CollectPadCash:Invoke(owner, whole, padCashList(plot)) == true then
				playSound(owner, "Collect")
				reportActivity(owner, "Collect")
			else
				plot.PadCash[index] = amount
				plot.OfflinePads[index] = wasOffline
			end
			updatePadLabel(plot, index)
		end
	end
end

local function createPadGui(part: BasePart): Pad
	local surface = Instance.new("SurfaceGui")
	surface.Name = "CollectGui"
	surface.Face = Enum.NormalId.Top
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.PixelsPerStud = 40
	surface.LightInfluence = 0

	local collectText = Instance.new("TextLabel")
	collectText.BackgroundTransparency = 1
	collectText.Size = UDim2.fromScale(1, 1)
	collectText.Font = Enum.Font.FredokaOne
	collectText.Text = "COLLECT"
	collectText.TextScaled = true
	collectText.TextColor3 = Color3.fromRGB(235, 255, 235)
	collectText.TextStrokeTransparency = 0.4
	collectText.Parent = surface
	surface.Parent = part

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "PadGui"
	billboard.Adornee = part
	billboard.Size = UDim2.fromScale(5, 1.75) -- studs, like everything in the world
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 2.2, 0)
	billboard.MaxDistance = 50
	billboard.LightInfluence = 0
	billboard.Enabled = false

	local tag = Instance.new("TextLabel")
	tag.Name = "Tag"
	tag.BackgroundTransparency = 1
	tag.Size = UDim2.fromScale(1, 0.4)
	tag.Font = Enum.Font.FredokaOne
	tag.Text = "OFFLINE CASH"
	tag.TextScaled = true
	tag.TextColor3 = Color3.fromRGB(255, 225, 70)
	tag.TextStrokeTransparency = 0.2
	tag.Visible = false
	tag.Parent = billboard

	local amount = Instance.new("TextLabel")
	amount.Name = "Amount"
	amount.BackgroundTransparency = 1
	amount.Position = UDim2.fromScale(0, 0.38)
	amount.Size = UDim2.fromScale(1, 0.62)
	amount.Font = Enum.Font.FredokaOne
	amount.Text = "$0"
	amount.TextScaled = true
	amount.TextColor3 = Color3.fromRGB(90, 255, 110)
	amount.TextStrokeTransparency = 0.1
	amount.Parent = billboard

	billboard.Parent = part
	return { Part = part, Billboard = billboard, Amount = amount, Tag = tag }
end

--------------------------------------------------------------------------------
-- Plots
--------------------------------------------------------------------------------

local function setLasersActive(plot: Plot, active: boolean)
	for _, laser in plot.Lasers do
		laser.Transparency = if active then 0.1 else 1
	end
end

local function updatePlotLabels(plot: Plot)
	local owner = plot.Owner
	if owner == nil then
		plot.SignTitle.Text = "Empty Base"
		plot.SignSubtitle.Text = ""
		plot.LockLabel.Text = ""
		return
	end
	plot.SignTitle.Text = owner.DisplayName .. "'s Base"
	plot.SignSubtitle.Text = NumberFormat.cash(tonumber(owner:GetAttribute("IncomePerSecond")) or 0) .. "/s"
	if isLocked(plot) then
		plot.LockLabel.Text = "LOCKED " .. NumberFormat.duration(plot.LockEndsAt - Workspace:GetServerTimeNow())
	else
		plot.LockLabel.Text = "STEP HERE TO LOCK"
	end
end

local function onLockButtonTouched(plot: Plot, hit: BasePart)
	local owner = plot.Owner
	local character = if owner then owner.Character else nil
	if owner == nil or character == nil or not hit:IsDescendantOf(character) or isLocked(plot) then
		return
	end
	-- The Long Lock pass makes it last longer.
	local seconds = GameConfig.LockDurationSeconds
	if DataApi.OwnsGamePass:Invoke(owner, "LongLock") == true then
		seconds *= FeatureConfig.LongLockMultiplier
	end
	plot.LockEndsAt = Workspace:GetServerTimeNow() + seconds
	plot.Model:SetAttribute("LockEndsAt", plot.LockEndsAt)
	setLasersActive(plot, true)
	updatePlotLabels(plot)
	notify(owner, string.format("Base locked for %d seconds!", seconds), "Success", "Lock")
	reportActivity(owner, "Lock")
end

local function createSign(sign: BasePart): (TextLabel, TextLabel)
	local surfaceGui = Instance.new("SurfaceGui")
	surfaceGui.Name = "SignGui"
	surfaceGui.Face = Enum.NormalId.Front
	surfaceGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surfaceGui.PixelsPerStud = 40
	surfaceGui.LightInfluence = 0

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Size = UDim2.fromScale(1, 0.62)
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = Color3.new(1, 1, 1)
	title.TextStrokeTransparency = 0.3
	title.Parent = surfaceGui

	local subtitle = Instance.new("TextLabel")
	subtitle.Name = "Subtitle"
	subtitle.BackgroundTransparency = 1
	subtitle.Position = UDim2.fromScale(0, 0.6)
	subtitle.Size = UDim2.fromScale(1, 0.36)
	subtitle.Font = Enum.Font.FredokaOne
	subtitle.TextScaled = true
	subtitle.TextColor3 = Color3.fromRGB(90, 255, 120)
	subtitle.TextStrokeTransparency = 0.3
	subtitle.Parent = surfaceGui

	surfaceGui.Parent = sign
	return title, subtitle
end

local function createLockLabel(lockButton: BasePart): TextLabel
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "LockGui"
	billboard.Adornee = lockButton
	billboard.Size = UDim2.fromScale(7, 1.4)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
	billboard.MaxDistance = 60
	billboard.LightInfluence = 0

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 90, 90)
	label.TextStrokeTransparency = 0.2
	label.Parent = billboard

	billboard.Parent = lockButton
	return label
end

local function findPart(parent: Instance, name: string): BasePart?
	local child = parent:FindFirstChild(name)
	if child and child:IsA("BasePart") then
		return child
	end
	return nil
end

local function collectNumberedParts(folder: Instance?, prefix: string): { [number]: BasePart }
	local parts: { [number]: BasePart } = {}
	if folder == nil then
		return parts
	end
	for _, child in folder:GetChildren() do
		local suffix = string.match(child.Name, "^" .. prefix .. "(%d+)$")
		if suffix and child:IsA("BasePart") then
			parts[tonumber(suffix) :: number] = child
		end
	end
	return parts
end

-- Numbered parts in order, skipping gaps.
local function sortedParts(parts: { [number]: BasePart }): { BasePart }
	local numbers: { number } = {}
	for number in parts do
		table.insert(numbers, number)
	end
	table.sort(numbers)
	local list: { BasePart } = {}
	for _, number in numbers do
		table.insert(list, parts[number])
	end
	return list
end

local function createFloorSign(part: BasePart): TextLabel
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "FloorGui"
	billboard.Adornee = part
	billboard.Size = UDim2.fromScale(12, 3)
	billboard.MaxDistance = 90
	billboard.LightInfluence = 0

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 220, 90)
	label.TextStrokeTransparency = 0.1
	label.Parent = billboard

	billboard.Parent = part
	return label
end

-- Shows which floors are still locked and what unlocks them.
local function updateFloorSigns(plot: Plot)
	for floor, label in plot.FloorSigns do
		local rebirths = GameConfig.FloorUnlockRebirths[floor] or 0
		if plot.Owner == nil or floor <= plot.UnlockedFloors then
			label.Text = ""
		else
			label.Text = string.format("🔒 Floor %d\nUnlocks at Rebirth %d", floor, rebirths)
		end
	end
end

local function refreshUnlockedFloors(plot: Plot)
	local owner = plot.Owner
	local data = if owner then getPlayerData(owner) else nil
	local rebirths = if data then tonumber(data.Rebirths) or 0 else 0
	local floors = math.max(1, GameConfig.getUnlockedFloors(rebirths))
	local maxFloors = math.ceil(#plot.Slots / GameConfig.SlotsPerFloor)
	floors = math.min(floors, maxFloors)
	if floors ~= plot.UnlockedFloors then
		local gained = floors > plot.UnlockedFloors and plot.UnlockedFloors > 0 and owner ~= nil
		plot.UnlockedFloors = floors
		plot.Model:SetAttribute("UnlockedFloors", floors)
		if gained and owner then
			notify(owner, string.format("Floor %d of your base is unlocked! More room for brainrots.", floors), "Success", "Purchase")
		end
	end
	updateFloorSigns(plot)
end

-- The walls, floors and neon trim a base skin recolours, with how they look
-- now so the Classic skin can put them back.
local function collectSkinParts(model: Instance): { SkinPart }
	local list: { SkinPart } = {}
	local function add(instance: Instance?, kind: string)
		if instance and instance:IsA("BasePart") and instance.Transparency < 0.5 then
			table.insert(list, { Part = instance, Kind = kind, Color = instance.Color, Material = instance.Material })
			if kind == "Trim" then
				instance:SetAttribute("SkinTrim", true)
			end
		end
	end
	add(model:FindFirstChild("Floor"), "Floor")
	add(model:FindFirstChild("Roof"), "Wall")
	add(model:FindFirstChild("WallAboveDoor"), "Wall")
	local walls = model:FindFirstChild("Walls")
	if walls then
		for _, child in walls:GetChildren() do
			if not string.find(child.Name, "Glass") and not string.find(child.Name, "Sill") then
				add(child, "Wall")
			end
		end
	end
	local floors = model:FindFirstChild("Floors")
	if floors then
		for _, child in floors:GetChildren() do
			if string.match(child.Name, "^Slab") or string.match(child.Name, "^Step") then
				add(child, "Floor")
			end
		end
	end
	local trim = model:FindFirstChild("Trim")
	if trim then
		for _, child in trim:GetChildren() do
			if child:IsA("BasePart") and (child.Material == Enum.Material.Neon or child.Name == "Pillar" or child.Name == "Flag") then
				add(child, "Trim")
			elseif child.Name == "RoofBlock" then
				add(child, "Wall")
			end
		end
	end
	return list
end

local function applySkin(plot: Plot, skinName: string?)
	local skin = if skinName then FeatureConfig.SkinByName[skinName] else nil
	local classic = skin == nil or skin.Effect == "Classic"
	for _, entry in plot.SkinParts do
		local part = entry.Part
		if skin == nil or classic then
			part.Color = entry.Color
			part.Material = entry.Material
		elseif entry.Kind == "Wall" then
			part.Color = skin.Wall
			part.Material = skin.WallMaterial
		elseif entry.Kind == "Floor" then
			part.Color = skin.Floor
			part.Material = skin.FloorMaterial
		else
			part.Color = skin.Trim
		end
	end
	plot.Model:SetAttribute("Skin", if skin and not classic then skin.Name else nil)
	plot.Model:SetAttribute("SkinEffect", if skin and not classic then skin.Effect else nil)
end

-- The skin a player has on, if they own it.
local function equippedSkin(player: Player): string?
	local skins = getProgress(player, "Skins")
	if typeof(skins) ~= "table" then
		return nil
	end
	local name = skins.Equipped
	local skin = if typeof(name) == "string" then FeatureConfig.SkinByName[name] else nil
	if skin == nil then
		return nil
	end
	local owned = typeof(skins.Owned) == "table" and table.find(skins.Owned, name) ~= nil
	return if owned or skin.Price == 0 then name else nil
end

local function loadPlot(model: Instance, index: number): Plot?
	if not model:IsA("Model") then
		return nil
	end
	local floor = findPart(model, "Floor")
	local interior = findPart(model, "Interior")
	local laserZone = findPart(model, "LaserZone")
	local lockButton = findPart(model, "LockButton")
	local spawnPoint = findPart(model, "SpawnPoint")
	local sign = findPart(model, "Sign")
	local slotParts = collectNumberedParts(model:FindFirstChild("Slots"), "Slot")
	local slots = sortedParts(slotParts)
	local lasers = sortedParts(collectNumberedParts(model:FindFirstChild("Lasers"), "Laser"))
	if floor == nil or interior == nil or laserZone == nil or lockButton == nil or spawnPoint == nil or sign == nil or #slots == 0 then
		warn(string.format("%s %s is missing parts and was skipped.", LOG_PREFIX, model:GetFullName()))
		return nil
	end

	-- Pad N belongs to Slot N.
	local pads: { [number]: Pad } = {}
	local padParts = collectNumberedParts(model:FindFirstChild("Pads"), "Pad")
	local padCash: { number } = {}
	for slotIndex, slot in slots do
		padCash[slotIndex] = 0
		for number, slotPart in slotParts do
			local padPart = padParts[number]
			if slotPart == slot and padPart then
				pads[slotIndex] = createPadGui(padPart)
			end
		end
	end

	-- Stairs and locked-floor signs on the upper floors.
	local stairs: { [number]: Stair } = {}
	local floorSigns: { [number]: TextLabel } = {}
	local floorsFolder = model:FindFirstChild("Floors")
	if floorsFolder then
		local bottoms = collectNumberedParts(floorsFolder, "StairBottom")
		local tops = collectNumberedParts(floorsFolder, "StairTop")
		for floorNumber, bottom in bottoms do
			local top = tops[floorNumber]
			if top then
				stairs[floorNumber] = { Bottom = bottom.Position, Top = top.Position }
			end
		end
		for floorNumber, signPart in collectNumberedParts(floorsFolder, "FloorSign") do
			floorSigns[floorNumber] = createFloorSign(signPart)
		end
	end

	local title, subtitle = createSign(sign)
	local plot: Plot = {
		Index = index,
		Model = model,
		Floor = floor,
		Interior = interior,
		LaserZone = laserZone,
		Carpet = findPart(model, "Carpet"),
		Lasers = lasers,
		SpawnPoint = spawnPoint,
		Slots = slots,
		Pads = pads,
		PadCash = padCash,
		OfflinePads = {},
		Occupants = {},
		Reserved = {},
		Owner = nil,
		LockEndsAt = 0,
		SignTitle = title,
		SignSubtitle = subtitle,
		LockLabel = createLockLabel(lockButton),
		Stairs = stairs,
		FloorSigns = floorSigns,
		UnlockedFloors = 1,
		Levels = table.create(#slots, 1),
		LevelRings = {},
		SkinParts = collectSkinParts(model),
	}

	model:SetAttribute("OwnerUserId", 0)
	model:SetAttribute("LockEndsAt", 0)
	model:SetAttribute("UnlockedFloors", 1)
	updateFloorSigns(plot)
	setLasersActive(plot, false)
	updatePlotLabels(plot)

	lockButton.Touched:Connect(function(hit: BasePart)
		onLockButtonTouched(plot, hit)
	end)
	return plot
end

local function teleportToPlot(player: Player)
	local plot = plotByPlayer[player]
	local character = player.Character
	if plot and character then
		character:PivotTo(plot.SpawnPoint.CFrame * CFrame.new(0, 4, 0))
	end
end

-- Uncollected Cash from last time goes back on the pads, and brainrots earn
-- offline cash for the time the player was away.
local function restorePads(player: Player, plot: Plot)
	local saved = DataApi.GetPadCash:Invoke(player)
	if typeof(saved) == "table" then
		for index, amount in saved do
			if typeof(index) == "number" and typeof(amount) == "number" and amount > 0 then
				-- A pad that no longer exists hands its Cash to the first one.
				local target = if index <= #plot.Slots then index else 1
				plot.PadCash[target] = (plot.PadCash[target] or 0) + amount
			end
		end
	end

	local seconds = tonumber(DataApi.TakeOfflineSeconds:Invoke(player)) or 0
	local total = 0
	if seconds >= GameConfig.OfflineMinSeconds then
		local earningSeconds = math.min(seconds, GameConfig.OfflineMaxHours * 3600)
		local incomeMultiplier = getIncomeMultiplier(player)
		local multiplier = incomeMultiplier * GameConfig.OfflineIncomeFraction
		for index, occupant in plot.Occupants do
			-- Offline cash at the level it had when its owner left; then it
			-- levels up for the time away too.
			local income = occupantIncome(occupant)
			local earned = math.floor(income * multiplier * earningSeconds)
			if not BrainrotConfig.isLuckyBlock(occupant.Definition) then
				occupant.Seconds += earningSeconds
				refreshOccupantInfo(occupant)
			end
			if earned > 0 then
				plot.PadCash[index] = (plot.PadCash[index] or 0) + earned
				plot.OfflinePads[index] = true
				total += earned
			end
		end
	end
	DataApi.SetPadCash:Invoke(player, padCashList(plot))
	updatePadLabels(plot)
	if total > 0 then
		saveBrainrots(plot)
	end

	if total > 0 then
		notify(
			player,
			string.format(
				"Welcome back! Your brainrots made %s while you were away (%s). Step on the green pads to collect it!",
				NumberFormat.cash(total),
				NumberFormat.duration(math.min(seconds, GameConfig.OfflineMaxHours * 3600))
			),
			"Success",
			"OfflineCash"
		)
	end
end

local function assignPlot(player: Player)
	if plotByPlayer[player] or player.Parent ~= Players then
		return
	end
	local plot: Plot? = nil
	for _, candidate in plots do
		if candidate.Owner == nil then
			plot = candidate
			break
		end
	end
	if plot == nil then
		notify(player, "Every base on this server is taken. Try another server!", "Error")
		return
	end

	plot.Owner = player
	plotByPlayer[player] = plot
	plot.Model:SetAttribute("OwnerUserId", player.UserId)
	plot.UnlockedFloors = 0
	refreshUnlockedFloors(plot)

	-- Pedestal upgrades, the Index and the base skin.
	local savedLevels = getProgress(player, "Pedestals")
	for index = 1, #plot.Slots do
		local level = if typeof(savedLevels) == "table" then tonumber(savedLevels[index]) else nil
		plot.Levels[index] = math.clamp(math.floor(level or 1), 1, FeatureConfig.maxPedestalLevel())
		updatePedestalLook(plot, index)
	end
	local found: { [string]: boolean } = {}
	local savedFound = getProgress(player, "Discovered")
	if typeof(savedFound) == "table" then
		for _, key in savedFound do
			if typeof(key) == "string" then
				found[key] = true
			end
		end
	end
	discovered[player] = found
	applySkin(plot, equippedSkin(player))

	local savedIds = DataApi.GetBrainrots:Invoke(player)
	local changed = false
	local nextSlot = 1
	if typeof(savedIds) == "table" then
		for _, entry in savedIds do
			local definition, mutation, trait = nil, nil, nil
			local hatName, seconds = nil, 0
			if typeof(entry) == "string" then
				definition, mutation, trait = BrainrotConfig.decode(entry)
				hatName, seconds = BrainrotConfig.decodeExtras(entry)
			end
			if definition and nextSlot <= #plot.Slots then
				placeOccupant(plot, nextSlot, definition, mutation, trait, nil, nil, hatName, seconds)
				discover(player, definition, mutation)
				nextSlot += 1
			else
				changed = true
			end
		end
	end

	-- A brand-new player gets one free brainrot so income starts right away.
	if nextSlot == 1 then
		local data = getPlayerData(player)
		local starter = BrainrotConfig.ById[GameConfig.StarterBrainrotId]
		if data and data.Cash == 0 and data.Rebirths == 0 and starter then
			placeOccupant(plot, 1, starter, nil, nil, nil, nil)
			discover(player, starter, nil)
			changed = true
			notify(player, string.format("Welcome! Here's a free %s to get you started.", starter.DisplayName), "Success")
		end
	end
	if changed then
		saveBrainrots(plot)
	end

	restorePads(player, plot)
	refreshIndex(player)
	placePending(player)
	updatePlotLabels(plot)
	teleportToPlot(player)
end

local function releasePlot(player: Player)
	local ownCarry = carries[player]
	if ownCarry then
		endCarry(ownCarry, nil)
	end

	local plot = plotByPlayer[player]
	if plot == nil then
		return
	end
	for _, carry in carries do
		if carry.VictimPlot == plot or carry.TargetPlot == plot then
			endCarry(carry, "The owner left, so the brainrot went back.")
		end
	end
	for _, occupant in plot.Occupants do
		destroyOccupant(occupant)
	end
	table.clear(plot.Occupants)
	table.clear(plot.Reserved)

	plotByPlayer[player] = nil
	plot.Owner = nil
	plot.LockEndsAt = 0
	plot.Model:SetAttribute("OwnerUserId", 0)
	plot.Model:SetAttribute("LockEndsAt", 0)
	plot.UnlockedFloors = 1
	plot.Model:SetAttribute("UnlockedFloors", 1)
	plot.Model:SetAttribute("Alarm", false)
	for index = 1, #plot.Slots do
		plot.Levels[index] = 1
		updatePedestalLook(plot, index)
	end
	applySkin(plot, nil)
	discovered[player] = nil
	indexBonus[player] = nil
	updateFloorSigns(plot)
	setLasersActive(plot, false)
	clearPads(plot)
	updatePlotLabels(plot)
end

--------------------------------------------------------------------------------
-- Ticks
--------------------------------------------------------------------------------

-- Horizontal speed check for thieves, so a teleport can't carry a stolen
-- brainrot home. Vertical movement (jumps, falls) is ignored.
local function movedTooFast(carry: Carry, position: Vector3, clock: number): boolean
	local elapsed = clock - carry.LastCheckedAt
	local offset = position - carry.LastPosition
	local horizontalDistance = Vector3.new(offset.X, 0, offset.Z).Magnitude
	carry.LastPosition = position
	carry.LastCheckedAt = clock
	local level = math.clamp(tonumber(carry.Thief:GetAttribute("SpeedLevel")) or 0, 0, #FeatureConfig.SpeedCosts)
	local bonus = math.max(0, ExtrasConfig.speedBonusOf(carry.Thief))
	local speed = GameConfig.CarryWalkSpeed + level * FeatureConfig.CarrySpeedPerLevel + bonus
	return horizontalDistance > speed * elapsed * 2 + GameConfig.CarrySpeedToleranceStuds
end

-- Runs every Tuning.FAST_TICK_SECONDS: laser doors, collect pads and brainrots being carried.
local function fastTick()
	for _, plot in plots do
		local owner = plot.Owner
		if owner and isLocked(plot) then
			local ownerCrew = owner:GetAttribute("CrewId")
			for _, player in Players:GetPlayers() do
				if player ~= owner and (ownerCrew == nil or player:GetAttribute("CrewId") ~= ownerCrew) then
					local rootPart, humanoid = getLiveCharacter(player)
					if
						rootPart
						and humanoid
						and isInsidePart(plot.LaserZone, rootPart.Position)
						and DataApi.IsLaserBypassActive:Invoke(player) ~= true
					then
						humanoid.Health = 0
						notify(player, "Zapped by the laser door!", "Error", "Zap")
					end
				end
			end
		end
		if owner then
			collectPads(plot)
		end
	end

	for thief, carry in carries do
		local rootPart = getLiveCharacter(thief)
		local clock = os.clock()
		if rootPart == nil then
			endCarry(carry, "You dropped the brainrot!")
		elseif movedTooFast(carry, rootPart.Position, clock) then
			endCarry(carry, "You moved too fast and dropped the brainrot!")
		elseif isInsidePart(carry.TargetPlot.Interior, rootPart.Position) then
			completeSteal(carry)
		elseif clock - carry.StartedAt > GameConfig.CarryTimeoutSeconds then
			endCarry(carry, "You took too long and dropped the brainrot!")
		else
			local victim = carry.VictimPlot.Owner
			local victimRoot = if victim then getLiveCharacter(victim) else nil
			if victim and victimRoot and (victimRoot.Position - rootPart.Position).Magnitude <= GameConfig.CatchDistance then
				endCarry(carry, "You got caught! The brainrot went back.")
				reportActivity(victim, "Catch")
			end
		end
	end
end

-- The spawn sign, brainrot levels and the slow tick (a block, so its helpers
-- aren't top-level locals; see Tuning).
local slowTick: () -> ()
do
	local spawnSignLabel: TextLabel? = nil
	do
		local spawnSign = conveyorFolder:FindFirstChild("SpawnSign", true)
		if spawnSign and spawnSign:IsA("BasePart") then
			local surfaceGui = Instance.new("SurfaceGui")
			surfaceGui.Name = "SignGui"
			surfaceGui.Face = Enum.NormalId.Front
			surfaceGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			surfaceGui.PixelsPerStud = 40
			surfaceGui.LightInfluence = 0

			local label = Instance.new("TextLabel")
			label.BackgroundColor3 = Color3.fromRGB(20, 24, 40)
			label.Size = UDim2.fromScale(1, 1)
			label.Font = Enum.Font.FredokaOne
			label.RichText = true
			label.TextScaled = true
			label.TextColor3 = Color3.new(1, 1, 1)
			label.Parent = surfaceGui
			surfaceGui.Parent = spawnSign
			spawnSignLabel = label
		end
	end

	local function updateSpawnSign()
		local label = spawnSignLabel
		if label == nil then
			return
		end
		local now = Workspace:GetServerTimeNow()
		local lines: { string } = {}
		for index = #GameConfig.GuaranteedRarities, 1, -1 do
			local rule = GameConfig.GuaranteedRarities[index]
			local rarity = BrainrotConfig.RarityByName[rule.Rarity]
			local colour = if rarity then rarity.Color:ToHex() else "ffffff"
			table.insert(
				lines,
				string.format(
					'Guaranteed <font color="#%s">%s</font> in %s',
					colour,
					rule.Rarity,
					NumberFormat.duration((nextGuaranteedAt[rule.Rarity] or now) - now)
				)
			)
		end
		label.Text = table.concat(lines, "\n")
	end

	-- Brainrots on their pedestals level up over time (lucky blocks don't).
	local levelsDirtyAt: { [Plot]: number } = {}
	Tuning.LEVEL_SAVE_SECONDS = 30

	local function levelUp(occupant: Occupant, owner: Player)
		if BrainrotConfig.isLuckyBlock(occupant.Definition) or occupant.OpeningResult then
			return
		end
		local before = ExtrasConfig.levelOf(occupant.Seconds)
		occupant.Seconds += Tuning.SLOW_TICK_SECONDS
		local after = ExtrasConfig.levelOf(occupant.Seconds)
		local plot = occupant.Plot
		levelsDirtyAt[plot] = levelsDirtyAt[plot] or os.clock()
		if after ~= before then
			refreshOccupantInfo(occupant)
			-- A new level is saved right away.
			levelsDirtyAt[plot] = nil
			saveBrainrots(plot)
			notify(
				owner,
				string.format("⭐ %s reached level %d! (+%d%% income)", occupant.Definition.DisplayName, after, math.floor(ExtrasConfig.IncomePerLevel * (after - 1) * 100 + 0.5)),
				"Success",
				"LevelUp"
			)
		end
	end

	-- Runs every Tuning.SLOW_TICK_SECONDS: income onto the pads, lock timers and signs.
	slowTick = function()
		local now = Workspace:GetServerTimeNow()
		for _, plot in plots do
			if plot.LockEndsAt > 0 and now >= plot.LockEndsAt then
				plot.LockEndsAt = 0
				plot.Model:SetAttribute("LockEndsAt", 0)
				setLasersActive(plot, false)
			end

			local owner = plot.Owner
			if owner then
				refreshUnlockedFloors(plot)
				local multiplier, boostInfo = getIncomeMultiplier(owner)
				local incomePerSecond = 0
				for index, occupant in plot.Occupants do
					if occupant.Carrier == nil and occupant.Walk == nil then
						local income = occupantIncome(occupant) * multiplier
						incomePerSecond += income
						plot.PadCash[index] = (plot.PadCash[index] or 0) + income * Tuning.SLOW_TICK_SECONDS
						levelUp(occupant, owner)
					end
				end
				owner:SetAttribute("IncomePerSecond", incomePerSecond)
				owner:SetAttribute("IncomeMultiplier", multiplier)
				-- Level time is saved every little while, not every second.
				local dirtySince = levelsDirtyAt[plot]
				if dirtySince and os.clock() - dirtySince >= Tuning.LEVEL_SAVE_SECONDS then
					levelsDirtyAt[plot] = nil
					saveBrainrots(plot)
				end
				owner:SetAttribute("BoostInfo", table.concat(boostInfo, "\n"))
				DataApi.SetPadCash:Invoke(owner, padCashList(plot))
				updatePadLabels(plot)
			end
			updatePlotLabels(plot)
		end
		updateSpawnSign()
	end
end

local function runLoop(intervalSeconds: number, name: string, callback: () -> ())
	task.spawn(function()
		while true do
			task.wait(intervalSeconds)
			xpcall(callback, function(err: any)
				warn(string.format("%s %s failed: %s", LOG_PREFIX, name, tostring(err)))
			end)
		end
	end)
end

--------------------------------------------------------------------------------
-- Mutation events
--------------------------------------------------------------------------------

local function notifyAll(message: string, kind: NotifyKind, sound: string?)
	for _, player in Players:GetPlayers() do
		notify(player, message, kind, sound)
	end
end

local function eventMessage(event: GameEvent): string
	local duration = NumberFormat.duration(GameConfig.EventDurationSeconds)
	local boost = event.TagBoost
	if event.AdminAbuse then
		return string.format(
			"ADMIN ABUSE!!! For %s: every brainrot is mutated, prices are cut, %sx luck, traits everywhere and Cash is raining!",
			duration,
			tostring(event.Luck or 1)
		)
	elseif event.Boss then
		return "BOSS RAID! A giant brainrot is stomping around the middle of the map. Click it (or slap it) to beat it together!"
	elseif event.Heist then
		return string.format("BANK HEIST! The vault is open for %s. Grab loot bags and run them home!", duration)
	elseif boost then
		return string.format(
			"%s! Half the brainrots are %s brainrots, and %s-mutated ones can spawn, for %s!",
			event.Name,
			boost.Tag,
			boost.Tag,
			duration
		)
	elseif event.CashRain then
		return string.format("%s! Grab the Cash falling from the sky (and look out for Cash brainrots) for %s!", event.Name, duration)
	elseif event.Luck then
		return string.format("%s! Rare brainrots are %sx more likely, and Lucky ones can spawn, for %s!", event.Name, tostring(event.Luck), duration)
	elseif event.Mutation and event.MutationChance then
		return string.format("%s! %s brainrots can spawn on the conveyor for %s!", event.Name, event.Mutation, duration)
	elseif event.Mutation then
		return string.format(
			"%s! %s brainrots are %sx more common for %s!",
			event.Name,
			event.Mutation,
			tostring(event.ChanceMultiplier or 1),
			duration
		)
	end
	return string.format("%s for %s!", event.Name, duration)
end

-- Cash Rain: coins land around the map; the first player to touch one gets
-- Cash worth a few seconds of their income.
local spawnCoinWave: () -> ()
local clearCoins: () -> ()
local collectCoins: () -> ()
do
	local coinExpiresAt: { [BasePart]: number } = {}
	local coinArea: { Min: Vector3, Max: Vector3 }? = nil
	do
		local baseplate = Workspace:FindFirstChild("Baseplate")
		if baseplate and baseplate:IsA("BasePart") then
			local half = baseplate.Size / 2 - Vector3.new(24, 0, 24)
			local top = baseplate.Position.Y + baseplate.Size.Y / 2
			coinArea = {
				Min = Vector3.new(baseplate.Position.X - half.X, top, baseplate.Position.Z - half.Z),
				Max = Vector3.new(baseplate.Position.X + half.X, top, baseplate.Position.Z + half.Z),
			}
		end
	end

	local function coinSpot(): Vector3?
		local area = coinArea
		if area == nil then
			return nil
		end
		for _ = 1, 8 do
			local x = rng:NextNumber(area.Min.X, area.Max.X)
			local z = rng:NextNumber(area.Min.Z, area.Max.Z)
			-- Only on open ground: not on a roof or inside a base.
			local hit = Workspace:Raycast(Vector3.new(x, area.Min.Y + 80, z), Vector3.new(0, -100, 0))
			if hit and hit.Position.Y <= area.Min.Y + 1.5 and not hit.Instance:IsDescendantOf(plotsFolder) then
				return Vector3.new(x, hit.Position.Y, z)
			end
		end
		return nil
	end

	spawnCoinWave = function()
		local expiresAt = os.clock() + GameConfig.CashRainWaveSeconds * 2.5
		for _ = 1, GameConfig.CashRainCoinsPerWave do
			local spot = coinSpot()
			if spot then
				local coin = Instance.new("Part")
				coin.Name = "Coin"
				coin.Shape = Enum.PartType.Cylinder
				coin.Size = Vector3.new(0.5, 3, 3)
				coin.Material = Enum.Material.Neon
				coin.Color = Color3.fromRGB(255, 205, 50)
				coin.Anchored = true
				coin.CanCollide = false
				coin.CanQuery = false
				coin.CanTouch = false
				coin.CFrame = CFrame.new(spot + Vector3.new(0, 2.2, 0))
				coin:SetAttribute("Spin", true)
				coin.Parent = coinsFolder
				coinExpiresAt[coin] = expiresAt
			end
		end
	end

	clearCoins = function()
		for coin in coinExpiresAt do
			coin:Destroy()
		end
		table.clear(coinExpiresAt)
	end

	-- Called from the fast tick.
	collectCoins = function()
		if next(coinExpiresAt) == nil then
			return
		end
		local clock = os.clock()
		local roots: { [Player]: BasePart } = {}
		for _, player in Players:GetPlayers() do
			local rootPart = getLiveCharacter(player)
			if rootPart then
				roots[player] = rootPart
			end
		end
		for coin, expiresAt in coinExpiresAt do
			if clock >= expiresAt or coin.Parent == nil then
				coinExpiresAt[coin] = nil
				coin:Destroy()
				continue
			end
			for player, rootPart in roots do
				if (rootPart.Position - coin.Position).Magnitude <= 5 then
					local income = tonumber(player:GetAttribute("IncomePerSecond")) or 0
					local amount = math.max(GameConfig.CashRainMinCoin, math.floor(income * GameConfig.CashRainCoinIncomeSeconds))
					coinExpiresAt[coin] = nil
					coin:Destroy()
					if addCash(player, amount) then
						playSound(player, "Collect")
						notify(player, "+" .. NumberFormat.cash(amount) .. " from the Cash Rain!", "Success")
					end
					break
				end
			end
		end
	end
end

Api.eventChangedEvent = Instance.new("BindableEvent")
Api.eventChangedEvent.Name = "EventChanged"
Api.eventChangedEvent.Parent = Api.gameplayApi

local function runEvent(event: GameEvent)
	local endsAt = Workspace:GetServerTimeNow() + GameConfig.EventDurationSeconds
	activeEvent = event
	ReplicatedStorage:SetAttribute("EventName", event.Name)
	ReplicatedStorage:SetAttribute("EventMutation", event.Mutation)
	ReplicatedStorage:SetAttribute("EventSky", event.Sky)
	ReplicatedStorage:SetAttribute("EventParticles", event.Particles)
	ReplicatedStorage:SetAttribute("EventAdmin", event.AdminAbuse == true)
	ReplicatedStorage:SetAttribute("EventEndsAt", endsAt)
	notifyAll(eventMessage(event), "Info", "Event")
	-- Boss raids and bank heists are run by RaidManager.
	Api.eventChangedEvent:Fire(event.Name)
	-- The EventEndsAt attribute is the end time: /endevent moves it to now.
	local nextWave = 0
	while true do
		local now = Workspace:GetServerTimeNow()
		endsAt = tonumber(ReplicatedStorage:GetAttribute("EventEndsAt")) or 0
		if now >= endsAt then
			break
		end
		if event.CashRain and now >= nextWave then
			spawnCoinWave()
			nextWave = now + GameConfig.CashRainWaveSeconds
		end
		task.wait(math.clamp(endsAt - now, 0.1, 1))
	end
	activeEvent = nil
	clearCoins()
	ReplicatedStorage:SetAttribute("EventName", nil)
	ReplicatedStorage:SetAttribute("EventMutation", nil)
	ReplicatedStorage:SetAttribute("EventSky", nil)
	ReplicatedStorage:SetAttribute("EventParticles", nil)
	ReplicatedStorage:SetAttribute("EventAdmin", false)
	ReplicatedStorage:SetAttribute("EventEndsAt", 0)
	Api.eventChangedEvent:Fire(nil)
	notifyAll(event.Name .. " is over.", "Info")
end

--------------------------------------------------------------------------------
-- Rebirth
--------------------------------------------------------------------------------

Api.requestRebirthFunction.OnServerInvoke = function(player: Player): (boolean, string)
	local now = os.clock()
	local last = lastRebirthRequest[player]
	if last and now - last < Tuning.REBIRTH_REQUEST_COOLDOWN_SECONDS then
		return false, "Slow down!"
	end
	lastRebirthRequest[player] = now

	local data = getPlayerData(player)
	if data == nil then
		return false, "Your data is still loading."
	end
	local rebirths = tonumber(data.Rebirths) or 0
	local cash = tonumber(data.Cash) or 0
	local cost = GameConfig.getRebirthCost(rebirths)
	if cash < cost then
		return false, string.format("You need %s to rebirth.", NumberFormat.cash(cost))
	end
	-- Each rebirth also needs certain brainrots at home in your base.
	local plot = plotByPlayer[player]
	local missing: { string } = {}
	for _, brainrotId in FeatureConfig.getRebirthRequirement(rebirths) do
		local found = false
		if plot then
			for _, occupant in plot.Occupants do
				if occupant.Definition.Id == brainrotId and occupant.Walk == nil and occupant.Carrier == nil then
					found = true
					break
				end
			end
		end
		if not found then
			local definition = BrainrotConfig.ById[brainrotId]
			table.insert(missing, if definition then definition.DisplayName else brainrotId)
		end
	end
	if #missing > 0 then
		return false, "You also need " .. table.concat(missing, " and ") .. " in your base to rebirth."
	end

	-- Rebirthing resets Cash and the pads to 0 and keeps your brainrots.
	if not spendCash(player, cash) then
		return false, "Rebirth failed, try again."
	end
	DataApi.AddRebirths:Invoke(player, 1)
	reportActivity(player, "Rebirth")
	if plot then
		clearPads(plot)
		refreshUnlockedFloors(plot)
	end
	DataApi.SetPadCash:Invoke(player, if plot then padCashList(plot) else {})

	local message = string.format(
		"Rebirth %d! Your income is now x%s.",
		rebirths + 1,
		tostring(GameConfig.getRebirthIncomeMultiplier(rebirths + 1))
	)
	for _, other in Players:GetPlayers() do
		if other ~= player then
			notify(other, string.format("%s just reached Rebirth %d!", player.DisplayName, rebirths + 1), "Info")
		end
	end
	return true, message
end

--------------------------------------------------------------------------------
-- Pedestal upgrades
--------------------------------------------------------------------------------

onUpgradeTriggered = function(occupant: Occupant, player: Player)
	local plot = occupant.Plot
	local slotIndex = occupant.SlotIndex
	if plot.Owner ~= player or occupant.Walk ~= nil or occupant.Carrier ~= nil or plot.Occupants[slotIndex] ~= occupant then
		return
	end
	if not isPlayerNear(player, occupant.PromptAttachment.WorldPosition) then
		return
	end
	local level = plot.Levels[slotIndex] or 1
	local cost = FeatureConfig.PedestalCosts[level]
	if cost == nil then
		notify(player, "This pedestal is already max level!", "Info")
		return
	end
	if not spendCash(player, cost) then
		notify(player, string.format("You need %s to upgrade this pedestal.", NumberFormat.cash(cost)), "Error")
		return
	end
	if plot.Owner ~= player then
		addCash(player, cost)
		return
	end
	plot.Levels[slotIndex] = level + 1
	setProgress(player, "Pedestals", plot.Levels)
	updatePedestalLook(plot, slotIndex)
	refreshUpgradePrompt(occupant)
	refreshOccupantInfo(occupant)
	notify(
		player,
		string.format("Pedestal upgraded to Lv %d! Brainrots here earn %s.", level + 1, percent(FeatureConfig.PedestalBonus * level)),
		"Success",
		"Purchase"
	)
	reportActivity(player, "Upgrade")
end

--------------------------------------------------------------------------------
-- Lucky blocks
--------------------------------------------------------------------------------

onOpenTriggered = function(occupant: Occupant, player: Player)
	local plot = occupant.Plot
	local slotIndex = occupant.SlotIndex
	local odds = occupant.Definition.Odds
	if
		odds == nil
		or plot.Owner ~= player
		or occupant.Walk ~= nil
		or occupant.Carrier ~= nil
		or occupant.OpeningResult ~= nil
		or plot.Occupants[slotIndex] ~= occupant
	then
		return
	end
	if not isPlayerNear(player, occupant.PromptAttachment.WorldPosition) then
		return
	end
	local definition = rollFromOdds(odds)
	if definition == nil then
		return
	end
	local mutation = rollMutation()
	local trait = rollTrait()
	local entry = entryOf(definition, mutation, trait)

	-- Saved as the result straight away, so leaving mid-reveal loses nothing.
	occupant.OpeningResult = entry
	if not saveBrainrots(plot) then
		occupant.OpeningResult = nil
		return
	end
	occupant.Model:SetAttribute("State", "Opening")
	setPromptFlag(occupant, "Carried", true)
	Api.luckyRevealEvent:FireAllClients(player.UserId, occupant.Definition.Id, entry, occupant.Root.Position)
	reportActivity(player, "OpenBlock")

	-- The block shakes while the client shows a roulette, then pops.
	task.delay(2.8, function()
		if plot.Owner ~= player or plot.Occupants[slotIndex] ~= occupant then
			return
		end
		plot.Occupants[slotIndex] = nil
		destroyOccupant(occupant)
		local placed = placeOccupant(plot, slotIndex, definition, mutation, trait, nil, nil)
		if placed then
			placed.Model:SetAttribute("Arrived", Workspace:GetServerTimeNow())
		end
		saveBrainrots(plot)
		discover(player, definition, mutation)
		local name = fullName(definition, mutation, trait)
		notify(player, string.format("Your %s opened into %s!", occupant.Definition.DisplayName, name), "Success", "StealSuccess")
		if definition.Rarity == "Secret" or definition.Rarity == "Brainrot God" then
			for _, other in Players:GetPlayers() do
				if other ~= player then
					notify(other, string.format("%s unboxed %s (%s)!", player.DisplayName, name, definition.Rarity), "Info", "Event")
				end
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- Gifts, fusing and trading (for RewardsManager, FuseManager, TradeManager)
--------------------------------------------------------------------------------

do
	local MAX_PENDING = 50

	local function freeSlotCount(plot: Plot): number
		local limit = math.min(#plot.Slots, plot.UnlockedFloors * GameConfig.SlotsPerFloor)
		local count = 0
		for index = 1, limit do
			if plot.Occupants[index] == nil and not plot.Reserved[index] then
				count += 1
			end
		end
		return count
	end

	placePending = function(player: Player)
		local plot = plotByPlayer[player]
		if plot == nil or plot.Owner ~= player then
			return
		end
		local pending = getProgress(player, "Pending")
		if typeof(pending) ~= "table" or #pending == 0 or findFreeSlot(plot) == nil then
			return
		end
		local remaining: { string } = {}
		local placed = 0
		for _, entry in pending do
			if typeof(entry) ~= "string" then
				continue
			end
			local definition, mutation, trait = BrainrotConfig.decode(entry)
			if definition == nil then
				continue
			end
			local slotIndex = findFreeSlot(plot)
			local occupant = if slotIndex then placeOccupant(plot, slotIndex, definition, mutation, trait, nil, nil) else nil
			if occupant then
				placed += 1
				occupant.Model:SetAttribute("Arrived", Workspace:GetServerTimeNow())
				discover(player, definition, mutation)
				notify(player, string.format("%s arrived in your base!", fullName(definition, mutation, trait)), "Success", "Purchase")
			else
				table.insert(remaining, entry)
			end
		end
		if placed > 0 then
			saveBrainrots(plot)
			setProgress(player, "Pending", remaining)
		end
	end

	-- Puts a brainrot (or lucky block) in the player's base, or queues it until
	-- a pedestal is free.
	local function giveBrainrot(player: Player, entry: string): string?
		local definition, mutation, trait = BrainrotConfig.decode(entry)
		if definition == nil or player.Parent ~= Players then
			return nil
		end
		local plot = plotByPlayer[player]
		local slotIndex = if plot then findFreeSlot(plot) else nil
		if plot and slotIndex then
			local occupant = placeOccupant(plot, slotIndex, definition, mutation, trait, nil, nil)
			if occupant then
				occupant.Model:SetAttribute("Arrived", Workspace:GetServerTimeNow())
				saveBrainrots(plot)
				discover(player, definition, mutation)
				return "Placed"
			end
		end
		local pending = getProgress(player, "Pending")
		local list = if typeof(pending) == "table" then pending else {}
		if #list >= MAX_PENDING then
			return nil
		end
		table.insert(list, entry)
		if not setProgress(player, "Pending", list) then
			return nil
		end
		notify(
			player,
			string.format("No room for %s yet! It'll show up when a pedestal is free.", fullName(definition, mutation, trait)),
			"Warning"
		)
		return "Pending"
	end

	-- The player's brainrots on these pedestals, if every one is at home and
	-- free to hand over (not walking, carried or being opened).
	local function idleOccupants(player: Player, slots: any): { Occupant }?
		local plot = plotByPlayer[player]
		if plot == nil or typeof(slots) ~= "table" or #slots > 16 then
			return nil
		end
		local list: { Occupant } = {}
		local seen: { [number]: boolean } = {}
		for _, slotIndex in slots do
			if typeof(slotIndex) ~= "number" or seen[slotIndex] then
				return nil
			end
			seen[slotIndex] = true
			local occupant = plot.Occupants[slotIndex]
			if occupant == nil or occupant.Walk ~= nil or occupant.Carrier ~= nil or occupant.OpeningResult ~= nil or occupant.Sniping then
				return nil
			end
			table.insert(list, occupant)
		end
		return list
	end

	local function takeBrainrots(player: Player, slots: any): { string }?
		local occupants = idleOccupants(player, slots)
		local plot = plotByPlayer[player]
		if occupants == nil or plot == nil or #occupants == 0 then
			return nil
		end
		local entries: { string } = {}
		for _, occupant in occupants do
			plot.Occupants[occupant.SlotIndex] = nil
			table.insert(entries, occupantEntry(occupant))
		end
		if not saveBrainrots(plot) then
			for _, occupant in occupants do
				plot.Occupants[occupant.SlotIndex] = occupant
			end
			return nil
		end
		for _, occupant in occupants do
			destroyOccupant(occupant)
			returnHat(occupant, player)
		end
		return entries
	end

	-- Swaps brainrots between two bases in one step: all of it happens or none.
	local function tradeBrainrots(first: Player, firstSlots: any, second: Player, secondSlots: any): boolean
		if first == second or getPlayerData(first) == nil or getPlayerData(second) == nil then
			return false
		end
		local firstPlot, secondPlot = plotByPlayer[first], plotByPlayer[second]
		local fromFirst, fromSecond = idleOccupants(first, firstSlots), idleOccupants(second, secondSlots)
		if firstPlot == nil or secondPlot == nil or fromFirst == nil or fromSecond == nil then
			return false
		end
		if #fromFirst + #fromSecond == 0 or #fromFirst > FeatureConfig.MaxTradeItems or #fromSecond > FeatureConfig.MaxTradeItems then
			return false
		end
		if freeSlotCount(firstPlot) + #fromFirst < #fromSecond or freeSlotCount(secondPlot) + #fromSecond < #fromFirst then
			return false
		end
		for _, occupant in fromFirst do
			firstPlot.Occupants[occupant.SlotIndex] = nil
		end
		for _, occupant in fromSecond do
			secondPlot.Occupants[occupant.SlotIndex] = nil
		end
		local function move(occupants: { Occupant }, plot: Plot, receiver: Player, giver: Player)
			for _, occupant in occupants do
				returnHat(occupant, giver)
				local slotIndex = findFreeSlot(plot)
				if slotIndex then
					local placed = placeOccupant(
						plot,
						slotIndex,
						occupant.Definition,
						occupant.Mutation,
						occupant.Trait,
						nil,
						occupant.Price,
						nil,
						occupant.Seconds
					)
					if placed then
						placed.Model:SetAttribute("Arrived", Workspace:GetServerTimeNow())
					end
					discover(receiver, occupant.Definition, occupant.Mutation)
				end
				destroyOccupant(occupant)
			end
		end
		move(fromFirst, secondPlot, second, first)
		move(fromSecond, firstPlot, first, second)
		saveBrainrots(firstPlot)
		saveBrainrots(secondPlot)
		DataApi.SaveNow:Invoke(first)
		DataApi.SaveNow:Invoke(second)
		placePending(first)
		placePending(second)
		return true
	end

	local function createApiFunction(name: string, callback: (...any) -> ...any)
		local bindable = Instance.new("BindableFunction")
		bindable.Name = name
		bindable.OnInvoke = callback
		bindable.Parent = Api.gameplayApi
	end

	local function asPlayer(value: any): Player?
		if typeof(value) == "Instance" and value:IsA("Player") then
			return value
		end
		return nil
	end

	createApiFunction("GiveBrainrot", function(playerArg: any, entry: any): string?
		local player = asPlayer(playerArg)
		if player == nil or typeof(entry) ~= "string" then
			return nil
		end
		local result = giveBrainrot(player, entry)
		placePending(player)
		return result
	end)

	createApiFunction("TakeBrainrots", function(playerArg: any, slots: any): { string }?
		local player = asPlayer(playerArg)
		return if player then takeBrainrots(player, slots) else nil
	end)

	createApiFunction("TradeBrainrots", function(firstArg: any, firstSlots: any, secondArg: any, secondSlots: any): boolean
		local first, second = asPlayer(firstArg), asPlayer(secondArg)
		return first ~= nil and second ~= nil and tradeBrainrots(first, firstSlots, second, secondSlots)
	end)

	createApiFunction("DescribeSlots", function(playerArg: any, slots: any): { string }?
		local player = asPlayer(playerArg)
		local occupants = if player then idleOccupants(player, slots) else nil
		if occupants == nil then
			return nil
		end
		local entries: { string } = {}
		for _, occupant in occupants do
			table.insert(entries, occupantEntry(occupant))
		end
		return entries
	end)

	-- Every brainrot in the player's base (not lucky blocks), as a list of
	-- infos with their Slot. (A list, because Bindables copy tables and a
	-- table keyed by slot numbers with gaps doesn't survive the copy.)
	createApiFunction("DescribeOccupants", function(playerArg: any): { { [string]: any } }?
		local player = asPlayer(playerArg)
		local plot = if player then plotByPlayer[player] else nil
		if plot == nil then
			return nil
		end
		local result: { { [string]: any } } = {}
		for slotIndex, occupant in plot.Occupants do
			if not BrainrotConfig.isLuckyBlock(occupant.Definition) and occupant.OpeningResult == nil then
				table.insert(result, {
					Slot = slotIndex,
					Entry = occupantEntry(occupant),
					Hat = occupant.Hat,
					Level = ExtrasConfig.levelOf(occupant.Seconds),
					Rarity = occupant.Definition.Rarity,
					Home = occupant.Walk == nil and occupant.Carrier == nil,
				})
			end
		end
		return result
	end)

	-- Hats: the owner puts one on (from their pile) or takes it off.
	local manageFunction = Instance.new("RemoteFunction")
	manageFunction.Name = "ManageBrainrot"
	manageFunction.Parent = Api.remotesFolder
	local lastManage: { [Player]: number } = {}
	manageFunction.OnServerInvoke = function(player: Player, action: any, slotIndex: any, argument: any): (boolean, string?, any)
		local now = os.clock()
		if action ~= "Info" and now - (lastManage[player] or 0) < 0.3 then
			return false, "Slow down!"
		end
		lastManage[player] = now
		local plot = plotByPlayer[player]
		local occupant = if plot and typeof(slotIndex) == "number" then plot.Occupants[slotIndex] else nil
		if plot == nil or occupant == nil or plot.Owner ~= player or BrainrotConfig.isLuckyBlock(occupant.Definition) then
			return false, "That brainrot isn't in your base."
		end
		if action == "Info" then
			return true, nil, {
				Level = ExtrasConfig.levelOf(occupant.Seconds),
				NextLevelIn = ExtrasConfig.secondsToNextLevel(occupant.Seconds),
				Hat = occupant.Hat,
				Income = occupantIncome(occupant),
				Hats = DataApi.GetHats:Invoke(player) or {},
			}
		end
		if occupant.Walk ~= nil or occupant.Carrier ~= nil or occupant.OpeningResult ~= nil then
			return false, "Wait until it's back on its pedestal."
		end
		if action == "PutHat" then
			local hat = if typeof(argument) == "string" then ExtrasConfig.HatByName[argument] else nil
			if hat == nil then
				return false, "You don't have that hat."
			end
			if occupant.Hat == hat.Name then
				return false, "It's already wearing one!"
			end
			if DataApi.TakeHat:Invoke(player, hat.Name) ~= true then
				return false, "You don't have that hat."
			end
			returnHat(occupant, player)
			occupant.Hat = hat.Name
			refreshOccupantInfo(occupant)
			saveBrainrots(plot)
			playSound(player, "Purchase")
			return true, string.format("%s is wearing the %s: +%d%% income!", occupant.Definition.DisplayName, hat.DisplayName, math.floor(hat.Bonus * 100 + 0.5))
		elseif action == "RemoveHat" then
			if occupant.Hat == nil then
				return false, "It isn't wearing a hat."
			end
			returnHat(occupant, player)
			refreshOccupantInfo(occupant)
			saveBrainrots(plot)
			return true, "Hat taken off."
		end
		return false, nil
	end
	Players.PlayerRemoving:Connect(function(player: Player)
		lastManage[player] = nil
	end)

	createApiFunction("GetIncome", function(playerArg: any): number
		local player = asPlayer(playerArg)
		return if player then tonumber(player:GetAttribute("IncomePerSecond")) or 0 else 0
	end)

	DataApi.ProgressChanged.Event:Connect(function(playerArg: any, key: any)
		local player = asPlayer(playerArg)
		if player == nil then
			return
		end
		if key == "Pending" then
			placePending(player)
		elseif key == "Skins" then
			local plot = plotByPlayer[player]
			if plot then
				applySkin(plot, equippedSkin(player))
			end
		end
	end)
end

--------------------------------------------------------------------------------
-- Friends, Premium and the group (income boosts)
--------------------------------------------------------------------------------

local updateSocial: (player: Player) -> ()
local onChatted: (player: Player, message: string) -> ()
local startEvent: (event: GameEvent) -> ()

updateSocial = function(player: Player)
	local friends = friendsOf[player] or {}
	friendsOf[player] = friends
	for _, other in Players:GetPlayers() do
		if other ~= player and friends[other.UserId] == nil then
			local ok, isFriend = pcall(function(): boolean
				return player:IsFriendsWithAsync(other.UserId)
			end)
			if ok then
				friends[other.UserId] = isFriend == true
				local theirs = friendsOf[other]
				if theirs then
					theirs[player.UserId] = isFriend == true
				end
				if isFriend == true and player.Parent == Players then
					notify(player, string.format("%s is your friend: +%d%% income for you both!", other.DisplayName, math.floor(FeatureConfig.FriendBoost * 100)), "Success")
					notify(other, string.format("%s is your friend: +%d%% income for you both!", player.DisplayName, math.floor(FeatureConfig.FriendBoost * 100)), "Success")
				end
			end
		end
	end
	if FeatureConfig.GroupId ~= 0 and inGroup[player] == nil then
		local ok, member = pcall(function(): boolean
			return player:IsInGroupAsync(FeatureConfig.GroupId)
		end)
		inGroup[player] = ok and member == true
	end
end

--------------------------------------------------------------------------------
-- Admin event commands (chat):
--   /events          list the events and these commands
--   /event <name>    start an event now, e.g. /event gold rush or /event lava
--   /abuse           start ADMIN ABUSE
--   /endevent        end the current event now
-- Starting an event ends the one running first. Only admins can use them:
-- FeatureConfig.AdminUserIds, the place's owner, and anyone in Studio.
-- They reach the server three ways (the new chat's TextChatCommands, the
-- client passing those on, and Player.Chatted); each command runs once.
--------------------------------------------------------------------------------

do
	local function isAdmin(player: Player): boolean
		if RunService:IsStudio() or table.find(FeatureConfig.AdminUserIds, player.UserId) ~= nil then
			return true
		end
		return game.CreatorType == Enum.CreatorType.User and game.CreatorId == player.UserId
	end

	startEvent = function(event: GameEvent)
		xpcall(runEvent, function(err: any)
			activeEvent = nil
			clearCoins()
			warn(string.format("%s Event failed: %s", LOG_PREFIX, tostring(err)))
		end, event)
	end

	local allEvents: { GameEvent } = table.clone(GameConfig.Events)
	table.insert(allEvents, GameConfig.AdminAbuseEvent)

	-- "Gold Rush" -> "goldrush"
	local function squash(text: string): string
		return (string.gsub(string.lower(text), "[^%w]", ""))
	end

	-- Exact name first, then the start of a name, then anywhere in one.
	local function findEvent(query: string): GameEvent?
		local key = squash(query)
		if key == "" then
			return nil
		end
		for pass = 1, 3 do
			for _, event in allEvents do
				local name = squash(event.Name)
				if
					(pass == 1 and name == key)
					or (pass == 2 and string.sub(name, 1, #key) == key)
					or (pass == 3 and string.find(name, key, 1, true) ~= nil)
				then
					return event
				end
			end
		end
		return nil
	end

	-- Ends the running event and waits for it to clean up. False if it didn't.
	local function endCurrentEvent(): boolean
		if activeEvent == nil then
			return true
		end
		ReplicatedStorage:SetAttribute("EventEndsAt", Workspace:GetServerTimeNow())
		local giveUpAt = Workspace:GetServerTimeNow() + 5
		while activeEvent ~= nil and Workspace:GetServerTimeNow() < giveUpAt do
			task.wait(0.1)
		end
		return activeEvent == nil
	end

	local function startByCommand(player: Player, event: GameEvent)
		if not endCurrentEvent() then
			notify(player, "The current event didn't end. Try again in a moment.", "Warning")
			return
		end
		notify(player, "Starting " .. event.Name .. "!", "Success")
		task.spawn(startEvent, event)
	end

	local function listEvents(player: Player)
		local names = {}
		for _, event in allEvents do
			table.insert(names, event.Name)
		end
		notify(player, "Events: " .. table.concat(names, ", "), "Info")
		notify(player, "Chat /event <name> to start one, /abuse for ADMIN ABUSE, /endevent to stop it.", "Info")
	end

	-- The same command can arrive more than once (see above).
	local lastCommand: { [Player]: { text: string, at: number } } = setmetatable({}, { __mode = "k" }) :: any

	onChatted = function(player: Player, message: string)
		local word, rest = string.match(message, "^%s*/(%S+)%s*(.-)%s*$")
		if word == nil or rest == nil then
			return
		end
		local command = string.lower(word)
		if command ~= "events" and command ~= "event" and command ~= "abuse" and command ~= "endevent" then
			return
		end
		local now = Workspace:GetServerTimeNow()
		local last = lastCommand[player]
		if last and last.text == message and now - last.at < 2 then
			return
		end
		lastCommand[player] = { text = message, at = now }
		print(string.format("%s %s used %s", LOG_PREFIX, player.Name, message))
		if not isAdmin(player) then
			notify(player, "Only admins can use /" .. command .. ".", "Warning")
			print(string.format("%s To let %s use commands, add %d to FeatureConfig.AdminUserIds.", LOG_PREFIX, player.Name, player.UserId))
			return
		end

		if command == "events" then
			listEvents(player)
		elseif command == "abuse" then
			startByCommand(player, GameConfig.AdminAbuseEvent)
		elseif command == "endevent" then
			local current = activeEvent
			if current == nil then
				notify(player, "No event is running.", "Warning")
			elseif endCurrentEvent() then
				notify(player, "Ended " .. current.Name .. ".", "Success")
			end
		elseif rest == "" then
			notify(player, "Say which event, like /event gold rush. Chat /events to see them all.", "Warning")
		else
			local event = findEvent(rest)
			if event then
				startByCommand(player, event)
			else
				notify(player, string.format('No event called "%s". Chat /events to see them all.', rest), "Warning")
			end
		end
	end

	-- Register the commands with the new chat, so they don't show up in chat.
	-- Always: ChatVersion is deprecated and can still say LegacyChatService
	-- while the new chat runs, and Player.Chatted doesn't fire there.
	local okChat, textChatService = pcall(function(): TextChatService
		return game:GetService("TextChatService")
	end)
	if okChat and textChatService then
		for _, alias in { "/events", "/event", "/abuse", "/endevent" } do
			local chatCommand = Instance.new("TextChatCommand")
			chatCommand.Name = "BrainrotEvent" .. string.sub(alias, 2)
			chatCommand.PrimaryAlias = alias
			chatCommand.AutocompleteVisible = false
			chatCommand.Triggered:Connect(function(source: TextSource, text: string)
				local player = Players:GetPlayerByUserId(source.UserId)
				if player then
					onChatted(player, text)
				end
			end)
			chatCommand.Parent = textChatService
		end
	end
	Api.chatCommandEvent.OnServerEvent:Connect(function(player: Player, text: any)
		if typeof(text) == "string" and #text <= 200 then
			onChatted(player, text)
		end
	end)
end

--------------------------------------------------------------------------------
-- Purchase announcements
--------------------------------------------------------------------------------

DataApi.EMPLaserOverriderPurchased.Event:Connect(function(player: any, durationSeconds: any)
	if typeof(player) == "Instance" and player:IsA("Player") then
		notify(player, string.format("EMP active! Walk through laser doors for %d seconds.", tonumber(durationSeconds) or 0), "Success", "Purchase")
	end
end)

DataApi.ServerRarityBoostChanged.Event:Connect(function(multiplier: any, _endsAt: any, purchaser: any)
	local boost = tonumber(multiplier) or 1
	if boost <= 1 or typeof(purchaser) ~= "Instance" or not purchaser:IsA("Player") then
		return
	end
	notifyAll(
		string.format("%s activated a x%s Rarity Boost for the whole server!", purchaser.DisplayName, tostring(boost)),
		"Success",
		"Event"
	)
end)

--------------------------------------------------------------------------------
-- Player lifecycle
--------------------------------------------------------------------------------

local function onCharacterAdded(player: Player, character: Model)
	local rootPart = character:WaitForChild("HumanoidRootPart", 10)
	if rootPart and player.Character == character then
		task.defer(teleportToPlot, player)
	end
end

local function onPlayerAdded(player: Player)
	player:SetAttribute("Carrying", false)
	player.CharacterAdded:Connect(function(character: Model)
		onCharacterAdded(player, character)
	end)
	player.Chatted:Connect(function(message: string)
		onChatted(player, message)
	end)
	task.spawn(updateSocial, player)

	if player:GetAttribute("DataLoaded") == true then
		assignPlot(player)
		return
	end
	local connection: RBXScriptConnection? = nil
	connection = player:GetAttributeChangedSignal("DataLoaded"):Connect(function()
		if player:GetAttribute("DataLoaded") == true then
			if connection then
				connection:Disconnect()
			end
			assignPlot(player)
		end
	end)
end

local function onPlayerRemoving(player: Player)
	releasePlot(player)
	lastRebirthRequest[player] = nil
	friendsOf[player] = nil
	inGroup[player] = nil
end

--------------------------------------------------------------------------------
-- Startup
--------------------------------------------------------------------------------

do
	local ok, result, missing = pcall(prepareImportedModels)
	if not ok then
		warn(string.format("%s Couldn't set up the imported brainrot models: %s", LOG_PREFIX, tostring(result)))
	elseif result > 0 then
		print(string.format("%s Using %d imported brainrot models.", LOG_PREFIX, result))
		if typeof(missing) == "table" and #missing > 0 then
			local names = {}
			for _, brainrotId in missing do
				table.insert(names, string.format("%s (One/%s.glb)", BrainrotConfig.ById[brainrotId].DisplayName, brainrotId))
			end
			warn(
				string.format(
					"%s %d brainrots have no imported model, so they're built from blocks: %s. To add one, import BrainrotModels/Import/One/<Id>.glb (File > Import 3D) and play again.",
					LOG_PREFIX,
					#missing,
					table.concat(names, ", ")
				)
			)
		end
	else
		warn(
			string.format(
				"%s No imported brainrot models yet, so the ones made on Customuse and Higgsfield are built from rough blocks and look mushy. For the real models, import BrainrotModels/Import/BrainrotModels.glb (File > Import 3D), save and play again.",
				LOG_PREFIX
			)
		)
	end
	-- In Studio, the StudioNotice banner says how many brainrots made on
	-- Customuse or Higgsfield have no imported model (they look mushy).
	if RunService:IsStudio() then
		local notImported = 0
		for _, definition in BrainrotConfig.Brainrots do
			if definition.Kind == "Brainrot" and not definition.BlockBuilt and TemplateModels.get(definition.Id) == nil then
				notImported += 1
			end
		end
		ReplicatedStorage:SetAttribute("ModelsNotImported", notImported)
	end
end

do
	local plotModels = plotsFolder:GetChildren()
	table.sort(plotModels, function(a, b)
		local aNumber = tonumber(string.match(a.Name, "%d+")) or math.huge
		local bNumber = tonumber(string.match(b.Name, "%d+")) or math.huge
		return aNumber < bNumber
	end)
	for _, model in plotModels do
		local plot = loadPlot(model, #plots + 1)
		if plot then
			table.insert(plots, plot)
		end
	end
	if #plots == 0 then
		warn(string.format("%s No usable plots found in %s.", LOG_PREFIX, plotsFolder:GetFullName()))
	end
end

ReplicatedStorage:SetAttribute("EventEndsAt", 0)
ReplicatedStorage:SetAttribute("EventAdmin", false)
-- Every API function exists by now.
Api.gameplayApi.Parent = ServerStorage

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

runLoop(Tuning.FAST_TICK_SECONDS, "Fast tick", fastTick)
runLoop(Tuning.FAST_TICK_SECONDS, "Cash Rain", collectCoins)
runLoop(Tuning.SLOW_TICK_SECONDS, "Slow tick", slowTick)

RunService.Heartbeat:Connect(function(dt: number)
	xpcall(stepWalkers, function(err: any)
		warn(string.format("%s Walking failed: %s", LOG_PREFIX, tostring(err)))
	end, dt)
end)

task.spawn(function()
	while true do
		task.wait(GameConfig.ConveyorSpawnIntervalSeconds)
		if conveyorItemCount < GameConfig.MaxConveyorBrainrots then
			xpcall(spawnConveyorBrainrot, function(err: any)
				warn(string.format("%s Conveyor spawn failed: %s", LOG_PREFIX, tostring(err)))
			end)
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(rng:NextNumber(GameConfig.EventMinGapSeconds, GameConfig.EventMaxGapSeconds))
		local events = GameConfig.Events
		if #events > 0 and activeEvent == nil then
			local event = events[rng:NextInteger(1, #events)]
			if rng:NextNumber() < FeatureConfig.AdminAbuseChance then
				event = GameConfig.AdminAbuseEvent
			end
			startEvent(event)
		end
	end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="286">
      <Properties>
        <string name="Name">GearManager</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
	GearManager
	Location: ServerScriptService (Script)

	The Gear Shop: sells the gear in GearConfig for Cash, saves what each player
	owns, hands the tools out on every spawn and makes them work:
	  Slap                a big glove on a stick that knocks other players
	                      back; a slapped thief drops the brainrot they carry
	  Speed Coil          runs faster while held
	  Gravity Coil        jumps much higher while held
	  Invisibility Cloak  click to turn invisible for a few seconds; grabbing a
	                      brainrot reveals you
	Coils do nothing while carrying a stolen brainrot, so thieves stay catchable.

	Troll items bought with Robux come as charges (saved by the data manager)
	and show up as tools while you have charges left:
	  Freeze Ray   freezes the player you face in a block of ice
	  Spike Trap   placed at your feet; whoever steps on it gets stuck
	  Land Mine    placed at your feet; launches whoever steps on it
	  Boogie Bomb  everyone around you dances and can't move
	Each makes a thief drop the brainrot they are carrying.

	Everything is decided here: the client only equips and clicks tools (which
	Roblox reports to the server) and calls BuyGear, which is re-checked
	(known gear, not owned yet, near the Gear Shop, enough Cash).

	Client-facing state:
	  ReplicatedStorage.Remotes.BuyGear (RemoteFunction: gearId -> (ok, message))
	  Player attribute OwnedGear (comma-separated gear IDs)
	  Player attribute Stunned (string: "Frozen" | "Spiked" | "Launched" |
	    "Dancing") while a troll item holds them
	  Workspace.Map.Traps (placed spike traps and land mines)
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ExtrasConfig = require(Shared:WaitForChild("ExtrasConfig"))
local FeatureConfig = require(Shared:WaitForChild("FeatureConfig"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local GearConfig = require(Shared:WaitForChild("GearConfig"))
local NumberFormat = require(Shared:WaitForChild("NumberFormat"))

type Gear = GearConfig.Gear
type TrollItem = GearConfig.TrollItem

-- A placed spike trap or land mine.
type Trap = {
	Kind: string,
	Owner: Player,
	Model: Model,
	Position: Vector3,
	ExpiresAt: number,
	Light: BasePart?,
}

local BUY_COOLDOWN_SECONDS = 0.5
local KNOCKBACK_SECONDS = 0.18
local TRAP_CHECK_SECONDS = 0.1
-- Roblox's R15 "dance" emote animation.
local DANCE_ANIMATION_ID = "rbxassetid://507771019"

local dataApi = ServerStorage:WaitForChild("DataAndMonetization")
local getGearFunction = dataApi:WaitForChild("GetGear") :: BindableFunction
local addGearFunction = dataApi:WaitForChild("AddGear") :: BindableFunction
local spendCashFunction = dataApi:WaitForChild("SpendCash") :: BindableFunction
local addCashFunction = dataApi:WaitForChild("AddCash") :: BindableFunction
local getItemsFunction = dataApi:WaitForChild("GetItems") :: BindableFunction
local useItemChargeFunction = dataApi:WaitForChild("UseItemCharge") :: BindableFunction
local itemsChangedEvent = dataApi:WaitForChild("ItemsChanged") :: BindableEvent
local gameplayApi = ServerStorage:WaitForChild("Gameplay")
local forceDropEvent = gameplayApi:WaitForChild("ForceDrop") :: BindableEvent
local activityEvent = gameplayApi:WaitForChild("Activity") :: BindableEvent

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local notifyEvent = remotes:WaitForChild("Notify") :: RemoteEvent
local playSoundEvent = remotes:WaitForChild("PlaySound") :: RemoteEvent

local buyGearFunction = Instance.new("RemoteFunction")
buyGearFunction.Name = "BuyGear"
buyGearFunction.Parent = remotes

-- Server API (ServerStorage.Gear) for guards and bosses:
--   BindableFunction Knockback(player, direction, strength, stunSeconds?)
--   BindableEvent    SlapSwing(player)   every swing of a slap glove
--   BindableEvent    Slapped(player, target)   a slap that hit someone
local gearApi = Instance.new("Folder")
gearApi.Name = "Gear"
local knockbackFunction = Instance.new("BindableFunction")
knockbackFunction.Name = "Knockback"
knockbackFunction.Parent = gearApi
local slapSwingEvent = Instance.new("BindableEvent")
slapSwingEvent.Name = "SlapSwing"
slapSwingEvent.Parent = gearApi
local slappedEvent = Instance.new("BindableEvent")
slappedEvent.Name = "Slapped"
slappedEvent.Parent = gearApi

local lastBuyRequest: { [Player]: number } = {}
local lastSlap: { [Player]: number } = {}
local lastCloak: { [Player]: number } = {}
-- Parts hidden by the cloak and the transparency to give back.
local cloaked: { [Player]: { [Instance]: number } } = {}
local lastItemUse: { [Player]: number } = {}
-- Players held in place by a troll item, until this os.clock() time.
local stunnedUntil: { [Player]: number } = {}
local traps: { Trap } = {}

local trapsFolder = Instance.new("Folder")
trapsFolder.Name = "Traps"
trapsFolder.Parent = Workspace:WaitForChild("Map")

--------------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------------

local function notify(player: Player, message: string, kind: string, sound: string?)
	notifyEvent:FireClient(player, message, kind, sound)
end

local function getLiveCharacter(player: Player): (BasePart?, Humanoid?)
	local character = player.Character
	if character == nil then
		return nil, nil
	end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if rootPart == nil or not rootPart:IsA("BasePart") or humanoid == nil or humanoid.Health <= 0 then
		return nil, nil
	end
	return rootPart, humanoid
end

local function getOwnedGear(player: Player): { string }
	local owned: { string } = {}
	for _, gear in GearConfig.Gear do
		if gear.Price <= 0 then
			table.insert(owned, gear.Id)
		end
	end
	local saved = getGearFunction:Invoke(player)
	if typeof(saved) == "table" then
		for _, gearId in saved do
			if typeof(gearId) == "string" and GearConfig.ById[gearId] and table.find(owned, gearId) == nil then
				table.insert(owned, gearId)
			end
		end
	end
	return owned
end

local function equippedGearId(player: Player): string?
	local character = player.Character
	local tool = if character then character:FindFirstChildOfClass("Tool") else nil
	local gearId = if tool then tool:GetAttribute("GearId") else nil
	return if typeof(gearId) == "string" then gearId else nil
end

-- Walk speed and jump height from the held gear and the Speed upgrade
-- (the SpeedLevel attribute, set by RewardsManager). GameplayManager sets
-- Carrying while a stolen brainrot is carried; coils don't work then.
local function applyMovement(player: Player)
	local _, humanoid = getLiveCharacter(player)
	if humanoid == nil then
		return
	end
	local carrying = player:GetAttribute("Carrying") == true
	local gearId = if carrying then nil else equippedGearId(player)
	local stunned = (stunnedUntil[player] or 0) > os.clock()
	if stunned then
		humanoid.WalkSpeed = 0
		humanoid.UseJumpPower = false
		humanoid.JumpHeight = 0
		return
	end
	local level = math.clamp(tonumber(player:GetAttribute("SpeedLevel")) or 0, 0, #FeatureConfig.SpeedCosts)
	-- Revenge, a pet and carrying loot add to (or take from) the speed.
	local bonus = ExtrasConfig.speedBonusOf(player)
	humanoid.WalkSpeed = bonus
		+ if carrying
			then GameConfig.CarryWalkSpeed + level * FeatureConfig.CarrySpeedPerLevel
			elseif gearId == "SpeedCoil" then GameConfig.DefaultWalkSpeed + level * FeatureConfig.SpeedPerLevel + GearConfig.SpeedCoilBonus
			else GameConfig.DefaultWalkSpeed + level * FeatureConfig.SpeedPerLevel
	humanoid.UseJumpPower = false
	humanoid.JumpHeight = if gearId == "GravityCoil" then GearConfig.GravityCoilJumpHeight else GearConfig.DefaultJumpHeight
end

--------------------------------------------------------------------------------
-- Invisibility Cloak
--------------------------------------------------------------------------------

local function uncloak(player: Player, message: string?)
	local hidden = cloaked[player]
	if hidden == nil then
		return
	end
	cloaked[player] = nil
	for instance, transparency in hidden do
		if instance:IsA("BasePart") then
			instance.Transparency = transparency
		elseif instance:IsA("Decal") then
			instance.Transparency = transparency
		end
	end
	-- SocialManager shows the name tag again.
	player:SetAttribute("Cloaked", nil)
	if message then
		notify(player, message, "Warning")
	end
end

local function cloak(player: Player)
	local rootPart, humanoid = getLiveCharacter(player)
	local character = player.Character
	if rootPart == nil or humanoid == nil or character == nil or cloaked[player] then
		return
	end
	if player:GetAttribute("Carrying") == true then
		notify(player, "You can't hide while carrying a brainrot!", "Error")
		return
	end
	local now = os.clock()
	local last = lastCloak[player]
	if last and now - last < GearConfig.CloakCooldownSeconds then
		notify(player, string.format("The cloak recharges in %ds.", math.ceil(GearConfig.CloakCooldownSeconds - (now - last))), "Warning")
		return
	end
	lastCloak[player] = now

	local hidden: { [Instance]: number } = {}
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BasePart") and descendant ~= rootPart then
			hidden[descendant] = descendant.Transparency
			descendant.Transparency = 1
		elseif descendant:IsA("Decal") then
			hidden[descendant] = descendant.Transparency
			descendant.Transparency = 1
		end
	end
	cloaked[player] = hidden
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	-- SocialManager hides the name tag while this is set.
	player:SetAttribute("Cloaked", true)
	notify(player, string.format("You're invisible for %d seconds!", GearConfig.CloakSeconds), "Success", "Cloak")

	task.delay(GearConfig.CloakSeconds, function()
		if cloaked[player] == hidden then
			uncloak(player, "You're visible again.")
		end
	end)
end

--------------------------------------------------------------------------------
-- Slap
--------------------------------------------------------------------------------

local function knockback(rootPart: BasePart, direction: Vector3, strength: number?)
	local attachment = rootPart:FindFirstChild("RootAttachment")
	if attachment == nil or not attachment:IsA("Attachment") then
		local created = Instance.new("Attachment")
		created.Name = "SlapAttachment"
		created.Parent = rootPart
		attachment = created
	end
	-- The constraint replicates to the player's own client, which simulates
	-- their character, so the push works on player-owned physics.
	local velocity = Instance.new("LinearVelocity")
	velocity.Name = "SlapKnockback"
	velocity.Attachment0 = attachment :: Attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	velocity.MaxForce = 1e6
	velocity.VectorVelocity = direction * (strength or GearConfig.SlapKnockback) + Vector3.new(0, 30, 0)
	velocity.Parent = rootPart
	Debris:AddItem(velocity, KNOCKBACK_SECONDS)
end

local function slap(player: Player, tool: Tool)
	local now = os.clock()
	local last = lastSlap[player]
	if last and now - last < GearConfig.SlapCooldownSeconds then
		return
	end
	lastSlap[player] = now
	local rootPart = getLiveCharacter(player)
	if rootPart == nil or tool.Parent ~= player.Character then
		return
	end

	slapSwingEvent:Fire(player)

	-- Plays the character's tool swing animation.
	local swing = Instance.new("StringValue")
	swing.Name = "toolanim"
	swing.Value = "Slash"
	swing.Parent = tool
	Debris:AddItem(swing, 1)

	local target: Player? = nil
	local targetRoot: BasePart? = nil
	local bestDistance = math.huge
	local facing = rootPart.CFrame.LookVector
	for _, other in Players:GetPlayers() do
		if other ~= player then
			local otherRoot = getLiveCharacter(other)
			if otherRoot then
				local offset = otherRoot.Position - rootPart.Position
				local distance = offset.Magnitude
				if distance > 0 and distance <= GearConfig.SlapRange and facing:Dot(offset.Unit) > 0.2 and distance < bestDistance then
					target, targetRoot, bestDistance = other, otherRoot, distance
				end
			end
		end
	end
	if target == nil or targetRoot == nil then
		playSoundEvent:FireClient(player, "Swing")
		return
	end

	local offset = targetRoot.Position - rootPart.Position
	knockback(targetRoot, Vector3.new(offset.X, 0, offset.Z).Unit)
	playSoundEvent:FireClient(player, "Slap")
	playSoundEvent:FireClient(target, "Slap")
	activityEvent:Fire(player, "Slap", 1)
	slappedEvent:Fire(player, target)
	if target:GetAttribute("Carrying") == true then
		forceDropEvent:Fire(target, string.format("%s slapped you and you dropped the brainrot!", player.DisplayName), player)
		notify(player, string.format("You slapped %s and they dropped the brainrot!", target.DisplayName), "Success")
	end
end

--------------------------------------------------------------------------------
-- Troll items
--------------------------------------------------------------------------------

local function newPart(name: string, size: Vector3, color: Color3, material: Enum.Material): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

-- Holds a player in place for a while (the longest hold wins).
local function stun(target: Player, seconds: number, kind: string)
	local untilClock = math.max(stunnedUntil[target] or 0, os.clock() + seconds)
	stunnedUntil[target] = untilClock
	target:SetAttribute("Stunned", kind)
	applyMovement(target)
	task.delay(seconds, function()
		if stunnedUntil[target] == untilClock then
			stunnedUntil[target] = nil
			target:SetAttribute("Stunned", nil)
			applyMovement(target)
		end
	end)
end

local function dropBrainrot(target: Player, attacker: Player, message: string)
	if target:GetAttribute("Carrying") == true then
		forceDropEvent:Fire(target, message, attacker)
		notify(attacker, string.format("%s dropped the brainrot they were stealing!", target.DisplayName), "Success")
	end
end

-- The other player most in front of `rootPart`, within `range`.
local function findTargetInFront(player: Player, rootPart: BasePart, range: number): (Player?, BasePart?)
	local best: Player? = nil
	local bestRoot: BasePart? = nil
	local bestScore = -math.huge
	local facing = rootPart.CFrame.LookVector
	for _, other in Players:GetPlayers() do
		local otherRoot = if other ~= player then getLiveCharacter(other) else nil
		if otherRoot then
			local offset = otherRoot.Position - rootPart.Position
			local distance = offset.Magnitude
			local alignment = if distance > 0 then facing:Dot(offset.Unit) else 0
			if distance <= range and alignment > 0.8 then
				local score = alignment * 2 - distance / range
				if score > bestScore then
					best, bestRoot, bestScore = other, otherRoot, score
				end
			end
		end
	end
	return best, bestRoot
end

local function freezeRay(player: Player, rootPart: BasePart): boolean
	local target, targetRoot = findTargetInFront(player, rootPart, GearConfig.FreezeRange)
	if target == nil or targetRoot == nil then
		notify(player, "Aim at another player to freeze them!", "Warning")
		return false
	end

	-- A quick icy beam, then an ice block around the target.
	local from = rootPart.Position + Vector3.new(0, 1, 0)
	local to = targetRoot.Position
	local beam = newPart("FreezeBeam", Vector3.new(0.4, 0.4, (to - from).Magnitude), Color3.fromRGB(150, 235, 255), Enum.Material.Neon)
	beam.CFrame = CFrame.lookAt((from + to) / 2, to)
	beam.Transparency = 0.2
	beam.Parent = trapsFolder
	Debris:AddItem(beam, 0.3)

	local ice = newPart("IceBlock", Vector3.new(5, 7, 5), Color3.fromRGB(160, 225, 255), Enum.Material.Ice)
	ice.Transparency = 0.35
	ice.CFrame = targetRoot.CFrame * CFrame.new(0, -0.4, 0)
	ice.Parent = trapsFolder
	targetRoot.Anchored = true
	stun(target, GearConfig.FreezeSeconds, "Frozen")
	task.delay(GearConfig.FreezeSeconds, function()
		ice:Destroy()
		if targetRoot.Parent then
			targetRoot.Anchored = false
		end
	end)

	playSoundEvent:FireClient(player, "Freeze")
	playSoundEvent:FireClient(target, "Freeze")
	notify(target, string.format("%s froze you solid!", player.DisplayName), "Error")
	dropBrainrot(target, player, string.format("%s froze you and you dropped the brainrot!", player.DisplayName))
	return true
end

-- Ground in front of the player's feet.
local function placeSpot(rootPart: BasePart, character: Model): Vector3?
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character, trapsFolder }
	local origin = rootPart.Position + rootPart.CFrame.LookVector * 4
	local hit = Workspace:Raycast(origin, Vector3.new(0, -12, 0), params)
	return if hit then hit.Position else nil
end

local function buildSpikeTrap(position: Vector3): Model
	local model = Instance.new("Model")
	model.Name = "SpikeTrap"
	local base = newPart("Base", Vector3.new(4.5, 0.3, 4.5), Color3.fromRGB(70, 70, 78), Enum.Material.DiamondPlate)
	base.CFrame = CFrame.new(position + Vector3.new(0, 0.15, 0))
	base.Parent = model
	for x = -1, 1 do
		for z = -1, 1 do
			local spike = newPart("Spike", Vector3.new(0.45, 1.4, 0.45), Color3.fromRGB(200, 205, 215), Enum.Material.Metal)
			spike.CFrame = CFrame.new(position + Vector3.new(x * 1.4, 0.8, z * 1.4)) * CFrame.Angles(0, math.rad(45), 0)
			spike.Parent = model
			local tip = newPart("Tip", Vector3.new(0.25, 0.5, 0.25), Color3.fromRGB(230, 60, 60), Enum.Material.Metal)
			tip.CFrame = CFrame.new(position + Vector3.new(x * 1.4, 1.7, z * 1.4)) * CFrame.Angles(0, math.rad(45), 0)
			tip.Parent = model
		end
	end
	model.PrimaryPart = base
	return model
end

local function buildLandMine(position: Vector3): (Model, BasePart)
	local model = Instance.new("Model")
	model.Name = "LandMine"
	local body = newPart("Body", Vector3.new(0.5, 2.6, 2.6), Color3.fromRGB(60, 75, 50), Enum.Material.Metal)
	body.Shape = Enum.PartType.Cylinder
	body.CFrame = CFrame.new(position + Vector3.new(0, 0.25, 0)) * CFrame.Angles(0, 0, math.rad(90))
	body.Parent = model
	local button = newPart("Button", Vector3.new(0.3, 1, 1), Color3.fromRGB(40, 40, 40), Enum.Material.Metal)
	button.Shape = Enum.PartType.Cylinder
	button.CFrame = CFrame.new(position + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, 0, math.rad(90))
	button.Parent = model
	local light = newPart("Light", Vector3.new(0.4, 0.4, 0.4), Color3.fromRGB(255, 40, 40), Enum.Material.Neon)
	light.Shape = Enum.PartType.Ball
	light.CFrame = CFrame.new(position + Vector3.new(0, 0.85, 0))
	light.Parent = model
	model.PrimaryPart = body
	return model, light
end

local function placeTrap(player: Player, rootPart: BasePart, kind: string): boolean
	local character = player.Character
	local spot = if character then placeSpot(rootPart, character) else nil
	if spot == nil then
		notify(player, "There's no ground here to put that on.", "Warning")
		return false
	end
	-- Only a few out at once: the oldest goes.
	local mine: { Trap } = {}
	for _, trap in traps do
		if trap.Owner == player then
			table.insert(mine, trap)
		end
	end
	if #mine >= GearConfig.MaxTrapsPerPlayer then
		local oldest = mine[1]
		oldest.Model:Destroy()
		table.remove(traps, table.find(traps, oldest) :: number)
	end

	local model: Model
	local light: BasePart? = nil
	if kind == "LandMine" then
		model, light = buildLandMine(spot)
	else
		model = buildSpikeTrap(spot)
	end
	model:SetAttribute("OwnerUserId", player.UserId)
	model.Parent = trapsFolder
	table.insert(traps, {
		Kind = kind,
		Owner = player,
		Model = model,
		Position = spot,
		ExpiresAt = os.clock() + GearConfig.TrapLifetimeSeconds,
		Light = light,
	})
	playSoundEvent:FireClient(player, "Place")
	return true
end

local function launch(rootPart: BasePart)
	local attachment = rootPart:FindFirstChild("RootAttachment")
	if attachment == nil or not attachment:IsA("Attachment") then
		local created = Instance.new("Attachment")
		created.Name = "LaunchAttachment"
		created.Parent = rootPart
		attachment = created
	end
	local angle = math.random() * math.pi * 2
	local velocity = Instance.new("LinearVelocity")
	velocity.Name = "MineLaunch"
	velocity.Attachment0 = attachment :: Attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	velocity.MaxForce = 1e7
	velocity.VectorVelocity = Vector3.new(math.cos(angle) * 25, GearConfig.MineLaunchSpeed, math.sin(angle) * 25)
	velocity.Parent = rootPart
	Debris:AddItem(velocity, 0.3)
end

local function triggerTrap(trap: Trap, victim: Player, victimRoot: BasePart)
	local owner = trap.Owner
	local ownerName = owner.DisplayName
	if trap.Kind == "LandMine" then
		local explosion = Instance.new("Explosion")
		explosion.Position = trap.Position
		explosion.BlastRadius = 6
		-- Just the boom: nobody gets hurt or flung by the blast itself.
		explosion.BlastPressure = 0
		explosion.DestroyJointRadiusPercent = 0
		explosion.Parent = Workspace
		launch(victimRoot)
		stun(victim, GearConfig.MineStunSeconds, "Launched")
		playSoundEvent:FireClient(victim, "Launch")
		notify(victim, string.format("You stepped on %s's land mine!", ownerName), "Error")
		dropBrainrot(victim, owner, string.format("%s's land mine made you drop the brainrot!", ownerName))
	else
		stun(victim, GearConfig.SpikeStunSeconds, "Spiked")
		victimRoot.AssemblyLinearVelocity = Vector3.zero
		playSoundEvent:FireClient(victim, "Ouch")
		notify(victim, string.format("You stepped on %s's spike trap!", ownerName), "Error")
		dropBrainrot(victim, owner, string.format("%s's spike trap made you drop the brainrot!", ownerName))
	end
	if owner.Parent == Players then
		notify(owner, string.format("%s stepped on your %s!", victim.DisplayName, if trap.Kind == "LandMine" then "land mine" else "spike trap"), "Success")
	end
end

local trapClock = 0
local function checkTraps()
	local now = os.clock()
	trapClock += 1
	local roots: { [Player]: BasePart } = {}
	for _, player in Players:GetPlayers() do
		local rootPart = getLiveCharacter(player)
		if rootPart then
			roots[player] = rootPart
		end
	end
	for index = #traps, 1, -1 do
		local trap = traps[index]
		if now >= trap.ExpiresAt or trap.Model.Parent == nil or trap.Owner.Parent ~= Players then
			trap.Model:Destroy()
			table.remove(traps, index)
			continue
		end
		local light = trap.Light
		if light then
			light.Transparency = if trapClock % 10 < 5 then 0 else 0.8
		end
		for player, rootPart in roots do
			local offset = rootPart.Position - trap.Position
			if
				player ~= trap.Owner
				and Vector3.new(offset.X, 0, offset.Z).Magnitude <= GearConfig.TrapTriggerRadius
				and offset.Y < 5
			then
				trap.Model:Destroy()
				table.remove(traps, index)
				triggerTrap(trap, player, rootPart)
				break
			end
		end
	end
end

local function boogieBomb(player: Player, rootPart: BasePart): boolean
	local ball = newPart("DiscoBall", Vector3.new(3, 3, 3), Color3.fromRGB(255, 90, 200), Enum.Material.Neon)
	ball.Shape = Enum.PartType.Ball
	ball.CFrame = CFrame.new(rootPart.Position + Vector3.new(0, 8, 0))
	local sparkles = Instance.new("Sparkles")
	sparkles.SparkleColor = Color3.fromRGB(255, 255, 120)
	sparkles.Parent = ball
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 120, 230)
	light.Range = GearConfig.BoogieRadius
	light.Brightness = 4
	light.Parent = ball
	ball.Parent = trapsFolder
	Debris:AddItem(ball, GearConfig.BoogieSeconds)

	local count = 0
	for _, other in Players:GetPlayers() do
		local otherRoot, otherHumanoid = getLiveCharacter(other)
		if other ~= player and otherRoot and otherHumanoid and (otherRoot.Position - rootPart.Position).Magnitude <= GearConfig.BoogieRadius then
			count += 1
			stun(other, GearConfig.BoogieSeconds, "Dancing")
			playSoundEvent:FireClient(other, "Boogie")
			notify(other, string.format("%s hit you with a Boogie Bomb! Dance!", player.DisplayName), "Error")
			dropBrainrot(other, player, string.format("%s's Boogie Bomb made you drop the brainrot!", player.DisplayName))
			local animator = otherHumanoid:FindFirstChildOfClass("Animator")
			if animator then
				local animation = Instance.new("Animation")
				animation.AnimationId = DANCE_ANIMATION_ID
				local ok, track = pcall(function()
					return animator:LoadAnimation(animation)
				end)
				if ok and track then
					track.Looped = true
					track:Play()
					task.delay(GearConfig.BoogieSeconds, function()
						track:Stop()
					end)
				end
			end
		end
	end
	playSoundEvent:FireClient(player, "Boogie")
	if count == 0 then
		notify(player, "Nobody was close enough to dance. Get closer next time!", "Warning")
	else
		notify(player, string.format("%d player%s can't stop dancing!", count, if count == 1 then "" else "s"), "Success")
	end
	return true
end

local ITEM_ACTIONS: { [string]: (Player, BasePart) -> boolean } = {
	FreezeRay = freezeRay,
	SpikeTrap = function(player: Player, rootPart: BasePart): boolean
		return placeTrap(player, rootPart, "SpikeTrap")
	end,
	LandMine = function(player: Player, rootPart: BasePart): boolean
		return placeTrap(player, rootPart, "LandMine")
	end,
	BoogieBomb = boogieBomb,
}

local refreshItemTools: (Player) -> ()

local function useItem(player: Player, tool: Tool, itemId: string)
	local rootPart = getLiveCharacter(player)
	if rootPart == nil or tool.Parent ~= player.Character then
		return
	end
	if (stunnedUntil[player] or 0) > os.clock() then
		return
	end
	local now = os.clock()
	local last = lastItemUse[player]
	if last and now - last < GearConfig.ItemCooldownSeconds then
		return
	end
	lastItemUse[player] = now
	local action = ITEM_ACTIONS[itemId]
	local items = getItemsFunction:Invoke(player)
	local charges = if typeof(items) == "table" then tonumber(items[itemId]) or 0 else 0
	if action == nil or charges <= 0 then
		refreshItemTools(player)
		return
	end
	if action(player, rootPart) then
		useItemChargeFunction:Invoke(player, itemId)
		refreshItemTools(player)
	end
end

--------------------------------------------------------------------------------
-- Tools
--------------------------------------------------------------------------------

local function toolPart(name: string, size: Vector3, color: Color3, material: Enum.Material): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

-- Welds `part` to `handle` at `offset` from the handle.
local function attach(handle: BasePart, part: BasePart, offset: CFrame)
	part.CFrame = handle.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = part
	weld.Parent = part
	part.Parent = handle
end

-- A big cartoon slap glove worn on the hand: the hand holds the cuff, the
-- fingers point up past the fist (the arm is raised while holding a tool)
-- and the palm faces sideways, ready to slap. The Grip is set as one CFrame
-- (setting GripForward/GripUp/GripRight one by one lets Roblox re-orthogonalise
-- them into a different pose).
local function buildSlapGlove(tool: Tool, color: Color3): Part
	local cuff = toolPart("Handle", Vector3.new(1.15, 1.1, 1.15), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
	cuff.Parent = tool
	-- The fist sits in the lower half of the cuff.
	tool.Grip = CFrame.new(0, -0.25, 0)

	local dark = color:Lerp(Color3.new(0, 0, 0), 0.35)
	attach(cuff, toolPart("CuffStripe", Vector3.new(1.2, 0.3, 1.2), color, Enum.Material.Neon), CFrame.new(0, 0.3, 0))
	attach(cuff, toolPart("Palm", Vector3.new(0.6, 1.9, 1.7), color, Enum.Material.SmoothPlastic), CFrame.new(0, 1.45, 0))
	attach(cuff, toolPart("PalmPad", Vector3.new(0.1, 1.3, 1.2), color:Lerp(Color3.new(1, 1, 1), 0.35), Enum.Material.SmoothPlastic), CFrame.new(-0.33, 1.4, 0))
	for index, z in { 0.63, 0.21, -0.21, -0.63 } do
		local length = if index == 1 or index == 4 then 1 else 1.3
		attach(cuff, toolPart("Finger" .. index, Vector3.new(0.55, length, 0.4), color, Enum.Material.SmoothPlastic), CFrame.new(0, 2.4 + length / 2 - 0.05, z))
		attach(cuff, toolPart("Knuckle" .. index, Vector3.new(0.6, 0.15, 0.42), dark, Enum.Material.SmoothPlastic), CFrame.new(0, 2.42, z))
	end
	attach(
		cuff,
		toolPart("Thumb", Vector3.new(0.55, 1.1, 0.45), color, Enum.Material.SmoothPlastic),
		CFrame.new(0, 1.5, -1.05) * CFrame.Angles(math.rad(-35), 0, 0)
	)
	local sparkles = Instance.new("Sparkles")
	sparkles.SparkleColor = color:Lerp(Color3.new(1, 1, 1), 0.4)
	sparkles.Parent = cuff:FindFirstChild("Palm")
	return cuff
end

local function createHandle(gear: Gear): Part
	local handle = toolPart("Handle", Vector3.new(1, 1, 1), gear.Color, Enum.Material.SmoothPlastic)
	if gear.Id == "InvisibilityCloak" then
		handle.Size = Vector3.new(0.3, 2, 1.6)
		handle.Material = Enum.Material.Fabric
		handle.Transparency = 0.3
	else
		handle.Shape = Enum.PartType.Cylinder
		handle.Size = Vector3.new(1.2, 1.4, 1.4)
		handle.Material = Enum.Material.Neon
	end
	return handle
end

local function createTool(player: Player, gear: Gear): Tool
	local tool = Instance.new("Tool")
	tool.Name = gear.DisplayName
	tool.ToolTip = gear.Description
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("GearId", gear.Id)
	if gear.Id == "Slap" then
		buildSlapGlove(tool, gear.Color)
	else
		createHandle(gear).Parent = tool
	end

	if gear.Id == "Slap" then
		tool.Activated:Connect(function()
			slap(player, tool)
		end)
	elseif gear.Id == "InvisibilityCloak" then
		tool.Activated:Connect(function()
			cloak(player)
		end)
	end
	tool.Equipped:Connect(function()
		applyMovement(player)
	end)
	tool.Unequipped:Connect(function()
		applyMovement(player)
	end)
	return tool
end

-- What each troll item looks like in your hand.
local function buildItemHandle(tool: Tool, item: TrollItem)
	if item.Id == "FreezeRay" then
		-- A blaster pointing forward (the handle's -Z).
		local body = toolPart("Handle", Vector3.new(0.6, 0.8, 2.2), Color3.fromRGB(235, 240, 250), Enum.Material.SmoothPlastic)
		body.Parent = tool
		attach(body, toolPart("Barrel", Vector3.new(0.45, 0.45, 1), item.Color, Enum.Material.Neon), CFrame.new(0, 0.1, -1.5))
		attach(body, toolPart("Tank", Vector3.new(0.5, 0.6, 0.9), item.Color, Enum.Material.Glass), CFrame.new(0, 0.6, 0.2))
		attach(body, toolPart("Grip", Vector3.new(0.45, 1, 0.5), Color3.fromRGB(60, 70, 90), Enum.Material.SmoothPlastic), CFrame.new(0, -0.7, 0.6))
	elseif item.Id == "SpikeTrap" then
		local base = toolPart("Handle", Vector3.new(1.6, 0.3, 1.6), Color3.fromRGB(70, 70, 78), Enum.Material.DiamondPlate)
		base.Parent = tool
		for index, offset in { Vector3.new(-0.45, 0, -0.45), Vector3.new(0.45, 0, -0.45), Vector3.new(-0.45, 0, 0.45), Vector3.new(0.45, 0, 0.45) } do
			attach(
				base,
				toolPart("Spike" .. index, Vector3.new(0.25, 0.7, 0.25), item.Color, Enum.Material.Metal),
				CFrame.new(offset + Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, math.rad(45), 0)
			)
		end
	elseif item.Id == "LandMine" then
		local body = toolPart("Handle", Vector3.new(0.4, 1.6, 1.6), Color3.fromRGB(60, 75, 50), Enum.Material.Metal)
		body.Shape = Enum.PartType.Cylinder
		body.Parent = tool
		local light = toolPart("Light", Vector3.new(0.35, 0.35, 0.35), item.Color, Enum.Material.Neon)
		light.Shape = Enum.PartType.Ball
		attach(body, light, CFrame.new(0.3, 0, 0))
	else
		local ball = toolPart("Handle", Vector3.new(1.4, 1.4, 1.4), item.Color, Enum.Material.Neon)
		ball.Shape = Enum.PartType.Ball
		ball.Parent = tool
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = Color3.fromRGB(255, 255, 120)
		sparkles.Parent = ball
	end
end

local function findItemTool(player: Player, itemId: string): Tool?
	local containers: { Instance? } = { player:FindFirstChildOfClass("Backpack"), player.Character }
	for _, container in containers do
		if container then
			for _, child in container:GetChildren() do
				if child:IsA("Tool") and child:GetAttribute("ItemId") == itemId then
					return child
				end
			end
		end
	end
	return nil
end

-- One tool per troll item you have charges of, named with the charges left.
refreshItemTools = function(player: Player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack == nil or player:GetAttribute("DataLoaded") ~= true then
		return
	end
	local items = getItemsFunction:Invoke(player)
	for _, item in GearConfig.TrollItems do
		local charges = if typeof(items) == "table" then tonumber(items[item.Id]) or 0 else 0
		local tool = findItemTool(player, item.Id)
		if charges <= 0 then
			if tool then
				tool:Destroy()
			end
		else
			if tool == nil then
				local created = Instance.new("Tool")
				created.ToolTip = item.Description
				created.CanBeDropped = false
				created.RequiresHandle = true
				created:SetAttribute("ItemId", item.Id)
				buildItemHandle(created, item)
				created.Activated:Connect(function()
					useItem(player, created, item.Id)
				end)
				created.Parent = backpack
				tool = created
			end
			(tool :: Tool).Name = string.format("%s x%d", item.DisplayName, charges)
		end
	end
end

local function hasTool(player: Player, gearId: string): boolean
	local containers: { Instance } = {}
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		table.insert(containers, backpack)
	end
	if player.Character then
		table.insert(containers, player.Character)
	end
	for _, container in containers do
		for _, child in container:GetChildren() do
			if child:IsA("Tool") and child:GetAttribute("GearId") == gearId then
				return true
			end
		end
	end
	return false
end

local function giveTools(player: Player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack == nil or player:GetAttribute("DataLoaded") ~= true then
		return
	end
	local owned = getOwnedGear(player)
	player:SetAttribute("OwnedGear", table.concat(owned, ","))
	for _, gear in GearConfig.Gear do
		if table.find(owned, gear.Id) and not hasTool(player, gear.Id) then
			createTool(player, gear).Parent = backpack
		end
	end
end

--------------------------------------------------------------------------------
-- Gear Shop
--------------------------------------------------------------------------------

local function isNearGearShop(player: Player): boolean
	local rootPart = getLiveCharacter(player)
	local map = Workspace:FindFirstChild("Map")
	local stall = if map then map:FindFirstChild("GearShop") else nil
	local counter = if stall then stall:FindFirstChild("Counter") else nil
	return rootPart ~= nil
		and counter ~= nil
		and counter:IsA("BasePart")
		and (rootPart.Position - counter.Position).Magnitude <= GearConfig.ShopDistance
end

buyGearFunction.OnServerInvoke = function(player: Player, gearId: any): (boolean, string)
	local now = os.clock()
	local last = lastBuyRequest[player]
	if last and now - last < BUY_COOLDOWN_SECONDS then
		return false, "Slow down!"
	end
	lastBuyRequest[player] = now

	local gear = if typeof(gearId) == "string" then GearConfig.ById[gearId] else nil
	if gear == nil then
		return false, "That gear doesn't exist."
	end
	if player:GetAttribute("DataLoaded") ~= true then
		return false, "Your data is still loading."
	end
	if table.find(getOwnedGear(player), gear.Id) then
		return false, string.format("You already own the %s.", gear.DisplayName)
	end
	if not isNearGearShop(player) then
		return false, "Walk up to the Gear Shop to buy gear."
	end
	if spendCashFunction:Invoke(player, gear.Price) ~= true then
		return false, string.format("You need %s for the %s.", NumberFormat.cash(gear.Price), gear.DisplayName)
	end
	if addGearFunction:Invoke(player, gear.Id) ~= true then
		addCashFunction:Invoke(player, gear.Price)
		return false, "Couldn't buy that, try again."
	end
	giveTools(player)
	return true, string.format("You bought the %s! It's in your backpack.", gear.DisplayName)
end

--------------------------------------------------------------------------------
-- Player lifecycle
--------------------------------------------------------------------------------

local function onCharacterAdded(player: Player, character: Model)
	uncloak(player, nil)
	local humanoid = character:WaitForChild("Humanoid", 10)
	-- A frame later, so the tools go into the new character's fresh Backpack.
	task.wait()
	if humanoid == nil or player.Character ~= character then
		return
	end
	giveTools(player)
	refreshItemTools(player)
	applyMovement(player)
end

local function onPlayerAdded(player: Player)
	player.CharacterAdded:Connect(function(character: Model)
		onCharacterAdded(player, character)
	end)
	player:GetAttributeChangedSignal("DataLoaded"):Connect(function()
		giveTools(player)
		refreshItemTools(player)
	end)
	player:GetAttributeChangedSignal("Carrying"):Connect(function()
		if player:GetAttribute("Carrying") == true then
			uncloak(player, "Grabbing a brainrot made you visible!")
		end
		applyMovement(player)
	end)
	for _, attribute in ExtrasConfig.SpeedAttributes do
		player:GetAttributeChangedSignal(attribute):Connect(function()
			applyMovement(player)
		end)
	end
	player:GetAttributeChangedSignal("SpeedLevel"):Connect(function()
		applyMovement(player)
	end)
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	end
end

knockbackFunction.OnInvoke = function(playerArg: any, direction: any, strength: any, stunSeconds: any): boolean
	if typeof(playerArg) ~= "Instance" or not playerArg:IsA("Player") or typeof(direction) ~= "Vector3" then
		return false
	end
	local rootPart = getLiveCharacter(playerArg)
	if rootPart == nil then
		return false
	end
	local flat = Vector3.new(direction.X, 0, direction.Z)
	knockback(rootPart, if flat.Magnitude > 0.01 then flat.Unit else Vector3.zAxis, math.clamp(tonumber(strength) or GearConfig.SlapKnockback, 0, 200))
	local seconds = tonumber(stunSeconds) or 0
	if seconds > 0 then
		stun(playerArg, math.min(seconds, 5), "Knocked")
	end
	return true
end
gearApi.Parent = ServerStorage

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(function(player: Player)
	lastBuyRequest[player] = nil
	lastSlap[player] = nil
	lastCloak[player] = nil
	cloaked[player] = nil
	lastItemUse[player] = nil
	stunnedUntil[player] = nil
end)

itemsChangedEvent.Event:Connect(function(player: any)
	if typeof(player) == "Instance" and player:IsA("Player") then
		refreshItemTools(player)
	end
end)

task.spawn(function()
	while true do
		task.wait(TRAP_CHECK_SECONDS)
		xpcall(checkTraps, function(err: any)
			warn("[GearManager] Traps failed: " .. tostring(err))
		end)
	end
end)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="287">
      <Properties>
        <string name="Name">LeaderboardManager</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
	LeaderboardManager
	Location: ServerScriptService (Script)

	Draws the global leaderboards in the Hall of Fame (Workspace.Map.Leaderboards):
	Top Steals, Top Earners (best income per second), Top Cash and Top
	Rebirths across every server, plus the game's logo board. Each player's
	scores are written to an OrderedDataStore every couple of minutes (only
	when they changed) and the top 10 are read back every minute. The top
	thief's avatar stands on the Hall of Fame's podium.

	When DataStores aren't available (an unpublished place in Studio), the
	boards rank the players in this server instead and say so.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local NumberFormat = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("NumberFormat"))

local LOG_PREFIX = "[LeaderboardManager]"
local STORE_PREFIX = "BrainrotGame_v1_Top"
local ROWS = 10
local WRITE_INTERVAL_SECONDS = 120
local REFRESH_INTERVAL_SECONDS = 60
local FIRST_REFRESH_DELAY_SECONDS = 5

type Stat = {
	Name: string,
	Board: string,
	Title: string,
	Color: Color3,
	Format: (number) -> string,
}

type Row = {
	UserId: number,
	Name: string,
	Value: number,
}

type BoardGui = {
	Rows: { { Frame: Frame, Rank: TextLabel, Avatar: ImageLabel, Name: TextLabel, Value: TextLabel } },
	Footer: TextLabel,
}

local function perSecond(value: number): string
	return NumberFormat.cash(value) .. "/s"
end

local STATS: { Stat } = {
	{ Name = "Cash", Board = "TopCash", Title = "TOP CASH", Color = Color3.fromRGB(80, 255, 110), Format = NumberFormat.cash },
	{ Name = "Steals", Board = "TopSteals", Title = "TOP STEALS", Color = Color3.fromRGB(255, 90, 90), Format = NumberFormat.commas },
	{ Name = "Earners", Board = "TopEarners", Title = "TOP EARNERS", Color = Color3.fromRGB(255, 210, 60), Format = perSecond },
	{ Name = "Rebirths", Board = "TopRebirths", Title = "TOP REBIRTHS", Color = Color3.fromRGB(80, 190, 255), Format = NumberFormat.commas },
}
local RANK_COLORS = {
	Color3.fromRGB(255, 210, 60),
	Color3.fromRGB(215, 225, 240),
	Color3.fromRGB(230, 150, 90),
}

local map = Workspace:WaitForChild("Map")
local boardsFolder = map:WaitForChild("Leaderboards", 30)

local stores: { [string]: OrderedDataStore } = {}
local warnedWrite = false
local lastWritten: { [Player]: { [string]: number } } = {}
local nameCache: { [number]: string } = {}
local boards: { [string]: BoardGui } = {}

for _, stat in STATS do
	local ok, result = pcall(function(): OrderedDataStore
		return DataStoreService:GetOrderedDataStore(STORE_PREFIX .. stat.Name)
	end)
	if ok then
		stores[stat.Name] = result
	end
end

--------------------------------------------------------------------------------
-- Board drawing
--------------------------------------------------------------------------------

local function text(parent: Instance, name: string, properties: { [string]: any }): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	for key, value in properties do
		(label :: any)[key] = value
	end
	label.Parent = parent
	return label
end

local function getScreen(boardName: string): BasePart?
	local board = if boardsFolder then boardsFolder:FindFirstChild(boardName) else nil
	board = board or map:FindFirstChild(boardName, true)
	local screen = if board then board:FindFirstChild("Screen") else nil
	return if screen and screen:IsA("BasePart") then screen else nil
end

local function createSurface(screen: BasePart): SurfaceGui
	local surface = Instance.new("SurfaceGui")
	surface.Name = "BoardGui"
	surface.Face = Enum.NormalId.Front
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.PixelsPerStud = 25
	surface.LightInfluence = 0
	surface.Parent = screen
	return surface
end

local function createBoard(stat: Stat, screen: BasePart): BoardGui
	local surface = createSurface(screen)
	text(surface, "Title", {
		Position = UDim2.fromScale(0.04, 0.015),
		Size = UDim2.fromScale(0.92, 0.1),
		Text = stat.Title,
		TextColor3 = stat.Color,
	})

	local rows = {}
	for index = 1, ROWS do
		local frame = Instance.new("Frame")
		frame.Name = "Row" .. index
		frame.Position = UDim2.fromScale(0.03, 0.125 + (index - 1) * 0.079)
		frame.Size = UDim2.fromScale(0.94, 0.072)
		frame.BackgroundColor3 = if index % 2 == 1 then Color3.fromRGB(40, 44, 70) else Color3.fromRGB(30, 33, 55)
		frame.BorderSizePixel = 0
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.2, 0)
		corner.Parent = frame
		frame.Parent = surface

		local rank = text(frame, "Rank", {
			Size = UDim2.fromScale(0.12, 1),
			Text = "#" .. index,
			TextColor3 = RANK_COLORS[index] or Color3.fromRGB(200, 205, 230),
		})
		local avatar = Instance.new("ImageLabel")
		avatar.Name = "Avatar"
		avatar.BackgroundTransparency = 1
		avatar.Position = UDim2.fromScale(0.13, 0.05)
		avatar.Size = UDim2.fromScale(0.1, 0.9)
		avatar.Parent = frame
		local name = text(frame, "PlayerName", {
			Position = UDim2.fromScale(0.25, 0.1),
			Size = UDim2.fromScale(0.45, 0.8),
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = "",
		})
		local value = text(frame, "Value", {
			Position = UDim2.fromScale(0.7, 0.1),
			Size = UDim2.fromScale(0.28, 0.8),
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = stat.Color,
			Text = "",
		})
		table.insert(rows, { Frame = frame, Rank = rank, Avatar = avatar, Name = name, Value = value })
	end

	local footer = text(surface, "Footer", {
		Position = UDim2.fromScale(0.04, 0.93),
		Size = UDim2.fromScale(0.92, 0.05),
		Text = "Loading...",
		TextColor3 = Color3.fromRGB(170, 175, 200),
	})
	return { Rows = rows, Footer = footer }
end

local function drawLogo()
	local screen = getScreen("LogoBoard")
	if screen == nil then
		return
	end
	local surface = createSurface(screen)
	local title = text(surface, "Logo", {
		Position = UDim2.fromScale(0.05, 0.12),
		Size = UDim2.fromScale(0.9, 0.5),
		Text = "SNATCH THE\nBRAINROT",
		TextStrokeTransparency = 0,
	})
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 90)),
		ColorSequenceKeypoint.new(0.35, Color3.fromRGB(255, 220, 60)),
		ColorSequenceKeypoint.new(0.7, Color3.fromRGB(90, 255, 140)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(90, 180, 255)),
	})
	gradient.Rotation = 90
	gradient.Parent = title
	text(surface, "Tagline", {
		Position = UDim2.fromScale(0.05, 0.68),
		Size = UDim2.fromScale(0.9, 0.12),
		Text = "Buy - Collect - Steal - Rebirth",
		TextColor3 = Color3.fromRGB(230, 235, 255),
	})
end

local function drawRows(stat: Stat, rows: { Row }, footerText: string)
	local board = boards[stat.Name]
	if board == nil then
		return
	end
	for index, row in board.Rows do
		local entry = rows[index]
		row.Frame.Visible = entry ~= nil
		if entry then
			row.Name.Text = entry.Name
			row.Value.Text = stat.Format(entry.Value)
			row.Avatar.Image = if entry.UserId > 0
				then string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=48&h=48", entry.UserId)
				else ""
		end
	end
	board.Footer.Text = footerText
end

--------------------------------------------------------------------------------
-- Data
--------------------------------------------------------------------------------

-- The best income per second each player reached this session.
local bestIncome: { [Player]: number } = {}

local function getStatValue(player: Player, statName: string): number?
	if statName == "Earners" then
		local current = math.floor(tonumber(player:GetAttribute("IncomePerSecond")) or 0)
		local best = math.max(bestIncome[player] or 0, current)
		bestIncome[player] = best
		return if best > 0 then best else nil
	end
	local leaderstats = player:FindFirstChild("leaderstats")
	local value = if leaderstats then leaderstats:FindFirstChild(statName) else nil
	if value and value:IsA("IntValue") then
		return value.Value
	end
	return nil
end

local function getName(userId: number): string
	local cached = nameCache[userId]
	if cached then
		return cached
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.Name
		return player.Name
	end
	local ok, result = pcall(function(): string
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local name = if ok and typeof(result) == "string" then result else "Player " .. userId
	nameCache[userId] = name
	return name
end

local function writeScores()
	for _, player in Players:GetPlayers() do
		if player.UserId > 0 then
			local written = lastWritten[player] or {}
			lastWritten[player] = written
			for _, stat in STATS do
				local store: OrderedDataStore? = stores[stat.Name]
				local value = getStatValue(player, stat.Name)
				if store and value and value > 0 and written[stat.Name] ~= value then
					local ok, err = pcall(function()
						if stat.Name == "Earners" then
							-- A record: only ever goes up.
							store:UpdateAsync(tostring(player.UserId), function(old: any): number
								return math.max(tonumber(old) or 0, math.floor(value))
							end)
						else
							store:SetAsync(tostring(player.UserId), math.floor(value))
						end
					end)
					if ok then
						written[stat.Name] = value
					elseif not warnedWrite then
						-- Usually an unpublished place in Studio; warn once, not every time.
						warnedWrite = true
						warn(string.format("%s Could not save scores (%s); the boards show this server only.", LOG_PREFIX, tostring(err)))
					end
				end
			end
		end
	end
end

local function readGlobalTop(stat: Stat): { Row }?
	local store: OrderedDataStore? = stores[stat.Name]
	if store == nil then
		return nil
	end
	local ok, page = pcall(function(): { any }
		return store:GetSortedAsync(false, ROWS):GetCurrentPage()
	end)
	if not ok or typeof(page) ~= "table" then
		return nil
	end
	local rows: { Row } = {}
	for _, entry in page do
		local userId = tonumber(entry.key)
		local value = tonumber(entry.value)
		if userId and value then
			table.insert(rows, { UserId = userId, Name = getName(userId), Value = value })
		end
	end
	return rows
end

local function readServerTop(stat: Stat): { Row }
	local rows: { Row } = {}
	for _, player in Players:GetPlayers() do
		local value = getStatValue(player, stat.Name)
		if value then
			table.insert(rows, { UserId = player.UserId, Name = player.Name, Value = value })
		end
	end
	table.sort(rows, function(a, b)
		return a.Value > b.Value
	end)
	while #rows > ROWS do
		table.remove(rows)
	end
	return rows
end

-- The top thief's avatar on the Hall of Fame's podium.
local championUserId = 0
local function updateChampion(userId: number, name: string)
	if userId == championUserId or userId <= 0 then
		return
	end
	local spot = map:FindFirstChild("ChampionSpot", true)
	if spot == nil or not spot:IsA("BasePart") then
		return
	end
	local ok, result = pcall(function(): Model
		return Players:CreateHumanoidModelFromUserId(userId)
	end)
	if not ok or typeof(result) ~= "Instance" or not result:IsA("Model") then
		return
	end
	local statue: Model = result
	championUserId = userId
	local old = spot.Parent and spot.Parent:FindFirstChild("ChampionStatue")
	if old then
		old:Destroy()
	end
	statue.Name = "ChampionStatue"
	for _, part in statue:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
		end
	end
	local humanoid = statue:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayName = "👑 " .. name
		humanoid.NameDisplayDistance = 0
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	local _, size = statue:GetBoundingBox()
	statue:PivotTo(spot.CFrame * CFrame.new(0, size.Y / 2 - 0.5, 0) * CFrame.Angles(0, math.pi, 0))
	local label = Instance.new("BillboardGui")
	label.Size = UDim2.fromScale(10, 2)
	label.StudsOffset = Vector3.new(0, size.Y / 2 + 1.5, 0)
	label.LightInfluence = 0
	label.MaxDistance = 150
	local nameLabel = Instance.new("TextLabel")
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.fromScale(1, 1)
	nameLabel.Font = Enum.Font.FredokaOne
	nameLabel.TextScaled = true
	nameLabel.Text = "👑 " .. name
	nameLabel.TextColor3 = Color3.fromRGB(255, 215, 70)
	nameLabel.TextStrokeTransparency = 0
	nameLabel.Parent = label
	label.Parent = statue.PrimaryPart or statue:FindFirstChildWhichIsA("BasePart")
	statue.Parent = spot.Parent
end

local function refreshBoards()
	for _, stat in STATS do
		local rows: { Row }
		local globalRows = readGlobalTop(stat)
		if globalRows then
			rows = globalRows
			drawRows(stat, rows, "All servers - updates every minute")
		else
			rows = readServerTop(stat)
			drawRows(stat, rows, "This server only (publish the game for global scores)")
		end
		local top = rows[1]
		if stat.Name == "Steals" and top then
			task.spawn(updateChampion, top.UserId, top.Name)
		end
	end
end

--------------------------------------------------------------------------------
-- Startup
--------------------------------------------------------------------------------

for _, stat in STATS do
	local screen = getScreen(stat.Board)
	if screen then
		boards[stat.Name] = createBoard(stat, screen)
	end
end
drawLogo()

Players.PlayerRemoving:Connect(function(player: Player)
	lastWritten[player] = nil
	bestIncome[player] = nil
end)

task.spawn(function()
	task.wait(FIRST_REFRESH_DELAY_SECONDS)
	local sinceWrite = WRITE_INTERVAL_SECONDS
	while true do
		if sinceWrite >= WRITE_INTERVAL_SECONDS then
			sinceWrite = 0
			xpcall(writeScores, function(err: any)
				warn(string.format("%s Writing scores failed: %s", LOG_PREFIX, tostring(err)))
			end)
		end
		xpcall(refreshBoards, function(err: any)
			warn(string.format("%s Refreshing boards failed: %s", LOG_PREFIX, tostring(err)))
		end)
		task.wait(REFRESH_INTERVAL_SECONDS)
		sinceWrite += REFRESH_INTERVAL_SECONDS
	end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="288">
      <Properties>
        <string name="Name">RaidManager</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
	RaidManager
	Location: ServerScriptService (Script)

	The two events that happen on the map itself (GameplayManager starts and
	ends them like any other event and tells this script through
	ServerStorage.Gameplay.EventChanged):

	  * Boss Raid: a giant brainrot rampages up and down the walkway between
	    the bases (Workspace.Map.BossArena). Each boss is a random tier
	    (ExtrasConfig.BossTiers, Easy to Mega): tougher ones are bigger, have
	    more health and more attacks, attack faster and drop better loot. The
	    attacks each warn first: stomp shockwaves, an aimed laser (a red line,
	    then the beam), a grab-and-throw (a red ring under someone), meteor
	    rain (red circles) and a jump slam (the ring where it'll land). Below
	    ExtrasConfig.BossRageFraction health it rages. Everyone clicks (or
	    slaps) it; when it falls, the top three raiders win lucky blocks, on
	    Hard and Mega everyone who helped gets one too, and every helper gets
	    Cash and maybe a hat. Beating it ends the event.
	  * Bank Heist: the vault door (Workspace.Map.Vault) rolls open. Each gold
	    pile holds cash, gold bars or diamonds (ExtrasConfig.HeistLoot), worth
	    more the rarer they are and heavier to carry. Grab some and carry it
	    into your own base for Cash; a slap or a fall makes you drop it for
	    anyone to grab. Security lasers sweep the vault (jump over them or get
	    zapped back and lose your bag). In the last minute the alarm goes
	    off: faster lasers, double loot. Whoever banks the most wins a lucky
	    block.

	Client-facing state:
	  Boss model (Workspace.Map.Brainrots, State "Boss") with attributes
	    BossHealth, BossMaxHealth, Stomp (server time of the last stomp),
	    StompRadius and Enraged
	  Attack warnings and effects: Parts in Workspace.BossEffects
	  ReplicatedStorage attributes BossName, BossTier, BossTierColour,
	    BossHealth, BossMaxHealth (0 = no boss), BossEnraged, HeistOpen and
	    HeistAlarm
	  Player attributes CarryingLoot, LootValue, LootKind, LootSpeed
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BrainrotConfig = require(Shared:WaitForChild("BrainrotConfig"))
local ExtrasConfig = require(Shared:WaitForChild("ExtrasConfig"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local GearConfig = require(Shared:WaitForChild("GearConfig"))
local NumberFormat = require(Shared:WaitForChild("NumberFormat"))
local TemplateModels = require(Shared:WaitForChild("TemplateModels"))

local LOG_PREFIX = "[RaidManager]"
local TICK_SECONDS = 0.1
local DOOR_SECONDS = 2
local DROPPED_LOOT_SECONDS = 20
-- A player can be zapped by a vault laser once per this long.
local LASER_HIT_COOLDOWN = 1.5

local dataApi = ServerStorage:WaitForChild("DataAndMonetization")
local gameplayApi = ServerStorage:WaitForChild("Gameplay")
local gearApi = ServerStorage:WaitForChild("Gear")
local addCashFunction = dataApi:WaitForChild("AddCash") :: BindableFunction
local addHatFunction = dataApi:WaitForChild("AddHat") :: BindableFunction
local eventChangedEvent = gameplayApi:WaitForChild("EventChanged") :: BindableEvent
local giveBrainrotFunction = gameplayApi:WaitForChild("GiveBrainrot") :: BindableFunction
local getIncomeFunction = gameplayApi:WaitForChild("GetIncome") :: BindableFunction
local activityEvent = gameplayApi:WaitForChild("Activity") :: BindableEvent
local knockbackFunction = gearApi:WaitForChild("Knockback") :: BindableFunction
local slapSwingEvent = gearApi:WaitForChild("SlapSwing") :: BindableEvent
local slappedEvent = gearApi:WaitForChild("Slapped") :: BindableEvent

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local notifyEvent = remotes:WaitForChild("Notify") :: RemoteEvent
local playSoundEvent = remotes:WaitForChild("PlaySound") :: RemoteEvent

local map = Workspace:WaitForChild("Map")
local brainrotsFolder = map:WaitForChild("Brainrots")
local plotsFolder = map:WaitForChild("Plots")

local effectsFolder = Instance.new("Folder")
effectsFolder.Name = "BossEffects"
effectsFolder.Parent = Workspace

local rng = Random.new()

local function notify(player: Player, message: string, kind: string, sound: string?)
	notifyEvent:FireClient(player, message, kind, sound)
end

local function notifyAll(message: string, kind: string, sound: string?)
	notifyEvent:FireAllClients(message, kind, sound)
end

local function getRoot(player: Player): BasePart?
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	if root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 then
		return root
	end
	return nil
end

local function flat(vector: Vector3): Vector3
	return Vector3.new(vector.X, 0, vector.Z)
end

local function income(player: Player): number
	return tonumber(getIncomeFunction:Invoke(player)) or 0
end

local function isInside(part: BasePart, position: Vector3): boolean
	local localPosition = part.CFrame:PointToObjectSpace(position)
	local half = part.Size / 2
	return math.abs(localPosition.X) <= half.X and math.abs(localPosition.Y) <= half.Y + 4 and math.abs(localPosition.Z) <= half.Z
end

-- Picks from a list of things with a Weight.
local function weighted<T>(choices: { T }, weightOf: (T) -> number): T
	local total = 0
	for _, choice in choices do
		total += weightOf(choice)
	end
	local roll = rng:NextNumber() * total
	for _, choice in choices do
		roll -= weightOf(choice)
		if roll <= 0 then
			return choice
		end
	end
	return choices[#choices]
end

-- A glowing warning or effect, cleaned up after `seconds`.
local function effect(name: string, size: Vector3, cframe: CFrame, colour: Color3, transparency: number, seconds: number, shape: Enum.PartType?): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = colour
	part.Material = Enum.Material.Neon
	part.Transparency = transparency
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	if shape then
		part.Shape = shape
	end
	part.Parent = effectsFolder
	task.delay(seconds, function()
		part:Destroy()
	end)
	return part
end

-- A flat red ring on the ground: "something lands here".
local function warningRing(name: string, centre: Vector3, radius: number, seconds: number): Part
	return effect(
		name,
		Vector3.new(0.3, radius * 2, radius * 2),
		CFrame.new(centre + Vector3.new(0, 0.25, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color3.fromRGB(255, 40, 40),
		0.45,
		seconds,
		Enum.PartType.Cylinder
	)
end

-- A harmless explosion to look at.
local function boom(position: Vector3, radius: number)
	local explosion = Instance.new("Explosion")
	explosion.Position = position
	explosion.BlastRadius = radius
	explosion.BlastPressure = 0
	explosion.DestroyJointRadiusPercent = 0
	explosion.ExplosionType = Enum.ExplosionType.NoCraters
	explosion.Parent = effectsFolder
	task.delay(1, function()
		explosion:Destroy()
	end)
end

-- Knocks back everyone near `centre` (on the ground, within `radius`).
local function blast(centre: Vector3, radius: number, strength: number, stun: number, message: string?)
	for _, player in Players:GetPlayers() do
		local root = getRoot(player)
		if root then
			local offset = root.Position - centre
			local away = flat(offset)
			if away.Magnitude <= radius and math.abs(offset.Y) < 14 then
				knockbackFunction:Invoke(player, if away.Magnitude > 0.1 then away else Vector3.zAxis, strength, stun)
				playSoundEvent:FireClient(player, "Ouch")
				if message then
					notify(player, message, "Warning")
				end
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Boss Raid
--------------------------------------------------------------------------------

type Boss = {
	Model: Model,
	Root: BasePart,
	Hitbox: BasePart,
	Name: string,
	Tier: ExtrasConfig.BossTier,
	Height: number,
	Speed: number,
	Health: number,
	MaxHealth: number,
	Damage: { [Player]: number },
	LastHit: { [Player]: number },
	Target: Vector3,
	NextAttack: number,
	LastAttack: string?,
	-- Standing still for an attack (or in the air, slamming).
	Busy: boolean,
	Enraged: boolean,
	Defeated: boolean,
}

local boss: Boss? = nil
local damageBoss: (current: Boss, player: Player, amount: number) -> ()

local function arena(): BasePart?
	local part = map:FindFirstChild("BossArena")
	return if part and part:IsA("BasePart") then part else nil
end

local function arenaGround(): number
	local area = arena()
	return if area then area.Position.Y - area.Size.Y / 2 else 0
end

local function randomSpot(area: BasePart): Vector3
	local half = area.Size / 2 - Vector3.new(20, 0, 12)
	local x = rng:NextNumber(-math.max(half.X, 1), math.max(half.X, 1))
	local z = rng:NextNumber(-math.max(half.Z, 1), math.max(half.Z, 1))
	return Vector3.new(area.Position.X + x, arenaGround(), area.Position.Z + z)
end

local function alive(current: Boss): boolean
	return boss == current and not current.Defeated
end

local function publishHealth(current: Boss)
	current.Model:SetAttribute("BossHealth", current.Health)
	ReplicatedStorage:SetAttribute("BossHealth", current.Health)
end

local function placeBoss(current: Boss, position: Vector3, facing: Vector3?)
	local look = if facing and flat(facing).Magnitude > 0.05 then flat(facing).Unit else current.Root.CFrame.LookVector
	current.Root.CFrame = CFrame.lookAt(position, position + look)
	current.Hitbox.CFrame = CFrame.new(position + Vector3.new(0, current.Height / 2, 0))
end

local function removeBoss(escaped: boolean)
	local current = boss
	boss = nil
	ReplicatedStorage:SetAttribute("BossName", nil)
	ReplicatedStorage:SetAttribute("BossTier", nil)
	ReplicatedStorage:SetAttribute("BossTierColour", nil)
	ReplicatedStorage:SetAttribute("BossEnraged", nil)
	ReplicatedStorage:SetAttribute("BossHealth", 0)
	ReplicatedStorage:SetAttribute("BossMaxHealth", 0)
	effectsFolder:ClearAllChildren()
	if current == nil then
		return
	end
	if escaped and not current.Defeated then
		notifyAll(string.format("%s got away! Maybe next time.", current.Name), "Warning")
	end
	current.Model:Destroy()
end

-- Raiders in reach: living players within `range` of the boss.
local function raidersNear(current: Boss, range: number): { { Player: Player, Root: BasePart } }
	local found = {}
	for _, player in Players:GetPlayers() do
		local root = getRoot(player)
		if root and flat(root.Position - current.Root.Position).Magnitude <= range then
			table.insert(found, { Player = player, Root = root })
		end
	end
	return found
end

local function spawnBoss()
	removeBoss(false)
	local area = arena()
	if area == nil then
		warn(LOG_PREFIX .. " No BossArena in the map; the Boss Raid has no boss.")
		return
	end
	local choices: { BrainrotConfig.Brainrot } = {}
	for _, id in ExtrasConfig.BossIds do
		local definition = BrainrotConfig.ById[id]
		if definition then
			table.insert(choices, definition)
		end
	end
	if #choices == 0 then
		return
	end
	local definition = choices[rng:NextInteger(1, #choices)]
	-- (NextBossTier: a tier picked by hand, for testing.)
	local forced = ReplicatedStorage:GetAttribute("NextBossTier")
	local tier = if typeof(forced) == "string" and ExtrasConfig.BossTierByName[forced]
		then ExtrasConfig.BossTierByName[forced]
		else weighted(ExtrasConfig.BossTiers, function(choice: ExtrasConfig.BossTier): number
			return choice.Weight
		end)
	local maxHealth = math.floor(math.max(ExtrasConfig.BossMinHealth, #Players:GetPlayers() * ExtrasConfig.BossHealthPerPlayer) * tier.Health)
	local height = ExtrasConfig.BossHeight * tier.Size

	local model = Instance.new("Model")
	model.Name = "Boss"
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.one
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Parent = model
	model.PrimaryPart = root
	local hitbox = Instance.new("Part")
	hitbox.Name = "Hitbox"
	hitbox.Size = Vector3.new(height * 0.6, height, height * 0.6)
	hitbox.Transparency = 1
	hitbox.Anchored = true
	hitbox.CanCollide = false
	hitbox.CanTouch = false
	hitbox.CanQuery = true
	hitbox.Parent = model
	local clicker = Instance.new("ClickDetector")
	clicker.MaxActivationDistance = ExtrasConfig.BossClickRange
	clicker.CursorIcon = "rbxasset://SystemCursors/Cross"
	clicker.Parent = hitbox

	local start = randomSpot(area)
	root.CFrame = CFrame.new(start)
	hitbox.CFrame = CFrame.new(start + Vector3.new(0, height / 2, 0))
	-- The imported model if there is one (else each client builds it).
	local template = TemplateModels.get(definition.Id)
	if template then
		TemplateModels.build(model, root, template, height)
	end
	model:SetAttribute("BrainrotId", definition.Id)
	model:SetAttribute("FigureHeight", height)
	model:SetAttribute("CustomModel", template ~= nil)
	model:SetAttribute("Rarity", "Brainrot God")
	model:SetAttribute("Mutation", "Boss")
	model:SetAttribute("Motion", "Walk")
	model:SetAttribute("State", "Boss")
	model:SetAttribute("BossTier", tier.Name)
	model:SetAttribute("BossMaxHealth", maxHealth)
	model:SetAttribute("BossHealth", maxHealth)
	model:SetAttribute("Stomp", 0)
	model:SetAttribute("StompRadius", ExtrasConfig.BossStompRadius * tier.Size)

	local name = "BOSS " .. definition.DisplayName
	local current: Boss = {
		Model = model,
		Root = root,
		Hitbox = hitbox,
		Name = name,
		Tier = tier,
		Height = height,
		Speed = ExtrasConfig.BossSpeed * tier.Speed,
		Health = maxHealth,
		MaxHealth = maxHealth,
		Damage = {},
		LastHit = {},
		Target = randomSpot(area),
		NextAttack = os.clock() + tier.AttackSeconds,
		LastAttack = nil,
		Busy = false,
		Enraged = false,
		Defeated = false,
	}
	boss = current
	ReplicatedStorage:SetAttribute("BossName", name)
	ReplicatedStorage:SetAttribute("BossTier", tier.Label)
	ReplicatedStorage:SetAttribute("BossTierColour", tier.Colour)
	ReplicatedStorage:SetAttribute("BossMaxHealth", maxHealth)
	publishHealth(current)
	model.Parent = brainrotsFolder

	local topPrize = BrainrotConfig.ById[tier.Prizes[1]]
	notifyAll(
		string.format(
			"%s %s appeared! Top raider wins a %s%s.",
			tier.Label,
			name,
			if topPrize then topPrize.DisplayName else "lucky block",
			if tier.EveryonePrize then ", and everyone who helps gets a lucky block" else ""
		),
		"Warning"
	)

	clicker.MouseClick:Connect(function(player: Player)
		local playerRoot = getRoot(player)
		if playerRoot == nil or boss ~= current then
			return
		end
		local now = os.clock()
		if now - (current.LastHit[player] or 0) < ExtrasConfig.BossClickCooldown then
			return
		end
		if (playerRoot.Position - current.Root.Position).Magnitude > ExtrasConfig.BossClickRange + height then
			return
		end
		current.LastHit[player] = now
		damageBoss(current, player, ExtrasConfig.BossClickDamage)
	end)
end

local function defeat(current: Boss)
	current.Defeated = true
	current.Busy = false
	current.Model:SetAttribute("State", "Defeated")
	effectsFolder:ClearAllChildren()
	local tier = current.Tier
	local ranking: { { Player: Player, Damage: number } } = {}
	local total = 0
	for player, amount in current.Damage do
		if player.Parent == Players then
			table.insert(ranking, { Player = player, Damage = amount })
			total += amount
		end
	end
	table.sort(ranking, function(a, b)
		return a.Damage > b.Damage
	end)
	local names: { string } = {}
	for place, entry in ranking do
		local player = entry.Player
		local helped = total > 0 and entry.Damage / total >= ExtrasConfig.BossMinShare
		local prize = if place <= #tier.Prizes then tier.Prizes[place] elseif helped then tier.EveryonePrize else nil
		if prize then
			giveBrainrotFunction:Invoke(player, prize)
			local definition = BrainrotConfig.ById[prize]
			local prizeName = if definition then definition.DisplayName else prize
			if place <= #tier.Prizes then
				table.insert(names, string.format("%d. %s", place, player.DisplayName))
				notify(player, string.format("You were #%d in the raid! You won a %s!", place, prizeName), "Success", "Purchase")
			else
				notify(player, string.format("You helped beat the boss! You won a %s!", prizeName), "Success", "Purchase")
			end
		end
		if helped then
			local cash = math.floor(math.max(ExtrasConfig.BossMinCash, income(player) * 60 * ExtrasConfig.BossCashMinutes) * tier.CashMultiplier)
			addCashFunction:Invoke(player, cash)
			local message = string.format("Boss beaten! +%s for helping.", NumberFormat.cash(cash))
			if rng:NextNumber() < ExtrasConfig.BossHatChance then
				local hatName = addHatFunction:Invoke(player, "Random", 1)
				local hat = if typeof(hatName) == "string" then ExtrasConfig.HatByName[hatName] else nil
				if hat then
					message ..= string.format(" And a %s %s!", hat.Icon, hat.DisplayName)
				end
			end
			notify(player, message, "Success", "Collect")
			activityEvent:Fire(player, "BossWin", 1)
			activityEvent:Fire(player, "BossHit", math.floor(entry.Damage / 50))
		end
	end
	notifyAll(
		string.format("%s %s is defeated! Top raiders: %s", tier.Label, current.Name, if #names > 0 then table.concat(names, ", ") else "nobody"),
		"Success",
		"Event"
	)
	-- Beating the boss ends the Boss Raid (GameplayManager's event loop
	-- watches EventEndsAt).
	ReplicatedStorage:SetAttribute("EventEndsAt", Workspace:GetServerTimeNow() + 3)
	task.delay(3, function()
		if boss == current then
			removeBoss(false)
		end
	end)
end

local function enrage(current: Boss)
	current.Enraged = true
	current.Speed *= ExtrasConfig.BossRageSpeedup
	current.Model:SetAttribute("Enraged", true)
	ReplicatedStorage:SetAttribute("BossEnraged", true)
	local fire = Instance.new("Fire")
	fire.Name = "Rage"
	fire.Size = current.Height * 0.35
	fire.Heat = 12
	fire.Color = Color3.fromRGB(255, 60, 20)
	fire.SecondaryColor = Color3.fromRGB(255, 200, 40)
	fire.Parent = current.Hitbox
	notifyAll(string.format("😡 %s is ENRAGED! It attacks faster!", current.Name), "Warning", "Alarm")
end

damageBoss = function(current: Boss, player: Player, amount: number)
	if not alive(current) then
		return
	end
	current.Health = math.max(0, current.Health - amount)
	current.Damage[player] = (current.Damage[player] or 0) + amount
	publishHealth(current)
	if current.Health <= 0 then
		defeat(current)
	elseif not current.Enraged and current.Health <= current.MaxHealth * ExtrasConfig.BossRageFraction then
		enrage(current)
	end
end

--------------------------------------------------------------------------------
-- Boss attacks: each warns first, then hits whoever didn't get out of the way
--------------------------------------------------------------------------------

local function stomp(current: Boss)
	current.Model:SetAttribute("Stomp", Workspace:GetServerTimeNow())
	blast(current.Root.Position, ExtrasConfig.BossStompRadius * current.Tier.Size, ExtrasConfig.BossStompKnockback, 0.6, nil)
end

-- A red line to where it's aiming, then a laser beam along it.
local function laser(current: Boss)
	local targets = raidersNear(current, ExtrasConfig.BossLaserRange)
	if #targets == 0 then
		stomp(current)
		return
	end
	local target = targets[rng:NextInteger(1, #targets)]
	current.Busy = true
	local eye = current.Root.Position + Vector3.new(0, current.Height * 0.72, 0)
	local aim = target.Root.Position - Vector3.new(0, 1, 0)
	local direction = (aim - eye).Unit
	local finish = eye + direction * ExtrasConfig.BossLaserRange
	local length = (finish - eye).Magnitude
	local middle = CFrame.lookAt((eye + finish) / 2, finish)
	placeBoss(current, current.Root.Position, aim - current.Root.Position)
	effect("LaserWarning", Vector3.new(0.35, 0.35, length), middle, Color3.fromRGB(255, 40, 40), 0.35, ExtrasConfig.BossLaserWindup)
	playSoundEvent:FireClient(target.Player, "Alarm")
	task.wait(ExtrasConfig.BossLaserWindup)
	if not alive(current) then
		return
	end
	effect("Laser", Vector3.new(2.6, 2.6, length), middle, Color3.fromRGB(255, 70, 60), 0, 0.4)
	for _, player in Players:GetPlayers() do
		local root = getRoot(player)
		if root then
			-- Distance from the beam.
			local along = math.clamp((root.Position - eye):Dot(direction), 0, length)
			local closest = eye + direction * along
			local gap = root.Position - closest
			if gap.Magnitude <= ExtrasConfig.BossLaserWidth then
				knockbackFunction:Invoke(player, if flat(gap).Magnitude > 0.1 then flat(gap) else flat(direction), ExtrasConfig.BossLaserKnockback, 1)
				playSoundEvent:FireClient(player, "Zap")
				notify(player, "⚡ Zapped by the boss's laser!", "Warning")
			end
		end
	end
	current.Busy = false
end

-- A red ring under someone; whoever's still in it is grabbed and thrown.
local function throw(current: Boss)
	local targets = raidersNear(current, ExtrasConfig.BossThrowRange)
	if #targets == 0 then
		laser(current)
		return
	end
	table.sort(targets, function(a, b)
		return (a.Root.Position - current.Root.Position).Magnitude < (b.Root.Position - current.Root.Position).Magnitude
	end)
	local target = targets[1]
	current.Busy = true
	local spot = Vector3.new(target.Root.Position.X, arenaGround(), target.Root.Position.Z)
	placeBoss(current, current.Root.Position, spot - current.Root.Position)
	warningRing("GrabWarning", spot, ExtrasConfig.BossThrowRadius, ExtrasConfig.BossThrowWindup)
	playSoundEvent:FireClient(target.Player, "Alarm")
	task.wait(ExtrasConfig.BossThrowWindup)
	if not alive(current) then
		return
	end
	for _, player in Players:GetPlayers() do
		local root = getRoot(player)
		if root and flat(root.Position - spot).Magnitude <= ExtrasConfig.BossThrowRadius then
			local away = flat(root.Position - current.Root.Position)
			knockbackFunction:Invoke(player, if away.Magnitude > 0.1 then away else Vector3.zAxis, ExtrasConfig.BossThrowStrength, 1.5)
			playSoundEvent:FireClient(player, "Launch")
			notify(player, string.format("%s grabbed you and THREW you!", current.Name), "Warning")
		end
	end
	current.Model:SetAttribute("Stomp", Workspace:GetServerTimeNow())
	current.Busy = false
end

-- Red circles near the raiders, then a meteor lands on each.
local function meteors(current: Boss)
	local targets = raidersNear(current, 120)
	local area = arena()
	local spots: { Vector3 } = {}
	for index = 1, ExtrasConfig.BossMeteorCount do
		local spot: Vector3
		if #targets > 0 and index % 2 == 1 then
			local target = targets[rng:NextInteger(1, #targets)]
			spot = target.Root.Position + Vector3.new(rng:NextNumber(-6, 6), 0, rng:NextNumber(-6, 6))
		elseif area then
			spot = randomSpot(area)
		else
			spot = current.Root.Position + Vector3.new(rng:NextNumber(-30, 30), 0, rng:NextNumber(-30, 30))
		end
		spot = Vector3.new(spot.X, arenaGround(), spot.Z)
		table.insert(spots, spot)
		warningRing("MeteorWarning", spot, ExtrasConfig.BossMeteorRadius, ExtrasConfig.BossMeteorWindup)
	end
	-- The meteors fall.
	local rocks: { Part } = {}
	for _, spot in spots do
		local rock = effect("Meteor", Vector3.one * 5, CFrame.new(spot + Vector3.new(0, 80, 0)), Color3.fromRGB(255, 110, 30), 0, ExtrasConfig.BossMeteorWindup + 0.2, Enum.PartType.Ball)
		table.insert(rocks, rock)
	end
	local started = os.clock()
	while os.clock() - started < ExtrasConfig.BossMeteorWindup do
		local alpha = math.clamp((os.clock() - started) / ExtrasConfig.BossMeteorWindup, 0, 1)
		for index, rock in rocks do
			rock.CFrame = CFrame.new(spots[index] + Vector3.new(0, 80 * (1 - alpha * alpha), 0))
		end
		task.wait(1 / 15)
	end
	if not alive(current) then
		return
	end
	for _, spot in spots do
		boom(spot + Vector3.new(0, 1, 0), ExtrasConfig.BossMeteorRadius)
		blast(spot, ExtrasConfig.BossMeteorRadius, ExtrasConfig.BossMeteorKnockback, 0.8, "☄️ A meteor got you!")
	end
end

-- It leaps onto someone (a ring where it'll land) and slams down.
local function slam(current: Boss)
	local targets = raidersNear(current, 80)
	if #targets == 0 then
		stomp(current)
		return
	end
	local target = targets[rng:NextInteger(1, #targets)]
	current.Busy = true
	local from = current.Root.Position
	local to = Vector3.new(target.Root.Position.X, arenaGround(), target.Root.Position.Z)
	local radius = ExtrasConfig.BossSlamRadius * current.Tier.Size
	warningRing("SlamWarning", to, radius, ExtrasConfig.BossSlamWindup)
	playSoundEvent:FireClient(target.Player, "Alarm")
	local started = os.clock()
	while os.clock() - started < ExtrasConfig.BossSlamWindup do
		if not alive(current) then
			return
		end
		local alpha = math.clamp((os.clock() - started) / ExtrasConfig.BossSlamWindup, 0, 1)
		local position = from:Lerp(to, alpha) + Vector3.new(0, math.sin(alpha * math.pi) * current.Height * 1.2, 0)
		placeBoss(current, position, to - from)
		task.wait(1 / 20)
	end
	if not alive(current) then
		return
	end
	placeBoss(current, to, to - from)
	current.Target = to
	current.Model:SetAttribute("Stomp", Workspace:GetServerTimeNow())
	boom(to + Vector3.new(0, 2, 0), radius * 0.6)
	blast(to, radius, ExtrasConfig.BossSlamKnockback, 1, string.format("💥 %s slammed down on you!", current.Name))
	current.Busy = false
end

local ATTACKS: { [string]: (Boss) -> () } = {
	Stomp = stomp,
	Laser = laser,
	Throw = throw,
	Meteors = meteors,
	Slam = slam,
}

local function attack(current: Boss)
	local choices = current.Tier.Attacks
	local name = choices[rng:NextInteger(1, #choices)]
	-- Not the same attack twice in a row, if it has others.
	if name == current.LastAttack and #choices > 1 then
		name = choices[rng:NextInteger(1, #choices)]
	end
	-- (NextBossAttack: an attack picked by hand, for testing.)
	local forced = ReplicatedStorage:GetAttribute("NextBossAttack")
	if typeof(forced) == "string" and ATTACKS[forced] then
		name = forced
		ReplicatedStorage:SetAttribute("NextBossAttack", nil)
	end
	current.LastAttack = name
	local run = ATTACKS[name] or stomp
	task.spawn(function()
		local ok, err = pcall(function()
			run(current)
		end)
		if not ok then
			current.Busy = false
			warn(string.format("%s Boss attack %s failed: %s", LOG_PREFIX, name, tostring(err)))
		end
	end)
end

local function stepBoss(dt: number)
	local current = boss
	if current == nil or current.Defeated then
		return
	end
	if not current.Busy then
		local area = arena()
		local position = current.Root.Position
		local offset = flat(current.Target - position)
		if offset.Magnitude < 3 then
			if area then
				current.Target = randomSpot(area)
			end
		else
			local step = math.min(offset.Magnitude, current.Speed * dt)
			placeBoss(current, position + offset.Unit * step, offset)
		end
	end
	if os.clock() >= current.NextAttack and not current.Busy then
		current.NextAttack = os.clock() + current.Tier.AttackSeconds / (if current.Enraged then ExtrasConfig.BossRageSpeedup else 1)
		attack(current)
	end
end

-- A slap glove swung at the boss hurts it more than a click.
slapSwingEvent.Event:Connect(function(playerArg: any)
	local current = boss
	if current == nil or typeof(playerArg) ~= "Instance" or not playerArg:IsA("Player") then
		return
	end
	local root = getRoot(playerArg)
	if root == nil then
		return
	end
	local offset = flat(current.Root.Position - root.Position)
	if offset.Magnitude <= GearConfig.SlapRange + current.Height * 0.35 and (offset.Magnitude < 1 or root.CFrame.LookVector:Dot(offset.Unit) > 0.2) then
		damageBoss(current, playerArg, ExtrasConfig.BossSlapDamage)
	end
end)

--------------------------------------------------------------------------------
-- Bank Heist
--------------------------------------------------------------------------------

type LootSpot = { Model: Model, Prompt: ProximityPrompt?, Taken: boolean, Kind: ExtrasConfig.HeistLoot, Sign: TextLabel? }
type Laser = { Part: Part, Phase: number }

local heistOpen = false
local heistAlarm = false
local lootSpots: { LootSpot } = {}
local lasers: { Laser } = {}
local laserClock = 0
local laserHits: { [Player]: number } = {}
local banked: { [Player]: number } = {}
local doorClosedPivot: CFrame? = nil
local doorMoving = 0

local function vault(): Model?
	local found = map:FindFirstChild("Vault")
	return if found and found:IsA("Model") then found else nil
end

local function vaultInside(): BasePart?
	local building = vault()
	local inside = if building then building:FindFirstChild("VaultInside") else nil
	return if inside and inside:IsA("BasePart") then inside else nil
end

local function moveDoor(open: boolean)
	local building = vault()
	local door = if building then building:FindFirstChild("VaultDoor") else nil
	local closed = if building then building:FindFirstChild("DoorClosed") else nil
	local opened = if building then building:FindFirstChild("DoorOpen") else nil
	if not (door and door:IsA("Model") and closed and closed:IsA("BasePart") and opened and opened:IsA("BasePart")) then
		return
	end
	-- The door moves around its disc.
	if door.PrimaryPart == nil then
		local disc = door:FindFirstChild("Disc")
		door.PrimaryPart = if disc and disc:IsA("BasePart") then disc else door:FindFirstChildWhichIsA("BasePart")
	end
	local closedPivot = doorClosedPivot or door:GetPivot()
	doorClosedPivot = closedPivot
	local shift = opened.Position - closed.Position
	local from = door:GetPivot()
	local to = if open then closedPivot + shift else closedPivot
	doorMoving += 1
	local token = doorMoving
	task.spawn(function()
		local started = os.clock()
		while token == doorMoving do
			local alpha = math.clamp((os.clock() - started) / DOOR_SECONDS, 0, 1)
			local eased = alpha * alpha * (3 - 2 * alpha)
			door:PivotTo(from:Lerp(to, eased))
			if alpha >= 1 then
				break
			end
			task.wait(1 / 20)
		end
	end)
end

local function randomLoot(): ExtrasConfig.HeistLoot
	return weighted(ExtrasConfig.HeistLoot, function(kind: ExtrasConfig.HeistLoot): number
		return kind.Weight
	end)
end

-- Shows a pile's loot: its bars and cash, a sign saying what it is, and a
-- sparkling diamond on top of a diamond pile.
local barLooks: { [BasePart]: { Colour: Color3, Material: Enum.Material } } = {}

local function dressPile(spot: LootSpot, visible: boolean)
	for _, part in spot.Model:GetDescendants() do
		if part:IsA("BasePart") and part.Name ~= "Pile" and part.Name ~= "Diamond" then
			part.Transparency = if visible then 0 else 1
			if string.sub(part.Name, 1, 3) == "Bar" then
				-- Gold bars as built; green bundles of cash; glassy diamonds.
				local look = barLooks[part] or { Colour = part.Color, Material = part.Material }
				barLooks[part] = look
				local kind = spot.Kind.Name
				part.Color = if kind == "Gold" then look.Colour else spot.Kind.Colour
				part.Material = if kind == "Gold" then look.Material elseif kind == "Diamond" then Enum.Material.Glass else Enum.Material.SmoothPlastic
			end
		end
	end
	local oldDiamond = spot.Model:FindFirstChild("Diamond")
	if oldDiamond then
		oldDiamond:Destroy()
	end
	local pile = spot.Model:FindFirstChild("Pile")
	if not (pile and pile:IsA("BasePart")) then
		return
	end
	if visible and spot.Kind.Name == "Diamond" then
		local diamond = Instance.new("Part")
		diamond.Name = "Diamond"
		diamond.Size = Vector3.new(1.8, 1.8, 1.8)
		diamond.CFrame = pile.CFrame * CFrame.new(0, 3.6, 0) * CFrame.Angles(math.rad(45), 0, math.rad(45))
		diamond.Color = spot.Kind.Colour
		diamond.Material = Enum.Material.Neon
		diamond.Anchored = true
		diamond.CanCollide = false
		diamond.CanQuery = false
		diamond.CanTouch = false
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = spot.Kind.Colour
		sparkles.Parent = diamond
		diamond.Parent = spot.Model
	end
	if spot.Sign then
		spot.Sign.Text = spot.Kind.Label
		spot.Sign.TextColor3 = spot.Kind.Colour
		spot.Sign.Visible = visible
	end
	if spot.Prompt then
		spot.Prompt.ObjectText = spot.Kind.Label
	end
end

local function clearLoot(player: Player)
	player:SetAttribute("CarryingLoot", nil)
	player:SetAttribute("LootValue", nil)
	player:SetAttribute("LootKind", nil)
	player:SetAttribute("LootSpeed", 0)
	local character = player.Character
	local bag = if character then character:FindFirstChild("LootBag") else nil
	if bag then
		bag:Destroy()
	end
end

local function lootKind(name: any): ExtrasConfig.HeistLoot
	for _, kind in ExtrasConfig.HeistLoot do
		if kind.Name == name then
			return kind
		end
	end
	return ExtrasConfig.HeistLoot[1]
end

local function makeBag(name: string, kind: ExtrasConfig.HeistLoot): Part
	local bag = Instance.new("Part")
	bag.Name = name
	bag.Shape = Enum.PartType.Ball
	bag.Size = Vector3.new(2.6, 2.6, 2.6)
	bag.Color = kind.Colour:Lerp(Color3.fromRGB(150, 110, 60), 0.5)
	bag.Material = if kind.Name == "Diamond" then Enum.Material.Neon else Enum.Material.Fabric
	bag.CanCollide = false
	bag.CanQuery = false
	bag.CanTouch = false
	local label = Instance.new("BillboardGui")
	label.Size = UDim2.fromScale(2, 2)
	label.StudsOffset = Vector3.new(0, 0.2, 0)
	label.LightInfluence = 0
	label.MaxDistance = 80
	local sign = Instance.new("TextLabel")
	sign.BackgroundTransparency = 1
	sign.Size = UDim2.fromScale(1, 1)
	sign.Text = if kind.Name == "Diamond" then "💎" elseif kind.Name == "Gold" then "🟨" else "💰"
	sign.TextScaled = true
	sign.Parent = label
	label.Parent = bag
	return bag
end

local function attachBag(player: Player, kind: ExtrasConfig.HeistLoot)
	local character = player.Character
	local torso = if character
		then (character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart"))
		else nil
	if character == nil or torso == nil or not torso:IsA("BasePart") then
		return
	end
	local bag = makeBag("LootBag", kind)
	bag.Massless = true
	bag.CFrame = torso.CFrame * CFrame.new(0, 0.4, 1.6)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = torso
	weld.Part1 = bag
	weld.Parent = bag
	bag.Parent = character
end

local function giveLoot(player: Player, value: number, kind: ExtrasConfig.HeistLoot)
	player:SetAttribute("CarryingLoot", true)
	player:SetAttribute("LootValue", value)
	player:SetAttribute("LootKind", kind.Name)
	player:SetAttribute("LootSpeed", kind.Speed)
	attachBag(player, kind)
end

-- A dropped bag anyone can pick up for a while.
local function dropLoot(player: Player, message: string)
	local value = tonumber(player:GetAttribute("LootValue")) or 0
	local kind = lootKind(player:GetAttribute("LootKind"))
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	clearLoot(player)
	notify(player, message, "Warning")
	if value <= 0 or root == nil or not root:IsA("BasePart") then
		return
	end
	local bag = makeBag("DroppedLoot", kind)
	bag.Anchored = true
	bag.Position = root.Position - Vector3.new(0, 1.6, 0)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Grab Loot"
	prompt.ObjectText = string.format("%s %s", kind.Label, NumberFormat.cash(value))
	prompt.HoldDuration = 0.4
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("PromptKind", "Loot")
	prompt.Parent = bag
	prompt.Triggered:Connect(function(taker: Player)
		if bag.Parent == nil or taker:GetAttribute("CarryingLoot") == true or taker:GetAttribute("Carrying") == true then
			return
		end
		bag:Destroy()
		giveLoot(taker, value, kind)
		notify(taker, string.format("You grabbed a dropped bag worth %s! Get it to your base!", NumberFormat.cash(value)), "Success", "Collect")
	end)
	bag.Parent = map
	task.delay(DROPPED_LOOT_SECONDS, function()
		if bag.Parent then
			bag:Destroy()
		end
	end)
end

local function onGrab(spot: LootSpot, player: Player)
	if not heistOpen or spot.Taken then
		return
	end
	if player:GetAttribute("CarryingLoot") == true then
		notify(player, "You're already carrying loot! Get it home first.", "Warning")
		return
	end
	if player:GetAttribute("Carrying") == true then
		notify(player, "Your hands are full!", "Warning")
		return
	end
	local kind = spot.Kind
	local multiplier = if heistAlarm then ExtrasConfig.HeistAlarmMultiplier else 1
	local value = math.floor(math.max(kind.Min, income(player) * kind.IncomeSeconds) * multiplier)
	spot.Taken = true
	dressPile(spot, false)
	if spot.Prompt then
		spot.Prompt.Enabled = false
	end
	giveLoot(player, value, kind)
	notify(player, string.format("You grabbed %s worth %s! Run it back to your base!", kind.Label, NumberFormat.cash(value)), "Success", "Collect")
	task.delay(ExtrasConfig.HeistRespawnSeconds, function()
		if heistOpen and spot.Taken then
			spot.Taken = false
			spot.Kind = randomLoot()
			dressPile(spot, true)
			if spot.Prompt then
				spot.Prompt.Enabled = true
			end
		end
	end)
end

-- Security lasers: bars at leg height across the vault, sweeping front to back.
local function addLasers()
	local inside = vaultInside()
	if inside == nil then
		return
	end
	for index = 1, ExtrasConfig.HeistLaserCount do
		local bar = Instance.new("Part")
		bar.Name = "SecurityLaser"
		bar.Size = Vector3.new(inside.Size.X, 0.35, 0.35)
		bar.Color = Color3.fromRGB(255, 30, 30)
		bar.Material = Enum.Material.Neon
		bar.Transparency = 0.1
		bar.Anchored = true
		bar.CanCollide = false
		bar.CanQuery = false
		bar.CanTouch = false
		bar.CastShadow = false
		bar.Parent = effectsFolder
		table.insert(lasers, { Part = bar, Phase = (index - 1) / ExtrasConfig.HeistLaserCount })
	end
end

local function removeLasers()
	for _, entry in lasers do
		entry.Part:Destroy()
	end
	lasers = {}
end

local function openHeist()
	local building = vault()
	if building == nil then
		warn(LOG_PREFIX .. " No Vault in the map; the Bank Heist has nothing to rob.")
		return
	end
	heistOpen = true
	heistAlarm = false
	banked = {}
	ReplicatedStorage:SetAttribute("HeistOpen", true)
	ReplicatedStorage:SetAttribute("HeistAlarm", false)
	moveDoor(true)
	lootSpots = {}
	local lootFolder = building:FindFirstChild("Loot")
	if lootFolder then
		for _, child in lootFolder:GetChildren() do
			local pile = child:FindFirstChild("Pile")
			if child:IsA("Model") and pile and pile:IsA("BasePart") then
				local spot: LootSpot = { Model = child, Prompt = nil, Taken = false, Kind = randomLoot(), Sign = nil }
				local prompt = Instance.new("ProximityPrompt")
				prompt.ActionText = "Grab Loot"
				prompt.HoldDuration = ExtrasConfig.HeistGrabSeconds
				prompt.MaxActivationDistance = 9
				prompt.RequiresLineOfSight = false
				prompt:SetAttribute("PromptKind", "Loot")
				prompt.Parent = pile
				prompt.Triggered:Connect(function(player: Player)
					onGrab(spot, player)
				end)
				spot.Prompt = prompt
				local billboard = Instance.new("BillboardGui")
				billboard.Name = "LootSign"
				billboard.Size = UDim2.fromScale(6, 1.4)
				billboard.StudsOffset = Vector3.new(0, 5.2, 0)
				billboard.LightInfluence = 0
				billboard.MaxDistance = 70
				local sign = Instance.new("TextLabel")
				sign.BackgroundTransparency = 1
				sign.Size = UDim2.fromScale(1, 1)
				sign.Font = Enum.Font.FredokaOne
				sign.TextScaled = true
				local stroke = Instance.new("UIStroke")
				stroke.Thickness = 2
				stroke.Parent = sign
				sign.Parent = billboard
				billboard.Parent = pile
				spot.Sign = sign
				dressPile(spot, true)
				table.insert(lootSpots, spot)
			end
		end
	end
	addLasers()
	notifyAll("🏦 The vault is open! Grab loot, jump over the lasers and get it home.", "Info")
end

local function closeHeist()
	if not heistOpen then
		return
	end
	heistOpen = false
	heistAlarm = false
	ReplicatedStorage:SetAttribute("HeistOpen", false)
	ReplicatedStorage:SetAttribute("HeistAlarm", false)
	moveDoor(false)
	removeLasers()
	for _, spot in lootSpots do
		if spot.Prompt then
			spot.Prompt:Destroy()
		end
		local sign = spot.Model:FindFirstChild("LootSign", true)
		if sign then
			sign:Destroy()
		end
		spot.Kind = lootKind("Gold")
		spot.Sign = nil
		dressPile(spot, true)
	end
	lootSpots = {}
	-- The best robber wins a lucky block.
	local best: Player? = nil
	local bestValue = 0
	for player, value in banked do
		if player.Parent == Players and value > bestValue then
			best, bestValue = player, value
		end
	end
	banked = {}
	if best then
		local prize = BrainrotConfig.ById[ExtrasConfig.HeistTopPrize]
		giveBrainrotFunction:Invoke(best, ExtrasConfig.HeistTopPrize)
		notifyAll(
			string.format("🏆 Best robber: %s (%s)! They win a %s.", best.DisplayName, NumberFormat.cash(bestValue), if prize then prize.DisplayName else "lucky block"),
			"Success",
			"Event"
		)
	end
end

local function plotInterior(player: Player): BasePart?
	for _, plot in plotsFolder:GetChildren() do
		if plot:GetAttribute("OwnerUserId") == player.UserId then
			local interior = plot:FindFirstChild("Interior")
			return if interior and interior:IsA("BasePart") then interior else nil
		end
	end
	return nil
end

-- The lasers sweep, zap whoever's in the way, and speed up for the alarm.
local function stepLasers(dt: number)
	local inside = vaultInside()
	if not heistOpen or inside == nil or #lasers == 0 then
		return
	end
	local endsAt = tonumber(ReplicatedStorage:GetAttribute("EventEndsAt")) or 0
	if not heistAlarm and endsAt > 0 and endsAt - Workspace:GetServerTimeNow() <= ExtrasConfig.HeistAlarmSeconds then
		heistAlarm = true
		ReplicatedStorage:SetAttribute("HeistAlarm", true)
		notifyAll("🚨 ALARM! Loot is worth DOUBLE now, but the lasers are faster!", "Warning", "Alarm")
	end
	local speed = if heistAlarm then ExtrasConfig.HeistAlarmLaserSpeed else ExtrasConfig.HeistLaserSpeed
	local depth = inside.Size.Z - 2
	laserClock += dt * speed / math.max(depth, 1)
	local floorY = -inside.Size.Y / 2
	local now = os.clock()
	for index, entry in lasers do
		-- Back and forth along the vault, each a little behind the last,
		-- alternating ankle and knee height.
		local t = (laserClock + entry.Phase) % 2
		local along = (if t < 1 then t else 2 - t) - 0.5
		local height = if index % 2 == 1 then 1.8 else 3.2
		local cframe = inside.CFrame * CFrame.new(0, floorY + height, along * depth)
		entry.Part.CFrame = cframe
		for _, player in Players:GetPlayers() do
			local root = getRoot(player)
			if root == nil or now - (laserHits[player] or 0) < LASER_HIT_COOLDOWN then
				continue
			end
			local localPosition = cframe:PointToObjectSpace(root.Position)
			-- The feet are about 3 studs under the root; a jump clears it.
			local feet = localPosition.Y - 3
			if math.abs(localPosition.X) <= inside.Size.X / 2 and math.abs(localPosition.Z) <= 1.4 and feet <= 0.4 and feet >= -5 then
				laserHits[player] = now
				local outward = -inside.CFrame.LookVector
				knockbackFunction:Invoke(player, flat(outward), ExtrasConfig.HeistLaserKnockback, 0.8)
				playSoundEvent:FireClient(player, "Zap")
				if player:GetAttribute("CarryingLoot") == true then
					dropLoot(player, "⚡ A security laser zapped you and you dropped your loot!")
				else
					notify(player, "⚡ Zapped by a security laser! Jump over them.", "Warning")
				end
			end
		end
	end
end

-- Bags carried into their owner's base are cashed in.
local function stepLoot(_dt: number)
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("CarryingLoot") ~= true then
			continue
		end
		local root = getRoot(player)
		if root == nil then
			dropLoot(player, "You dropped your loot!")
			continue
		end
		local interior = plotInterior(player)
		if interior and isInside(interior, root.Position) then
			local value = tonumber(player:GetAttribute("LootValue")) or 0
			clearLoot(player)
			if value > 0 then
				addCashFunction:Invoke(player, value)
				if heistOpen then
					banked[player] = (banked[player] or 0) + value
				end
				notify(player, string.format("Heist complete! +%s", NumberFormat.cash(value)), "Success", "Collect")
				activityEvent:Fire(player, "Heist", 1)
			end
		end
	end
end

slappedEvent.Event:Connect(function(slapper: any, target: any)
	if typeof(target) == "Instance" and target:IsA("Player") and target:GetAttribute("CarryingLoot") == true then
		dropLoot(target, "You got slapped and dropped your loot!")
		if typeof(slapper) == "Instance" and slapper:IsA("Player") then
			notify(slapper, string.format("%s dropped their loot! Grab it!", target.DisplayName), "Success")
		end
	end
end)

--------------------------------------------------------------------------------
-- Events and the loop
--------------------------------------------------------------------------------

local function eventByName(name: string?): GameConfig.GameEvent?
	if name == nil then
		return nil
	end
	for _, event in GameConfig.Events do
		if event.Name == name then
			return event
		end
	end
	return nil
end

eventChangedEvent.Event:Connect(function(name: any)
	local event = eventByName(if typeof(name) == "string" then name else nil)
	if event and event.Boss then
		spawnBoss()
	elseif event and event.Heist then
		openHeist()
	else
		removeBoss(true)
		closeHeist()
	end
end)

Players.PlayerRemoving:Connect(function(player: Player)
	local current = boss
	if current then
		current.Damage[player] = nil
		current.LastHit[player] = nil
	end
	laserHits[player] = nil
	banked[player] = nil
end)
Players.PlayerAdded:Connect(function(player: Player)
	player:SetAttribute("LootSpeed", 0)
	player.CharacterRemoving:Connect(function()
		if player:GetAttribute("CarryingLoot") == true then
			clearLoot(player)
		end
	end)
end)
ReplicatedStorage:SetAttribute("BossHealth", 0)
ReplicatedStorage:SetAttribute("BossMaxHealth", 0)
ReplicatedStorage:SetAttribute("HeistOpen", false)
ReplicatedStorage:SetAttribute("HeistAlarm", false)

task.spawn(function()
	local last = os.clock()
	while true do
		task.wait(TICK_SECONDS)
		local now = os.clock()
		local dt = math.min(now - last, 0.5)
		last = now
		for label, step in { Boss = stepBoss, Lasers = stepLasers, Loot = stepLoot } :: { [string]: (number) -> () } do
			local ok, err = pcall(function()
				step(dt)
			end)
			if not ok then
				warn(string.format("%s %s failed: %s", LOG_PREFIX, label, tostring(err)))
			end
		end
	end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="289">
      <Properties>
        <string name="Name">RewardsManager</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
	RewardsManager
	Location: ServerScriptService (Script)

	Everything players earn by showing up and playing:
	  * the spin wheel: one free spin a day (one more each with Premium and
	    with the VIP pass), plus spins
	    from Robux spin packs, daily rewards, playtime gifts, quests and codes
	  * a 7-day login streak with a bigger reward each day
	  * playtime gifts that unlock after minutes played today
	  * codes, each once per player
	  * three daily quests (buy, steal, collect, open a lucky block, ...)
	    and a bonus for finishing all three
	  * badges (FeatureConfig.Badges)
	  * the short tutorial for new players
	  * the Upgrades shop: walk speed levels and base skins bought with Cash
	  * the Group Chest for members of the game's group
	  * saved settings (music and sound volume, low graphics)

	Every request is checked here: the client only asks. Rewards go through the
	DataAndMonetization API (Cash, saved Progress) and the Gameplay API
	(brainrots and lucky blocks land in the base, or wait for room).

	Remotes (ReplicatedStorage.Remotes):
	  Rewards       RemoteFunction (action, argument) -> (ok, message?, extra?)
	  RewardsState  RemoteEvent, server -> client: the player's state (see buildState)
	Player attributes: SpeedLevel, TutorialStep (0 = none)
]]

local BadgeService = game:GetService("BadgeService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BrainrotConfig = require(Shared:WaitForChild("BrainrotConfig"))
local FeatureConfig = require(Shared:WaitForChild("FeatureConfig"))
local NumberFormat = require(Shared:WaitForChild("NumberFormat"))

type Reward = FeatureConfig.Reward

local LOG_PREFIX = "[RewardsManager]"
local REQUEST_COOLDOWN_SECONDS = 0.35
local PLAYTIME_TICK_SECONDS = 5
local MAX_CODE_LENGTH = 32

local dataApi = ServerStorage:WaitForChild("DataAndMonetization")
local gameplayApi = ServerStorage:WaitForChild("Gameplay")

local function bindableFunction(folder: Instance, name: string): BindableFunction
	return folder:WaitForChild(name) :: BindableFunction
end

local addCashFunction = bindableFunction(dataApi, "AddCash")
local spendCashFunction = bindableFunction(dataApi, "SpendCash")
local getPlayerDataFunction = bindableFunction(dataApi, "GetPlayerData")
local getProgressFunction = bindableFunction(dataApi, "GetProgress")
local setProgressFunction = bindableFunction(dataApi, "SetProgress")
local progressChangedEvent = dataApi:WaitForChild("ProgressChanged") :: BindableEvent
local giveBrainrotFunction = bindableFunction(gameplayApi, "GiveBrainrot")
local getIncomeFunction = bindableFunction(gameplayApi, "GetIncome")
local ownsGamePassFunction = bindableFunction(dataApi, "OwnsGamePass")
local addHatFunction = bindableFunction(dataApi, "AddHat")
local activityEvent = gameplayApi:WaitForChild("Activity") :: BindableEvent

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local notifyEvent = remotes:WaitForChild("Notify") :: RemoteEvent

local rewardsFunction = Instance.new("RemoteFunction")
rewardsFunction.Name = "Rewards"
local stateEvent = Instance.new("RemoteEvent")
stateEvent.Name = "RewardsState"
stateEvent.Parent = remotes

local rng = Random.new()
local lastRequest: { [Player]: number } = {}
local ready: { [Player]: boolean } = {}
local statePushQueued: { [Player]: boolean } = {}

--------------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------------

local function notify(player: Player, message: string, kind: string, sound: string?)
	notifyEvent:FireClient(player, message, kind, sound)
end

local function today(): number
	return os.time() // 86400
end

local function getProgress(player: Player, key: string): any
	return getProgressFunction:Invoke(player, key)
end

local function setProgress(player: Player, key: string, value: any): boolean
	return setProgressFunction:Invoke(player, key, value) == true
end

local function getTable(player: Player, key: string): { [any]: any }
	local value = getProgress(player, key)
	return if typeof(value) == "table" then value else {}
end

local function getNumber(player: Player, key: string): number
	return tonumber(getProgress(player, key)) or 0
end

local function isLoaded(player: Player): boolean
	return ready[player] == true and player.Parent == Players and getPlayerDataFunction:Invoke(player) ~= nil
end

local function income(player: Player): number
	return tonumber(getIncomeFunction:Invoke(player)) or 0
end

local function isPremium(player: Player): boolean
	return player.MembershipType == Enum.MembershipType.Premium
end

local function isVip(player: Player): boolean
	return ownsGamePassFunction:Invoke(player, "VIP") == true
end

--------------------------------------------------------------------------------
-- Rewards
--------------------------------------------------------------------------------

local function addSpins(player: Player, count: number): boolean
	local spins = getTable(player, "Spins")
	spins.Extra = math.clamp((tonumber(spins.Extra) or 0) + count, 0, 10000)
	return setProgress(player, "Spins", spins)
end

local function addBoost(player: Player, seconds: number): boolean
	local endsAt = math.max(getNumber(player, "CashBoostEndsAt"), os.time())
	return setProgress(player, "CashBoostEndsAt", endsAt + seconds)
end

-- Gives a reward and returns what it was, for the message ("$5K", ...).
local function grant(player: Player, reward: Reward): (boolean, string)
	if reward.Kind == "Cash" then
		local amount = FeatureConfig.cashAmount(reward, income(player))
		return addCashFunction:Invoke(player, amount) == true, NumberFormat.cash(amount)
	elseif reward.Kind == "Spins" then
		return addSpins(player, reward.Count or 1), FeatureConfig.describeReward(reward)
	elseif reward.Kind == "Boost" then
		return addBoost(player, reward.Seconds or 0), FeatureConfig.describeReward(reward)
	elseif (reward.Kind == "Block" or reward.Kind == "Brainrot") and reward.Id and BrainrotConfig.ById[reward.Id] then
		local result = giveBrainrotFunction:Invoke(player, reward.Id)
		return result == "Placed" or result == "Pending", FeatureConfig.describeReward(reward)
	elseif reward.Kind == "Hat" then
		local hatName = addHatFunction:Invoke(player, reward.Hat or "Random", 1)
		if typeof(hatName) ~= "string" then
			return false, "nothing"
		end
		return true, FeatureConfig.describeReward({ Kind = "Hat", Hat = hatName } :: Reward)
	end
	return false, "nothing"
end

-- Server API (ServerStorage.Rewards) for the season pass and boss raids:
--   BindableFunction GrantReward(player, reward) -> (ok, description)
do
	local folder = Instance.new("Folder")
	folder.Name = "Rewards"
	local grantFunction = Instance.new("BindableFunction")
	grantFunction.Name = "GrantReward"
	grantFunction.OnInvoke = function(playerArg: any, reward: any): (boolean, string)
		if typeof(playerArg) ~= "Instance" or not playerArg:IsA("Player") or typeof(reward) ~= "table" then
			return false, "nothing"
		end
		return grant(playerArg, reward :: Reward)
	end
	grantFunction.Parent = folder
	folder.Parent = ServerStorage
end

--------------------------------------------------------------------------------
-- Badges
--------------------------------------------------------------------------------

local function awardBadge(player: Player, key: string)
	local badgeId = FeatureConfig.Badges[key]
	if typeof(badgeId) ~= "number" or badgeId == 0 then
		return
	end
	local awarded = getTable(player, "Badges")
	if table.find(awarded, key) then
		return
	end
	task.spawn(function()
		local ok, result = pcall(function(): boolean
			return BadgeService:AwardBadge(player.UserId, badgeId)
		end)
		if ok and result and player.Parent == Players then
			local list = getTable(player, "Badges")
			if table.find(list, key) == nil then
				table.insert(list, key)
				setProgress(player, "Badges", list)
			end
		elseif not ok then
			warn(string.format("%s Couldn't award badge %s: %s", LOG_PREFIX, key, tostring(result)))
		end
	end)
end

--------------------------------------------------------------------------------
-- Quests
--------------------------------------------------------------------------------

type QuestState = { Id: string, Progress: number, Claimed: boolean }

-- Today's quests, rolling new ones on a new day.
local function getQuests(player: Player): { Day: number, List: { QuestState }, Bonus: boolean }
	local saved = getTable(player, "Quests")
	local list: { QuestState } = {}
	if saved.Day == today() and typeof(saved.List) == "table" then
		for _, entry in saved.List do
			if typeof(entry) == "table" and typeof(entry.Id) == "string" and FeatureConfig.QuestById[entry.Id] then
				table.insert(list, {
					Id = entry.Id,
					Progress = math.max(0, tonumber(entry.Progress) or 0),
					Claimed = entry.Claimed == true,
				})
			end
		end
	end
	if #list == 0 then
		local pool = table.clone(FeatureConfig.Quests)
		for _ = 1, math.min(FeatureConfig.QuestsPerDay, #pool) do
			local quest = table.remove(pool, rng:NextInteger(1, #pool))
			if quest then
				table.insert(list, { Id = quest.Id, Progress = 0, Claimed = false })
			end
		end
		local fresh = { Day = today(), List = list, Bonus = false }
		setProgress(player, "Quests", fresh)
		return fresh
	end
	return { Day = today(), List = list, Bonus = saved.Bonus == true }
end

--------------------------------------------------------------------------------
-- State for the client
--------------------------------------------------------------------------------

local function spinsAvailable(player: Player): (number, number)
	local spins = getTable(player, "Spins")
	local free = if spins.FreeDay ~= today() then 1 else 0
	if isPremium(player) and spins.PremiumDay ~= today() then
		free += FeatureConfig.PremiumDailySpins
	end
	if isVip(player) and spins.VipDay ~= today() then
		free += FeatureConfig.VipDailySpins
	end
	return free, math.max(0, tonumber(spins.Extra) or 0)
end

local function buildState(player: Player): { [string]: any }
	local daily = getTable(player, "Daily")
	local streak = tonumber(daily.Streak) or 0
	local claimedToday = daily.Day == today()
	local continues = daily.Day == today() - 1
	local nextStreak = if claimedToday then streak else (if continues then streak + 1 else 1)

	local playtime = getTable(player, "Playtime")
	local playSeconds = if playtime.Day == today() then tonumber(playtime.Seconds) or 0 else 0
	local playClaimed = if playtime.Day == today() and typeof(playtime.Claimed) == "table" then playtime.Claimed else {}

	local quests = getQuests(player)
	local questList = {}
	for _, quest in quests.List do
		local info = FeatureConfig.QuestById[quest.Id]
		table.insert(questList, {
			Id = quest.Id,
			Text = info.Text,
			Target = info.Target,
			Progress = math.min(quest.Progress, info.Target),
			Claimed = quest.Claimed,
			Reward = FeatureConfig.describeReward(info.Reward, income(player)),
		})
	end

	local free, extra = spinsAvailable(player)
	local skins = getTable(player, "Skins")
	local settings = getTable(player, "Settings")
	return {
		Day = today(),
		SecondsToNextDay = 86400 - os.time() % 86400,
		Daily = {
			Streak = streak,
			Claimed = claimedToday,
			-- Which of the 7 rewards is (or was) today's.
			Index = (math.max(nextStreak, 1) - 1) % #FeatureConfig.DailyRewards + 1,
		},
		Spins = { Free = free, Extra = extra },
		Playtime = { Seconds = playSeconds, Claimed = playClaimed },
		Quests = questList,
		QuestBonus = quests.Bonus,
		Settings = settings,
		SpeedLevel = getNumber(player, "SpeedLevel"),
		Skins = {
			Owned = if typeof(skins.Owned) == "table" then skins.Owned else {},
			Equipped = if typeof(skins.Equipped) == "string" then skins.Equipped else "Classic",
		},
		GroupChest = getProgress(player, "GroupChest") == true,
		GroupEnabled = FeatureConfig.GroupId ~= 0,
		Income = income(player),
	}
end

local function pushState(player: Player)
	if statePushQueued[player] then
		return
	end
	statePushQueued[player] = true
	task.defer(function()
		statePushQueued[player] = nil
		if isLoaded(player) then
			stateEvent:FireClient(player, buildState(player))
		end
	end)
end

--------------------------------------------------------------------------------
-- Tutorial
--------------------------------------------------------------------------------

local TUTORIAL_ACTIVITIES = { "Buy", "Collect", "Lock" }
local TUTORIAL_DONE = #TUTORIAL_ACTIVITIES + 1

local function setTutorialStep(player: Player, step: number)
	setProgress(player, "Tutorial", step)
	player:SetAttribute("TutorialStep", if step >= TUTORIAL_DONE then 0 else step)
end

local function advanceTutorial(player: Player, activity: string)
	local step = getNumber(player, "Tutorial")
	if step < 1 or step >= TUTORIAL_DONE or TUTORIAL_ACTIVITIES[step] ~= activity then
		return
	end
	step += 1
	setTutorialStep(player, step)
	if step >= TUTORIAL_DONE then
		addCashFunction:Invoke(player, FeatureConfig.TutorialReward)
		notify(
			player,
			string.format("Tutorial done! Here's %s. Now go steal some brainrots!", NumberFormat.cash(FeatureConfig.TutorialReward)),
			"Success",
			"Rebirth"
		)
	end
end

--------------------------------------------------------------------------------
-- Activity: quests, badges and the tutorial
--------------------------------------------------------------------------------

local function onActivity(player: Player, kind: string, amount: number)
	if not isLoaded(player) then
		return
	end
	advanceTutorial(player, kind)

	local quests = getQuests(player)
	local changed = false
	for _, quest in quests.List do
		local info = FeatureConfig.QuestById[quest.Id]
		if info.Activity == kind and not quest.Claimed and quest.Progress < info.Target then
			quest.Progress = math.min(info.Target, quest.Progress + amount)
			changed = true
			if quest.Progress >= info.Target then
				notify(player, string.format("Quest complete: %s! Claim it in Quests.", info.Text), "Success", "Notify")
			end
		end
	end
	if changed then
		setProgress(player, "Quests", quests)
		pushState(player)
	end

	if kind == "Steal" then
		awardBadge(player, "FirstSteal")
	elseif kind == "Rebirth" then
		awardBadge(player, "FirstRebirth")
		local data = getPlayerDataFunction:Invoke(player)
		if typeof(data) == "table" and (tonumber(data.Rebirths) or 0) >= 5 then
			awardBadge(player, "Rebirth5")
		end
	elseif kind == "OpenBlock" then
		awardBadge(player, "LuckyOpener")
	elseif kind == "Fuse" then
		awardBadge(player, "FirstFuse")
	elseif kind == "Trade" then
		awardBadge(player, "FirstTrade")
	elseif kind == "Secret" then
		awardBadge(player, "SecretOwner")
	elseif kind == "IndexComplete" then
		awardBadge(player, "IndexMaster")
	end
end

activityEvent.Event:Connect(function(playerArg: any, kind: any, amount: any)
	if typeof(playerArg) == "Instance" and playerArg:IsA("Player") and typeof(kind) == "string" then
		onActivity(playerArg, kind, math.clamp(tonumber(amount) or 1, 0, 1e12))
	end
end)

--------------------------------------------------------------------------------
-- Requests
--------------------------------------------------------------------------------

type Handler = (player: Player, argument: any) -> (boolean, string?, any)

local function pickSpinPrize(): number
	local total = 0
	for _, prize in FeatureConfig.SpinPrizes do
		total += prize.Weight
	end
	local roll = rng:NextNumber(0, total)
	for index, prize in FeatureConfig.SpinPrizes do
		roll -= prize.Weight
		if roll <= 0 then
			return index
		end
	end
	return 1
end

local HANDLERS: { [string]: Handler } = {}

HANDLERS.State = function(player: Player): (boolean, string?, any)
	return true, nil, buildState(player)
end

HANDLERS.ClaimDaily = function(player: Player): (boolean, string?, any)
	local daily = getTable(player, "Daily")
	if daily.Day == today() then
		return false, "You already claimed today's reward. Come back tomorrow!"
	end
	local streak = if daily.Day == today() - 1 then (tonumber(daily.Streak) or 0) + 1 else 1
	local index = (streak - 1) % #FeatureConfig.DailyRewards + 1
	if not setProgress(player, "Daily", { Day = today(), Streak = streak }) then
		return false, "Try again in a moment."
	end
	local ok, what = grant(player, FeatureConfig.DailyRewards[index])
	if streak >= 7 then
		awardBadge(player, "WeekStreak")
	end
	pushState(player)
	return ok, string.format("Day %d reward: %s!", streak, what)
end

HANDLERS.Spin = function(player: Player): (boolean, string?, any)
	local spins = getTable(player, "Spins")
	local free, extra = spinsAvailable(player)
	if free <= 0 and extra <= 0 then
		return false, "No spins left! Get more from quests, gifts or the shop."
	end
	if spins.FreeDay ~= today() then
		spins.FreeDay = today()
	elseif isPremium(player) and spins.PremiumDay ~= today() then
		spins.PremiumDay = today()
	elseif isVip(player) and spins.VipDay ~= today() then
		spins.VipDay = today()
	else
		spins.Extra = extra - 1
	end
	if not setProgress(player, "Spins", spins) then
		return false, "Try again in a moment."
	end
	local index = pickSpinPrize()
	local prize = FeatureConfig.SpinPrizes[index]
	local _, what = grant(player, prize.Reward)
	onActivity(player, "Spin", 1)
	pushState(player)
	return true, "You won " .. what .. "!", { Index = index }
end

HANDLERS.ClaimPlaytime = function(player: Player, argument: any): (boolean, string?, any)
	local index = tonumber(argument)
	local gift = if index then FeatureConfig.PlaytimeRewards[index] else nil
	if index == nil or gift == nil then
		return false, nil
	end
	local playtime = getTable(player, "Playtime")
	if playtime.Day ~= today() then
		return false, "Keep playing to unlock this gift!"
	end
	local claimed = if typeof(playtime.Claimed) == "table" then playtime.Claimed else {}
	if table.find(claimed, index) then
		return false, "Already opened!"
	end
	if (tonumber(playtime.Seconds) or 0) < gift.Minutes * 60 then
		return false, "Keep playing to unlock this gift!"
	end
	table.insert(claimed, index)
	playtime.Claimed = claimed
	if not setProgress(player, "Playtime", playtime) then
		return false, "Try again in a moment."
	end
	local ok, what = grant(player, gift.Reward)
	pushState(player)
	return ok, "Gift opened: " .. what .. "!"
end

HANDLERS.Redeem = function(player: Player, argument: any): (boolean, string?, any)
	if typeof(argument) ~= "string" or #argument > MAX_CODE_LENGTH then
		return false, "That code doesn't exist."
	end
	local code = string.upper((string.gsub(argument, "%s", "")))
	local reward = FeatureConfig.Codes[code]
	if reward == nil then
		return false, "That code doesn't exist."
	end
	local used = getTable(player, "Codes")
	if table.find(used, code) then
		return false, "You already used this code."
	end
	table.insert(used, code)
	if not setProgress(player, "Codes", used) then
		return false, "Try again in a moment."
	end
	local ok, what = grant(player, reward)
	pushState(player)
	return ok, string.format("Code %s: %s!", code, what)
end

HANDLERS.ClaimQuest = function(player: Player, argument: any): (boolean, string?, any)
	local quests = getQuests(player)
	local quest = quests.List[tonumber(argument) or 0]
	if quest == nil then
		return false, nil
	end
	local info = FeatureConfig.QuestById[quest.Id]
	if quest.Claimed then
		return false, "Already claimed!"
	elseif quest.Progress < info.Target then
		return false, "Finish the quest first!"
	end
	quest.Claimed = true
	if not setProgress(player, "Quests", quests) then
		return false, "Try again in a moment."
	end
	local ok, what = grant(player, info.Reward)
	pushState(player)
	-- Season pass XP.
	activityEvent:Fire(player, "Quest", 1)
	return ok, "Quest reward: " .. what .. "!"
end

HANDLERS.ClaimQuestBonus = function(player: Player): (boolean, string?, any)
	local quests = getQuests(player)
	if quests.Bonus then
		return false, "Already claimed!"
	end
	for _, quest in quests.List do
		if not quest.Claimed then
			return false, "Claim all of today's quests first!"
		end
	end
	quests.Bonus = true
	if not setProgress(player, "Quests", quests) then
		return false, "Try again in a moment."
	end
	local ok, what = grant(player, FeatureConfig.QuestBonus)
	pushState(player)
	return ok, "All quests done! Bonus: " .. what .. "!"
end

HANDLERS.BuySpeed = function(player: Player): (boolean, string?, any)
	local level = getNumber(player, "SpeedLevel")
	local cost = FeatureConfig.SpeedCosts[level + 1]
	if cost == nil then
		return false, "You're already max speed!"
	end
	if spendCashFunction:Invoke(player, cost) ~= true then
		return false, string.format("You need %s for the next speed level.", NumberFormat.cash(cost))
	end
	setProgress(player, "SpeedLevel", level + 1)
	player:SetAttribute("SpeedLevel", level + 1)
	pushState(player)
	return true, string.format("Speed level %d! You run faster now.", level + 1)
end

HANDLERS.BuySkin = function(player: Player, argument: any): (boolean, string?, any)
	local skin = if typeof(argument) == "string" then FeatureConfig.SkinByName[argument] else nil
	if skin == nil or skin.Price == nil then
		return false, nil
	end
	local skins = getTable(player, "Skins")
	local owned = if typeof(skins.Owned) == "table" then skins.Owned else {}
	if table.find(owned, skin.Name) or skin.Price == 0 then
		return false, "You already own this skin."
	end
	if spendCashFunction:Invoke(player, skin.Price) ~= true then
		return false, string.format("You need %s for the %s skin.", NumberFormat.cash(skin.Price), skin.Name)
	end
	table.insert(owned, skin.Name)
	skins.Owned = owned
	skins.Equipped = skin.Name
	setProgress(player, "Skins", skins)
	pushState(player)
	return true, string.format("Your base is now %s!", skin.Name)
end

HANDLERS.EquipSkin = function(player: Player, argument: any): (boolean, string?, any)
	local skin = if typeof(argument) == "string" then FeatureConfig.SkinByName[argument] else nil
	if skin == nil then
		return false, nil
	end
	local skins = getTable(player, "Skins")
	local owned = if typeof(skins.Owned) == "table" then skins.Owned else {}
	if skin.Price ~= 0 and table.find(owned, skin.Name) == nil then
		return false, "You don't own this skin yet."
	end
	skins.Owned = owned
	skins.Equipped = skin.Name
	setProgress(player, "Skins", skins)
	pushState(player)
	return true, string.format("Equipped the %s skin.", skin.Name)
end

HANDLERS.ClaimGroupChest = function(player: Player): (boolean, string?, any)
	if FeatureConfig.GroupId == 0 then
		return false, "There's no group chest yet."
	end
	if getProgress(player, "GroupChest") == true then
		return false, "You already opened the Group Chest."
	end
	local ok, member = pcall(function(): boolean
		return player:IsInGroupAsync(FeatureConfig.GroupId)
	end)
	if not ok or not member then
		return false, "Join the group to open the Group Chest!"
	end
	setProgress(player, "GroupChest", true)
	local granted, what = grant(player, FeatureConfig.GroupChest)
	pushState(player)
	return granted, "Group Chest: " .. what .. "!"
end

HANDLERS.SaveSettings = function(player: Player, argument: any): (boolean, string?, any)
	if typeof(argument) ~= "table" then
		return false, nil
	end
	local defaults = FeatureConfig.DefaultSettings
	setProgress(player, "Settings", {
		Music = math.clamp(tonumber(argument.Music) or defaults.Music, 0, 1),
		Sfx = math.clamp(tonumber(argument.Sfx) or defaults.Sfx, 0, 1),
		LowGraphics = argument.LowGraphics == true,
	})
	return true, nil
end

HANDLERS.SkipTutorial = function(player: Player): (boolean, string?, any)
	if getNumber(player, "Tutorial") < TUTORIAL_DONE then
		setTutorialStep(player, TUTORIAL_DONE)
	end
	return true, nil
end

rewardsFunction.OnServerInvoke = function(player: Player, action: any, argument: any): (boolean, string?, any)
	if typeof(action) ~= "string" then
		return false, nil
	end
	local handler = HANDLERS[action]
	if handler == nil or not isLoaded(player) then
		return false, "Still loading, try again in a moment."
	end
	local now = os.clock()
	if action ~= "State" and now - (lastRequest[player] or 0) < REQUEST_COOLDOWN_SECONDS then
		return false, "Slow down!"
	end
	lastRequest[player] = now
	local ok, message, extra = handler(player, argument)
	return ok, message, extra
end

--------------------------------------------------------------------------------
-- Players
--------------------------------------------------------------------------------

local function onDataLoaded(player: Player)
	if ready[player] then
		return
	end
	ready[player] = true
	player:SetAttribute("SpeedLevel", math.clamp(getNumber(player, "SpeedLevel"), 0, #FeatureConfig.SpeedCosts))

	-- New players get the tutorial; everyone else has seen the game already.
	local tutorial = getProgress(player, "Tutorial")
	if tutorial == nil then
		local data = getPlayerDataFunction:Invoke(player)
		local isNew = typeof(data) == "table" and data.Cash == 0 and data.Rebirths == 0 and data.Steals == 0
		setTutorialStep(player, if isNew then 1 else TUTORIAL_DONE)
	else
		setTutorialStep(player, math.clamp(tonumber(tutorial) or TUTORIAL_DONE, 1, TUTORIAL_DONE))
	end
	awardBadge(player, "Welcome")
	pushState(player)

	local free = spinsAvailable(player)
	local daily = getTable(player, "Daily")
	if daily.Day ~= today() or free > 0 then
		task.delay(6, function()
			if player.Parent == Players then
				notify(player, "Your daily reward and free spin are ready! 🎁", "Info", "Notify")
			end
		end)
	end
end

local function onPlayerAdded(player: Player)
	if player:GetAttribute("DataLoaded") == true then
		task.spawn(onDataLoaded, player)
		return
	end
	local connection: RBXScriptConnection? = nil
	connection = player:GetAttributeChangedSignal("DataLoaded"):Connect(function()
		if player:GetAttribute("DataLoaded") == true then
			if connection then
				connection:Disconnect()
			end
			onDataLoaded(player)
		end
	end)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(function(player: Player)
	ready[player] = nil
	lastRequest[player] = nil
	statePushQueued[player] = nil
end)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

-- Robux purchases (spin packs, skins, Cash Boosts) change saved progress.
progressChangedEvent.Event:Connect(function(playerArg: any, key: any)
	if typeof(playerArg) == "Instance" and playerArg:IsA("Player") and (key == "Spins" or key == "Skins" or key == "CashBoostEndsAt") then
		pushState(playerArg)
	end
end)

-- Playtime: minutes played today (UTC), and badges that watch Cash.
task.spawn(function()
	while true do
		task.wait(PLAYTIME_TICK_SECONDS)
		for _, player in Players:GetPlayers() do
			if not isLoaded(player) then
				continue
			end
			local playtime = getTable(player, "Playtime")
			if playtime.Day ~= today() then
				playtime = { Day = today(), Seconds = 0, Claimed = {} }
			end
			local before = tonumber(playtime.Seconds) or 0
			playtime.Seconds = before + PLAYTIME_TICK_SECONDS
			setProgress(player, "Playtime", playtime)
			for _, gift in FeatureConfig.PlaytimeRewards do
				local unlockAt = gift.Minutes * 60
				if before < unlockAt and playtime.Seconds >= unlockAt then
					notify(player, "A playtime gift is ready to open! 🎁", "Info", "Notify")
					pushState(player)
				end
			end
			local data = getPlayerDataFunction:Invoke(player)
			if typeof(data) == "table" and (tonumber(data.Cash) or 0) >= 1000000 then
				awardBadge(player, "Millionaire")
			end
		end
	end
end)

-- Parent last so the client sees both remotes together.
rewardsFunction.Parent = remotes
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="290">
      <Properties>
        <string name="Name">SeasonManager</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
	SeasonManager
	Location: ServerScriptService (Script)

	The season pass: playing earns XP (ExtrasConfig.ActivityXP for everything
	GameplayManager and the other scripts report, plus a little for every
	minute played), every ExtrasConfig.TierXP XP opens the next of 30 tiers,
	and each tier has a free reward and a premium one for owners of the Season
	Pass game pass. A new season (and a fresh pass) starts every
	ExtrasConfig.SeasonDays days; its XP is kept by DataAndMonetizationManager.

	Remotes:
	  Season       RemoteFunction ("State") -> state, ("Claim", { Tier, Track })
	               -> (ok, message), ("ClaimAll") -> (ok, message)
	  SeasonState  RemoteEvent, server -> client: state (see buildState)
	Saved: progress "SeasonClaims" = { Id, Free = { tier... }, Premium = { tier... } }
	Also publishes this week's limited brainrot (ExtrasConfig.LimitedRotation)
	as ReplicatedStorage attributes LimitedId and LimitedEndsAt (server time).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ExtrasConfig = require(Shared:WaitForChild("ExtrasConfig"))
local FeatureConfig = require(Shared:WaitForChild("FeatureConfig"))

type Reward = FeatureConfig.Reward
type Claims = { Id: number, Free: { number }, Premium: { number } }

local REQUEST_COOLDOWN_SECONDS = 0.3
local PLAYTIME_TICK_SECONDS = 60

local dataApi = ServerStorage:WaitForChild("DataAndMonetization")
local gameplayApi = ServerStorage:WaitForChild("Gameplay")
local rewardsApi = ServerStorage:WaitForChild("Rewards")
local getSeasonFunction = dataApi:WaitForChild("GetSeason") :: BindableFunction
local addSeasonXPFunction = dataApi:WaitForChild("AddSeasonXP") :: BindableFunction
local getProgressFunction = dataApi:WaitForChild("GetProgress") :: BindableFunction
local setProgressFunction = dataApi:WaitForChild("SetProgress") :: BindableFunction
local ownsGamePassFunction = dataApi:WaitForChild("OwnsGamePass") :: BindableFunction
local progressChangedEvent = dataApi:WaitForChild("ProgressChanged") :: BindableEvent
local gamePassChangedEvent = dataApi:WaitForChild("GamePassOwnershipChanged") :: BindableEvent
local activityEvent = gameplayApi:WaitForChild("Activity") :: BindableEvent
local grantRewardFunction = rewardsApi:WaitForChild("GrantReward") :: BindableFunction

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local notifyEvent = remotes:WaitForChild("Notify") :: RemoteEvent

local seasonFunction = Instance.new("RemoteFunction")
seasonFunction.Name = "Season"
seasonFunction.Parent = remotes
local stateEvent = Instance.new("RemoteEvent")
stateEvent.Name = "SeasonState"
stateEvent.Parent = remotes

local ready: { [Player]: boolean } = {}
local lastRequest: { [Player]: number } = {}

local function notify(player: Player, message: string, kind: string, sound: string?)
	notifyEvent:FireClient(player, message, kind, sound)
end

local function getSeason(player: Player): (number, number)
	local season = getSeasonFunction:Invoke(player)
	if typeof(season) ~= "table" then
		return ExtrasConfig.season(os.time()), 0
	end
	return tonumber(season.Id) or 1, tonumber(season.XP) or 0
end

local function isPremium(player: Player): boolean
	return ownsGamePassFunction:Invoke(player, "SeasonPass") == true
end

local function getClaims(player: Player, seasonId: number): Claims
	local saved = getProgressFunction:Invoke(player, "SeasonClaims")
	if typeof(saved) ~= "table" or saved.Id ~= seasonId then
		return { Id = seasonId, Free = {}, Premium = {} }
	end
	local function list(value: any): { number }
		local result: { number } = {}
		if typeof(value) == "table" then
			for _, tier in value do
				if typeof(tier) == "number" then
					table.insert(result, tier)
				end
			end
		end
		return result
	end
	return { Id = seasonId, Free = list(saved.Free), Premium = list(saved.Premium) }
end

local function buildState(player: Player): { [string]: any }
	local seasonId, xp = getSeason(player)
	local _, endsAt = ExtrasConfig.season(os.time())
	local claims = getClaims(player, seasonId)
	return {
		Season = seasonId,
		-- Clients count down in server time.
		EndsAt = Workspace:GetServerTimeNow() + (endsAt - os.time()),
		XP = xp,
		Tier = ExtrasConfig.tierOf(xp),
		Premium = isPremium(player),
		Free = claims.Free,
		PremiumClaimed = claims.Premium,
	}
end

local function pushState(player: Player)
	if ready[player] and player.Parent == Players then
		stateEvent:FireClient(player, buildState(player))
	end
end

local function addXP(player: Player, amount: number)
	if not ready[player] or amount <= 0 then
		return
	end
	local _, before = getSeason(player)
	local after = tonumber(addSeasonXPFunction:Invoke(player, amount)) or before
	local tierBefore, tierAfter = ExtrasConfig.tierOf(before), ExtrasConfig.tierOf(after)
	if tierAfter > tierBefore then
		notify(player, string.format("🏆 Season tier %d reached! Claim your reward in the Season menu.", tierAfter), "Success", "Notify")
	end
	pushState(player)
end

-- Gives a tier's reward on one track. Returns (ok, message).
local function claim(player: Player, tier: number, track: string): (boolean, string?)
	local seasonId, xp = getSeason(player)
	if tier < 1 or tier > ExtrasConfig.SeasonTierCount or tier ~= math.floor(tier) then
		return false, nil
	end
	if ExtrasConfig.tierOf(xp) < tier then
		return false, "Reach that tier first!"
	end
	if track == "Premium" and not isPremium(player) then
		return false, "Get the Season Pass for the premium rewards!"
	end
	if track ~= "Free" and track ~= "Premium" then
		return false, nil
	end
	local claims = getClaims(player, seasonId)
	local list = if track == "Free" then claims.Free else claims.Premium
	if table.find(list, tier) then
		return false, "Already claimed!"
	end
	table.insert(list, tier)
	-- Saved before the reward is given, so it can't be claimed twice.
	if setProgressFunction:Invoke(player, "SeasonClaims", claims) ~= true then
		return false, "Try again in a moment."
	end
	local reward = ExtrasConfig.SeasonTiers[tier][if track == "Free" then 1 else 2]
	local ok, what = grantRewardFunction:Invoke(player, reward)
	return ok == true, string.format("Tier %d: %s!", tier, tostring(what))
end

seasonFunction.OnServerInvoke = function(player: Player, action: any, argument: any): (boolean, string?, any)
	if not ready[player] then
		return false, "Still loading, try again in a moment."
	end
	if action == "State" then
		return true, nil, buildState(player)
	end
	local now = os.clock()
	if now - (lastRequest[player] or 0) < REQUEST_COOLDOWN_SECONDS then
		return false, "Slow down!"
	end
	lastRequest[player] = now
	if action == "Claim" and typeof(argument) == "table" then
		local ok, message = claim(player, tonumber(argument.Tier) or 0, tostring(argument.Track))
		pushState(player)
		return ok, message, buildState(player)
	elseif action == "ClaimAll" then
		local _, xp = getSeason(player)
		local reached = ExtrasConfig.tierOf(xp)
		local count = 0
		for tier = 1, reached do
			for _, track in { "Free", "Premium" } do
				if claim(player, tier, track) then
					count += 1
				end
			end
		end
		pushState(player)
		return count > 0, if count > 0 then string.format("Claimed %d reward%s!", count, if count == 1 then "" else "s") else "Nothing to claim yet.", buildState(player)
	end
	return false, nil
end

activityEvent.Event:Connect(function(playerArg: any, kind: any, amount: any)
	if typeof(playerArg) ~= "Instance" or not playerArg:IsA("Player") or typeof(kind) ~= "string" then
		return
	end
	local xp = ExtrasConfig.ActivityXP[kind]
	if xp == nil then
		return
	end
	-- Most activities come one at a time; a few (BossHit) report a count.
	local count = if kind == "BossHit" then math.clamp(tonumber(amount) or 1, 0, 500) else 1
	addXP(playerArg, xp * count)
end)

progressChangedEvent.Event:Connect(function(playerArg: any, key: any)
	if typeof(playerArg) == "Instance" and playerArg:IsA("Player") and (key == "Season" or key == "SeasonClaims") then
		pushState(playerArg)
	end
end)

gamePassChangedEvent.Event:Connect(function(playerArg: any, passName: any)
	if typeof(playerArg) == "Instance" and playerArg:IsA("Player") and passName == "SeasonPass" then
		pushState(playerArg)
	end
end)

local function onPlayerAdded(player: Player)
	local function start()
		ready[player] = true
		pushState(player)
	end
	if player:GetAttribute("DataLoaded") == true then
		start()
		return
	end
	local connection: RBXScriptConnection? = nil
	connection = player:GetAttributeChangedSignal("DataLoaded"):Connect(function()
		if player:GetAttribute("DataLoaded") == true then
			if connection then
				connection:Disconnect()
			end
			start()
		end
	end)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(function(player: Player)
	ready[player] = nil
	lastRequest[player] = nil
end)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

-- This week's limited brainrot, from the server's clock (a player's device
-- clock can be wrong): ReplicatedStorage attributes LimitedId and
-- LimitedEndsAt (server time).
local function publishLimited()
	local limited, endsAt = ExtrasConfig.currentLimited(os.time())
	ReplicatedStorage:SetAttribute("LimitedId", limited.Id)
	ReplicatedStorage:SetAttribute("LimitedEndsAt", Workspace:GetServerTimeNow() + (endsAt - os.time()))
end
publishLimited()
task.spawn(function()
	while true do
		task.wait(30)
		publishLimited()
	end
end)

-- A little XP for every minute played.
task.spawn(function()
	while true do
		task.wait(PLAYTIME_TICK_SECONDS)
		for player in ready do
			pcall(addXP, player, ExtrasConfig.PlaytimeXPPerMinute * PLAYTIME_TICK_SECONDS / 60)
		end
	end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="291">
      <Properties>
        <string name="Name">SocialManager</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
	SocialManager
	Location: ServerScriptService (Script)

	Everything between players:
	  * name tags: sized in studs above each head (Roblox's own name is
	    hidden), with the player's crew and bounty
	  * crews: up to ExtrasConfig.CrewMaxSize players in a server team up. Each
	    crewmate in the server adds ExtrasConfig.CrewBoostPerMember income;
	    crewmates walk through each other's laser doors and can't steal from
	    each other. Crews last as long as the server session.
	  * bounties: the server's top thief (at least BountyMinSteals steals this
	    session) has a price on their head, paid by the game to whoever steals
	    from them next
	  * revenge: when someone steals from you, you're faster for
	    RevengeSeconds and stealing anything back from them pays a bonus

	Remotes:
	  Crew       RemoteFunction (action, argument) -> (ok, message?, state?)
	             actions State, Create {Name, Color}, Invite userId,
	             Accept crewId, Decline crewId, Leave, Kick userId
	  CrewEvent  RemoteEvent, server -> client: ("Invite", info) or ("State", state)
	Player attributes: CrewId, CrewName, CrewColor, CrewBoost, Bounty,
	  RevengeTarget (UserId), RevengeEndsAt (server time), RevengeSpeed
	ReplicatedStorage attribute: BountyHolder (UserId, 0 = none)
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ExtrasConfig = require(Shared:WaitForChild("ExtrasConfig"))
local NumberFormat = require(Shared:WaitForChild("NumberFormat"))

local REQUEST_COOLDOWN_SECONDS = 0.4
local BOUNTY_REFRESH_SECONDS = 2

type Crew = {
	Id: string,
	Name: string,
	ColorIndex: number,
	Leader: Player,
	Members: { Player },
}

local dataApi = ServerStorage:WaitForChild("DataAndMonetization")
local gameplayApi = ServerStorage:WaitForChild("Gameplay")
local addCashFunction = dataApi:WaitForChild("AddCash") :: BindableFunction
local getIncomeFunction = gameplayApi:WaitForChild("GetIncome") :: BindableFunction
local stolenEvent = gameplayApi:WaitForChild("Stolen") :: BindableEvent
local activityEvent = gameplayApi:WaitForChild("Activity") :: BindableEvent

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local notifyEvent = remotes:WaitForChild("Notify") :: RemoteEvent

local crewFunction = Instance.new("RemoteFunction")
crewFunction.Name = "Crew"
crewFunction.Parent = remotes
local crewEvent = Instance.new("RemoteEvent")
crewEvent.Name = "CrewEvent"
crewEvent.Parent = remotes

local crews: { [string]: Crew } = {}
local crewOf: { [Player]: Crew } = {}
-- Invites waiting for an answer: invites[target][crewId] = expiry (os.clock()).
local invites: { [Player]: { [string]: number } } = {}
local sessionSteals: { [Player]: number } = {}
local lastRequest: { [Player]: number } = {}
local bountyHolder: Player? = nil

local function notify(player: Player, message: string, kind: string, sound: string?)
	notifyEvent:FireClient(player, message, kind, sound)
end

local function notifyAll(message: string, kind: string, sound: string?)
	notifyEvent:FireAllClients(message, kind, sound)
end

local function income(player: Player): number
	return tonumber(getIncomeFunction:Invoke(player)) or 0
end

--------------------------------------------------------------------------------
-- Name tags
--------------------------------------------------------------------------------

local function tagLine(parent: Instance, name: string, height: number, order: number, color: Color3): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, height)
	label.LayoutOrder = order
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.Text = ""
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(20, 20, 30)
	stroke.Parent = label
	label.Parent = parent
	return label
end

local function updateTag(player: Player)
	local character = player.Character
	local head = if character then character:FindFirstChild("Head") else nil
	local tag = if head then head:FindFirstChild("NameTag") else nil
	if tag == nil or not tag:IsA("BillboardGui") then
		return
	end
	tag.Enabled = player:GetAttribute("Cloaked") ~= true
	local crewLabel = tag:FindFirstChild("Crew") :: TextLabel?
	local bountyLabel = tag:FindFirstChild("Bounty") :: TextLabel?
	local crewName = player:GetAttribute("CrewName")
	if crewLabel then
		crewLabel.Visible = typeof(crewName) == "string"
		crewLabel.Text = if typeof(crewName) == "string" then "[" .. crewName .. "]" else ""
		local color = player:GetAttribute("CrewColor")
		crewLabel.TextColor3 = if typeof(color) == "Color3" then color else Color3.new(1, 1, 1)
	end
	local bounty = tonumber(player:GetAttribute("Bounty")) or 0
	if bountyLabel then
		bountyLabel.Visible = bounty > 0
		bountyLabel.Text = "💰 BOUNTY " .. NumberFormat.cash(bounty)
	end
end

local function addTag(player: Player, character: Model)
	local head = character:WaitForChild("Head", 10)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if head == nil or not head:IsA("BasePart") or player.Character ~= character then
		return
	end
	if humanoid and humanoid:IsA("Humanoid") then
		-- Our own tag replaces Roblox's name, which doesn't scale with distance.
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	local old = head:FindFirstChild("NameTag")
	if old then
		old:Destroy()
	end
	local tag = Instance.new("BillboardGui")
	tag.Name = "NameTag"
	tag.Adornee = head
	-- Studs, like everything in the world: small far away, normal up close.
	tag.Size = UDim2.fromScale(7, 2.4)
	tag.StudsOffsetWorldSpace = Vector3.new(0, 2.6, 0)
	tag.MaxDistance = 140
	tag.LightInfluence = 0
	tag.PlayerToHideFrom = player
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = tag
	tagLine(tag, "Crew", 0.26, 1, Color3.new(1, 1, 1))
	local nameLabel = tagLine(tag, "PlayerName", 0.42, 2, Color3.new(1, 1, 1))
	nameLabel.Text = player.DisplayName
	local bounty = tagLine(tag, "Bounty", 0.3, 3, Color3.fromRGB(255, 215, 60))
	local bountyStroke = bounty:FindFirstChildOfClass("UIStroke")
	if bountyStroke then
		bountyStroke.Color = Color3.fromRGB(150, 20, 20)
	end
	tag.Parent = head
	updateTag(player)
end

--------------------------------------------------------------------------------
-- Crews
--------------------------------------------------------------------------------

local function crewState(player: Player): { [string]: any }
	local crew = crewOf[player]
	local state: { [string]: any } = { Invites = {} }
	if crew then
		local members = {}
		for _, member in crew.Members do
			table.insert(members, { UserId = member.UserId, Name = member.DisplayName })
		end
		state.Crew = {
			Id = crew.Id,
			Name = crew.Name,
			ColorIndex = crew.ColorIndex,
			Leader = crew.Leader.UserId,
			Members = members,
		}
	end
	local now = os.clock()
	local pending: { [string]: number } = invites[player] or {}
	for crewId, expiry in pending do
		local invited = crews[crewId]
		if invited and expiry > now then
			table.insert(state.Invites, { CrewId = crewId, CrewName = invited.Name, From = invited.Leader.DisplayName })
		end
	end
	return state
end

local function pushState(player: Player)
	if player.Parent == Players then
		crewEvent:FireClient(player, "State", crewState(player))
	end
end

local function refreshCrew(crew: Crew)
	local boost = ExtrasConfig.CrewBoostPerMember * math.max(0, #crew.Members - 1)
	local color = ExtrasConfig.CrewColors[crew.ColorIndex] or Color3.new(1, 1, 1)
	for _, member in crew.Members do
		member:SetAttribute("CrewId", crew.Id)
		member:SetAttribute("CrewName", crew.Name)
		member:SetAttribute("CrewColor", color)
		member:SetAttribute("CrewBoost", boost)
		updateTag(member)
		pushState(member)
	end
end

local function leaveCrew(player: Player, message: string?)
	local crew = crewOf[player]
	if crew == nil then
		return
	end
	crewOf[player] = nil
	local index = table.find(crew.Members, player)
	if index then
		table.remove(crew.Members, index)
	end
	player:SetAttribute("CrewId", nil)
	player:SetAttribute("CrewName", nil)
	player:SetAttribute("CrewColor", nil)
	player:SetAttribute("CrewBoost", 0)
	updateTag(player)
	pushState(player)
	if #crew.Members == 0 then
		crews[crew.Id] = nil
		return
	end
	if crew.Leader == player then
		crew.Leader = crew.Members[1]
		notify(crew.Leader, "You lead the crew now.", "Info")
	end
	for _, member in crew.Members do
		notify(member, message or string.format("%s left the crew.", player.DisplayName), "Info")
	end
	refreshCrew(crew)
end

local HANDLERS: { [string]: (player: Player, argument: any) -> (boolean, string?) } = {}

HANDLERS.Create = function(player: Player, argument: any): (boolean, string?)
	if crewOf[player] then
		return false, "You're already in a crew."
	end
	local nameIndex = if typeof(argument) == "table" then tonumber(argument.Name) else nil
	local colorIndex = if typeof(argument) == "table" then tonumber(argument.Color) else nil
	local name = if nameIndex then ExtrasConfig.CrewNames[nameIndex] else nil
	if name == nil then
		return false, "Pick a crew name."
	end
	local crew: Crew = {
		Id = HttpService:GenerateGUID(false),
		Name = name,
		ColorIndex = if colorIndex and ExtrasConfig.CrewColors[colorIndex] then colorIndex else 1,
		Leader = player,
		Members = { player },
	}
	crews[crew.Id] = crew
	crewOf[player] = crew
	refreshCrew(crew)
	return true, string.format("You started the %s! Invite players from the Crew menu.", name)
end

HANDLERS.Invite = function(player: Player, argument: any): (boolean, string?)
	local crew = crewOf[player]
	if crew == nil then
		return false, "Start a crew first."
	end
	local target = if typeof(argument) == "number" then Players:GetPlayerByUserId(argument) else nil
	if target == nil or target == player then
		return false, "That player isn't here."
	end
	if crewOf[target] == crew then
		return false, "They're already in your crew."
	end
	if #crew.Members >= ExtrasConfig.CrewMaxSize then
		return false, "Your crew is full."
	end
	invites[target] = invites[target] or {}
	invites[target][crew.Id] = os.clock() + ExtrasConfig.CrewInviteSeconds
	crewEvent:FireClient(target, "Invite", { CrewId = crew.Id, CrewName = crew.Name, From = player.DisplayName })
	pushState(target)
	return true, string.format("Invited %s to the %s.", target.DisplayName, crew.Name)
end

HANDLERS.Accept = function(player: Player, argument: any): (boolean, string?)
	local crewId = if typeof(argument) == "string" then argument else nil
	local crew = if crewId then crews[crewId] else nil
	local expiry = if crewId and invites[player] then invites[player][crewId] else nil
	if crew == nil or expiry == nil or expiry < os.clock() then
		return false, "That invite ran out."
	end
	if #crew.Members >= ExtrasConfig.CrewMaxSize then
		return false, "That crew is full now."
	end
	invites[player][crewId :: string] = nil
	leaveCrew(player)
	crewOf[player] = crew
	table.insert(crew.Members, player)
	for _, member in crew.Members do
		if member ~= player then
			notify(member, string.format("%s joined the crew!", player.DisplayName), "Success")
		end
	end
	refreshCrew(crew)
	return true, string.format("You joined the %s! +%d%% income for each crewmate here.", crew.Name, math.floor(ExtrasConfig.CrewBoostPerMember * 100))
end

HANDLERS.Decline = function(player: Player, argument: any): (boolean, string?)
	if typeof(argument) == "string" and invites[player] then
		invites[player][argument] = nil
	end
	pushState(player)
	return true, nil
end

HANDLERS.Leave = function(player: Player): (boolean, string?)
	if crewOf[player] == nil then
		return false, "You're not in a crew."
	end
	leaveCrew(player)
	return true, "You left the crew."
end

HANDLERS.Kick = function(player: Player, argument: any): (boolean, string?)
	local crew = crewOf[player]
	local target = if typeof(argument) == "number" then Players:GetPlayerByUserId(argument) else nil
	if crew == nil or crew.Leader ~= player then
		return false, "Only the crew leader can do that."
	end
	if target == nil or target == player or crewOf[target] ~= crew then
		return false, "They're not in your crew."
	end
	leaveCrew(target, string.format("%s was kicked from the crew.", target.DisplayName))
	notify(target, "You were kicked from the crew.", "Warning")
	return true, nil
end

crewFunction.OnServerInvoke = function(player: Player, action: any, argument: any): (boolean, string?, any)
	if action == "State" then
		return true, nil, crewState(player)
	end
	local handler = if typeof(action) == "string" then HANDLERS[action] else nil
	if handler == nil then
		return false, nil
	end
	local now = os.clock()
	if now - (lastRequest[player] or 0) < REQUEST_COOLDOWN_SECONDS then
		return false, "Slow down!"
	end
	lastRequest[player] = now
	local ok, message = handler(player, argument)
	return ok, message, crewState(player)
end

--------------------------------------------------------------------------------
-- Bounties
--------------------------------------------------------------------------------

local function bountyFor(player: Player): number
	local steals = sessionSteals[player] or 0
	local perSecond = income(player)
	local fromIncome = math.min(perSecond * ExtrasConfig.BountyIncomeSecondsPerSteal * steals, perSecond * ExtrasConfig.BountyMaxIncomeSeconds)
	return math.floor(ExtrasConfig.BountyBase + fromIncome)
end

local function refreshBounty()
	local best: Player? = nil
	local bestSteals = ExtrasConfig.BountyMinSteals - 1
	for player, steals in sessionSteals do
		if player.Parent == Players and steals > bestSteals then
			best, bestSteals = player, steals
		end
	end
	if best ~= bountyHolder then
		local old = bountyHolder
		bountyHolder = best
		if old then
			old:SetAttribute("Bounty", 0)
			updateTag(old)
		end
		if best then
			notifyAll(string.format("💰 %s is the server's top thief! Steal from them to claim the bounty!", best.DisplayName), "Warning", "Notify")
		end
	end
	ReplicatedStorage:SetAttribute("BountyHolder", if best then best.UserId else 0)
	if best then
		best:SetAttribute("Bounty", bountyFor(best))
		updateTag(best)
	end
end

--------------------------------------------------------------------------------
-- Revenge
--------------------------------------------------------------------------------

local function clearRevenge(player: Player)
	player:SetAttribute("RevengeTarget", nil)
	player:SetAttribute("RevengeEndsAt", nil)
	player:SetAttribute("RevengeSpeed", 0)
end

local function startRevenge(victim: Player, thief: Player)
	local endsAt = Workspace:GetServerTimeNow() + ExtrasConfig.RevengeSeconds
	victim:SetAttribute("RevengeTarget", thief.UserId)
	victim:SetAttribute("RevengeEndsAt", endsAt)
	victim:SetAttribute("RevengeSpeed", ExtrasConfig.RevengeSpeedBonus)
	notify(
		victim,
		string.format("REVENGE! Steal anything from %s in the next %d seconds for a bonus. You're faster!", thief.DisplayName, ExtrasConfig.RevengeSeconds),
		"Warning",
		"Notify"
	)
	task.delay(ExtrasConfig.RevengeSeconds, function()
		if victim:GetAttribute("RevengeEndsAt") == endsAt then
			clearRevenge(victim)
		end
	end)
end

stolenEvent.Event:Connect(function(thiefArg: any, victimArg: any)
	if typeof(thiefArg) ~= "Instance" or not thiefArg:IsA("Player") or typeof(victimArg) ~= "Instance" or not victimArg:IsA("Player") then
		return
	end
	local thief: Player = thiefArg
	local victim: Player = victimArg
	sessionSteals[thief] = (sessionSteals[thief] or 0) + 1

	-- Getting them back.
	local endsAt = tonumber(thief:GetAttribute("RevengeEndsAt")) or 0
	if thief:GetAttribute("RevengeTarget") == victim.UserId and Workspace:GetServerTimeNow() < endsAt then
		local bonus = math.max(ExtrasConfig.RevengeMinCash, math.floor(income(thief) * ExtrasConfig.RevengeIncomeSeconds))
		addCashFunction:Invoke(thief, bonus)
		clearRevenge(thief)
		notify(thief, string.format("REVENGE! You got %s back and earned %s!", victim.DisplayName, NumberFormat.cash(bonus)), "Success", "StealSuccess")
		notify(victim, string.format("%s got their revenge!", thief.DisplayName), "Warning")
		activityEvent:Fire(thief, "Revenge", 1)
	end

	-- The bounty on the victim.
	if victim == bountyHolder then
		local bounty = tonumber(victim:GetAttribute("Bounty")) or bountyFor(victim)
		addCashFunction:Invoke(thief, bounty)
		sessionSteals[victim] = 0
		notifyAll(string.format("💰 %s claimed the %s bounty on %s!", thief.DisplayName, NumberFormat.cash(bounty), victim.DisplayName), "Success", "Notify")
		activityEvent:Fire(thief, "Bounty", 1)
	end

	startRevenge(victim, thief)
	refreshBounty()
end)

--------------------------------------------------------------------------------
-- Players
--------------------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	player:SetAttribute("CrewBoost", 0)
	player:SetAttribute("Bounty", 0)
	player:SetAttribute("RevengeSpeed", 0)
	player.CharacterAdded:Connect(function(character: Model)
		addTag(player, character)
	end)
	if player.Character then
		task.spawn(addTag, player, player.Character)
	end
	player:GetAttributeChangedSignal("Cloaked"):Connect(function()
		updateTag(player)
	end)
	-- Anyone in the server can be invited: show them to everyone's crew menu.
	for _, other in Players:GetPlayers() do
		if other ~= player then
			pushState(other)
		end
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(function(player: Player)
	leaveCrew(player)
	invites[player] = nil
	sessionSteals[player] = nil
	lastRequest[player] = nil
	for _, pending in invites do
		for crewId in pending do
			if crews[crewId] == nil then
				pending[crewId] = nil
			end
		end
	end
	if bountyHolder == player then
		bountyHolder = nil
	end
	refreshBounty()
	-- Anyone who wanted revenge on them can't get it now.
	for _, other in Players:GetPlayers() do
		if other:GetAttribute("RevengeTarget") == player.UserId then
			clearRevenge(other)
		end
	end
end)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end
ReplicatedStorage:SetAttribute("BountyHolder", 0)

task.spawn(function()
	while true do
		task.wait(BOUNTY_REFRESH_SECONDS)
		pcall(refreshBounty)
	end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="292">
      <Properties>
        <string name="Name">TradeManager</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
	TradeManager
	Location: ServerScriptService (Script)

	Brainrot trading between two players:
	  1. A asks B to trade; B has a few seconds to accept.
	  2. Both put up to FeatureConfig.MaxTradeItems brainrots from their base
	     on the table. Every change un-readies both sides, so nobody can swap
	     an offer at the last second.
	  3. When both press Ready a short countdown runs; then the server swaps
	     the brainrots in one step (GameplayManager's TradeBrainrots checks
	     that every brainrot is still at home and that both bases have room).

	Remotes (ReplicatedStorage.Remotes):
	  Trade       RemoteFunction (action, argument) -> (ok, message?)
	    "Request" userId | "Respond" { From = userId, Accept = bool } |
	    "Offer" { slot, ... } | "Ready" bool | "Cancel"
	  TradeState  RemoteEvent, server -> client:
	    { Kind = "Request", From, Name, ExpiresIn }
	    { Kind = "Session", Partner, PartnerName, Mine, Theirs, MyReady,
	      TheirReady, CountdownEndsAt }   (offers are lists of { Slot, Entry })
	    { Kind = "Closed", Message }
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local FeatureConfig = require(Shared:WaitForChild("FeatureConfig"))

local REQUEST_COOLDOWN_SECONDS = 0.25
local ASK_COOLDOWN_SECONDS = 4

local gameplayApi = ServerStorage:WaitForChild("Gameplay")
local tradeBrainrotsFunction = gameplayApi:WaitForChild("TradeBrainrots") :: BindableFunction
local describeSlotsFunction = gameplayApi:WaitForChild("DescribeSlots") :: BindableFunction
local activityEvent = gameplayApi:WaitForChild("Activity") :: BindableEvent

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local notifyEvent = remotes:WaitForChild("Notify") :: RemoteEvent

local tradeFunction = Instance.new("RemoteFunction")
tradeFunction.Name = "Trade"
local stateEvent = Instance.new("RemoteEvent")
stateEvent.Name = "TradeState"
stateEvent.Parent = remotes

type Offer = { { Slot: number, Entry: string } }

type Session = {
	A: Player,
	B: Player,
	Offers: { [Player]: Offer },
	Ready: { [Player]: boolean },
	CountdownEndsAt: number,
	-- Bumped on every change, so an old countdown knows it's stale.
	Version: number,
	Closed: boolean,
}

type Request = { From: Player, ExpiresAt: number }

local sessions: { [Player]: Session } = {}
-- requests[target][from]
local requests: { [Player]: { [Player]: Request } } = {}
local lastRequest: { [Player]: number } = {}
local lastAsk: { [Player]: number } = {}

local function notify(player: Player, message: string, kind: string, sound: string?)
	notifyEvent:FireClient(player, message, kind, sound)
end

local function partnerOf(session: Session, player: Player): Player
	return if session.A == player then session.B else session.A
end

local function pushSession(session: Session)
	for _, player in { session.A, session.B } do
		local partner = partnerOf(session, player)
		stateEvent:FireClient(player, {
			Kind = "Session",
			Partner = partner.UserId,
			PartnerName = partner.DisplayName,
			Mine = session.Offers[player],
			Theirs = session.Offers[partner],
			MyReady = session.Ready[player] == true,
			TheirReady = session.Ready[partner] == true,
			CountdownEndsAt = session.CountdownEndsAt,
		})
	end
end

local function closeSession(session: Session, message: string?)
	if session.Closed then
		return
	end
	session.Closed = true
	for _, player in { session.A, session.B } do
		if sessions[player] == session then
			sessions[player] = nil
		end
		if player.Parent == Players then
			stateEvent:FireClient(player, { Kind = "Closed", Message = message })
		end
	end
end

-- Any change: nobody is ready any more and a running countdown stops.
local function changed(session: Session)
	session.Version += 1
	session.Ready[session.A] = false
	session.Ready[session.B] = false
	session.CountdownEndsAt = 0
	pushSession(session)
end

local function slotsOf(offer: Offer): { number }
	local slots: { number } = {}
	for _, item in offer do
		table.insert(slots, item.Slot)
	end
	return slots
end

-- True if every offered pedestal still holds what was offered.
local function offerStillValid(player: Player, offer: Offer): boolean
	if #offer == 0 then
		return true
	end
	local entries = describeSlotsFunction:Invoke(player, slotsOf(offer))
	if typeof(entries) ~= "table" or #entries ~= #offer then
		return false
	end
	for index, item in offer do
		if entries[index] ~= item.Entry then
			return false
		end
	end
	return true
end

local function finish(session: Session, version: number)
	if session.Closed or session.Version ~= version then
		return
	end
	local a, b = session.A, session.B
	local ok = offerStillValid(a, session.Offers[a])
		and offerStillValid(b, session.Offers[b])
		and tradeBrainrotsFunction:Invoke(a, slotsOf(session.Offers[a]), b, slotsOf(session.Offers[b])) == true
	if not ok then
		notify(a, "The trade didn't go through: something changed or a base is full.", "Error")
		notify(b, "The trade didn't go through: something changed or a base is full.", "Error")
		-- Offers may point at pedestals that changed; start the table over.
		session.Offers[a] = {}
		session.Offers[b] = {}
		changed(session)
		return
	end
	activityEvent:Fire(a, "Trade", 1)
	activityEvent:Fire(b, "Trade", 1)
	notify(a, string.format("Trade with %s complete!", b.DisplayName), "Success", "StealSuccess")
	notify(b, string.format("Trade with %s complete!", a.DisplayName), "Success", "StealSuccess")
	closeSession(session, "Trade complete!")
end

type Handler = (player: Player, argument: any) -> (boolean, string?)
local HANDLERS: { [string]: Handler } = {}

HANDLERS.Request = function(player: Player, argument: any): (boolean, string?)
	local target = if typeof(argument) == "number" then Players:GetPlayerByUserId(argument) else nil
	if target == nil or target == player then
		return false, "That player isn't here."
	end
	if sessions[player] then
		return false, "You're already trading."
	end
	if sessions[target] then
		return false, target.DisplayName .. " is busy trading."
	end
	local now = os.clock()
	if now - (lastAsk[player] or 0) < ASK_COOLDOWN_SECONDS then
		return false, "Wait a moment before asking again."
	end
	lastAsk[player] = now
	-- They asked us too: just start.
	local mine = requests[player]
	local theirs = if mine then mine[target] else nil
	if theirs and theirs.ExpiresAt > now then
		return HANDLERS.Respond(player, { From = target.UserId, Accept = true })
	end
	requests[target] = requests[target] or {}
	requests[target][player] = { From = player, ExpiresAt = now + FeatureConfig.TradeRequestSeconds }
	stateEvent:FireClient(target, {
		Kind = "Request",
		From = player.UserId,
		Name = player.DisplayName,
		ExpiresIn = FeatureConfig.TradeRequestSeconds,
	})
	return true, string.format("Trade request sent to %s.", target.DisplayName)
end

HANDLERS.Respond = function(player: Player, argument: any): (boolean, string?)
	if typeof(argument) ~= "table" or typeof(argument.From) ~= "number" then
		return false, nil
	end
	local from = Players:GetPlayerByUserId(argument.From)
	local pending = requests[player]
	local request = if pending and from then pending[from] else nil
	if pending and from then
		pending[from] = nil
	end
	if from == nil or request == nil or request.ExpiresAt < os.clock() then
		return false, "That trade request ran out."
	end
	if argument.Accept ~= true then
		notify(from, player.DisplayName .. " said no to trading.", "Warning")
		return true, nil
	end
	if sessions[player] or sessions[from] then
		return false, "One of you is already trading."
	end
	local session: Session = {
		A = from,
		B = player,
		Offers = { [from] = {}, [player] = {} },
		Ready = { [from] = false, [player] = false },
		CountdownEndsAt = 0,
		Version = 0,
		Closed = false,
	}
	sessions[from] = session
	sessions[player] = session
	pushSession(session)
	return true, nil
end

HANDLERS.Offer = function(player: Player, argument: any): (boolean, string?)
	local session = sessions[player]
	if session == nil or typeof(argument) ~= "table" then
		return false, nil
	end
	local slots: { number } = {}
	for _, slot in argument do
		if typeof(slot) ~= "number" or slot ~= math.floor(slot) or table.find(slots, slot) then
			return false, nil
		end
		table.insert(slots, slot)
	end
	if #slots > FeatureConfig.MaxTradeItems then
		return false, string.format("You can offer up to %d brainrots.", FeatureConfig.MaxTradeItems)
	end
	local entries = if #slots > 0 then describeSlotsFunction:Invoke(player, slots) else {}
	if typeof(entries) ~= "table" or #entries ~= #slots then
		return false, "Only brainrots sitting in your base can be traded."
	end
	local offer: Offer = {}
	for index, slot in slots do
		table.insert(offer, { Slot = slot, Entry = entries[index] })
	end
	session.Offers[player] = offer
	changed(session)
	return true, nil
end

HANDLERS.Ready = function(player: Player, argument: any): (boolean, string?)
	local session = sessions[player]
	if session == nil then
		return false, nil
	end
	local partner = partnerOf(session, player)
	if #session.Offers[player] + #session.Offers[partner] == 0 then
		return false, "Put something on the table first."
	end
	session.Ready[player] = argument == true
	if session.Ready[session.A] and session.Ready[session.B] then
		session.Version += 1
		local version = session.Version
		session.CountdownEndsAt = Workspace:GetServerTimeNow() + FeatureConfig.TradeCountdownSeconds
		task.delay(FeatureConfig.TradeCountdownSeconds, finish, session, version)
	else
		session.Version += 1
		session.CountdownEndsAt = 0
	end
	pushSession(session)
	return true, nil
end

HANDLERS.Cancel = function(player: Player): (boolean, string?)
	local session = sessions[player]
	if session then
		closeSession(session, player.DisplayName .. " cancelled the trade.")
	end
	return true, nil
end

tradeFunction.OnServerInvoke = function(player: Player, action: any, argument: any): (boolean, string?)
	local handler = if typeof(action) == "string" then HANDLERS[action] else nil
	if handler == nil or player:GetAttribute("DataLoaded") ~= true then
		return false, nil
	end
	local now = os.clock()
	if now - (lastRequest[player] or 0) < REQUEST_COOLDOWN_SECONDS then
		return false, "Slow down!"
	end
	lastRequest[player] = now
	return handler(player, argument)
end

Players.PlayerRemoving:Connect(function(player: Player)
	local session = sessions[player]
	if session then
		closeSession(session, player.DisplayName .. " left the game.")
	end
	requests[player] = nil
	for _, pending in requests do
		pending[player] = nil
	end
	lastRequest[player] = nil
	lastAsk[player] = nil
end)

tradeFunction.Parent = remotes
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="293">
      <Properties>
        <string name="Name">WorldManager</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
	WorldManager
	Location: ServerScriptService (Script)

	Day, night and weather, the same for everyone on the server:
	  * Lighting.ClockTime runs through a whole day every
	    GameConfig.DayLengthSeconds (the day part is longer than the night);
	    the street lamps light up at night (lights inside the bases are always on)
	  * Blood Moon, Galaxy Night, Boss Raids and Bank Heists turn it to
	    midnight while they run
	  * every few minutes the weather changes (Clear, Rain, Snow, Thunderstorm
	    or Fog, weighted by GameConfig.Weather)
	The WorldEffects client script draws the weather and event skies.

	Client-facing state:
	  ReplicatedStorage attributes Weather (string), WeatherEndsAt (server time)
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))

local UPDATE_SECONDS = 0.5
-- Share of the cycle that is daytime (6:00 to 18:00).
local DAY_FRACTION = 0.7
-- Seconds for the sky to turn to midnight when a night event starts or ends.
local NIGHT_BLEND_SECONDS = 6
local NIGHT_SKIES: { [string]: boolean } = { Blood = true, Galaxy = true, Boss = true, Heist = true }

local rng = Random.new()

-- The server starts at 10:00.
local cycleStart = Workspace:GetServerTimeNow() - GameConfig.DayLengthSeconds * DAY_FRACTION * (4 / 12)
local nightBlend = 0

local function naturalClock(now: number): number
	local phase = ((now - cycleStart) % GameConfig.DayLengthSeconds) / GameConfig.DayLengthSeconds
	if phase < DAY_FRACTION then
		return 6 + 12 * phase / DAY_FRACTION
	end
	return (18 + 12 * (phase - DAY_FRACTION) / (1 - DAY_FRACTION)) % 24
end

local function isNight(clock: number): boolean
	return clock < 6.3 or clock > 17.7
end

-- Map lights that only shine at night. Lights marked AlwaysOn (inside the
-- bases, the Fuse Machine) stay on.
local lamps: { Light } = {}
do
	local map = Workspace:WaitForChild("Map")
	for _, descendant in map:GetDescendants() do
		if descendant:IsA("Light") and descendant:GetAttribute("AlwaysOn") ~= true then
			table.insert(lamps, descendant)
		end
	end
end

local lampsOn: boolean? = nil
local function setLamps(on: boolean)
	if lampsOn == on then
		return
	end
	lampsOn = on
	for _, lamp in lamps do
		lamp.Enabled = on
	end
end

local function updateClock(dt: number)
	local sky = ReplicatedStorage:GetAttribute("EventSky")
	local wantNight = typeof(sky) == "string" and NIGHT_SKIES[sky] == true
	local step = dt / NIGHT_BLEND_SECONDS
	nightBlend = math.clamp(nightBlend + (if wantNight then step else -step), 0, 1)

	local clock = naturalClock(Workspace:GetServerTimeNow())
	if nightBlend > 0 then
		-- The short way round the clock to midnight.
		local toMidnight = ((0 - clock + 12) % 24) - 12
		clock = (clock + toMidnight * nightBlend) % 24
	end
	Lighting.ClockTime = clock
	setLamps(isNight(clock))
end

local function pickWeather(previous: string?): string
	local total = 0
	for _, weather in GameConfig.Weather do
		if weather.Name ~= previous then
			total += weather.Weight
		end
	end
	local roll = rng:NextNumber(0, total)
	for _, weather in GameConfig.Weather do
		if weather.Name ~= previous then
			roll -= weather.Weight
			if roll <= 0 then
				return weather.Name
			end
		end
	end
	return "Clear"
end

ReplicatedStorage:SetAttribute("Weather", "Clear")
ReplicatedStorage:SetAttribute("WeatherEndsAt", Workspace:GetServerTimeNow() + GameConfig.WeatherMinSeconds)

task.spawn(function()
	while true do
		task.wait(UPDATE_SECONDS)
		xpcall(updateClock, function(err: any)
			warn("[WorldManager] Day cycle failed: " .. tostring(err))
		end, UPDATE_SECONDS)
	end
end)

task.spawn(function()
	local current: string = "Clear"
	task.wait(GameConfig.WeatherMinSeconds)
	while true do
		current = pickWeather(current)
		local seconds = rng:NextNumber(GameConfig.WeatherMinSeconds, GameConfig.WeatherMaxSeconds)
		ReplicatedStorage:SetAttribute("Weather", current)
		ReplicatedStorage:SetAttribute("WeatherEndsAt", Workspace:GetServerTimeNow() + seconds)
		task.wait(seconds)
	end
end)
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="294">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="295">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="296">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="297">
        <Properties>
          <string name="Name">BrainrotVisuals</string>
          <string name="Source"><![CDATA[--!strict
--[[
	BrainrotVisuals
	Location: StarterPlayer.StarterPlayerScripts (LocalScript)

	Brainrots with an imported model (see GameplayManager's
	prepareImportedModels) arrive with their real meshes, jointed by Welds;
	this script animates them. For the others it swaps the server's simple
	block figure for the blocky model rebuilt by AssetLoader (a body plus legs).
	Then for both:
	  * adds rarity effects: glow light, sparkles and a rising aura for the
	    rarest, a pulsing light for Mythic, a rainbow glow for Brainrot Gods and
	    a dark aura with white sparks for Secrets, and extra shine
	  * adds mutation effects: each mutation recolours the model and sparkles
	    in its colour (Rainbow cycles through every colour, Lava smokes and
	    throws embers, Bloodrot drips, Frozen and Galaxy shimmer)
	  * adds trait effects: Fire burns, Glitched flickers and jumps about,
	    Nyan leaves a rainbow trail (Tiny and Giant are just their size)
	  * animates it: anything with two legs really walks (legs stepping in
	    turn, a small bob and lean) matched to how fast it moves; block-built
	    brainrots also swing their arms, flap their wings, wag their tails,
	    nod and look around, and spin their propellers and wheels; brainrots
	    without legs waddle side to side with each step; Fly hovers and banks
	    and Drive rolls along with little bumps. Idle brainrots bob and sway
	    (Spin ones twirl, Hop ones bounce a little), and carried ones wriggle.
	    Lucky blocks float and turn, hop home, and shake before they pop.
	  * a sparkle burst when a brainrot arrives out of nowhere (a gift, a
	    trade, a fuse or an opened lucky block)
	  * hats (the Hat attribute) on top of the head, and glowing blocks that
	    orbit every mutated brainrot
	  * guards, pets and bosses (State Guard, Pet, Boss) walk like any other;
	    a beaten boss (State Defeated) topples over

	Every model is built once in the background (a few milliseconds a frame)
	and each brainrot gets a copy, so they appear straight away. If a model
	can't be built, the block figure simply stays visible. When a brainrot
	streams out and back in, its model is attached again. Nothing here affects
	gameplay; it is all local to this client.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AssetLoader = require(Shared:WaitForChild("AssetLoader"))
local BrainrotConfig = require(Shared:WaitForChild("BrainrotConfig"))
local HatModels = require(Shared:WaitForChild("HatModels"))
local HatAnchors = require(Shared:WaitForChild("HatAnchors"))

local PIECE_ATTRIBUTE = "HiggsfieldPiece"
local ANIMATION_DISTANCE = 220
local RAINBOW_INTERVAL = 1 / 15
-- Walk cycle
local LEG_SWING = math.rad(30)
local WALK_LEAN = math.rad(4)
local WALK_ROLL = math.rad(3)
-- Up-and-down per step, as a fraction of the brainrot's height (kept small
-- so they don't bounce like balls).
local WALK_BOB = 0.022
-- Brainrots without legs waddle: a side-to-side rock with each step.
local WADDLE_ROLL = math.rad(9)
local WADDLE_TURN = math.rad(6)
local MIN_WALK_SPEED = 0.4
-- Arms swing a little less than legs; propellers turn this fast (radians a second).
local ARM_SWING = math.rad(26)
local PROP_SPIN = 16
-- Skaters pop a trick this often (seconds; slower when parked), in the air
-- this long and this high (share of their height).
local SKATE_TRICK_EVERY = 3.4
local SKATE_AIR_TIME = 0.8
local SKATE_POP = 0.28

type RarityEffect = {
	Light: number,
	Range: number,
	Sparkles: number,
	Aura: boolean,
	Pulse: boolean,
	Reflectance: number,
	-- Brainrot God: the glow cycles through the rainbow.
	RainbowLight: boolean?,
	-- Secret: dark smoke and white sparks.
	Dark: boolean?,
}

type PieceVisual = {
	Part: BasePart,
	Weld: Weld,
	-- "Body", "Leg", "Arm", "Wing", "Tail", "Head", "Prop", "Ear" or "Board".
	Kind: string,
	-- Rest pose relative to the Root (the brainrot's feet).
	Base: CFrame,
	-- What it moves about (a leg's hip, an arm's shoulder, ...), relative to the Root.
	Hip: Vector3,
	-- +1 or -1: which way it swings on the first step (wings: which side).
	Direction: number,
	-- A Prop spins about this axis.
	Axis: Vector3,
}

type Visual = {
	Model: Model,
	Root: BasePart,
	Body: BasePart,
	-- Imported models belong to the server; blocky ones were made here.
	Imported: boolean,
	-- Tints an imported model in its mutation's colour.
	Highlight: Highlight?,
	Pieces: { PieceVisual },
	HasLegs: boolean,
	Height: number,
	Phase: number,
	Light: PointLight?,
	BaseBrightness: number,
	Pulse: boolean,
	Rainbow: boolean,
	RainbowLight: boolean,
	Motion: string,
	LastPosition: Vector3,
	Speed: number,
	Stride: number,
	-- How far wheels and propellers have turned.
	Spin: number,
	-- A lucky block (floats and turns, shakes while opening).
	Block: boolean,
	-- The Glitched trait: flickers and jumps about.
	Glitch: boolean,
	-- Its hat, if it wears one.
	Hat: Model?,
	-- Glowing blocks circling a mutated brainrot.
	Orbiters: { BasePart },
	OrbitRadius: number,
	-- When the current State began (for the boss falling over).
	StateSince: number,
	LastState: any,
}

local RARITY_EFFECTS: { [string]: RarityEffect } = {
	Common = { Light = 0, Range = 0, Sparkles = 0, Aura = false, Pulse = false, Reflectance = 0 },
	Rare = { Light = 0.4, Range = 6, Sparkles = 2, Aura = false, Pulse = false, Reflectance = 0.02 },
	Epic = { Light = 0.6, Range = 7, Sparkles = 4, Aura = false, Pulse = false, Reflectance = 0.05 },
	Legendary = { Light = 0.9, Range = 8, Sparkles = 7, Aura = true, Pulse = false, Reflectance = 0.1 },
	Mythic = { Light = 1.2, Range = 9, Sparkles = 11, Aura = true, Pulse = true, Reflectance = 0.14 },
	["Brainrot God"] = {
		Light = 1.4,
		Range = 10,
		Sparkles = 14,
		Aura = true,
		Pulse = true,
		Reflectance = 0.16,
		RainbowLight = true,
	},
	Secret = { Light = 1.3, Range = 10, Sparkles = 16, Aura = true, Pulse = true, Reflectance = 0.2, Dark = true },
	OG = { Light = 1.7, Range = 12, Sparkles = 20, Aura = true, Pulse = true, Reflectance = 0.25 },
}

local MUTATION_REFLECTANCE: { [string]: number } = {
	Gold = 0.22,
	Diamond = 0.3,
	Rainbow = 0.15,
	Bloodrot = 0.1,
	Galaxy = 0.2,
	Lava = 0.12,
	Frozen = 0.35,
	Taco = 0.1,
	Lucky = 0.18,
	Cash = 0.2,
	Storm = 0.25,
	Heist = 0.3,
	Boss = 0.12,
	Admin = 0.2,
}

-- How many glowing blocks circle a brainrot with each mutation.
local ORBITERS: { [string]: number } = {
	Gold = 3,
	Diamond = 4,
	Rainbow = 6,
	Bloodrot = 4,
	Galaxy = 6,
	Lava = 4,
	Frozen = 4,
	Taco = 5,
	Lucky = 5,
	Cash = 5,
	Storm = 6,
	Heist = 5,
	Boss = 6,
	Admin = 8,
}

local MUTATION_COLOURS: { [string]: ColorSequence } = {
	Galaxy = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(120, 60, 255)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 120, 230)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(90, 200, 255)),
	}),
	Lava = ColorSequence.new(Color3.fromRGB(255, 220, 80), Color3.fromRGB(255, 60, 10)),
	Frozen = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(140, 220, 255)),
	Bloodrot = ColorSequence.new(Color3.fromRGB(255, 60, 70), Color3.fromRGB(120, 0, 10)),
	Taco = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 210, 80)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 90, 40)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(110, 210, 60)),
	}),
	Lucky = ColorSequence.new(Color3.fromRGB(120, 255, 150), Color3.fromRGB(20, 170, 70)),
	Cash = ColorSequence.new(Color3.fromRGB(190, 255, 110), Color3.fromRGB(255, 220, 70)),
	Storm = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(80, 150, 255)),
	Heist = ColorSequence.new(Color3.fromRGB(255, 225, 90), Color3.fromRGB(60, 50, 20)),
	Boss = ColorSequence.new(Color3.fromRGB(255, 200, 60), Color3.fromRGB(255, 50, 20)),
	Admin = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 40, 70)),
		ColorSequenceKeypoint.new(0.5, Color3.new(1, 1, 1)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 40, 70)),
	}),
}

local RAINBOW_SEQUENCE = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 70, 70)),
	ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 60)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(80, 255, 120)),
	ColorSequenceKeypoint.new(0.75, Color3.fromRGB(60, 170, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(230, 90, 255)),
})

local map = Workspace:WaitForChild("Map")
local brainrotsFolder = map:WaitForChild("Brainrots")

local visuals: { [Model]: Visual } = {}
local MOTIONS: { [string]: boolean } = { Walk = true, Fly = true, Drive = true, Spin = true, Hop = true, Skate = true }
local attaching: { [Model]: boolean } = {}
local rainbowAssets: { [AssetLoader.BrainrotAsset]: boolean } = {}

--------------------------------------------------------------------------------
-- Effects
--------------------------------------------------------------------------------

local localPlayer = Players.LocalPlayer

-- Settings > Low graphics: no sparkles or auras.
local function lowGraphics(): boolean
	return localPlayer ~= nil and localPlayer:GetAttribute("LowGraphics") == true
end

local function sparkles(part: BasePart, name: string, rate: number, colour: ColorSequence, size: number, rising: boolean)
	if lowGraphics() then
		return
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = name
	-- Default texture: Roblox's built-in sparkle, no upload needed.
	emitter.Rate = rate
	emitter.Color = colour
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	emitter.Lifetime = NumberRange.new(0.8, 1.6)
	emitter.Speed = if rising then NumberRange.new(1.5, 3) else NumberRange.new(0.3, 1.2)
	emitter.SpreadAngle = if rising then Vector2.new(25, 25) else Vector2.new(180, 180)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Acceleration = if rising then Vector3.new(0, 1.5, 0) else Vector3.zero
	emitter.RotSpeed = NumberRange.new(-90, 90)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.3, size),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 0.8),
	})
	emitter.Parent = part
end

local TRAIL_RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 160, 40)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 240, 60)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(70, 230, 90)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(60, 150, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(170, 80, 255)),
})

local function addTraitEffects(visual: Visual, traitName: string?)
	local part = visual.Body
	local scale = visual.Height / 5
	if traitName == "Fire" then
		local fire = Instance.new("Fire")
		fire.Name = "TraitFire"
		fire.Color = Color3.fromRGB(255, 110, 20)
		fire.SecondaryColor = Color3.fromRGB(255, 230, 80)
		fire.Heat = 7
		fire.Size = 3 * scale
		fire.Parent = part
		local glow = Instance.new("PointLight")
		glow.Name = "FireGlow"
		glow.Color = Color3.fromRGB(255, 140, 40)
		glow.Brightness = 0.9
		glow.Range = 8 * math.clamp(scale, 1, 1.5)
		glow.Parent = part
	elseif traitName == "Glitched" then
		visual.Glitch = true
		sparkles(part, "GlitchBits", 8, ColorSequence.new(Color3.fromRGB(60, 255, 240), Color3.fromRGB(255, 60, 220)), 0.35 * scale, false)
	elseif traitName == "Nyan" then
		local top = Instance.new("Attachment")
		top.Name = "TrailTop"
		top.Position = Vector3.new(0, 0.35 * visual.Height, 0)
		top.Parent = part
		local bottom = Instance.new("Attachment")
		bottom.Name = "TrailBottom"
		bottom.Position = Vector3.new(0, -0.1 * visual.Height, 0)
		bottom.Parent = part
		local trail = Instance.new("Trail")
		trail.Name = "NyanTrail"
		trail.Attachment0 = top
		trail.Attachment1 = bottom
		trail.Color = TRAIL_RAINBOW
		trail.LightEmission = 0.8
		trail.Lifetime = 0.7
		trail.MinLength = 0.05
		trail.FaceCamera = true
		trail.Transparency = NumberSequence.new(0.1, 1)
		trail.Parent = part
		sparkles(part, "NyanStars", 6, ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(255, 240, 120)), 0.4 * scale, false)
	end
end

-- A burst of sparkles when a brainrot pops into a base.
local function arrivalBurst(visual: Visual)
	local arrived = visual.Model:GetAttribute("Arrived")
	if typeof(arrived) ~= "number" or Workspace:GetServerTimeNow() - arrived > 4 then
		return
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Arrival"
	emitter.Rate = 0
	emitter.Speed = NumberRange.new(6, 14)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Lifetime = NumberRange.new(0.6, 1.2)
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new(0.5, 0)
	emitter.Color = RAINBOW_SEQUENCE
	emitter.Parent = visual.Body
	emitter:Emit(50)
	task.delay(2, function()
		emitter:Destroy()
	end)
end

-- Glowing blocks circling a mutated brainrot (moved every frame in animate).
local function addOrbiters(visual: Visual, mutation: BrainrotConfig.Mutation)
	if lowGraphics() then
		return
	end
	local count = ORBITERS[mutation.Name] or 3
	local size = math.clamp(visual.Height * 0.07, 0.2, 1.2)
	local width = visual.Body.Size.X
	visual.OrbitRadius = math.max(width * 0.55, visual.Height * 0.35) + size
	for index = 1, count do
		local cube = Instance.new("Part")
		cube.Name = "Orbiter"
		cube.Size = Vector3.one * size * (if index % 2 == 0 then 0.7 else 1)
		cube.Material = Enum.Material.Neon
		cube.Color = if mutation.Name == "Rainbow" then Color3.fromHSV(index / count, 0.8, 1) else mutation.Color
		cube.Anchored = true
		cube.CanCollide = false
		cube.CanQuery = false
		cube.CanTouch = false
		cube.CastShadow = false
		cube.Transparency = 0.1
		cube:SetAttribute(PIECE_ATTRIBUTE, true)
		cube.Parent = visual.Root
		table.insert(visual.Orbiters, cube)
	end
end

-- The hat goes on top of the head (HatAnchors, worked out from each
-- brainrot's shape by tools/build_hat_anchors.py) and moves with it.
local function attachHat(visual: Visual)
	local old = visual.Hat
	if old then
		old:Destroy()
		visual.Hat = nil
	end
	local hatName = visual.Model:GetAttribute("Hat")
	if typeof(hatName) ~= "string" then
		return
	end
	local brainrotId = visual.Model:GetAttribute("BrainrotId")
	local anchor = if typeof(brainrotId) == "string" then HatAnchors[brainrotId] else nil
	local target: BasePart = visual.Body
	for _, piece in visual.Pieces do
		if piece.Kind == (if anchor then anchor.Piece else "Head") and piece.Kind ~= "Body" then
			target = piece.Part
		end
	end
	-- (Without an anchor: the middle of the top of the head or body.)
	local width = if anchor
		then anchor.Width * visual.Height
		else math.clamp(math.min(target.Size.X, target.Size.Z) * 0.75, 0.6, visual.Height * 0.55)
	local hat = HatModels.build(hatName, width)
	if hat == nil then
		return
	end
	local size = target.Size
	local top = if anchor
		then CFrame.new(anchor.X * size.X, anchor.Y * size.Y - width * 0.06, anchor.Z * size.Z)
		else CFrame.new(0, size.Y / 2 - width * 0.06, 0)
	for _, part in hat:GetDescendants() do
		if part:IsA("BasePart") then
			local offset = part.CFrame
			part.Anchored = false
			part.Massless = true
			part:SetAttribute(PIECE_ATTRIBUTE, true)
			part.CFrame = target.CFrame * top * offset
			local weld = Instance.new("Weld")
			weld.Part0 = target
			weld.Part1 = part
			weld.C0 = top * offset
			weld.Parent = part
		end
	end
	hat.Parent = target
	visual.Hat = hat
end

local function addEffects(visual: Visual, rarityName: string?, mutationName: string?)
	local part = visual.Body
	local effect = if rarityName then RARITY_EFFECTS[rarityName] else nil
	local rarity = if rarityName then BrainrotConfig.RarityByName[rarityName] else nil
	local mutation = if mutationName then BrainrotConfig.MutationByName[mutationName] else nil
	local scale = visual.Height / 5

	local glowColour = if mutation then mutation.Color elseif rarity then rarity.Color else Color3.new(1, 1, 1)
	local brightness = if effect then effect.Light else 0
	local range = if effect then effect.Range else 0
	if mutation then
		brightness = math.max(brightness, 0.8)
		range = math.max(range, 8)
	end

	local reflectance = math.max(
		if effect then effect.Reflectance else 0,
		if mutationName then MUTATION_REFLECTANCE[mutationName] or 0 else 0
	)
	for _, piece in visual.Pieces do
		piece.Part.Reflectance = reflectance
	end

	if brightness > 0 then
		local light = Instance.new("PointLight")
		light.Name = "Glow"
		light.Color = glowColour
		light.Brightness = brightness
		light.Range = range * math.clamp(scale, 1, 1.5)
		light.Shadows = false
		light.Parent = part
		visual.Light = light
		visual.BaseBrightness = brightness
	end

	local rainbowRarity = effect ~= nil and effect.RainbowLight == true
	local darkRarity = effect ~= nil and effect.Dark == true
	if effect and effect.Sparkles > 0 and rarity then
		local colours = if rainbowRarity
			then RAINBOW_SEQUENCE
			elseif darkRarity then ColorSequence.new(Color3.new(1, 1, 1))
			else ColorSequence.new(rarity.Color)
		sparkles(part, "RaritySparkles", effect.Sparkles, colours, 0.45 * scale, false)
	end
	if effect and effect.Aura and rarity then
		local colours = if rainbowRarity
			then RAINBOW_SEQUENCE
			elseif darkRarity then ColorSequence.new(Color3.fromRGB(40, 40, 50), Color3.new(1, 1, 1))
			else ColorSequence.new(Color3.new(1, 1, 1), rarity.Color)
		sparkles(part, "Aura", if darkRarity then 10 else 6, colours, 0.6 * scale, true)
	end
	if darkRarity then
		local smoke = Instance.new("Smoke")
		smoke.Name = "SecretSmoke"
		smoke.Color = Color3.fromRGB(25, 25, 35)
		smoke.Opacity = 0.12
		smoke.RiseVelocity = 1.5
		smoke.Size = 1.5 * scale
		smoke.Parent = part
		if visual.Light then
			(visual.Light :: PointLight).Color = Color3.fromRGB(230, 230, 255)
		end
	end
	visual.Pulse = effect ~= nil and effect.Pulse
	visual.RainbowLight = rainbowRarity and mutation == nil

	if mutation then
		local colours = if mutation.Name == "Rainbow"
			then RAINBOW_SEQUENCE
			else MUTATION_COLOURS[mutation.Name] or ColorSequence.new(mutation.Color, Color3.new(1, 1, 1))
		sparkles(part, "MutationSparkles", 10, colours, 0.55 * scale, false)
		sparkles(part, "MutationAura", 5, colours, 0.7 * scale, true)
		addOrbiters(visual, mutation)
		if mutation.Name == "Admin" then
			visual.Glitch = true
		end
		if mutation.Name == "Lava" or mutation.Name == "Boss" then
			local fire = Instance.new("Fire")
			fire.Name = "LavaFire"
			fire.Color = Color3.fromRGB(255, 120, 20)
			fire.SecondaryColor = Color3.fromRGB(255, 220, 60)
			fire.Heat = 4
			fire.Size = 2.5 * scale
			fire.Parent = part
		elseif mutation.Name == "Bloodrot" then
			-- Dripping red.
			local drips = Instance.new("ParticleEmitter")
			drips.Name = "BloodDrips"
			drips.Rate = 6
			drips.Color = colours
			drips.LightInfluence = 0.5
			drips.Lifetime = NumberRange.new(0.6, 1)
			drips.Speed = NumberRange.new(0, 0.5)
			drips.Acceleration = Vector3.new(0, -20, 0)
			drips.Size = NumberSequence.new(0.18 * scale)
			drips.Parent = part
		end
	end
end

--------------------------------------------------------------------------------
-- Attaching models
--------------------------------------------------------------------------------

local function isOwnPiece(instance: Instance): boolean
	return instance:GetAttribute(PIECE_ATTRIBUTE) == true
end

-- Hides a part of the server's block figure on this client only.
local function hideFallback(visual: Visual, instance: Instance)
	if not visual.Imported and instance:IsA("BasePart") and instance ~= visual.Root and not isOwnPiece(instance) then
		instance.LocalTransparencyModifier = 1
	end
end

local function detach(instance: Model)
	local visual = visuals[instance]
	if visual == nil then
		return
	end
	visuals[instance] = nil
	for _, orbiter in visual.Orbiters do
		orbiter:Destroy()
	end
	local hat = visual.Hat
	if hat then
		hat:Destroy()
	end
	if visual.Imported then
		local highlight = visual.Highlight
		if highlight then
			highlight:Destroy()
		end
		return
	end
	for _, piece in visual.Pieces do
		piece.Part:Destroy()
	end
end

-- An imported model: animate the Welds the server made.
local function attachImported(instance: Model)
	local root = instance:FindFirstChild("Root")
	local height = instance:GetAttribute("FigureHeight")
	if root == nil or not root:IsA("BasePart") or typeof(height) ~= "number" then
		return
	end
	local existing = visuals[instance]
	if existing and existing.Root == root then
		return
	end
	detach(instance)

	local pieces: { PieceVisual } = {}
	local body: BasePart? = nil
	local legs = 0
	for _, descendant in instance:GetDescendants() do
		if descendant:IsA("Weld") and descendant.Name == "Pose" and descendant.Part0 == root then
			local part = descendant.Part1
			if part == nil then
				continue
			end
			-- Moving pieces carry their joint (Hip) and phase; block-built ones
			-- also their kind (arm, wing, ...) and a prop's spin axis.
			local hip = part:GetAttribute("Hip")
			local phase = part:GetAttribute("LegPhase")
			local kindAttribute = part:GetAttribute("PieceKind")
			local axisAttribute = part:GetAttribute("PieceAxis")
			local moving = typeof(hip) == "Vector3" and typeof(phase) == "number"
			local kind = if not moving then "Body" elseif typeof(kindAttribute) == "string" then kindAttribute else "Leg"
			if kind == "Leg" then
				legs += 1
			end
			table.insert(pieces, {
				Part = part,
				Weld = descendant,
				Kind = kind,
				Base = descendant.C0,
				Hip = if typeof(hip) == "Vector3" then hip else Vector3.zero,
				Direction = if phase == 1 then -1 else 1,
				Axis = if axisAttribute == "X" then Vector3.xAxis elseif axisAttribute == "Z" then Vector3.zAxis else Vector3.yAxis,
			})
			if part.Name == "Body" or (body == nil and kind == "Body") then
				body = part
			end
		end
	end
	if body == nil or #pieces == 0 then
		return
	end

	local mutationAttribute = instance:GetAttribute("Mutation")
	local rarityAttribute = instance:GetAttribute("Rarity")
	local motionAttribute = instance:GetAttribute("Motion")
	local mutation = if typeof(mutationAttribute) == "string" then mutationAttribute else nil
	local visual: Visual = {
		Model = instance,
		Root = root,
		Body = body :: BasePart,
		Imported = true,
		Highlight = nil,
		Pieces = pieces,
		HasLegs = legs >= 2,
		Height = height,
		Phase = math.random() * math.pi * 2,
		Light = nil,
		BaseBrightness = 0,
		Pulse = false,
		Rainbow = mutation == "Rainbow",
		RainbowLight = false,
		Motion = if typeof(motionAttribute) == "string" and MOTIONS[motionAttribute] then motionAttribute else "Walk",
		LastPosition = root.Position,
		Speed = 0,
		Stride = math.random() * math.pi * 2,
		Spin = 0,
		Block = instance:GetAttribute("LuckyBlock") == true,
		Glitch = false,
		Hat = nil,
		Orbiters = {},
		OrbitRadius = 0,
		StateSince = os.clock(),
		LastState = nil,
	}
	addEffects(visual, if typeof(rarityAttribute) == "string" then rarityAttribute else nil, mutation)
	local traitAttribute = instance:GetAttribute("Trait")
	addTraitEffects(visual, if typeof(traitAttribute) == "string" then traitAttribute else nil)
	pcall(arrivalBurst, visual)
	pcall(attachHat, visual)
	local mutationInfo = if mutation then BrainrotConfig.MutationByName[mutation] else nil
	if mutationInfo then
		-- Textured meshes can't be recoloured, so the mutation glows over them.
		local highlight = Instance.new("Highlight")
		highlight.Name = "MutationGlow"
		highlight.FillColor = mutationInfo.Color
		highlight.FillTransparency = 0.78
		highlight.OutlineColor = mutationInfo.Color
		highlight.OutlineTransparency = 0.35
		highlight.DepthMode = Enum.HighlightDepthMode.Occluded
		highlight.Adornee = instance
		highlight.Parent = instance
		visual.Highlight = highlight
	end
	visuals[instance] = visual
end

local function attachModel(instance: Instance)
	if not instance:IsA("Model") or attaching[instance] then
		return
	end
	if instance:GetAttribute("CustomModel") == true then
		attachImported(instance)
		return
	end
	local brainrotId = instance:GetAttribute("BrainrotId")
	local height = instance:GetAttribute("FigureHeight")
	local mutationAttribute = instance:GetAttribute("Mutation")
	local rarityAttribute = instance:GetAttribute("Rarity")
	local motionAttribute = instance:GetAttribute("Motion")
	if typeof(brainrotId) ~= "string" or typeof(height) ~= "number" then
		return
	end
	local root = instance:FindFirstChild("Root")
	local existing = visuals[instance]
	if existing and existing.Root == root and existing.Body.Parent ~= nil then
		return
	end
	detach(instance)

	attaching[instance] = true
	xpcall(function()
		local rootInstance = root or instance:WaitForChild("Root", 30)
		if rootInstance == nil or not rootInstance:IsA("BasePart") then
			return
		end
		local mutation = if typeof(mutationAttribute) == "string" then mutationAttribute else nil
		local rarity = if typeof(rarityAttribute) == "string" then rarityAttribute else nil

		-- The blocky meshes, or where this device can't build meshes, the same
		-- brainrot from plain boxes.
		local built, asset = AssetLoader.createBrainrotParts(brainrotId, mutation, height)
		local placed: { AssetLoader.BoxPiece } = {}
		if built and asset then
			for _, entry in built do
				table.insert(placed, {
					Part = entry.Part :: BasePart,
					Kind = entry.Piece.Kind,
					Offset = entry.Offset,
					Pivot = entry.Pivot,
					Phase = entry.Piece.Phase,
					Axis = entry.Piece.Axis,
				})
			end
		else
			local boxes = AssetLoader.createBrainrotBoxes(brainrotId, mutation, height)
			if boxes == nil then
				return
			end
			placed = boxes
		end
		if instance.Parent == nil or rootInstance.Parent ~= instance then
			for _, entry in placed do
				entry.Part:Destroy()
			end
			return
		end

		local pieces: { PieceVisual } = {}
		local body: BasePart? = nil
		local hasLegs = false
		local centre = CFrame.new(0, height / 2, 0)
		for _, entry in placed do
			local part = entry.Part
			part:SetAttribute(PIECE_ATTRIBUTE, true)
			-- (A box piece's boxes are ours too.)
			for _, box in part:GetChildren() do
				if box:IsA("BasePart") then
					box:SetAttribute(PIECE_ATTRIBUTE, true)
				end
			end
			part.Anchored = false
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.Massless = true

			-- A Weld (not WeldConstraint) so the animation can move it via C0.
			local weld = Instance.new("Weld")
			weld.Part0 = rootInstance
			weld.Part1 = part
			weld.C0 = centre * CFrame.new(entry.Offset)
			weld.Parent = part

			local kind = entry.Kind
			hasLegs = hasLegs or kind == "Leg"
			table.insert(pieces, {
				Part = part,
				Weld = weld,
				Kind = kind,
				Base = centre * CFrame.new(entry.Offset),
				Hip = centre.Position + entry.Pivot,
				Direction = if entry.Phase == 1 then -1 else 1,
				Axis = if entry.Axis == "X" then Vector3.xAxis elseif entry.Axis == "Z" then Vector3.zAxis else Vector3.yAxis,
			})
			if kind == "Body" then
				body = part
			end
		end
		if body == nil then
			for _, entry in placed do
				entry.Part:Destroy()
			end
			return
		end

		local visual: Visual = {
			Model = instance,
			Root = rootInstance,
			Body = body :: BasePart,
			Imported = false,
			Highlight = nil,
			Pieces = pieces,
			HasLegs = hasLegs,
			Height = height,
			Phase = math.random() * math.pi * 2,
			Light = nil,
			BaseBrightness = 0,
			Pulse = false,
			Rainbow = mutation == "Rainbow",
			RainbowLight = false,
			Motion = if typeof(motionAttribute) == "string" and MOTIONS[motionAttribute] then motionAttribute else "Walk",
			LastPosition = rootInstance.Position,
			Speed = 0,
			Stride = math.random() * math.pi * 2,
			Spin = 0,
			Block = false,
			Glitch = false,
			Hat = nil,
			Orbiters = {},
			OrbitRadius = 0,
			StateSince = os.clock(),
			LastState = nil,
		}
		addEffects(visual, rarity, mutation)
		local traitAttribute = instance:GetAttribute("Trait")
		addTraitEffects(visual, if typeof(traitAttribute) == "string" then traitAttribute else nil)
		pcall(arrivalBurst, visual)
		-- Parented under the Root, so they leave with it if it streams out.
		for _, piece in pieces do
			piece.Part.Parent = rootInstance
		end
		for _, descendant in instance:GetDescendants() do
			hideFallback(visual, descendant)
		end

		visuals[instance] = visual
		pcall(attachHat, visual)
		if visual.Rainbow and asset then
			rainbowAssets[asset] = true
		end
	end, function(err: any)
		warn("[BrainrotVisuals] Could not attach a model: " .. tostring(err))
	end)
	attaching[instance] = nil
end

local function track(instance: Instance)
	if not instance:IsA("Model") then
		return
	end
	task.spawn(attachModel, instance)
	instance.ChildAdded:Connect(function(child: Instance)
		if child.Name == "Root" then
			-- The Root streamed back in: build the model again.
			task.spawn(attachModel, instance)
		end
	end)
	instance.DescendantAdded:Connect(function(descendant: Instance)
		local visual = visuals[instance]
		if visual then
			hideFallback(visual, descendant)
		end
	end)
	instance:GetAttributeChangedSignal("Hat"):Connect(function()
		local visual = visuals[instance]
		if visual then
			pcall(attachHat, visual)
		end
	end)
	instance.ChildRemoved:Connect(function(child: Instance)
		local visual = visuals[instance]
		if visual and child == visual.Root then
			detach(instance)
		end
	end)
end

brainrotsFolder.ChildAdded:Connect(track)
brainrotsFolder.ChildRemoved:Connect(function(child: Instance)
	if child:IsA("Model") then
		detach(child)
	end
end)
for _, child in brainrotsFolder:GetChildren() do
	track(child)
end

-- A brainrot still showing its block figure (its model couldn't be built,
-- say the device was busy) gets another try every few seconds.
task.spawn(function()
	while true do
		task.wait(5)
		for _, child in brainrotsFolder:GetChildren() do
			if child:IsA("Model") and visuals[child] == nil and not attaching[child] then
				task.spawn(attachModel, child)
			end
		end
	end
end)


--------------------------------------------------------------------------------
-- Animation
--------------------------------------------------------------------------------

-- How far each leg swings, and the whole model's offset from its Root (the
-- brainrot's feet), for the current state.
local function animate(visual: Visual, state: any, t: number, dt: number)
	local height = visual.Height
	local phase = t + visual.Phase
	local centre = CFrame.new(0, height / 2, 0)

	-- Walking speed from how far the Root moved, so the steps match the
	-- conveyor, the walk home and anything else that moves it.
	local position = visual.Root.Position
	local moved = position - visual.LastPosition
	visual.LastPosition = position
	local speed = if dt > 0 then Vector3.new(moved.X, 0, moved.Z).Magnitude / dt else 0
	if speed > 60 then
		speed = 0 -- teleported
	end
	visual.Speed += (speed - visual.Speed) * math.min(1, dt * 8)

	local swing = 0
	local modelOffset: CFrame
	local motion = visual.Motion
	local moving = visual.Speed > MIN_WALK_SPEED
	local blend = math.clamp(visual.Speed / 3, 0, 1)
	if moving then
		local stepsPerSecond = math.clamp(visual.Speed / (height * 1.1), 0.8, 2.4)
		visual.Stride += dt * stepsPerSecond * math.pi * 2
	end
	local stride = visual.Stride

	if state ~= visual.LastState then
		visual.LastState = state
		visual.StateSince = t
	end
	-- Skating: how far through a trick (0 to 1), the height of the jump
	-- (0 on the ground, 1 at the top), which trick, and the pushing foot.
	local skateAlpha, skateAir, skateTrick, skatePush = 0, 0, 0, 0
	if state == "Defeated" then
		local fall = math.clamp((t - visual.StateSince) / 0.8, 0, 1)
		local eased = fall * fall
		modelOffset = CFrame.new(0, -height * 0.2 * eased, 0) * centre * CFrame.Angles(0, 0, math.rad(85) * eased)
	elseif state == "Carried" then
		local wiggle = phase * 12
		swing = math.sin(phase * 16) * math.rad(35)
		modelOffset = centre * CFrame.Angles(math.sin(wiggle) * math.rad(10), 0, math.cos(wiggle * 0.7) * math.rad(14))
	elseif state == "Opening" then
		-- A lucky block about to pop: shakes harder and harder.
		local shake = math.rad(6 + 10 * math.abs(math.sin(t * 3)))
		modelOffset = CFrame.new(0, 0.3 * height, 0)
			* centre
			* CFrame.Angles(math.sin(t * 47) * shake, t * 6, math.cos(t * 53) * shake)
	elseif visual.Block then
		if moving then
			-- Little hops all the way home.
			local air = math.abs(math.sin(stride * 0.6))
			modelOffset = CFrame.new(0, air * 0.18 * height, 0) * centre * CFrame.Angles(-math.rad(6) * air, 0, 0)
		else
			-- Floats and slowly turns on its pedestal.
			local float = (0.18 + 0.06 * math.sin(phase * 2)) * height
			modelOffset = CFrame.new(0, float, 0) * centre * CFrame.Angles(0, phase * 0.9, math.sin(phase * 1.3) * math.rad(4))
		end
	elseif motion == "Fly" then
		-- Hovers above the ground, banking and dipping as it flies.
		local lift = (0.35 + 0.05 * math.sin(phase * 2.2)) * height
		local bank = math.sin(phase * 0.9) * math.rad(if moving then 12 else 6)
		local pitch = if moving then -math.rad(10) * blend else math.sin(phase * 1.3) * math.rad(4)
		modelOffset = CFrame.new(0, lift, 0) * centre * CFrame.Angles(pitch, 0, bank)
	elseif motion == "Skate" and state ~= "Carried" then
		-- Rides a skateboard: carves from side to side, kicks to push after
		-- landing, and pops a trick every few seconds (an ollie, a kickflip
		-- or a shove-it), even parked on a pedestal.
		local period = if moving then SKATE_TRICK_EVERY else SKATE_TRICK_EVERY * 1.6
		local cycle = phase % period
		if cycle < SKATE_AIR_TIME then
			skateAlpha = cycle / SKATE_AIR_TIME
			skateAir = math.sin(skateAlpha * math.pi)
			skateTrick = math.floor(phase / period) % 3
		elseif moving then
			local since = cycle - SKATE_AIR_TIME - 0.3
			if since > 0 and since < 1.4 then
				skatePush = math.max(0, math.sin(since / 1.4 * math.pi * 2)) * blend
			end
		end
		local ground = 1 - skateAir
		local carve = math.sin(phase * 1.6) * math.rad(if moving then 9 else 3) * ground
		local weave = if moving then math.sin(phase * 1.6 - 0.8) * math.rad(8) * blend else math.sin(phase * 0.7) * math.rad(6)
		-- Nose up on the way up, down on the way down.
		local pitch = math.sin(skateAlpha * math.pi * 2) * math.rad(12)
		modelOffset = CFrame.new(0, skateAir * SKATE_POP * height, 0) * centre * CFrame.Angles(pitch, weave, carve)
	elseif motion == "Drive" then
		-- Rolls along with little bumps; rumbles in place when parked.
		local bump = if moving then math.abs(math.sin(stride * 2)) * 0.02 * height else math.abs(math.sin(phase * 14)) * 0.005 * height
		local rock = if moving then math.sin(stride * 2) * math.rad(2) else 0
		modelOffset = CFrame.new(0, bump, 0) * centre * CFrame.Angles(rock - math.rad(3) * blend, 0, 0)
	elseif moving then
		if visual.HasLegs then
			-- A real walk: legs step in turn, a small bob as they pass each
			-- other, leaning into the walk.
			swing = math.sin(stride) * LEG_SWING * blend
			local bob = (0.5 + 0.5 * math.cos(stride * 2)) * WALK_BOB * height * blend
			local roll = math.sin(stride) * WALK_ROLL * blend
			modelOffset = CFrame.new(0, bob, 0) * centre * CFrame.Angles(-WALK_LEAN * blend, 0, roll)
		elseif motion == "Hop" then
			-- Small hops, rocking a little from side to side.
			local air = math.abs(math.sin(stride * 0.8))
			local rock = math.sin(stride * 0.8) * math.rad(6) * blend
			modelOffset = CFrame.new(0, air * 0.1 * height * blend, 0) * centre * CFrame.Angles(-math.rad(6) * air * blend, 0, rock)
		else
			-- No legs to walk on: waddle, rocking onto each side with every
			-- step and turning a little with it.
			local rock = math.sin(stride) * WADDLE_ROLL * blend
			local turn = math.sin(stride) * WADDLE_TURN * blend
			local bob = math.abs(math.sin(stride)) * WALK_BOB * height * blend
			modelOffset = CFrame.new(0, bob, 0) * centre * CFrame.Angles(-WALK_LEAN * blend, turn, rock)
		end
	elseif motion == "Spin" then
		-- A slow twirl on the spot.
		local rise = math.abs(math.sin(phase * 1.5)) * 0.02 * height
		modelOffset = CFrame.new(0, rise, 0) * centre * CFrame.Angles(0, phase * 0.8, 0)
	elseif motion == "Hop" then
		-- A small bounce every so often, squashing a little on landing.
		local air = math.abs(math.sin(phase * 1.2))
		modelOffset = CFrame.new(0, air * 0.05 * height, 0) * centre * CFrame.Angles(-math.rad(4) * air, 0, 0)
	else
		-- Idle: gentle bob and sway, with a small hop every few seconds.
		local bob = (math.sin(phase * 2) * 0.5 + 0.5) * 0.025 * height
		local cycle = (phase * 0.5) % (math.pi * 2)
		local hop = if cycle < 0.5 then math.sin(cycle / 0.5 * math.pi) * 0.03 * height else 0
		local sway = math.sin(phase * 1.1) * math.rad(7)
		modelOffset = CFrame.new(0, bob + hop, 0) * centre * CFrame.Angles(0, sway, math.sin(phase * 2) * math.rad(2))
	end

	-- Glitched: every so often it jumps to a wrong spot for a frame.
	if visual.Glitch and math.random() < 0.06 then
		local jolt = Vector3.new(math.random() - 0.5, math.random() * 0.3, math.random() - 0.5) * 0.3 * height
		modelOffset = CFrame.new(jolt) * modelOffset * CFrame.Angles(0, (math.random() - 0.5) * 0.8, 0)
	end

	-- Arms swing against the legs (or with each waddle), flail when carried
	-- and wave a little when idle.
	local armSwing: number
	if state == "Carried" then
		armSwing = math.sin(phase * 14) * math.rad(55)
	elseif motion == "Skate" then
		armSwing = math.sin(phase * 1.9) * math.rad(8)
	elseif moving and motion ~= "Fly" and motion ~= "Drive" then
		armSwing = -math.sin(stride) * ARM_SWING * blend
	else
		armSwing = math.sin(phase * 1.6) * math.rad(6)
	end
	-- Wings flap fast in flight, slowly otherwise.
	local flying = motion == "Fly" or state == "Carried"
	local flapRate = if flying then (if moving then 15 else 10) else 4
	local flap = math.sin(t * flapRate + visual.Phase) * math.rad(if flying then 32 else 10)
	local wag = math.sin(phase * (if moving then 9 else 4)) * math.rad(if moving then 22 else 14)
	local hasEars, hasBoard = false, false
	for _, piece in visual.Pieces do
		if piece.Kind == "Ear" then
			hasEars = true
		elseif piece.Kind == "Board" then
			hasBoard = true
		end
	end
	local nod: CFrame
	if hasEars and not moving and state ~= "Carried" then
		-- A puppy's head tilt every few seconds, one way then the other.
		local cycle = phase % 5
		local tilt = if cycle < 1.8 then math.sin(cycle / 1.8 * math.pi) * math.rad(20) else 0
		local side = if math.floor(phase / 5) % 2 == 0 then 1 else -1
		nod = CFrame.Angles(math.sin(phase * 0.9) * math.rad(3), math.sin(phase * 0.45) * math.rad(12), tilt * side)
	elseif moving then
		nod = CFrame.Angles(math.sin(stride * 2) * math.rad(5) * blend, math.sin(stride) * math.rad(4) * blend, 0)
	else
		-- Looks around now and then.
		nod = CFrame.Angles(math.sin(phase * 0.9) * math.rad(3), math.sin(phase * 0.45) * math.rad(16), math.sin(phase * 0.7) * math.rad(3))
	end
	-- Propellers always turn; wheels roll with the ground speed; halos turn slowly.
	visual.Spin += dt * (if motion == "Drive" or motion == "Skate" then visual.Speed * 1.6 else PROP_SPIN)

	-- Ears flop outwards with every step (flapping when carried).
	local earFlop: number
	if state == "Carried" then
		earFlop = (0.5 + 0.5 * math.sin(phase * 14)) * math.rad(40)
	elseif moving then
		earFlop = math.rad(4) + (0.5 + 0.5 * math.sin(stride * 2)) * math.rad(20) * blend
	else
		earFlop = math.rad(4) + (0.5 + 0.5 * math.sin(phase * 1.3)) * math.rad(5)
	end
	-- (They fly up when a skater jumps.)
	earFlop += skateAir * math.rad(45)
	-- The skateboard: flips about its length for a kickflip or spins flat
	-- for a shove-it.
	local boardTurn = CFrame.identity
	if skateAir > 0 and skateTrick > 0 then
		local spin = (1 - math.cos(skateAlpha * math.pi)) * math.pi
		boardTurn = if skateTrick == 1 then CFrame.Angles(0, 0, spin) else CFrame.Angles(0, spin, 0)
	end

	-- Glowing blocks circle the brainrot, bobbing and tumbling.
	local orbiters = visual.Orbiters
	if #orbiters > 0 then
		local rootFrame = visual.Root.CFrame
		local count = #orbiters
		for index, cube in orbiters do
			local angle = t * 1.6 + (index - 1) / count * math.pi * 2
			local y = height * (0.5 + 0.25 * math.sin(t * 2 + index * 1.7))
			cube.CFrame = rootFrame
				* CFrame.new(math.cos(angle) * visual.OrbitRadius, y, math.sin(angle) * visual.OrbitRadius)
				* CFrame.Angles(t * 2 + index, t * 3, 0)
		end
	end

	-- modelOffset moves the model about its centre; the pieces' rest poses
	-- are relative to the feet.
	local frame = modelOffset * centre:Inverse()
	-- Ears move with the head and wheels with the board.
	local headPose, boardPose = CFrame.identity, CFrame.identity
	if hasEars or hasBoard then
		for _, piece in visual.Pieces do
			if piece.Kind == "Head" then
				headPose = CFrame.new(piece.Hip) * nod * CFrame.new(-piece.Hip)
			elseif piece.Kind == "Board" then
				-- Mid-kickflip the board drops half its width under the feet,
				-- so it flips clear of them.
				local drop = if skateTrick == 1 then skateAir * piece.Part.Size.X * 0.5 else 0
				boardPose = CFrame.new(0, -drop, 0) * CFrame.new(piece.Hip) * boardTurn * CFrame.new(-piece.Hip)
			end
		end
	end
	for _, piece in visual.Pieces do
		local kind = piece.Kind
		local turn: CFrame? = nil
		-- Which side of the body it's on, for things that swing outwards.
		local side = if piece.Hip.X >= 0 then 1 else -1
		if kind == "Leg" and motion == "Skate" and state ~= "Carried" then
			-- The back foot kicks to push; the other stays on the board.
			turn = CFrame.Angles(if piece.Direction < 0 then -skatePush * math.rad(40) else 0, 0, 0)
		elseif kind == "Leg" then
			turn = CFrame.Angles(swing * piece.Direction, 0, 0)
		elseif kind == "Arm" and motion == "Skate" and state ~= "Carried" then
			-- Arms out for balance, flung up in the air.
			local raise = math.rad(22) + math.sin(phase * 2.3 + piece.Direction) * math.rad(7) + skateAir * math.rad(50)
			turn = CFrame.Angles(armSwing * piece.Direction, 0, raise * side)
		elseif kind == "Arm" then
			turn = CFrame.Angles(armSwing * piece.Direction, 0, 0)
		elseif kind == "Wing" then
			turn = CFrame.Angles(0, 0, flap * piece.Direction)
		elseif kind == "Tail" then
			turn = CFrame.Angles(0, wag * piece.Direction, 0)
		elseif kind == "Head" then
			turn = nod
		elseif kind == "Prop" then
			local angle = if piece.Axis == Vector3.yAxis then visual.Spin * 0.25 else visual.Spin
			turn = boardPose * CFrame.new(piece.Hip) * CFrame.fromAxisAngle(piece.Axis, angle * piece.Direction) * CFrame.new(-piece.Hip)
		elseif kind == "Board" then
			turn = boardPose
		elseif kind == "Ear" then
			turn = headPose * CFrame.new(piece.Hip) * CFrame.Angles(0, 0, earFlop * side) * CFrame.new(-piece.Hip)
		end
		if kind == "Prop" or kind == "Board" or kind == "Ear" then
			-- (Already about its joint, and its parent's.)
			piece.Weld.C0 = frame * (turn :: CFrame) * piece.Base
		elseif turn then
			piece.Weld.C0 = frame * CFrame.new(piece.Hip) * turn * CFrame.new(-piece.Hip) * piece.Base
		else
			piece.Weld.C0 = frame * piece.Base
		end
	end
end

local lastRainbowUpdate = 0
local lastFrame = os.clock()

RunService.RenderStepped:Connect(function()
	local t = os.clock()
	local dt = math.min(t - lastFrame, 0.1)
	lastFrame = t
	local camera = Workspace.CurrentCamera
	local cameraPosition = if camera then camera.CFrame.Position else Vector3.zero

	for model, visual in visuals do
		if model.Parent == nil or visual.Root.Parent ~= model then
			detach(model)
			continue
		end
		if (visual.Root.Position - cameraPosition).Magnitude > ANIMATION_DISTANCE then
			visual.LastPosition = visual.Root.Position
			continue
		end
		animate(visual, model:GetAttribute("State"), t, dt)
		if visual.Glitch then
			local flicker = if math.random() < 0.08 then 0.6 else 0
			for _, piece in visual.Pieces do
				piece.Part.LocalTransparencyModifier = flicker
			end
		end

		local light = visual.Light
		if light then
			if visual.Pulse then
				light.Brightness = visual.BaseBrightness * (0.7 + 0.3 * math.sin(t * 4 + visual.Phase))
			end
			if visual.Rainbow or visual.RainbowLight then
				light.Color = Color3.fromHSV((t * 0.25) % 1, 0.8, 1)
			end
		end
		local highlight = visual.Highlight
		if highlight and visual.Rainbow then
			local colour = Color3.fromHSV((t * 0.25) % 1, 0.8, 1)
			highlight.FillColor = colour
			highlight.OutlineColor = colour
		end
	end

	if t - lastRainbowUpdate >= RAINBOW_INTERVAL and next(rainbowAssets) ~= nil then
		lastRainbowUpdate = t
		for asset in rainbowAssets do
			AssetLoader.animateRainbow(asset, t)
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="298">
        <Properties>
          <string name="Name">ExtrasClient</string>
          <string name="Source"><![CDATA[--!strict
--[[
	ExtrasClient
	Location: StarterPlayer.StarterPlayerScripts (LocalScript)

	The menus and effects for the features the original game doesn't have,
	in the same chunky style as the rest of the HUD (see UIKit):
	  * the Manage menu (the G prompt on your own brainrot): its level, income
	    and hat, guard duty and pet
	  * a column of side buttons on the right: Season (the season pass), Crew
	    and Pets (which brainrots follow you, and more pet slots)
	  * crew invites, the Limited Shop on the map (this week's brainrot on its
	    display, a countdown and the purchase window)
	  * the boss's health bar and stomp shockwaves, the revenge arrow, the
	    loot bag and bounty banners
	  * pets: every player's pet brainrots follow them around (drawn here,
	    animated by BrainrotVisuals)

	Nothing here decides anything: every button asks the server (the
	ManageBrainrot, Companion, Crew, Season and Rewards remotes), which checks
	it and answers.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BrainrotConfig = require(Shared:WaitForChild("BrainrotConfig"))
local ExtrasConfig = require(Shared:WaitForChild("ExtrasConfig"))
local FeatureConfig = require(Shared:WaitForChild("FeatureConfig"))
local HatModels = require(Shared:WaitForChild("HatModels"))
local MonetizationConfig = require(Shared:WaitForChild("MonetizationConfig"))
local NumberFormat = require(Shared:WaitForChild("NumberFormat"))
local Sounds = require(Shared:WaitForChild("Sounds"))
local TemplateModels = require(Shared:WaitForChild("TemplateModels"))
local UIKit = require(Shared:WaitForChild("UIKit"))

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local manageFunction = remotes:WaitForChild("ManageBrainrot") :: RemoteFunction
local companionFunction = remotes:WaitForChild("Companion") :: RemoteFunction
local crewFunction = remotes:WaitForChild("Crew") :: RemoteFunction
local crewEvent = remotes:WaitForChild("CrewEvent") :: RemoteEvent
local seasonFunction = remotes:WaitForChild("Season") :: RemoteFunction
local seasonStateEvent = remotes:WaitForChild("SeasonState") :: RemoteEvent

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui
local map = Workspace:WaitForChild("Map")
local brainrotsFolder = map:WaitForChild("Brainrots")

local create = UIKit.create
local label = UIKit.label
local button = UIKit.button
local corner = UIKit.corner
local stroke = UIKit.stroke
local COLORS = UIKit.Colors
local ACCENTS = {
	Manage = Color3.fromRGB(60, 190, 150),
	Season = Color3.fromRGB(255, 170, 30),
	Crew = Color3.fromRGB(80, 140, 255),
	Pets = Color3.fromRGB(235, 120, 60),
	Limited = Color3.fromRGB(255, 200, 40),
	Premium = Color3.fromRGB(255, 190, 40),
}

local screen = create("ScreenGui", {
	Name = "ExtrasHud",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 1,
}) :: ScreenGui

-- Asks the server through a RemoteFunction; shows its answer as a pop-up.
local function ask(remote: RemoteFunction, ...: any): (boolean, any)
	local args = table.pack(...)
	local ok, success, message, extra = pcall(function()
		return remote:InvokeServer(table.unpack(args, 1, args.n))
	end)
	if not ok then
		UIKit.toast("Couldn't reach the server, try again.", "Error")
		return false, nil
	end
	if typeof(message) == "string" then
		UIKit.toast(message, if success == true then "Success" else "Error")
		Sounds.play(if success == true then "Purchase" else "Error")
	end
	return success == true, extra
end

-- Asks quietly (for state that fills a window).
local function fetch(remote: RemoteFunction, ...: any): any
	local args = table.pack(...)
	local ok, success, _, extra = pcall(function()
		return remote:InvokeServer(table.unpack(args, 1, args.n))
	end)
	if ok and success == true then
		return extra
	end
	return nil
end

local function promptProduct(key: string)
	local productId = MonetizationConfig.ProductIds[key]
	if productId and not MonetizationConfig.isSetUp(productId) then
		UIKit.toast(MonetizationConfig.NotSetUpMessage, "Warning")
	elseif productId then
		pcall(function()
			MarketplaceService:PromptProductPurchase(player, productId)
		end)
	end
end

local function promptPass(key: string)
	local passId = MonetizationConfig.GamePasses[key]
	if passId and not MonetizationConfig.isSetUp(passId) then
		UIKit.toast(MonetizationConfig.NotSetUpMessage, "Warning")
	elseif passId then
		pcall(function()
			MarketplaceService:PromptGamePassPurchase(player, passId)
		end)
	end
end

local function duration(seconds: number): string
	local total = math.max(0, math.floor(seconds))
	if total >= 86400 then
		return string.format("%dd %dh", total // 86400, total // 3600 % 24)
	elseif total >= 3600 then
		return string.format("%dh %dm", total // 3600, total // 60 % 60)
	end
	return string.format("%dm %02ds", total // 60, total % 60)
end

-- A 3D hat spinning in a little window.
local function hatViewport(hatName: string, properties: { [string]: any }): ViewportFrame
	local viewport = create("ViewportFrame", {
		BackgroundColor3 = COLORS.PanelDark,
		Ambient = Color3.fromRGB(200, 200, 200),
		LightColor = Color3.new(1, 1, 1),
		LightDirection = Vector3.new(-0.4, -1, 0.6),
	}, { corner(10) }) :: ViewportFrame
	for key, value in properties do
		(viewport :: any)[key] = value
	end
	local model = HatModels.build(hatName, 2)
	if model then
		model:PivotTo(CFrame.new(0, -0.6, 0))
		model.Parent = viewport
		local camera = Instance.new("Camera")
		camera.FieldOfView = 40
		camera.CFrame = CFrame.lookAt(Vector3.new(2.2, 1.8, -3.4), Vector3.new(0, 0, 0))
		camera.Parent = viewport
		viewport.CurrentCamera = camera
	end
	return viewport
end

--------------------------------------------------------------------------------
-- Side buttons (right, next to Trade/Upgrade/Settings)
--------------------------------------------------------------------------------

local column = UIKit.sideColumn(screen, "ExtraButtons", 3, {})
UIKit.placeSideColumn(column, true, 1)
local seasonButton = UIKit.sideButton(column, "SeasonButton", "Season", ACCENTS.Season, "Season", 1, "🏆")
local crewButton = UIKit.sideButton(column, "CrewButton", "Crew", ACCENTS.Crew, "Crew", 2, "👥")
local petsButton = UIKit.sideButton(column, "PetsButton", "Pets", ACCENTS.Pets, "Pets", 3, "🐾")

--------------------------------------------------------------------------------
-- Manage menu: level, hat, guard and pet for one of your brainrots
--------------------------------------------------------------------------------

local manageFrame, manageBody = UIKit.modal(screen, "ManageMenu", "Your Brainrot", ACCENTS.Manage, Vector2.new(640, 600))
local manageSlot: number? = nil
local refreshManage: () -> ()
do
	local preview = create("Frame", {
		Name = "Preview",
		Size = UDim2.new(0.34, 0, 0.36, 0),
		BackgroundColor3 = COLORS.PanelDark,
	}, { corner(12), stroke(Color3.new(0, 0, 0), 2) }) :: Frame
	preview.Parent = manageBody

	local function info(name: string, y: number, height: number, colour: Color3): TextLabel
		local line = label({
			Name = name,
			Position = UDim2.new(0.37, 0, y, 0),
			Size = UDim2.new(0.63, 0, height, 0),
			Text = "",
			TextColor3 = colour,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextSize = 26,
		})
		line.Parent = manageBody
		return line
	end
	local nameLabel = info("BrainrotName", 0, 0.09, COLORS.Text)
	local rarityLabel = info("Rarity", 0.09, 0.065, COLORS.Muted)
	local levelLabel = info("Level", 0.16, 0.07, Color3.fromRGB(140, 230, 255))
	local nextLabel = info("NextLevel", 0.23, 0.055, COLORS.Muted)
	local incomeLabel = info("Income", 0.29, 0.065, COLORS.Income)

	local buttons = create("Frame", {
		Name = "Roles",
		Position = UDim2.new(0, 0, 0.39, 0),
		Size = UDim2.new(1, 0, 0.1, 0),
		BackgroundTransparency = 1,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0.02, 0),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	}) :: Frame
	buttons.Parent = manageBody
	local guardButton = button("🛡️ Make Guard", Color3.fromRGB(60, 140, 230), { Name = "GuardButton", Size = UDim2.new(0.32, 0, 1, 0), LayoutOrder = 1 })
	guardButton.Parent = buttons
	local petButton = button("🐾 Make Pet", Color3.fromRGB(230, 120, 60), { Name = "PetButton", Size = UDim2.new(0.32, 0, 1, 0), LayoutOrder = 2 })
	petButton.Parent = buttons
	local superButton = button("⚡ Super Guard", Color3.fromRGB(150, 80, 230), { Name = "SuperGuardButton", Size = UDim2.new(0.32, 0, 1, 0), LayoutOrder = 3 })
	superButton.Parent = buttons

	local hatTitle = label({
		Name = "HatTitle",
		Position = UDim2.new(0, 0, 0.51, 0),
		Size = UDim2.new(0.62, 0, 0.065, 0),
		Text = "🎩 Hats: more income for whoever wears one",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextSize = 22,
	})
	hatTitle.Parent = manageBody
	local removeHatButton = button("Take hat off", COLORS.Close, {
		Name = "RemoveHat",
		Position = UDim2.new(0.64, 0, 0.505, 0),
		Size = UDim2.new(0.36, 0, 0.075, 0),
	})
	removeHatButton.Parent = manageBody

	local hatList = create("ScrollingFrame", {
		Name = "HatList",
		Position = UDim2.new(0, 0, 0.59, 0),
		Size = UDim2.new(1, 0, 0.3, 0),
		BackgroundTransparency = 1,
		ScrollBarThickness = 8,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	}) :: ScrollingFrame
	hatList.Parent = manageBody

	local crateButton = button("🎁 Hat Crate (random hat)", Color3.fromRGB(150, 90, 230), {
		Name = "HatCrate",
		Position = UDim2.new(0.2, 0, 0.91, 0),
		Size = UDim2.new(0.6, 0, 0.085, 0),
	})
	crateButton.Parent = manageBody
	crateButton.Activated:Connect(function()
		promptProduct("HatCrate")
	end)
	superButton.Activated:Connect(function()
		promptPass("SuperGuard")
	end)

	type HatCard = { Frame: Frame, Count: TextLabel, Wear: TextButton }
	local hatCards: { [string]: HatCard } = {}
	for order, hat in ExtrasConfig.Hats do
		local card = create("Frame", {
			Name = hat.Name,
			Size = UDim2.new(0, 120, 1, -12),
			BackgroundColor3 = COLORS.PanelLight,
			LayoutOrder = order,
		}, { corner(12), stroke(hat.Color, 3) }) :: Frame
		hatViewport(hat.Name, { Name = "Preview", Position = UDim2.new(0, 6, 0, 6), Size = UDim2.new(1, -12, 0.42, 0) }).Parent = card
		label({ Name = "HatName", Position = UDim2.new(0, 2, 0.46, 0), Size = UDim2.new(1, -4, 0.14, 0), Text = hat.DisplayName, TextSize = 16 }).Parent = card
		label({
			Name = "Bonus",
			Position = UDim2.new(0, 2, 0.59, 0),
			Size = UDim2.new(1, -4, 0.12, 0),
			Text = string.format("+%d%% income", math.floor(hat.Bonus * 100 + 0.5)),
			TextColor3 = COLORS.Cash,
			TextSize = 15,
		}).Parent = card
		local count = label({ Name = "Count", Position = UDim2.new(0, 2, 0.7, 0), Size = UDim2.new(1, -4, 0.11, 0), Text = "x0", TextColor3 = COLORS.Muted, TextSize = 14 })
		count.Parent = card
		local wear = button("Wear", COLORS.Buy, { Name = "Wear", Position = UDim2.new(0.08, 0, 0.82, 0), Size = UDim2.new(0.84, 0, 0.16, 0) })
		wear.Parent = card
		wear.Activated:Connect(function()
			if manageSlot then
				ask(manageFunction, "PutHat", manageSlot, hat.Name)
				refreshManage()
			end
		end)
		card.Parent = hatList
		hatCards[hat.Name] = { Frame = card, Count = count, Wear = wear }
	end

	local guardSlot: number? = nil
	local petSlotList: { number } = {}
	guardButton.Activated:Connect(function()
		if manageSlot then
			ask(companionFunction, if guardSlot == manageSlot then "Unguard" else "Guard", manageSlot)
			refreshManage()
		end
	end)
	petButton.Activated:Connect(function()
		if manageSlot then
			ask(companionFunction, if table.find(petSlotList, manageSlot) then "Unpet" else "Pet", manageSlot)
			refreshManage()
		end
	end)
	removeHatButton.Activated:Connect(function()
		if manageSlot then
			ask(manageFunction, "RemoveHat", manageSlot)
			refreshManage()
		end
	end)

	local shownPreview: string? = nil
	refreshManage = function()
		local slot = manageSlot
		if slot == nil then
			return
		end
		local infoData = fetch(manageFunction, "Info", slot)
		local roles = fetch(companionFunction, "State")
		if manageSlot ~= slot or typeof(infoData) ~= "table" then
			return
		end
		guardSlot = if typeof(roles) == "table" then roles.Guard else nil
		petSlotList = if typeof(roles) == "table" and typeof(roles.Pets) == "table" then roles.Pets else {}

		-- Which brainrot is on that pedestal (from its model).
		local entryId: string? = nil
		local mutationName: string? = nil
		for _, model in brainrotsFolder:GetChildren() do
			if model:GetAttribute("OwnerUserId") == player.UserId and model:GetAttribute("Slot") == slot then
				local id = model:GetAttribute("BrainrotId")
				entryId = if typeof(id) == "string" then id else nil
				local mutation = model:GetAttribute("Mutation")
				mutationName = if typeof(mutation) == "string" then mutation else nil
			end
		end
		local definition = if entryId then BrainrotConfig.ById[entryId] else nil
		if definition then
			local rarity = BrainrotConfig.RarityByName[definition.Rarity]
			nameLabel.Text = (if mutationName then mutationName .. " " else "") .. definition.DisplayName
			rarityLabel.Text = definition.Rarity
			rarityLabel.TextColor3 = if rarity then rarity.Color else COLORS.Muted
			if shownPreview ~= definition.Id then
				shownPreview = definition.Id
				for _, child in preview:GetChildren() do
					if child:IsA("ViewportFrame") then
						child:Destroy()
					end
				end
				UIKit.brainrotViewport(definition.Id, if rarity then rarity.Color:Lerp(Color3.new(0, 0, 0), 0.55) else COLORS.PanelDark, {
					Size = UDim2.fromScale(1, 1),
				}).Parent = preview
			end
		end
		local level = tonumber(infoData.Level) or 1
		levelLabel.Text = string.format("⭐ Level %d / %d  (+%d%% income)", level, ExtrasConfig.MaxLevel, math.floor(ExtrasConfig.IncomePerLevel * (level - 1) * 100 + 0.5))
		local nextIn = tonumber(infoData.NextLevelIn)
		nextLabel.Text = if nextIn then "Next level in " .. duration(nextIn) .. " on its pedestal" else "MAX LEVEL!"
		incomeLabel.Text = NumberFormat.cash(tonumber(infoData.Income) or 0) .. "/s"

		guardButton.Text = if guardSlot == slot then "🛡️ Stop Guarding" else "🛡️ Make Guard"
		petButton.Text = if table.find(petSlotList, slot) then "🐾 Stop Pet" else "🐾 Make Pet"
		local hats = if typeof(infoData.Hats) == "table" then infoData.Hats else {}
		local wearing = if typeof(infoData.Hat) == "string" then infoData.Hat else nil
		local worn = if wearing then ExtrasConfig.HatByName[wearing] else nil
		hatTitle.Text = if worn
			then string.format("🎩 Wearing: %s %s (+%d%%)", worn.Icon, worn.DisplayName, math.floor(worn.Bonus * 100 + 0.5))
			else "🎩 Hats: more income for whoever wears one"
		removeHatButton.Visible = worn ~= nil
		for hatName, card in hatCards do
			local count = tonumber(hats[hatName]) or 0
			card.Count.Text = "You have x" .. count
			UIKit.setEnabled(card.Wear, count > 0 and wearing ~= hatName, COLORS.Buy)
			card.Wear.Text = if wearing == hatName then "Wearing" else "Wear"
		end
	end
end

ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, who: Player)
	if who ~= player then
		return
	end
	local kind = prompt:GetAttribute("PromptKind")
	if kind == "Manage" then
		local model = prompt:FindFirstAncestorWhichIsA("Model")
		local slot = if model then model:GetAttribute("Slot") else nil
		if typeof(slot) == "number" then
			manageSlot = slot
			UIKit.openModal(manageFrame)
			task.spawn(refreshManage)
		end
	end
end)

--------------------------------------------------------------------------------
-- Season pass
--------------------------------------------------------------------------------

local seasonFrame, seasonBody = UIKit.modal(screen, "SeasonMenu", "Season Pass", ACCENTS.Season, Vector2.new(800, 600))
local seasonState: { [string]: any }? = nil
local renderSeason: () -> ()
do
	local header = label({
		Name = "SeasonInfo",
		Size = UDim2.new(0.55, 0, 0.07, 0),
		Text = "Season 1",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextSize = 26,
	})
	header.Parent = seasonBody
	local bar, setBar = UIKit.progressBar(ACCENTS.Season, {
		Name = "XPBar",
		Position = UDim2.new(0, 0, 0.08, 0),
		Size = UDim2.new(0.55, 0, 0.06, 0),
	})
	bar.Parent = seasonBody

	local claimAll = button("Claim all", COLORS.Buy, { Name = "ClaimAll", Position = UDim2.new(0.57, 0, 0, 0), Size = UDim2.new(0.2, 0, 0.065, 0) })
	claimAll.Parent = seasonBody
	local skip = button("Skip a tier", Color3.fromRGB(80, 160, 255), { Name = "SkipTier", Position = UDim2.new(0.79, 0, 0, 0), Size = UDim2.new(0.21, 0, 0.065, 0) })
	skip.Parent = seasonBody
	local getPass = button("👑 Get the Season Pass", ACCENTS.Premium, { Name = "GetPass", Position = UDim2.new(0.57, 0, 0.075, 0), Size = UDim2.new(0.43, 0, 0.065, 0) })
	getPass.Parent = seasonBody
	claimAll.Activated:Connect(function()
		local ok, state = ask(seasonFunction, "ClaimAll")
		if ok and typeof(state) == "table" then
			seasonState = state
			renderSeason()
		end
	end)
	skip.Activated:Connect(function()
		promptProduct("SeasonTierSkip")
	end)
	getPass.Activated:Connect(function()
		promptPass("SeasonPass")
	end)

	local columns = create("Frame", {
		Name = "Columns",
		Position = UDim2.new(0, 0, 0.155, 0),
		Size = UDim2.new(1, -12, 0.05, 0),
		BackgroundTransparency = 1,
	}) :: Frame
	columns.Parent = seasonBody
	label({ Size = UDim2.new(0.12, 0, 1, 0), Text = "Tier", TextSize = 20, TextColor3 = COLORS.Muted }).Parent = columns
	label({ Position = UDim2.new(0.13, 0, 0, 0), Size = UDim2.new(0.43, 0, 1, 0), Text = "Free", TextSize = 20, TextColor3 = COLORS.Muted }).Parent = columns
	label({ Position = UDim2.new(0.57, 0, 0, 0), Size = UDim2.new(0.43, 0, 1, 0), Text = "👑 Premium", TextSize = 20, TextColor3 = ACCENTS.Premium }).Parent = columns

	local list = create("ScrollingFrame", {
		Name = "Tiers",
		Position = UDim2.new(0, 0, 0.21, 0),
		Size = UDim2.new(1, 0, 0.79, 0),
		BackgroundTransparency = 1,
		ScrollBarThickness = 8,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, {
		create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	}) :: ScrollingFrame
	list.Parent = seasonBody

	type Cell = { Frame: Frame, Button: TextButton, Text: TextLabel }
	type Row = { Frame: Frame, Tier: TextLabel, Free: Cell, Premium: Cell }
	local rows: { Row } = {}

	local function cell(parent: Frame, x: number, reward: FeatureConfig.Reward, premium: boolean, tier: number): Cell
		local frame = create("Frame", {
			Position = UDim2.new(x, 0, 0, 3),
			Size = UDim2.new(0.43, 0, 1, -6),
			BackgroundColor3 = if premium then Color3.fromRGB(70, 55, 25) else COLORS.PanelLight,
		}, { corner(10), stroke(if premium then ACCENTS.Premium else Color3.new(0, 0, 0), 2) }) :: Frame
		local text = label({
			Position = UDim2.new(0, 8, 0, 0),
			Size = UDim2.new(0.62, -8, 1, 0),
			Text = FeatureConfig.describeReward(reward),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextSize = 18,
		})
		text.Parent = frame
		local claim = button("Claim", COLORS.Buy, { Position = UDim2.new(0.64, 0, 0.12, 0), Size = UDim2.new(0.34, 0, 0.76, 0) })
		claim.Parent = frame
		claim.Activated:Connect(function()
			local ok, state = ask(seasonFunction, "Claim", { Tier = tier, Track = if premium then "Premium" else "Free" })
			if ok and typeof(state) == "table" then
				seasonState = state
				renderSeason()
			end
		end)
		frame.Parent = parent
		return { Frame = frame, Button = claim, Text = text }
	end

	for tier, rewards in ExtrasConfig.SeasonTiers do
		local row = create("Frame", {
			Name = "Tier" .. tier,
			Size = UDim2.new(1, -12, 0, 54),
			BackgroundTransparency = 1,
			LayoutOrder = tier,
		}) :: Frame
		local tierLabel = label({
			Size = UDim2.new(0.12, 0, 1, 0),
			Text = tostring(tier),
			TextSize = 28,
			BackgroundTransparency = 0,
			BackgroundColor3 = COLORS.PanelDark,
		})
		corner(10).Parent = tierLabel
		tierLabel.Parent = row
		rows[tier] = {
			Frame = row,
			Tier = tierLabel,
			Free = cell(row, 0.13, rewards[1], false, tier),
			Premium = cell(row, 0.57, rewards[2], true, tier),
		}
		row.Parent = list
	end

	renderSeason = function()
		local state = seasonState
		if state == nil then
			return
		end
		local xp = tonumber(state.XP) or 0
		local tier = tonumber(state.Tier) or 0
		local premium = state.Premium == true
		local endsAt = tonumber(state.EndsAt) or 0
		header.Text = string.format("Season %d  ·  ends in %s", tonumber(state.Season) or 1, duration(endsAt - Workspace:GetServerTimeNow()))
		if tier >= ExtrasConfig.SeasonTierCount then
			setBar(1, "Every tier done! 🏆")
		else
			local into = xp - tier * ExtrasConfig.TierXP
			setBar(into / ExtrasConfig.TierXP, string.format("Tier %d → %d:  %d / %d XP", tier, tier + 1, math.floor(into), ExtrasConfig.TierXP))
		end
		getPass.Visible = not premium
		local free = if typeof(state.Free) == "table" then state.Free else {}
		local claimedPremium = if typeof(state.PremiumClaimed) == "table" then state.PremiumClaimed else {}
		local waiting = false
		for index, row in rows do
			local reached = index <= tier
			row.Tier.BackgroundColor3 = if reached then ACCENTS.Season else COLORS.PanelDark
			for _, track in { "Free", "Premium" } do
				local cellInfo = if track == "Free" then row.Free else row.Premium
				local claimed = table.find(if track == "Free" then free else claimedPremium, index) ~= nil
				local locked = track == "Premium" and not premium
				if claimed then
					cellInfo.Button.Text = "✅"
					UIKit.setEnabled(cellInfo.Button, false, COLORS.Buy)
				elseif not reached then
					cellInfo.Button.Text = "🔒"
					UIKit.setEnabled(cellInfo.Button, false, COLORS.Buy)
				elseif locked then
					cellInfo.Button.Text = "👑"
					UIKit.setEnabled(cellInfo.Button, false, COLORS.Buy)
				else
					cellInfo.Button.Text = "Claim"
					UIKit.setEnabled(cellInfo.Button, true, COLORS.Buy)
					waiting = true
				end
			end
		end
		UIKit.setAlert(seasonButton, waiting)
	end

	seasonStateEvent.OnClientEvent:Connect(function(state: any)
		if typeof(state) == "table" then
			seasonState = state
			renderSeason()
		end
	end)
	task.spawn(function()
		local state = fetch(seasonFunction, "State")
		if typeof(state) == "table" then
			seasonState = state
			renderSeason()
		end
	end)
end

seasonButton.Activated:Connect(function()
	if UIKit.toggleModal(seasonFrame) then
		renderSeason()
	end
end)

--------------------------------------------------------------------------------
-- Crews
--------------------------------------------------------------------------------

local crewFrame, crewBody = UIKit.modal(screen, "CrewMenu", "Crew", ACCENTS.Crew, Vector2.new(660, 560))
local crewState: { [string]: any } = { Invites = {} }
local renderCrew: () -> ()
do
	local nameIndex = 1
	local colorIndex = 1

	-- Starting a crew.
	local startPage = create("Frame", { Name = "Start", Size = UDim2.fromScale(1, 0.5), BackgroundTransparency = 1 }) :: Frame
	startPage.Parent = crewBody
	label({ Size = UDim2.new(1, 0, 0.18, 0), Text = "Start a crew: +5% income for each crewmate here!", TextSize = 22 }).Parent = startPage
	local previous = button("◀", COLORS.PanelLight, { Position = UDim2.new(0, 0, 0.22, 0), Size = UDim2.new(0.1, 0, 0.2, 0) })
	previous.Parent = startPage
	local crewName = label({ Name = "CrewName", Position = UDim2.new(0.12, 0, 0.22, 0), Size = UDim2.new(0.76, 0, 0.2, 0), Text = "", TextSize = 32 })
	crewName.Parent = startPage
	local nextName = button("▶", COLORS.PanelLight, { Position = UDim2.new(0.9, 0, 0.22, 0), Size = UDim2.new(0.1, 0, 0.2, 0) })
	nextName.Parent = startPage
	local swatches = create("Frame", {
		Position = UDim2.new(0.1, 0, 0.47, 0),
		Size = UDim2.new(0.8, 0, 0.18, 0),
		BackgroundTransparency = 1,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 8),
		}),
	}) :: Frame
	swatches.Parent = startPage
	local swatchButtons: { TextButton } = {}
	for index, colour in ExtrasConfig.CrewColors do
		local swatch = create("TextButton", {
			Size = UDim2.new(0, 40, 1, 0),
			BackgroundColor3 = colour,
			Text = "",
		}, { corner(8), stroke(Color3.new(0, 0, 0), 2) }) :: TextButton
		swatch.Activated:Connect(function()
			colorIndex = index
			renderCrew()
		end)
		swatch.Parent = swatches
		swatchButtons[index] = swatch
	end
	local createButton = button("Start crew", COLORS.Buy, { Name = "CreateCrew", Position = UDim2.new(0.3, 0, 0.72, 0), Size = UDim2.new(0.4, 0, 0.2, 0) })
	createButton.Parent = startPage
	previous.Activated:Connect(function()
		nameIndex = (nameIndex - 2) % #ExtrasConfig.CrewNames + 1
		renderCrew()
	end)
	nextName.Activated:Connect(function()
		nameIndex = nameIndex % #ExtrasConfig.CrewNames + 1
		renderCrew()
	end)
	createButton.Activated:Connect(function()
		local ok, state = ask(crewFunction, "Create", { Name = nameIndex, Color = colorIndex })
		if ok and typeof(state) == "table" then
			crewState = state
		end
		renderCrew()
	end)

	-- In a crew.
	local crewPage = create("Frame", { Name = "InCrew", Size = UDim2.fromScale(1, 0.5), BackgroundTransparency = 1 }) :: Frame
	crewPage.Parent = crewBody
	local crewTitle = label({ Name = "CrewTitle", Size = UDim2.new(0.7, 0, 0.18, 0), Text = "", TextSize = 32, TextXAlignment = Enum.TextXAlignment.Left })
	crewTitle.Parent = crewPage
	local leave = button("Leave", COLORS.Close, { Name = "LeaveCrew", Position = UDim2.new(0.75, 0, 0, 0), Size = UDim2.new(0.25, 0, 0.16, 0) })
	leave.Parent = crewPage
	leave.Activated:Connect(function()
		local ok, state = ask(crewFunction, "Leave")
		if ok and typeof(state) == "table" then
			crewState = state
		end
		renderCrew()
	end)
	local members = create("Frame", {
		Name = "Members",
		Position = UDim2.new(0, 0, 0.2, 0),
		Size = UDim2.new(1, 0, 0.8, 0),
		BackgroundTransparency = 1,
	}, { create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }) }) :: Frame
	members.Parent = crewPage

	-- Invites for you, and players you can invite.
	local lower = create("ScrollingFrame", {
		Name = "People",
		Position = UDim2.new(0, 0, 0.52, 0),
		Size = UDim2.new(1, 0, 0.48, 0),
		BackgroundTransparency = 1,
		ScrollBarThickness = 8,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, { create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }) }) :: ScrollingFrame
	lower.Parent = crewBody

	local function row(parent: Instance, text: string, order: number, colour: Color3?): Frame
		local frame = create("Frame", {
			Size = UDim2.new(1, -12, 0, 40),
			BackgroundColor3 = colour or COLORS.PanelLight,
			LayoutOrder = order,
		}, { corner(8) }) :: Frame
		label({ Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(0.62, 0, 1, 0), Text = text, TextSize = 20, TextXAlignment = Enum.TextXAlignment.Left }).Parent = frame
		frame.Parent = parent
		return frame
	end

	local function rowButton(frame: Frame, text: string, colour: Color3, x: number, width: number, callback: () -> ())
		local rowAction = button(text, colour, { Position = UDim2.new(x, 0, 0.1, 0), Size = UDim2.new(width, 0, 0.8, 0) })
		rowAction.Parent = frame
		rowAction.Activated:Connect(callback)
	end

	renderCrew = function()
		local crew = crewState.Crew
		startPage.Visible = crew == nil
		crewPage.Visible = crew ~= nil
		crewName.Text = ExtrasConfig.CrewNames[nameIndex]
		crewName.TextColor3 = ExtrasConfig.CrewColors[colorIndex]
		for index, swatch in swatchButtons do
			local swatchStroke = swatch:FindFirstChildOfClass("UIStroke")
			if swatchStroke then
				swatchStroke.Thickness = if index == colorIndex then 4 else 2
				swatchStroke.Color = if index == colorIndex then Color3.new(1, 1, 1) else Color3.new(0, 0, 0)
			end
		end
		for _, child in members:GetChildren() do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		for _, child in lower:GetChildren() do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		local inCrew: { [number]: boolean } = {}
		if crew then
			local colour = ExtrasConfig.CrewColors[tonumber(crew.ColorIndex) or 1] or Color3.new(1, 1, 1)
			local count = if typeof(crew.Members) == "table" then #crew.Members else 1
			crewTitle.Text = string.format("%s  (+%d%%)", tostring(crew.Name), math.floor(ExtrasConfig.CrewBoostPerMember * math.max(0, count - 1) * 100 + 0.5))
			crewTitle.TextColor3 = colour
			local lead = crew.Leader == player.UserId
			for order, member in crew.Members or {} do
				inCrew[member.UserId] = true
				local memberRow = row(members, (if member.UserId == crew.Leader then "👑 " else "") .. tostring(member.Name), order)
				if lead and member.UserId ~= player.UserId then
					rowButton(memberRow, "Kick", COLORS.Close, 0.74, 0.24, function()
						local ok, state = ask(crewFunction, "Kick", member.UserId)
						if ok and typeof(state) == "table" then
							crewState = state
						end
						renderCrew()
					end)
				end
			end
		end
		local order = 0
		for _, invite in crewState.Invites or {} do
			order += 1
			local inviteRow = row(lower, string.format("📩 %s invited you to %s", tostring(invite.From), tostring(invite.CrewName)), order, Color3.fromRGB(50, 80, 140))
			rowButton(inviteRow, "Join", COLORS.Buy, 0.64, 0.17, function()
				local ok, state = ask(crewFunction, "Accept", invite.CrewId)
				if ok and typeof(state) == "table" then
					crewState = state
				end
				renderCrew()
			end)
			rowButton(inviteRow, "No", COLORS.Close, 0.82, 0.16, function()
				local _, state = ask(crewFunction, "Decline", invite.CrewId)
				if typeof(state) == "table" then
					crewState = state
				end
				renderCrew()
			end)
		end
		if crew then
			for _, other in Players:GetPlayers() do
				if other ~= player and not inCrew[other.UserId] then
					order += 1
					local otherRow = row(lower, other.DisplayName, order)
					rowButton(otherRow, "Invite", Color3.fromRGB(80, 140, 255), 0.7, 0.28, function()
						ask(crewFunction, "Invite", other.UserId)
					end)
				end
			end
			if order == 0 then
				row(lower, "Nobody else to invite right now.", 1, COLORS.PanelDark)
			end
		end
		UIKit.setAlert(crewButton, #(crewState.Invites or {}) > 0)
	end

	-- A pop-up when someone invites you.
	local popup = create("Frame", {
		Name = "CrewInvite",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -170),
		Size = UDim2.fromOffset(460, 110),
		BackgroundColor3 = COLORS.Panel,
		Visible = false,
	}, { corner(14), stroke(ACCENTS.Crew, 3) }) :: Frame
	popup.Parent = screen
	UIKit.autoScale(popup)
	local popupText = label({ Position = UDim2.new(0, 10, 0, 6), Size = UDim2.new(1, -20, 0.45, 0), Text = "", TextSize = 22 })
	popupText.Parent = popup
	local popupJoin = button("Join", COLORS.Buy, { Position = UDim2.new(0.1, 0, 0.55, 0), Size = UDim2.new(0.38, 0, 0.36, 0) })
	popupJoin.Parent = popup
	local popupNo = button("No thanks", COLORS.Close, { Position = UDim2.new(0.52, 0, 0.55, 0), Size = UDim2.new(0.38, 0, 0.36, 0) })
	popupNo.Parent = popup
	local popupCrewId: string? = nil
	popupJoin.Activated:Connect(function()
		popup.Visible = false
		if popupCrewId then
			local ok, state = ask(crewFunction, "Accept", popupCrewId)
			if ok and typeof(state) == "table" then
				crewState = state
			end
			renderCrew()
		end
	end)
	popupNo.Activated:Connect(function()
		popup.Visible = false
		if popupCrewId then
			local _, state = ask(crewFunction, "Decline", popupCrewId)
			if typeof(state) == "table" then
				crewState = state
			end
			renderCrew()
		end
	end)

	crewEvent.OnClientEvent:Connect(function(kind: any, data: any)
		if kind == "State" and typeof(data) == "table" then
			crewState = data
			renderCrew()
		elseif kind == "Invite" and typeof(data) == "table" then
			popupCrewId = if typeof(data.CrewId) == "string" then data.CrewId else nil
			popupText.Text = string.format("%s invited you to the %s!", tostring(data.From), tostring(data.CrewName))
			popup.Visible = true
			Sounds.play("Notify")
			local shown = popupCrewId
			task.delay(ExtrasConfig.CrewInviteSeconds, function()
				if popupCrewId == shown then
					popup.Visible = false
				end
			end)
		end
	end)
	task.spawn(function()
		local state = fetch(crewFunction, "State")
		if typeof(state) == "table" then
			crewState = state
		end
		renderCrew()
	end)
end

crewButton.Activated:Connect(function()
	if UIKit.toggleModal(crewFrame) then
		renderCrew()
	end
end)

--------------------------------------------------------------------------------
-- Pets: which of your brainrots follow you, and buying more pet slots
--------------------------------------------------------------------------------

local petsFrame, petsBody = UIKit.modal(screen, "PetsMenu", "PETS", ACCENTS.Pets, Vector2.new(760, 580))
local renderPets: () -> ()
do
	local summary = label({
		Name = "Summary",
		Size = UDim2.new(0.62, 0, 0, 34),
		Text = "",
		TextSize = 26,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	summary.Parent = petsBody
	local speedLabel = label({
		Name = "Speed",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.38, 0, 0, 34),
		Text = "",
		TextColor3 = COLORS.Cash,
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	speedLabel.Parent = petsBody

	-- One tile per pet slot: its pet, empty, or locked with its price.
	local slotRow = create("Frame", {
		Name = "Slots",
		Position = UDim2.fromOffset(0, 42),
		Size = UDim2.new(1, 0, 0, 92),
		BackgroundTransparency = 1,
	}, {
		create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	}) :: Frame
	slotRow.Parent = petsBody
	type SlotTile = { Frame: Frame, Text: TextLabel }
	local slotTiles: { SlotTile } = {}
	local slotCount = ExtrasConfig.MaxPetSlots
	for index = 1, slotCount do
		local tile = create("Frame", {
			Name = "Slot" .. index,
			Size = UDim2.new(1 / slotCount, -8 * (slotCount - 1) / slotCount, 1, 0),
			BackgroundColor3 = COLORS.PanelLight,
			LayoutOrder = index,
		}, { corner(12), stroke(COLORS.Outline, 2) }) :: Frame
		local text = label({
			Name = "Text",
			Position = UDim2.fromOffset(4, 4),
			Size = UDim2.new(1, -8, 1, -8),
			Text = "",
			TextSize = 18,
			TextWrapped = true,
		})
		text.Parent = tile
		tile.Parent = slotRow
		table.insert(slotTiles, { Frame = tile, Text = text })
	end

	local buyButton = button("", COLORS.Buy, {
		Name = "BuySlot",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 144),
		Size = UDim2.new(0.7, 0, 0, 52),
	})
	buyButton.Parent = petsBody
	buyButton.Activated:Connect(function()
		ask(companionFunction, "BuySlot")
		renderPets()
	end)

	label({
		Name = "ListTitle",
		Position = UDim2.fromOffset(0, 206),
		Size = UDim2.new(1, 0, 0, 28),
		Text = "Your brainrots: pick who follows you",
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
	}).Parent = petsBody
	local list = create("ScrollingFrame", {
		Name = "List",
		Position = UDim2.fromOffset(0, 240),
		Size = UDim2.new(1, 0, 1, -240),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = ACCENTS.Pets,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
	}, {
		create("UIGridLayout", {
			CellSize = UDim2.fromOffset(UIKit.gridCells(UIKit.bodySize(petsFrame).X, 4, 10, 8), 122),
			CellPadding = UDim2.fromOffset(10, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	}) :: ScrollingFrame
	list.Parent = petsBody

	local function cashNow(): number
		local stats = player:FindFirstChild("leaderstats")
		local cash = if stats then stats:FindFirstChild("Cash") else nil
		return if cash and cash:IsA("ValueBase") then tonumber((cash :: any).Value) or 0 else 0
	end

	renderPets = function()
		local roles = fetch(companionFunction, "State")
		local pets: { number } = if typeof(roles) == "table" and typeof(roles.Pets) == "table" then roles.Pets else {}
		local owned = if typeof(roles) == "table" and typeof(roles.PetSlots) == "number" then roles.PetSlots else 1
		local guarding = if typeof(roles) == "table" then roles.Guard else nil
		-- Your brainrots, by pedestal.
		local mine: { [number]: Model } = {}
		for _, model in brainrotsFolder:GetChildren() do
			local slot = model:GetAttribute("Slot")
			if model:IsA("Model") and model:GetAttribute("OwnerUserId") == player.UserId and typeof(slot) == "number" then
				mine[slot] = model
			end
		end
		local function nameOf(model: Model?): string?
			local id = if model then model:GetAttribute("BrainrotId") else nil
			local definition = if typeof(id) == "string" then BrainrotConfig.ById[id] else nil
			return if definition then definition.DisplayName else nil
		end

		summary.Text = string.format("🐾 Pets following you: %d / %d", #pets, owned)
		speedLabel.Text = string.format("+%s walk speed", tostring(tonumber(player:GetAttribute("PetSpeed")) or 0))
		for index, tile in slotTiles do
			if index <= owned then
				local name = if pets[index] then nameOf(mine[pets[index]]) else nil
				tile.Text.Text = if name then "🐾 " .. name else "Empty"
				tile.Frame.BackgroundColor3 = if name then ACCENTS.Pets:Lerp(COLORS.PanelLight, 0.45) else COLORS.PanelLight
			else
				tile.Text.Text = "🔒\n" .. NumberFormat.cash(ExtrasConfig.PetSlotPrices[index])
				tile.Frame.BackgroundColor3 = COLORS.PanelDark
			end
		end
		local price = ExtrasConfig.PetSlotPrices[owned + 1]
		if price then
			buyButton.Text = string.format("Unlock pet slot %d: %s", owned + 1, NumberFormat.cash(price))
			UIKit.setEnabled(buyButton, cashNow() >= price, COLORS.Buy)
		else
			buyButton.Text = "Every pet slot unlocked!"
			UIKit.setEnabled(buyButton, false, COLORS.Buy)
		end

		for _, child in list:GetChildren() do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		local order: { number } = {}
		for slot in mine do
			table.insert(order, slot)
		end
		table.sort(order)
		for position, slot in order do
			local model = mine[slot]
			local id = model:GetAttribute("BrainrotId")
			local definition = if typeof(id) == "string" then BrainrotConfig.ById[id] else nil
			if definition == nil or BrainrotConfig.isLuckyBlock(definition) then
				continue
			end
			local rarity = BrainrotConfig.RarityByName[definition.Rarity]
			local mutation = model:GetAttribute("Mutation")
			local following = table.find(pets, slot) ~= nil
			local card = create("Frame", {
				Name = "Slot" .. slot,
				BackgroundColor3 = COLORS.PanelLight,
				LayoutOrder = position,
			}, { corner(12), stroke(if rarity then rarity.Color else COLORS.Outline, 2) }) :: Frame
			label({
				Name = "BrainrotName",
				Position = UDim2.fromOffset(6, 6),
				Size = UDim2.new(1, -12, 0, 26),
				Text = (if typeof(mutation) == "string" then mutation .. " " else "") .. definition.DisplayName,
				TextSize = 20,
			}).Parent = card
			label({
				Name = "Info",
				Position = UDim2.fromOffset(6, 34),
				Size = UDim2.new(1, -12, 0, 22),
				Text = string.format("%s   +%s speed", definition.Rarity, tostring(ExtrasConfig.PetSpeedBonus[definition.Rarity] or 1)),
				TextColor3 = if rarity then rarity.Color else COLORS.Muted,
				TextSize = 17,
			}).Parent = card
			local isGuard = slot == guarding
			local action = button(if following then "Stop following" elseif isGuard then "🛡️ Guarding" else "🐾 Follow", if following then COLORS.Close else ACCENTS.Pets, {
				Name = "Action",
				Position = UDim2.new(0, 8, 1, -52),
				Size = UDim2.new(1, -16, 0, 44),
			})
			if isGuard then
				UIKit.setEnabled(action, false, ACCENTS.Pets)
			end
			action.Activated:Connect(function()
				if not isGuard then
					ask(companionFunction, if following then "Unpet" else "Pet", slot)
					renderPets()
				end
			end)
			action.Parent = card
			card.Parent = list
		end
	end
end

petsButton.Activated:Connect(function()
	if UIKit.toggleModal(petsFrame) then
		renderPets()
	end
end)
for _, attribute in { "PetBaseSlots", "PetCapacity" } do
	player:GetAttributeChangedSignal(attribute):Connect(function()
		if petsFrame.Visible then
			renderPets()
		end
	end)
end

--------------------------------------------------------------------------------
-- The Limited Shop: this week's limited brainrot
--------------------------------------------------------------------------------

-- This week's limited and how long it has left, as the server tells it.
local function weeklyLimited(): (ExtrasConfig.Limited, number)
	local id = ReplicatedStorage:GetAttribute("LimitedId")
	local endsAt = ReplicatedStorage:GetAttribute("LimitedEndsAt")
	for _, limited in ExtrasConfig.LimitedRotation do
		if limited.Id == id and typeof(endsAt) == "number" then
			return limited, endsAt - Workspace:GetServerTimeNow()
		end
	end
	local limited, localEndsAt = ExtrasConfig.currentLimited(os.time())
	return limited, localEndsAt - os.time()
end

local limitedFrame, limitedBody = UIKit.modal(screen, "LimitedMenu", "⭐ LIMITED ⭐", ACCENTS.Limited, Vector2.new(560, 560))
local refreshLimited: () -> ()
do
	local preview = create("Frame", {
		Name = "Preview",
		Size = UDim2.new(0.45, 0, 0.55, 0),
		BackgroundColor3 = COLORS.PanelDark,
	}, { corner(12), stroke(ACCENTS.Limited, 3) }) :: Frame
	preview.Parent = limitedBody
	local function line(name: string, y: number, height: number, colour: Color3, size: number): TextLabel
		local text = label({
			Name = name,
			Position = UDim2.new(0.48, 0, y, 0),
			Size = UDim2.new(0.52, 0, height, 0),
			Text = "",
			TextColor3 = colour,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextSize = size,
		})
		text.Parent = limitedBody
		return text
	end
	local nameLabel = line("BrainrotName", 0, 0.12, COLORS.Text, 30)
	local rarityLabel = line("Rarity", 0.12, 0.08, COLORS.Muted, 24)
	local incomeLabel = line("Income", 0.2, 0.08, COLORS.Income, 24)
	local endsLabel = line("EndsIn", 0.3, 0.08, Color3.fromRGB(255, 120, 120), 22)
	local nextLabel = line("NextWeek", 0.4, 0.1, COLORS.Muted, 18)
	label({
		Name = "About",
		Position = UDim2.new(0, 0, 0.58, 0),
		Size = UDim2.new(1, 0, 0.16, 0),
		Text = "A famous Roblox limited, as a brainrot! Sold this week only, then it's gone until it comes back round. It never shows up on the conveyor.",
		TextSize = 18,
		TextWrapped = true,
		TextColor3 = COLORS.Muted,
	}).Parent = limitedBody
	local buy = button("Buy", ACCENTS.Limited, { Name = "BuyLimited", Position = UDim2.new(0.2, 0, 0.78, 0), Size = UDim2.new(0.6, 0, 0.14, 0) })
	buy.Parent = limitedBody
	local current: ExtrasConfig.Limited? = nil
	buy.Activated:Connect(function()
		if current then
			promptProduct(current.Product)
		end
	end)

	local shown: string? = nil
	refreshLimited = function()
		local limited, secondsLeft = weeklyLimited()
		current = limited
		local definition = BrainrotConfig.ById[limited.Id]
		if definition == nil then
			return
		end
		local rarity = BrainrotConfig.RarityByName[definition.Rarity]
		nameLabel.Text = definition.DisplayName
		rarityLabel.Text = definition.Rarity
		rarityLabel.TextColor3 = if rarity then rarity.Color else COLORS.Muted
		incomeLabel.Text = NumberFormat.cash(definition.IncomePerSecond) .. "/s"
		endsLabel.Text = "Ends in " .. duration(secondsLeft)
		local rotation = ExtrasConfig.LimitedRotation
		local following = rotation[(table.find(rotation, limited) or 0) % #rotation + 1]
		local nextDefinition = BrainrotConfig.ById[following.Id]
		nextLabel.Text = if nextDefinition then "Next week: " .. nextDefinition.DisplayName else ""
		buy.Text = string.format("Buy for R$ %d", limited.Robux)
		if shown ~= limited.Id then
			shown = limited.Id
			for _, child in preview:GetChildren() do
				if child:IsA("ViewportFrame") then
					child:Destroy()
				end
			end
			UIKit.brainrotViewport(limited.Id, if rarity then rarity.Color:Lerp(Color3.new(0, 0, 0), 0.55) else COLORS.PanelDark, {
				Size = UDim2.fromScale(1, 1),
			}).Parent = preview
		end
	end
end

-- The stall on the map: the brainrot turns on its display, with a sign.
do
	local shop = map:WaitForChild("LimitedShop", 30)
	local display = if shop then shop:FindFirstChild("LimitedDisplay") else nil
	local infoAnchor = if shop then shop:FindFirstChild("LimitedInfoAnchor") else nil
	local sign: TextLabel? = nil
	if infoAnchor and infoAnchor:IsA("BasePart") then
		local billboard = create("BillboardGui", {
			Name = "LimitedInfo",
			Adornee = infoAnchor,
			Size = UDim2.fromScale(14, 4.2),
			LightInfluence = 0,
			MaxDistance = 160,
		}) :: BillboardGui
		local text = label({ Size = UDim2.fromScale(1, 1), Text = "", TextSize = 40, TextColor3 = ACCENTS.Limited })
		text.RichText = true
		text.Parent = billboard
		billboard.Parent = infoAnchor
		sign = text
	end
	local displayModel: Model? = nil
	local displayId: string? = nil
	task.spawn(function()
		while true do
			local limited, secondsLeft = weeklyLimited()
			local definition = BrainrotConfig.ById[limited.Id]
			if sign and definition then
				sign.Text = string.format(
					'⭐ THIS WEEK ONLY ⭐\n<font color="#ffffff">%s</font>\nR$ %d · ends in %s',
					definition.DisplayName,
					limited.Robux,
					duration(secondsLeft)
				)
			end
			if display and display:IsA("BasePart") and displayId ~= limited.Id then
				displayId = limited.Id
				if displayModel then
					displayModel:Destroy()
				end
				local model = UIKit.previewModel(limited.Id, 5)
				if model then
					for _, part in model:GetDescendants() do
						if part:IsA("BasePart") then
							part.Anchored = true
							part.CanCollide = false
						end
					end
					model.Parent = Workspace
					displayModel = model
				end
			end
			if limitedFrame.Visible then
				refreshLimited()
			end
			task.wait(1)
		end
	end)
	-- It turns slowly on its display.
	RunService.RenderStepped:Connect(function()
		local model = displayModel
		if model and display and display:IsA("BasePart") then
			model:PivotTo(display.CFrame * CFrame.new(0, 2.5 + math.sin(os.clock() * 2) * 0.2, 0) * CFrame.Angles(0, os.clock() * 0.8, 0))
		end
	end)
end

ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, who: Player)
	if who == player and prompt.Name == "LimitedPrompt" then
		refreshLimited()
		UIKit.openModal(limitedFrame)
	end
end)

