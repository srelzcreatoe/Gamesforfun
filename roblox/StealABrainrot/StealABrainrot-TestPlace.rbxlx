    <Item class="Folder" referent="55">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">AssetLoader</string>
          <string name="Source"><![CDATA[--!strict
--[[
	AssetLoader (client)

	Rebuilds the blocky brainrot models (a body and its legs, so they can walk)
	and the icons that tools/build_assets.py packed into ReplicatedStorage.Assets,
	using EditableMesh and EditableImage. This avoids uploading any assets to a
	Roblox account first.

	Editable meshes and images only exist on the machine that creates them, so
	each client builds its own copy. Every function returns nil when the data or
	the Editable APIs aren't available, and callers keep their simple fallback.

	Speed: each brainrot's meshes are built once, a few milliseconds per frame
	so the game never freezes, and turned into template MeshParts. Every
	brainrot after that is a clone of the templates, which is instant.
	preloadBrainrot builds models in the background before they are needed;
	models someone is waiting for go first.
]]

local AssetService = game:GetService("AssetService")
local EncodingService = game:GetService("EncodingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MESH_FORMAT = 3
local ICON_FORMAT = 1
local QUAD_BYTES = 7
-- CreateMeshPartAsync calls running at once, and tries per mesh part.
local MAX_CONCURRENT_PARTS = 4
local PART_ATTEMPTS = 4
-- Building meshes stops for the next frame after this long.
local BUILD_SLICE_SECONDS = 0.004
-- A model that failed to build is tried again after this long.
local RETRY_SECONDS = 20

-- One mesh of a brainrot: its body or one leg. Sizes and positions are for a
-- model 1 stud tall, relative to the model's centre.
export type Piece = {
	Kind: string,
	Mesh: EditableMesh,
	ColorIds: { number },
	Size: Vector3,
	Offset: Vector3,
	-- Legs swing about their hip; legs with different phases step in turn.
	Pivot: Vector3,
	Phase: number,
}

export type BrainrotAsset = {
	Pieces: { Piece },
	-- One MeshPart per piece; brainrots are clones of these.
	Templates: { MeshPart },
	-- Bounding box of the whole model when it is 1 stud tall.
	Size: Vector3,
	HasLegs: boolean,
	-- Untinted palette colours (for Rainbow).
	BaseColors: { Color3 },
}

-- A MeshPart built for one piece, `height` studs tall overall.
export type BuiltPiece = {
	Part: MeshPart,
	Piece: Piece,
	-- Rest position relative to the model's centre, in studs.
	Offset: Vector3,
	Pivot: Vector3,
}

local AssetLoader = {}

local brainrotCache: { [string]: BrainrotAsset } = {}
local iconCache: { [string]: EditableImage } = {}
-- Names that were already tried and failed, so they aren't rebuilt every
-- time: brainrots until a retry time, icons for good.
local failed: { [string]: boolean } = {}
local brainrotRetryAt: { [string]: number } = {}
-- Brainrot models being built right now.
local building: { [string]: boolean } = {}
-- Only one model is built at a time; requests someone is waiting for go
-- before background preloading.
local buildBusy = false
local urgentWaiting = 0
local sliceStart = os.clock()
local warnings = 0
local partsInFlight = 0

local function warnLimited(message: string)
	-- A few warnings help find the cause; after that they'd only spam Output.
	if warnings < 5 then
		warnings += 1
		warn("[AssetLoader] " .. message .. " Falling back to simple figures and icons where needed.")
	end
end

local function getModule(folderName: string, name: string): ModuleScript?
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local folder = if assets then assets:FindFirstChild(folderName) else nil
	local module = if folder then folder:FindFirstChild(name) else nil
	if module and module:IsA("ModuleScript") then
		return module
	end
	return nil
end

local function decode(encoded: string): buffer
	local compressed = EncodingService:Base64Decode(buffer.fromstring(encoded))
	return EncodingService:DecompressBuffer(compressed, Enum.CompressionAlgorithm.Zstd)
end

--------------------------------------------------------------------------------
-- Mutation colours
--------------------------------------------------------------------------------

local function luminance(colour: Color3): number
	return 0.299 * colour.R + 0.587 * colour.G + 0.114 * colour.B
end

local TINTS: { [string]: { Dark: Color3, Light: Color3 } } = {
	Gold = { Dark = Color3.fromRGB(150, 90, 10), Light = Color3.fromRGB(255, 232, 120) },
	Diamond = { Dark = Color3.fromRGB(30, 120, 220), Light = Color3.fromRGB(215, 250, 255) },
	Bloodrot = { Dark = Color3.fromRGB(70, 0, 10), Light = Color3.fromRGB(255, 80, 90) },
	Galaxy = { Dark = Color3.fromRGB(35, 10, 90), Light = Color3.fromRGB(230, 150, 255) },
	Lava = { Dark = Color3.fromRGB(90, 20, 10), Light = Color3.fromRGB(255, 190, 60) },
	Frozen = { Dark = Color3.fromRGB(70, 150, 220), Light = Color3.fromRGB(235, 250, 255) },
}

-- Recolours a palette entry for a mutation, keeping a little of the original.
local function tint(colour: Color3, mutation: string?): Color3
	local ramp = if mutation then TINTS[mutation] else nil
	if ramp == nil then
		return colour
	end
	local shade = ramp.Dark:Lerp(ramp.Light, math.clamp(luminance(colour) * 1.2, 0, 1))
	return shade:Lerp(colour, 0.15)
end

-- Colour of a Rainbow palette entry at time `t`.
function AssetLoader.rainbowColor(base: Color3, index: number, t: number): Color3
	local _, saturation, value = base:ToHSV()
	local hue = (t * 0.25 + index * 0.03) % 1
	return Color3.fromHSV(hue, math.max(saturation, 0.65), math.max(value, 0.8))
end

--------------------------------------------------------------------------------
-- Blocky meshes
--------------------------------------------------------------------------------

type Quad = {
	Axis: number,
	Positive: number,
	Plane: number,
	U0: number,
	V0: number,
	U1: number,
	V1: number,
	Colour: number,
}

local function readQuads(encoded: string, quadCount: number): { Quad }
	local data = decode(encoded)
	if buffer.len(data) ~= quadCount * QUAD_BYTES then
		error("quad data does not match its header")
	end
	local quads: { Quad } = table.create(quadCount)
	for quad = 0, quadCount - 1 do
		local offset = quad * QUAD_BYTES
		local axisDirection = buffer.readu8(data, offset)
		local positive = axisDirection % 2
		local u0 = buffer.readu8(data, offset + 2)
		local v0 = buffer.readu8(data, offset + 3)
		quads[quad + 1] = {
			Axis = axisDirection // 2,
			Positive = positive,
			Plane = buffer.readu8(data, offset + 1) + positive,
			U0 = u0,
			V0 = v0,
			U1 = u0 + buffer.readu8(data, offset + 4),
			V1 = v0 + buffer.readu8(data, offset + 5),
			Colour = buffer.readu8(data, offset + 6),
		}
	end
	return quads
end

-- Corner of a quad in block units.
local function cornerOf(axis: number, plane: number, u: number, v: number): Vector3
	local corner = { 0, 0, 0 }
	corner[axis + 1] = plane
	corner[(axis + 1) % 3 + 1] = u
	corner[(axis + 2) % 3 + 1] = v
	return Vector3.new(corner[1], corner[2], corner[3])
end

local function quadBounds(quads: { Quad }): (Vector3, Vector3)
	local low = Vector3.new(math.huge, math.huge, math.huge)
	local high = -low
	for _, quad in quads do
		local a = cornerOf(quad.Axis, quad.Plane, quad.U0, quad.V0)
		local b = cornerOf(quad.Axis, quad.Plane, quad.U1, quad.V1)
		low = low:Min(a):Min(b)
		high = high:Max(a):Max(b)
	end
	return low, high
end

-- Builds one piece's mesh with its vertices centred on the piece, so the
-- MeshPart's origin is the middle of the piece.
local function buildMesh(quads: { Quad }, centre: Vector3, scale: number, colours: { Color3 }): (EditableMesh, { number })
	local mesh = AssetService:CreateEditableMesh()
	if mesh == nil then
		error("the editable memory budget is exhausted")
	end

	local colorIds: { number } = {}
	for index, colour in colours do
		colorIds[index] = mesh:AddColor(colour, 1)
	end

	-- One flat normal per face direction: axis * 2 + positive.
	local normalIds: { number } = {}
	for axis = 0, 2 do
		for positive = 0, 1 do
			local direction = if positive == 1 then 1 else -1
			local normal = if axis == 0
				then Vector3.new(direction, 0, 0)
				elseif axis == 1 then Vector3.new(0, direction, 0)
				else Vector3.new(0, 0, direction)
			normalIds[axis * 2 + positive + 1] = mesh:AddNormal(normal)
		end
	end

	-- Corners are shared between quads; normals and colours are per face.
	local vertexIds: { [number]: number } = {}
	local function vertex(corner: Vector3): number
		local key = (corner.X * 256 + corner.Y) * 256 + corner.Z
		local id = vertexIds[key]
		if id == nil then
			id = mesh:AddVertex((corner - centre) * scale)
			vertexIds[key] = id
		end
		return id
	end

	for index, quad in quads do
		if index % 64 == 0 and os.clock() - sliceStart > BUILD_SLICE_SECONDS then
			task.wait()
			sliceStart = os.clock()
		end
		local axis, plane = quad.Axis, quad.Plane
		-- Counter-clockwise seen from outside the block.
		local a = vertex(cornerOf(axis, plane, quad.U0, quad.V0))
		local b = vertex(cornerOf(axis, plane, quad.U1, quad.V0))
		local c = vertex(cornerOf(axis, plane, quad.U1, quad.V1))
		local d = vertex(cornerOf(axis, plane, quad.U0, quad.V1))
		if quad.Positive == 0 then
			a, b, c, d = d, c, b, a
		end
		local normalId = normalIds[axis * 2 + quad.Positive + 1]
		local colorId = colorIds[quad.Colour + 1]
		for _, face in { mesh:AddTriangle(a, b, c), mesh:AddTriangle(a, c, d) } do
			mesh:SetFaceNormals(face, { normalId, normalId, normalId })
			mesh:SetFaceColors(face, { colorId, colorId, colorId })
		end
	end
	return mesh, colorIds
end

local function createBlockyAsset(data: { [string]: any }, mutation: string?): BrainrotAsset
	local baseColors: { Color3 } = {}
	local tinted: { Color3 } = {}
	for index, hex in data.Palette do
		local base = Color3.fromRGB(bit32.rshift(hex, 16), bit32.band(bit32.rshift(hex, 8), 255), bit32.band(hex, 255))
		baseColors[index] = base
		tinted[index] = tint(base, mutation)
	end

	local partData: { { [string]: any } } = data.Parts
	local partQuads: { { Quad } } = {}
	local low = Vector3.new(math.huge, math.huge, math.huge)
	local high = -low
	for index, part in partData do
		local quads = readQuads(part.Quads, part.QuadCount)
		partQuads[index] = quads
		local partLow, partHigh = quadBounds(quads)
		low = low:Min(partLow)
		high = high:Max(partHigh)
	end
	local modelSize = high - low
	if modelSize.Y <= 0 then
		error("the model is empty")
	end
	local modelCentre = (low + high) / 2
	local scale = 1 / modelSize.Y

	local pieces: { Piece } = {}
	local created: { EditableMesh } = {}
	local ok, err = pcall(function()
		for index, part in partData do
			local partLow, partHigh = quadBounds(partQuads[index])
			local centre = (partLow + partHigh) / 2
			local mesh, colorIds = buildMesh(partQuads[index], centre, scale, tinted)
			table.insert(created, mesh)
			local pivot = part.Pivot
			table.insert(pieces, {
				Kind = if part.Kind == "Leg" then "Leg" else "Body",
				Mesh = mesh,
				ColorIds = colorIds,
				Size = (partHigh - partLow) * scale,
				Offset = (centre - modelCentre) * scale,
				Pivot = if typeof(pivot) == "table"
					then (Vector3.new(pivot[1], pivot[2], pivot[3]) - modelCentre) * scale
					else Vector3.zero,
				Phase = if part.Phase == 1 then 1 else 0,
			})
		end
	end)
	if not ok then
		for _, mesh in created do
			mesh:Destroy()
		end
		error(err, 0)
	end

	local hasLegs = false
	for _, piece in pieces do
		hasLegs = hasLegs or piece.Kind == "Leg"
	end
	return {
		Pieces = pieces,
		Templates = {},
		Size = modelSize * scale,
		HasLegs = hasLegs,
		BaseColors = baseColors,
	}
end

-- CreateMeshPartAsync can fail when many parts are made at once (for example
-- when a player joins a full server), so only a few run at a time and each is
-- retried with a growing delay.
local function createMeshPart(mesh: EditableMesh): MeshPart
	local lastError: any = nil
	for attempt = 1, PART_ATTEMPTS do
		while partsInFlight >= MAX_CONCURRENT_PARTS do
			task.wait()
		end
		partsInFlight += 1
		local ok, result = pcall(function(): MeshPart
			return AssetService:CreateMeshPartAsync(Content.fromObject(mesh), {
				CollisionFidelity = Enum.CollisionFidelity.Box,
			})
		end)
		partsInFlight -= 1
		if ok then
			return result
		end
		lastError = result
		if attempt < PART_ATTEMPTS then
			task.wait(0.5 * 2 ^ (attempt - 1))
		end
	end
	error(lastError, 0)
end

local function acquireBuild(urgent: boolean)
	if urgent then
		urgentWaiting += 1
	end
	while buildBusy or (not urgent and urgentWaiting > 0) do
		task.wait()
	end
	if urgent then
		urgentWaiting -= 1
	end
	buildBusy = true
	sliceStart = os.clock()
end

local function releaseBuild()
	buildBusy = false
end

local function buildAsset(brainrotId: string, mutation: string?): BrainrotAsset
	local module = getModule("Brainrots", brainrotId)
	if module == nil then
		error("no model data")
	end
	local data = require(module) :: any
	if data.Format ~= MESH_FORMAT then
		error("unsupported data format " .. tostring(data.Format))
	end
	local asset = createBlockyAsset(data, mutation)
	local ok, err = pcall(function()
		for _, piece in asset.Pieces do
			local template = createMeshPart(piece.Mesh)
			-- White so the vertex colours show unchanged.
			template.Color = Color3.new(1, 1, 1)
			template.Material = Enum.Material.SmoothPlastic
			template.Name = if piece.Kind == "Leg" then "Leg" else "Body"
			table.insert(asset.Templates, template)
		end
	end)
	if not ok then
		for _, template in asset.Templates do
			template:Destroy()
		end
		for _, piece in asset.Pieces do
			piece.Mesh:Destroy()
		end
		error(err, 0)
	end
	return asset
end

-- Returns a brainrot's shared meshes and template parts for a mutation,
-- building them on first use. Yields while building. `urgent` is for a model
-- someone is waiting to see; background preloading passes false.
function AssetLoader.getBrainrot(brainrotId: string, mutation: string?, urgent: boolean?): BrainrotAsset?
	local key = brainrotId .. "|" .. (mutation or "")
	while building[key] do
		task.wait()
	end
	local cached = brainrotCache[key]
	if cached then
		return cached
	end
	if os.clock() < (brainrotRetryAt[key] or 0) then
		return nil
	end

	building[key] = true
	acquireBuild(urgent ~= false)
	local ok, result = pcall(buildAsset, brainrotId, mutation)
	releaseBuild()
	building[key] = nil
	if not ok then
		brainrotRetryAt[key] = os.clock() + RETRY_SECONDS
		warnLimited(string.format("Could not build the %s model (%s).", brainrotId, tostring(result)))
		return nil
	end
	brainrotRetryAt[key] = nil
	brainrotCache[key] = result
	return result
end

-- Builds a brainrot's plain model in the background, so it shows instantly
-- when it's needed. Yields.
function AssetLoader.preloadBrainrot(brainrotId: string)
	AssetLoader.getBrainrot(brainrotId, nil, false)
end

function AssetLoader.isLoaded(brainrotId: string, mutation: string?): boolean
	return brainrotCache[brainrotId .. "|" .. (mutation or "")] ~= nil
end

-- A copy of a template part. Clones share the template's EditableMesh; if
-- this device doesn't carry the mesh over, a new part is made from it.
local function copyTemplate(template: MeshPart, mesh: EditableMesh): MeshPart
	local ok, clone = pcall(function(): MeshPart?
		local copy = template:Clone()
		local content = (copy :: any).MeshContent
		if content == nil or content.Object == nil then
			copy:Destroy()
			return nil
		end
		return copy
	end)
	if ok and clone then
		return clone
	end
	local part = createMeshPart(mesh)
	part.Color = template.Color
	part.Material = template.Material
	part.Name = template.Name
	return part
end

-- Creates the brainrot's MeshParts (body and legs), `height` studs tall,
-- unparented and unpositioned. Yields until the model is built (instant once
-- it is). Returns nil if it can't be built.
function AssetLoader.createBrainrotParts(brainrotId: string, mutation: string?, height: number): ({ BuiltPiece }?, BrainrotAsset?)
	local asset = AssetLoader.getBrainrot(brainrotId, mutation, true)
	if asset == nil then
		return nil, nil
	end
	local built: { BuiltPiece } = {}
	local ok, err = pcall(function()
		for index, piece in asset.Pieces do
			local part = copyTemplate(asset.Templates[index], piece.Mesh)
			part.Size = piece.Size * height
			table.insert(built, {
				Part = part,
				Piece = piece,
				Offset = piece.Offset * height,
				Pivot = piece.Pivot * height,
			})
		end
	end)
	if not ok then
		for _, entry in built do
			entry.Part:Destroy()
		end
		warnLimited(string.format("Could not create the %s mesh parts (%s).", brainrotId, tostring(err)))
		return nil, nil
	end
	return built, asset
end

-- An anchored Model of the brainrot standing still, centred on its pivot, for
-- previews. Yields.
function AssetLoader.createBrainrotModel(brainrotId: string, mutation: string?, height: number): Model?
	local built = AssetLoader.createBrainrotParts(brainrotId, mutation, height)
	if built == nil then
		return nil
	end
	local model = Instance.new("Model")
	model.Name = brainrotId
	for _, entry in built do
		entry.Part.Anchored = true
		entry.Part.CFrame = CFrame.new(entry.Offset)
		entry.Part.Parent = model
		if entry.Piece.Kind == "Body" then
			model.PrimaryPart = entry.Part
		end
	end
	model.WorldPivot = CFrame.identity
	return model
end

-- Recolours a Rainbow brainrot; every MeshPart that shares it updates at once.
function AssetLoader.animateRainbow(asset: BrainrotAsset, t: number)
	for _, piece in asset.Pieces do
		for index, colorId in piece.ColorIds do
			piece.Mesh:SetColor(colorId, AssetLoader.rainbowColor(asset.BaseColors[index], index, t))
		end
	end
end

--------------------------------------------------------------------------------
-- Icons
--------------------------------------------------------------------------------

local function getIcon(folderName: string, name: string): EditableImage?
	local key = folderName .. "/" .. name
	local cached = iconCache[key]
	if cached or failed["Icon:" .. key] then
		return cached
	end
	failed["Icon:" .. key] = true

	local module = getModule(folderName, name)
	if module == nil then
		return nil
	end
	local ok, result = pcall(function(): EditableImage
		local data = require(module) :: any
		if data.Format ~= ICON_FORMAT then
			error("unsupported data format " .. tostring(data.Format))
		end
		local size: number = data.Size
		local pixels = decode(data.Pixels)
		if buffer.len(pixels) ~= size * size * 4 then
			error("pixel data does not match the image size")
		end
		local image = AssetService:CreateEditableImage({ Size = Vector2.new(size, size) })
		if image == nil then
			error("the editable memory budget is exhausted")
		end
		image:WritePixelsBuffer(Vector2.zero, Vector2.new(size, size), pixels)
		return image
	end)
	if not ok then
		warnLimited(string.format("Could not build the %s icon (%s).", key, tostring(result)))
		return nil
	end
	failed["Icon:" .. key] = nil
	iconCache[key] = result
	return result
end

-- Developer product icon, such as "SmallCashBundle".
function AssetLoader.getProductIcon(key: string): EditableImage?
	return getIcon("ProductIcons", key)
end

-- HUD button icon: "Shop", "Rebirth" or "Index".
function AssetLoader.getUIIcon(name: string): EditableImage?
	return getIcon("UIIcons", name)
end

return table.freeze(AssetLoader)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">AudioConfig</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Music and sound effects. Every ID is audio from Roblox's Creator Store that
	any experience may play: Roblox's own UI and game sounds, and licensed
	production music (APM). To use your own, upload it in the Creator Dashboard
	and put its ID here. If a sound fails to load on a player's device, a
	built-in Roblox sound plays instead; music is simply skipped.
]]

export type SoundInfo = {
	Id: number,
	Volume: number,
}

local function sound(id: number, volume: number): SoundInfo
	return table.freeze({ Id = id, Volume = volume })
end

local AudioConfig: {
	Music: { number },
	MusicVolume: number,
	FallbackSound: string,
	Sounds: { [string]: SoundInfo },
	RainSound: SoundInfo,
} = {
	-- Played in order, looping.
	Music = table.freeze({
		1847524834, -- Happy And Quirky A (APM)
		9047837288, -- Playful Promenade (APM)
		9047843332, -- The Jazzy Pizzman (APM)
		140228184971194, -- Game Lobby Alternate (APM)
	}),
	MusicVolume = 0.22,
	FallbackSound = "rbxasset://sounds/electronicpingshort.wav",

	Sounds = table.freeze({
		-- Interface
		Click = sound(17208396156, 0.5), -- Roblox GUI - Select
		Open = sound(17208405682, 0.45), -- Roblox GUI - Swipe
		Error = sound(17208353912, 0.6), -- Roblox GUI - Negative
		Notify = sound(17208361335, 0.5), -- Roblox GUI - Notification High
		-- Money
		Purchase = sound(10066947742, 0.7), -- RBLX UI Purchase
		Collect = sound(127645268874265, 0.6), -- CoinTransfer_01
		Sell = sound(127645268874265, 0.6),
		OfflineCash = sound(16480575861, 0.7), -- Pinball Big Metal Tally
		Rebirth = sound(17208327798, 0.8), -- Roblox GUI - Aura
		-- Stealing
		Grab = sound(17208319162, 0.7), -- Roblox GUI - Pickup
		Alarm = sound(16480578169, 0.8), -- Pinball 8-bit Riser
		StealSuccess = sound(12222253, 0.7), -- victory.wav
		Stolen = sound(17208372272, 0.7), -- Roblox GUI - Notification Low
		Returned = sound(15675055424, 0.6), -- Roblox UI Cute Pop
		Sniped = sound(17208353912, 0.7),
		-- Base
		Lock = sound(16480560857, 0.7), -- Pinball Giant Button Press
		Zap = sound(16480558943, 0.8), -- Pinball Joystick Buzz
		-- Gear and events
		Slap = sound(12222046, 0.8), -- hit.wav
		Swing = sound(12222200, 0.6), -- swoosh.wav
		Cloak = sound(15675024286, 0.6), -- Roblox UI Whoosh 01
		Event = sound(15675043410, 0.8), -- Roblox UI Tonal Stinger
		-- Troll items
		Freeze = sound(12222005, 0.7), -- glassbreak.wav
		Place = sound(12222124, 0.6), -- Short spring sound.wav
		Ouch = sound(12222058, 0.8), -- Kid saying Ouch.wav
		Launch = sound(12222084, 0.7), -- Rocket shot.wav
		Boogie = sound(1839931391, 0.6), -- Pizza Dance (APM)
		-- Weather
		Thunder = sound(12222030, 0.7), -- HalloweenThunder.wav
		Lightning = sound(12222019, 0.5), -- HalloweenLightning.wav
	}),
	-- Looped while it rains.
	RainSound = sound(1516791621, 0.35), -- Rain Effect
}

return table.freeze(AudioConfig)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">BrainrotConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Every brainrot that can appear on the conveyor, the rarity tiers and the
-- mutations.
-- Each brainrot's blocky 3D model (made with Higgsfield) is packed in
-- ReplicatedStorage.Assets.Brainrots and shown by the BrainrotVisuals client
-- script; the server's simple block figure is the fallback. To use a model you
-- imported in Studio instead (for example one made on Customuse), put a Model
-- named after the brainrot's Id in ReplicatedStorage.BrainrotModels; it is
-- scaled to the brainrot's height.

export type BodyShape = "Ball" | "Block"

-- How a brainrot moves: Walk swings its legs, Fly hovers and banks, Drive
-- bounces along, Spin pirouettes and Hop jumps.
export type Motion = "Walk" | "Fly" | "Drive" | "Spin" | "Hop"

export type Rarity = {
	Name: string,
	Color: Color3,
	-- Relative spawn chance on the conveyor.
	Weight: number,
	Glow: boolean,
	-- Billboard text style: "Plain", "Rainbow" or "Secret".
	Style: string,
}

export type Mutation = {
	Name: string,
	-- Chance for a conveyor brainrot to spawn with this mutation. Event-only
	-- mutations have 0 and only appear during their event.
	Chance: number,
	-- Multiplies both income and price.
	Multiplier: number,
	Color: Color3,
}

export type Brainrot = {
	Id: string,
	DisplayName: string,
	Rarity: string,
	Price: number,
	IncomePerSecond: number,
	BodyShape: BodyShape,
	BodyColor: Color3,
	AccentColor: Color3,
	Scale: number,
	Motion: Motion,
	Tags: { string },
}

local rgb = Color3.fromRGB

local Rarities: { Rarity } = {
	{ Name = "Common", Color = rgb(210, 210, 210), Weight = 55, Glow = false, Style = "Plain" },
	{ Name = "Rare", Color = rgb(70, 150, 255), Weight = 26, Glow = false, Style = "Plain" },
	{ Name = "Epic", Color = rgb(175, 90, 255), Weight = 12, Glow = false, Style = "Plain" },
	{ Name = "Legendary", Color = rgb(255, 190, 40), Weight = 4.5, Glow = true, Style = "Plain" },
	{ Name = "Mythic", Color = rgb(255, 60, 90), Weight = 1.8, Glow = true, Style = "Plain" },
	{ Name = "Brainrot God", Color = rgb(255, 120, 255), Weight = 0.5, Glow = true, Style = "Rainbow" },
	{ Name = "Secret", Color = rgb(20, 20, 20), Weight = 0.12, Glow = true, Style = "Secret" },
}

local function brainrot(
	id: string,
	displayName: string,
	rarity: string,
	price: number,
	incomePerSecond: number,
	bodyColor: Color3,
	accentColor: Color3,
	scale: number,
	motion: Motion?,
	tags: { string }?
): Brainrot
	return table.freeze({
		Id = id,
		DisplayName = displayName,
		Rarity = rarity,
		Price = price,
		IncomePerSecond = incomePerSecond,
		BodyShape = "Block" :: BodyShape,
		BodyColor = bodyColor,
		AccentColor = accentColor,
		Scale = scale,
		Motion = (motion or "Walk") :: Motion,
		Tags = table.freeze(table.clone(tags or {})),
	})
end

local TACO = { "Taco" }

local Brainrots: { Brainrot } = {
	-- Common
	brainrot("NoobiniPizzanini", "Noobini Pizzanini", "Common", 25, 1, rgb(255, 200, 90), rgb(200, 50, 40), 0.9),
	brainrot("LiriliLarila", "Lirili Larila", "Common", 60, 2, rgb(90, 170, 70), rgb(140, 90, 50), 0.95),
	brainrot("TimCheese", "Tim Cheese", "Common", 120, 3, rgb(255, 215, 60), rgb(130, 80, 40), 0.9),
	brainrot("Fluriflura", "Fluriflura", "Common", 200, 4, rgb(255, 110, 190), rgb(70, 170, 60), 0.9),
	brainrot("GufoTortillo", "Gufo Tortillo", "Common", 300, 5, rgb(150, 95, 50), rgb(255, 200, 40), 0.85),
	brainrot("CubettoBlu", "Cubetto Blu", "Common", 450, 7, rgb(40, 130, 230), rgb(200, 200, 205), 0.9),
	brainrot("MaialinoTaco", "Maialino Taco", "Common", 600, 8, rgb(255, 170, 190), rgb(240, 200, 60), 0.9, "Walk", TACO),
	-- Rare
	brainrot("TrippiTroppi", "Trippi Troppi", "Rare", 900, 12, rgb(150, 150, 160), rgb(255, 130, 50), 1),
	brainrot("TungTungTungSahur", "Tung Tung Tung Sahur", "Rare", 1400, 16, rgb(200, 130, 50), rgb(120, 70, 30), 1.1),
	brainrot("BonecaAmbalabu", "Boneca Ambalabu", "Rare", 2000, 22, rgb(90, 180, 60), rgb(40, 40, 40), 1),
	brainrot("PorcelliniTacolini", "Porcellini Tacolini", "Rare", 2800, 28, rgb(255, 170, 190), rgb(240, 200, 60), 0.95, "Walk", TACO),
	brainrot("MattoncinoCattivo", "Mattoncino Cattivo", "Rare", 3500, 34, rgb(130, 130, 135), rgb(255, 120, 30), 1.05),
	brainrot("BurritoHotspotito", "Burrito Hotspotito", "Rare", 4500, 40, rgb(230, 190, 120), rgb(30, 30, 30), 1, "Walk", TACO),
	-- Epic
	brainrot("BrrBrrPatapim", "Brr Brr Patapim", "Epic", 7000, 60, rgb(110, 170, 60), rgb(150, 100, 50), 1.15),
	brainrot("CappuccinoAssassino", "Cappuccino Assassino", "Epic", 9500, 75, rgb(235, 230, 220), rgb(30, 30, 30), 1.1),
	brainrot("BananitaDolphinita", "Bananita Dolphinita", "Epic", 12000, 90, rgb(130, 190, 240), rgb(250, 220, 60), 1.1),
	brainrot("PettirossoTacchino", "Pettirosso Tacchino", "Epic", 15000, 110, rgb(220, 40, 40), rgb(30, 30, 30), 1.05),
	brainrot("CapraAvocadra", "Capra Avocadra", "Epic", 20000, 140, rgb(140, 200, 60), rgb(120, 70, 30), 1.1),
	brainrot("ToroPalloncino", "Toro Palloncino", "Epic", 26000, 170, rgb(150, 80, 40), rgb(240, 230, 200), 1.1, "Hop"),
	-- Legendary
	brainrot("ChimpanziniBananini", "Chimpanzini Bananini", "Legendary", 40000, 240, rgb(250, 220, 60), rgb(110, 70, 40), 1.2),
	brainrot("BallerinaCappuccina", "Ballerina Cappuccina", "Legendary", 55000, 320, rgb(255, 170, 200), rgb(250, 240, 230), 1.25, "Spin"),
	brainrot("CapibaraTacoloco", "Capibara Tacoloco", "Legendary", 75000, 420, rgb(150, 100, 50), rgb(240, 200, 60), 1.1, "Walk", TACO),
	brainrot("Cioccolatone", "Cioccolatone", "Legendary", 100000, 550, rgb(110, 60, 30), rgb(255, 150, 190), 1.3),
	brainrot("PeperoncinoFigo", "Peperoncino Figo", "Legendary", 130000, 700, rgb(220, 30, 30), rgb(80, 200, 60), 1.3, "Walk", TACO),
	-- Mythic
	brainrot("BombardiroCrocodilo", "Bombardiro Crocodilo", "Mythic", 250000, 1200, rgb(80, 150, 60), rgb(150, 150, 160), 0.8, "Fly"),
	brainrot("TralaleroTralala", "Tralalero Tralala", "Mythic", 400000, 1800, rgb(40, 130, 230), rgb(250, 250, 250), 1.3),
	brainrot("CoccodrilloTacorito", "Coccodrillo Tacorito", "Mythic", 600000, 2600, rgb(230, 200, 140), rgb(60, 170, 60), 1.4, "Walk", TACO),
	brainrot("RattoSchiaffone", "Ratto Schiaffone", "Mythic", 850000, 3500, rgb(30, 30, 35), rgb(170, 60, 230), 1.4),
	-- Brainrot God
	brainrot("GattoPizzanave", "Gatto Pizzanave", "Brainrot God", 2000000, 8000, rgb(240, 170, 70), rgb(150, 150, 160), 1, "Fly"),
	brainrot("PiccioneMacchina", "Piccione Macchina", "Brainrot God", 3500000, 13000, rgb(140, 140, 150), rgb(60, 160, 120), 1.4, "Drive"),
	brainrot("TacoplanoBombardino", "Tacoplano Bombardino", "Brainrot God", 5000000, 18000, rgb(130, 130, 140), rgb(240, 200, 60), 0.75, "Fly", TACO),
	-- Secret
	brainrot("SpaghettiTualetti", "Spaghetti Tualetti", "Secret", 15000000, 50000, rgb(245, 245, 245), rgb(250, 210, 80), 1.5, "Hop"),
	brainrot("TacoritaBicicleta", "Tacorita Bicicleta", "Secret", 25000000, 75000, rgb(240, 200, 60), rgb(40, 110, 230), 1.4, "Drive", TACO),
	brainrot("SessantaSette", "67", "Secret", 67000000, 167000, rgb(40, 140, 240), rgb(250, 250, 250), 1.8),
}

local ById: { [string]: Brainrot } = {}
local ByRarity: { [string]: { Brainrot } } = {}
local RarityByName: { [string]: Rarity } = {}

for _, rarity in Rarities do
	RarityByName[rarity.Name] = rarity
	ByRarity[rarity.Name] = {}
end
for _, definition in Brainrots do
	ById[definition.Id] = definition
	table.insert(ByRarity[definition.Rarity], definition)
end

local Mutations: { Mutation } = {
	{ Name = "Gold", Chance = 0.06, Multiplier = 1.5, Color = rgb(255, 205, 50) },
	{ Name = "Diamond", Chance = 0.025, Multiplier = 2, Color = rgb(110, 225, 255) },
	{ Name = "Rainbow", Chance = 0.006, Multiplier = 5, Color = rgb(255, 110, 220) },
	-- Only during their events.
	{ Name = "Bloodrot", Chance = 0, Multiplier = 3, Color = rgb(200, 20, 40) },
	{ Name = "Galaxy", Chance = 0, Multiplier = 4, Color = rgb(150, 80, 255) },
	{ Name = "Lava", Chance = 0, Multiplier = 3.5, Color = rgb(255, 100, 20) },
	{ Name = "Frozen", Chance = 0, Multiplier = 2.5, Color = rgb(170, 230, 255) },
}

local MutationByName: { [string]: Mutation } = {}
for _, mutation in Mutations do
	MutationByName[mutation.Name] = mutation
end

-- Saved brainrots are "Id" or "Id:Mutation".
local function encode(brainrotId: string, mutationName: string?): string
	return if mutationName then brainrotId .. ":" .. mutationName else brainrotId
end

local function decode(entry: string): (Brainrot?, Mutation?)
	local brainrotId, mutationName = string.match(entry, "^(%w+):?(%w*)$")
	if brainrotId == nil then
		return nil, nil
	end
	local mutation = if mutationName and mutationName ~= "" then MutationByName[mutationName] else nil
	return ById[brainrotId], mutation
end

local function hasTag(definition: Brainrot, tag: string): boolean
	return table.find(definition.Tags, tag) ~= nil
end

return table.freeze({
	Mutations = table.freeze(Mutations),
	MutationByName = table.freeze(MutationByName),
	encode = encode,
	decode = decode,
	hasTag = hasTag,
	Rarities = table.freeze(Rarities),
	Brainrots = table.freeze(Brainrots),
	ById = table.freeze(ById),
	ByRarity = table.freeze(ByRarity),
	RarityByName = table.freeze(RarityByName),
})
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">GameConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Gameplay tuning shared by GameplayManager and the client HUD.

export type TagBoost = { Tag: string, Multiplier: number }

export type GameEvent = {
	Name: string,
	Mutation: string?,
	ChanceMultiplier: number?,
	MutationChance: number?,
	TagBoost: TagBoost?,
	Luck: number?,
	CashRain: boolean?,
	Sky: string?,
	Particles: string?,
}

local EVENTS: { GameEvent } = {
	table.freeze({ Name = "Gold Rush", Mutation = "Gold", ChanceMultiplier = 5, Sky = "Gold", Particles = "Sparkles" }),
	table.freeze({ Name = "Diamond Storm", Mutation = "Diamond", ChanceMultiplier = 6, Sky = "Diamond", Particles = "Crystals" }),
	table.freeze({ Name = "Rainbow Party", Mutation = "Rainbow", ChanceMultiplier = 10, Sky = "Rainbow", Particles = "Confetti" }),
	table.freeze({ Name = "Blood Moon", Mutation = "Bloodrot", MutationChance = 0.12, Sky = "Blood", Particles = "Embers" }),
	table.freeze({ Name = "Galaxy Night", Mutation = "Galaxy", MutationChance = 0.08, Sky = "Galaxy", Particles = "Stars" }),
	table.freeze({ Name = "Lava Rain", Mutation = "Lava", MutationChance = 0.1, Sky = "Lava", Particles = "Meteors" }),
	table.freeze({ Name = "Frost Storm", Mutation = "Frozen", MutationChance = 0.14, Sky = "Frost", Particles = "Snow" }),
	table.freeze({ Name = "Taco Tuesday", TagBoost = table.freeze({ Tag = "Taco", Multiplier = 8 }), Sky = "Taco", Particles = "Tacos" }),
	table.freeze({ Name = "Lucky Hour", Luck = 3, Sky = "Lucky", Particles = "Clovers" }),
	table.freeze({ Name = "Cash Rain", CashRain = true, Sky = "Cash", Particles = "Cash" }),
}

local GameConfig = {
	-- Conveyor
	ConveyorSpawnIntervalSeconds = 2.5,
	ConveyorSpeedStudsPerSecond = 10,
	MaxConveyorBrainrots = 24,
	-- A bought brainrot walks to its buyer's base this fast (studs per second).
	-- Until it walks through the door, other players can buy it off its buyer.
	BrainrotWalkSpeed = 8,
	-- Long walks speed up so none takes longer than this.
	MaxWalkSeconds = 25,

	-- Interaction
	PromptDistance = 10,
	-- Extra studs the server allows on top of PromptDistance for lag.
	InteractionTolerance = 6,
	StealHoldSeconds = 1.2,

	-- Stealing
	DefaultWalkSpeed = 16,
	CarryWalkSpeed = 11,
	CarryTimeoutSeconds = 90,
	-- Extra studs per check a thief may move before the steal counts as a teleport.
	CarrySpeedToleranceStuds = 8,
	CatchDistance = 6,

	-- Guaranteed spawns: when a timer runs out, the next conveyor brainrot is
	-- of that rarity. Listed from rarest; a natural spawn also resets its timer.
	GuaranteedRarities = table.freeze({
		table.freeze({ Rarity = "Secret", IntervalSeconds = 45 * 60 }),
		table.freeze({ Rarity = "Brainrot God", IntervalSeconds = 20 * 60 }),
		table.freeze({ Rarity = "Mythic", IntervalSeconds = 10 * 60 }),
		table.freeze({ Rarity = "Legendary", IntervalSeconds = 4 * 60 }),
	}),

	-- Bases: 8 pedestals on each of 4 floors. A floor opens at this many rebirths.
	SlotsPerFloor = 8,
	FloorUnlockRebirths = table.freeze({ 0, 1, 2, 3 }),

	-- Base lock
	LockDurationSeconds = 60,

	-- Collect pads and offline cash: brainrots fill the pad in front of them
	-- with Cash; stepping on the pad collects it. While you're away they keep
	-- earning this fraction of their income, for up to OfflineMaxHours.
	OfflineIncomeFraction = 1,
	OfflineMaxHours = 8,
	OfflineMinSeconds = 60,

	-- Events: every few minutes one runs for a few minutes. Each can make a
	-- mutation more common (ChanceMultiplier) or give an event-only mutation a
	-- chance (MutationChance), boost brainrots with a tag (TagBoost), make rare
	-- brainrots more common (Luck), or rain Cash (CashRain). Sky and Particles
	-- choose what players see.
	EventMinGapSeconds = 5 * 60,
	EventMaxGapSeconds = 8 * 60,
	EventDurationSeconds = 3 * 60,
	Events = table.freeze(EVENTS),
	-- Cash Rain: coins land around the map; each is worth this many seconds of
	-- the collector's income (at least CashRainMinCoin).
	CashRainCoinsPerWave = 12,
	CashRainWaveSeconds = 10,
	CashRainCoinIncomeSeconds = 20,
	CashRainMinCoin = 150,

	-- Day and night, and weather that changes every few minutes.
	DayLengthSeconds = 10 * 60,
	WeatherMinSeconds = 3 * 60,
	WeatherMaxSeconds = 5 * 60,
	Weather = table.freeze({
		table.freeze({ Name = "Clear", Weight = 5 }),
		table.freeze({ Name = "Rain", Weight = 2 }),
		table.freeze({ Name = "Snow", Weight = 1 }),
		table.freeze({ Name = "Thunderstorm", Weight = 1 }),
		table.freeze({ Name = "Fog", Weight = 1 }),
	}),

	-- Economy
	SellRefundFraction = 0.5,
	StarterBrainrotId = "NoobiniPizzanini",
	RebirthBaseCost = 100000,
	RebirthCostGrowth = 2.5,
	RebirthIncomeBonus = 0.5,
}

function GameConfig.getRebirthCost(rebirths: number): number
	return math.floor(GameConfig.RebirthBaseCost * GameConfig.RebirthCostGrowth ^ rebirths)
end

function GameConfig.getRebirthIncomeMultiplier(rebirths: number): number
	return 1 + GameConfig.RebirthIncomeBonus * rebirths
end

-- How many floors of a base are open at this many rebirths.
function GameConfig.getUnlockedFloors(rebirths: number): number
	local floors = 0
	for floor, needed in GameConfig.FloorUnlockRebirths do
		if rebirths >= needed then
			floors = floor
		end
	end
	return math.max(floors, 1)
end

return table.freeze(GameConfig)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">GearConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Gear sold for Cash at the Gear Shop stall. Owned gear is saved and given back
-- every time you spawn. GearManager on the server makes each tool work.
-- Troll items are bought with Robux in the Shop (see MonetizationConfig) and
-- come with a few charges each.

export type Gear = {
	Id: string,
	DisplayName: string,
	-- 0 = everyone gets it for free.
	Price: number,
	Description: string,
	Color: Color3,
	Order: number,
}

export type TrollItem = {
	Id: string,
	DisplayName: string,
	Description: string,
	Color: Color3,
}

local Gear: { Gear } = {
	{
		Id = "Slap",
		DisplayName = "Slap",
		Price = 0,
		Description = "A giant slap glove on a stick. A slapped thief drops the brainrot!",
		Color = Color3.fromRGB(150, 70, 255),
		Order = 1,
	},
	{
		Id = "SpeedCoil",
		DisplayName = "Speed Coil",
		Price = 7500,
		Description = "Run much faster while you hold it (not while carrying a brainrot).",
		Color = Color3.fromRGB(60, 200, 255),
		Order = 2,
	},
	{
		Id = "GravityCoil",
		DisplayName = "Gravity Coil",
		Price = 20000,
		Description = "Jump three times higher while you hold it.",
		Color = Color3.fromRGB(170, 90, 255),
		Order = 3,
	},
	{
		Id = "InvisibilityCloak",
		DisplayName = "Invisibility Cloak",
		Price = 100000,
		Description = "Click to turn invisible for 8 seconds. Grabbing a brainrot reveals you.",
		Color = Color3.fromRGB(120, 130, 150),
		Order = 4,
	},
}

local TrollItems: { TrollItem } = {
	{
		Id = "FreezeRay",
		DisplayName = "Freeze Ray",
		Description = "Freeze the player in front of you solid. Frozen thieves drop their brainrot!",
		Color = Color3.fromRGB(120, 220, 255),
	},
	{
		Id = "SpikeTrap",
		DisplayName = "Spike Trap",
		Description = "Put down a spike trap. Whoever steps on it gets stuck and drops their brainrot.",
		Color = Color3.fromRGB(170, 175, 185),
	},
	{
		Id = "LandMine",
		DisplayName = "Land Mine",
		Description = "Hide a land mine. It launches whoever steps on it sky high!",
		Color = Color3.fromRGB(220, 50, 40),
	},
	{
		Id = "BoogieBomb",
		DisplayName = "Boogie Bomb",
		Description = "Everyone around you can't stop dancing for a few seconds!",
		Color = Color3.fromRGB(255, 90, 200),
	},
}

local TrollItemById: { [string]: TrollItem } = {}
for _, item in TrollItems do
	TrollItemById[item.Id] = table.freeze(item)
end

local ById: { [string]: Gear } = {}
for _, gear in Gear do
	ById[gear.Id] = table.freeze(gear)
end

return table.freeze({
	Gear = table.freeze(Gear),
	ById = table.freeze(ById),
	SlapCooldownSeconds = 0.8,
	SlapRange = 8,
	SlapKnockback = 70,
	SpeedCoilBonus = 12,
	GravityCoilJumpHeight = 22,
	DefaultJumpHeight = 7.2,
	CloakSeconds = 8,
	CloakCooldownSeconds = 30,
	-- Buying needs you to be this close to the Gear Shop counter.
	ShopDistance = 30,

	TrollItems = table.freeze(TrollItems),
	TrollItemById = table.freeze(TrollItemById),
	ItemCooldownSeconds = 1.5,
	FreezeRange = 45,
	FreezeSeconds = 4,
	SpikeStunSeconds = 3,
	MineLaunchSpeed = 110,
	MineStunSeconds = 2,
	BoogieRadius = 22,
	BoogieSeconds = 4,
	-- Placed traps and mines: how long they stay, how many each player can
	-- have out and how close someone has to step.
	TrapLifetimeSeconds = 120,
	MaxTrapsPerPlayer = 3,
	TrapTriggerRadius = 3.5,
})
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="61">
        <Properties>
          <string name="Name">MonetizationConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Robux products and game passes. Read by DataAndMonetizationManager on the
-- server and by the shop UI on the client, so the IDs only live here.
-- Replace every ID with the real ones from the Creator Dashboard.

local NumberFormat = require(script.Parent:WaitForChild("NumberFormat"))

export type ShopProduct = {
	Key: string,
	ProductId: number,
	DisplayName: string,
	Description: string,
	-- Upload the matching image from ProductIcons/ and paste its image ID here
	-- to show it in the shop. 0 uses the product's own icon once the product
	-- exists, or a coloured tile with IconText until then.
	IconAssetId: number,
	IconText: string,
	IconColor: Color3,
}

local ProductIds = table.freeze({
	SmallCashBundle = 100001,
	MediumCashBundle = 100002,
	EMPLaserOverrider = 100003,
	ServerRarityBoost = 100004,
	FreezeRay = 100005,
	SpikeTrap = 100006,
	LandMine = 100007,
	BoogieBomb = 100008,
})

-- Troll items: each purchase adds this many uses of the tool (saved).
local ItemCharges: { [string]: number } = table.freeze({
	FreezeRay = 3,
	SpikeTrap = 3,
	LandMine = 3,
	BoogieBomb = 2,
})

local GamePasses: { [string]: number } = table.freeze({
	VIP = 200001,
	DoubleCash = 200002,
})

local SMALL_CASH_BUNDLE_AMOUNT = 5000
local MEDIUM_CASH_BUNDLE_AMOUNT = 25000
local LASER_BYPASS_DURATION_SECONDS = 30
local SERVER_RARITY_BOOST_DURATION_SECONDS = 15 * 60
local SERVER_RARITY_BOOST_MULTIPLIER = 2

local ShopProducts: { ShopProduct } = {
	{
		Key = "SmallCashBundle",
		ProductId = ProductIds.SmallCashBundle,
		DisplayName = "Small Cash Bundle",
		Description = string.format("+%s Cash instantly", NumberFormat.commas(SMALL_CASH_BUNDLE_AMOUNT)),
		IconAssetId = 0,
		IconText = "$",
		IconColor = Color3.fromRGB(46, 204, 113),
	},
	{
		Key = "MediumCashBundle",
		ProductId = ProductIds.MediumCashBundle,
		DisplayName = "Medium Cash Bundle",
		Description = string.format("+%s Cash instantly", NumberFormat.commas(MEDIUM_CASH_BUNDLE_AMOUNT)),
		IconAssetId = 0,
		IconText = "$$$",
		IconColor = Color3.fromRGB(26, 160, 220),
	},
	{
		Key = "EMPLaserOverrider",
		ProductId = ProductIds.EMPLaserOverrider,
		DisplayName = "EMP Laser Overrider",
		Description = string.format("Walk through every laser door for %d seconds", LASER_BYPASS_DURATION_SECONDS),
		IconAssetId = 0,
		IconText = "EMP",
		IconColor = Color3.fromRGB(60, 90, 220),
	},
	{
		Key = "ServerRarityBoost",
		ProductId = ProductIds.ServerRarityBoost,
		DisplayName = "Server Rarity Boost",
		Description = string.format(
			"x%d rare brainrot chance for the whole server for %d minutes",
			SERVER_RARITY_BOOST_MULTIPLIER,
			SERVER_RARITY_BOOST_DURATION_SECONDS // 60
		),
		IconAssetId = 0,
		IconText = "x2",
		IconColor = Color3.fromRGB(200, 60, 200),
	},
	{
		Key = "FreezeRay",
		ProductId = ProductIds.FreezeRay,
		DisplayName = "Freeze Ray x3",
		Description = "Freeze a player solid for 4 seconds. Thieves drop what they carry!",
		IconAssetId = 0,
		IconText = "ICE",
		IconColor = Color3.fromRGB(80, 200, 255),
	},
	{
		Key = "SpikeTrap",
		ProductId = ProductIds.SpikeTrap,
		DisplayName = "Spike Trap x3",
		Description = "Spikes that trap whoever steps on them for 3 seconds.",
		IconAssetId = 0,
		IconText = "!!",
		IconColor = Color3.fromRGB(240, 110, 40),
	},
	{
		Key = "LandMine",
		ProductId = ProductIds.LandMine,
		DisplayName = "Land Mine x3",
		Description = "BOOM! Launches anyone who steps on it into the air.",
		IconAssetId = 0,
		IconText = "*",
		IconColor = Color3.fromRGB(70, 150, 60),
	},
	{
		Key = "BoogieBomb",
		ProductId = ProductIds.BoogieBomb,
		DisplayName = "Boogie Bomb x2",
		Description = "Everyone near you can't stop dancing for 4 seconds.",
		IconAssetId = 0,
		IconText = "♪",
		IconColor = Color3.fromRGB(230, 70, 200),
	},
}

return table.freeze({
	ProductIds = ProductIds,
	GamePasses = GamePasses,
	SmallCashBundleAmount = SMALL_CASH_BUNDLE_AMOUNT,
	MediumCashBundleAmount = MEDIUM_CASH_BUNDLE_AMOUNT,
	LaserBypassDurationSeconds = LASER_BYPASS_DURATION_SECONDS,
	ServerRarityBoostDurationSeconds = SERVER_RARITY_BOOST_DURATION_SECONDS,
	ServerRarityBoostMultiplier = SERVER_RARITY_BOOST_MULTIPLIER,
	DoubleCashIncomeMultiplier = 2,
	ItemCharges = ItemCharges,
	ShopProducts = table.freeze(ShopProducts),
})
]]></string>
        </Properties>
