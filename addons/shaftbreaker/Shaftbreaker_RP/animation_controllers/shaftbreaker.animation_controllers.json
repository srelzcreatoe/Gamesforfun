    "controller.animation.shaftbreaker.phase": {
      "initial_state": "dormant",
      "states": {
        "dormant": {
          "animations": [
            {
              "dormant": "v.base_weight * (1.0 - v.move_blend)"
            },
            {
              "stalk_walk": "v.base_weight * v.move_blend"
            }
          ],
          "transitions": [
            {
              "stalking": "q.property('shaftbreaker:phase') == 'stalking'"
            },
            {
              "watching": "q.property('shaftbreaker:phase') == 'watching'"
            },
            {
              "breaker": "q.property('shaftbreaker:phase') == 'breaker'"
