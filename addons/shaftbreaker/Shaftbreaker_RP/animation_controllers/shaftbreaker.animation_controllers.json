            {
              "dormant": "q.property('shaftbreaker:phase') == 'dormant'"
            },
            {
              "stalking": "q.property('shaftbreaker:phase') == 'stalking'"
            },
            {
              "watching": "q.property('shaftbreaker:phase') == 'watching'"
            },
            {
              "frenzy": "q.property('shaftbreaker:phase') == 'frenzy'"
            }
          ],
          "blend_transition": 0.35
        },
        "frenzy": {
          "animations": [
            {
              "frenzy_idle": "v.base_weight * (1.0 - v.move_blend)"
            },
            {
              "frenzy_run": "v.base_weight * v.move_blend"
            },
            {
              "crooked_gait": "v.base_weight * v.move_blend * (v.gait == 1 ? 1.0 : 0.0)"
            },
            {
              "broken_gait": "v.base_weight * v.move_blend * (v.gait == 2 ? 1.0 : 0.0)"
            }
          ],
          "transitions": [
            {
              "dormant": "q.property('shaftbreaker:phase') == 'dormant'"
            },
            {
              "stalking": "q.property('shaftbreaker:phase') == 'stalking'"
            },
            {
