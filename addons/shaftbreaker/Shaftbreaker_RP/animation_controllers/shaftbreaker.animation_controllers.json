          "transitions": [
            {
              "none": "v.act != 44"
            }
          ],
          "blend_transition": 0.25,
          "animations": [
            {
              "claw_left": "v.actw"
            }
          ]
        },
        "a45": {
          "on_entry": [
            "v.act_t0 = q.life_time;"
          ],
          "transitions": [
            {
              "none": "v.act != 45"
            }
          ],
          "blend_transition": 0.25,
          "animations": [
            {
              "finish_step": "v.actw"
            }
          ]
        }
      }
    },
    "controller.animation.shaftbreaker.attack": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "swing": "q.is_delayed_attacking"
            }
          ],
          "blend_transition": 0.15
        },
        "swing": {
          "on_entry": [
            "v.swing = math.random_integer(0, 2);"
          ],
          "animations": [
            {
              "claw_right_add": "(1.0 - v.actw) * (v.swing == 0 ? 1.0 : 0.0)"
            },
            {
              "claw_left_add": "(1.0 - v.actw) * (v.swing == 1 ? 1.0 : 0.0)"
            },
            {
              "claw_wide_add": "(1.0 - v.actw) * (v.swing == 2 ? 1.0 : 0.0)"
            }
          ],
          "transitions": [
            {
              "default": "q.all_animations_finished"
            }
          ],
          "blend_transition": 0.15
        }
      }
    }
  }
}