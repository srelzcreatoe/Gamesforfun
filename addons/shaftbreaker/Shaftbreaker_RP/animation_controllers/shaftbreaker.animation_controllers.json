            }
          ],
          "blend_transition": 0.7
        },
        "breaker": {
          "animations": [
            {
              "frenzy_idle": "v.base_weight * (1.0 - v.move_blend)"
            },
            {
              "breaker_walk": "v.base_weight * v.move_blend"
            }
