{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.sb_skull": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default",
        "Texture.enchanted"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "worn": "c.item_slot == 'head'"
        },
        {
          "held": "c.item_slot != 'head'"
        }
      ]
    }
  }
}