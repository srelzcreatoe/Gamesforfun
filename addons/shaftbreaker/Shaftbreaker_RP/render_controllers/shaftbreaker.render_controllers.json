{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.shaftbreaker": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.default",
            "Texture.spectral"
          ]
        },
        "materials": {
          "Array.mats": [
            "Material.default",
            "Material.spectral"
          ]
        }
      },
      "geometry": "Geometry.default",
      "textures": [
        "Array.skins[q.property('shaftbreaker:spectral') ? 1 : 0]"
      ],
      "materials": [
        {
          "*": "Array.mats[q.property('shaftbreaker:spectral') ? 1 : 0]"
        }
      ],
      "part_visibility": [
        {
          "*": "!q.is_invisible"
        }
      ]
    },
    "controller.render.shaftbreaker_eyes": {
      "geometry": "Geometry.default",
      "textures": [
        "Texture.eyes"
      ],
      "materials": [
        {
          "*": "Material.eyes"
        }
      ],
      "ignore_lighting": true,
      "color": {
        "r": 1.0,
        "g": 1.0,
        "b": 1.0,
        "a": "math.clamp(q.property('shaftbreaker:eyes') * (q.property('shaftbreaker:spectral') ? 0.6 : 1.0), 0.0, 1.0)"
      },
      "part_visibility": [
        {
          "*": false
        },
        {
          "head": true
        }
      ]
    }
  }
}