{
 "format_version": "1.10.0",
 "animation_controllers": {
  "controller.animation.purple_rat.move": {
   "initial_state": "idle",
   "states": {
    "idle": {
     "animations": [
      "idle"
     ],
     "blend_transition": 0.2,
     "transitions": [
      {
       "walk": "query.modified_move_speed > 0.05"
      }
     ]
    },
    "walk": {
     "animations": [
      "walk"
     ],
     "blend_transition": 0.2,
     "transitions": [
      {
       "idle": "query.modified_move_speed <= 0.05"
      },
      {
       "run": "query.modified_move_speed > 0.7"
      }
     ]
    },
    "run": {
     "animations": [
      "run"
     ],
     "blend_transition": 0.2,
     "transitions": [
      {
       "walk": "query.modified_move_speed <= 0.7"
      }
     ]
    }
   }
  }
 }
}