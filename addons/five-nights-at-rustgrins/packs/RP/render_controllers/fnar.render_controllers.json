{
 "format_version": "1.10.0",
 "render_controllers": {
  "controller.render.fnar.body": {
   "arrays": {
    "textures": {
     "Array.skin": [
      "Texture.default",
      "Texture.hollow"
     ]
    }
   },
   "geometry": "Geometry.default",
   "materials": [
    {
     "*": "Material.default"
    }
   ],
   "textures": [
    "Array.skin[query.property('fnar:hollow')]"
   ],
   "part_visibility": [
    {
     "*": "!variable.fnar_hidden"
    }
   ]
  },
  "controller.render.fnar.eyes": {
   "arrays": {
    "textures": {
     "Array.eyes": [
      "Texture.eyes",
      "Texture.pinprick"
     ]
    }
   },
   "geometry": "Geometry.default",
   "materials": [
    {
     "*": "Material.eyes"
    }
   ],
   "textures": [
    "Array.eyes[query.property('fnar:hollow')]"
   ],
   "ignore_lighting": true,
   "part_visibility": [
    {
     "*": false
    },
    {
     "head": "variable.fnar_eyes && !variable.fnar_hidden"
    }
   ]
  }
 }
}
