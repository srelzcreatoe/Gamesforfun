     "$child_control": "server_form.long_form_panel",
     "layer": 2,
     "bindings": [
      {
       "binding_name": "#title_text"
      },
      {
       "binding_type": "view",
       "source_property_name": "((#title_text - '§k§r§k§r§m') = #title_text)",
       "target_property_name": "#visible"
      }
     ]
    }
   },
   {
    "fnar_cam_form@server_form.fnar_cam_form": {
     "bindings": [
      {
       "binding_name": "#title_text"
      },
      {
       "binding_type": "view",
       "source_property_name": "(not ((#title_text - '§k§r§k§r§m') = #title_text))",
       "target_property_name": "#visible"
      }
     ]
    }
   }
  ]
