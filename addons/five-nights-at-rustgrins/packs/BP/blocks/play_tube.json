{
  "format_version": "1.26.50",
  "minecraft:block": {
    "description": {
      "identifier": "fnar:play_tube",
      "menu_category": {
        "category": "construction"
      },
      "states": {
        "fnar:color": {
          "values": {
            "min": 0,
            "max": 3
          }
        },
        "fnar:window": [
          false,
          true
        ]
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": [
            "minecraft:cardinal_direction"
          ],
          "y_rotation_offset": 180
        }
      }
    },
    "components": {
      "minecraft:geometry": "geometry.fnar.play_tube",
      "minecraft:material_instances": {
        "*": {
          "texture": "fnar_play_tube_red",
          "render_method": "alpha_test"
        }
      },
      "minecraft:collision_box": {
        "origin": [
          -7,
          1,
          -8
        ],
        "size": [
          14,
          14,
          16
        ]
      },
      "minecraft:selection_box": {
        "origin": [
          -7,
          1,
          -8
        ],
        "size": [
          14,
          14,
          16
        ]
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 1.0
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 3
      },
      "minecraft:map_color": "#9a2722",
      "minecraft:light_dampening": 0
    },
    "permutations": [
      {
        "condition": "q.block_state('fnar:color') == 0",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "fnar_play_tube_red",
              "render_method": "alpha_test"
            }
          }
        }
      },
      {
        "condition": "q.block_state('fnar:color') == 1",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "fnar_play_tube_blue",
              "render_method": "alpha_test"
            }
          }
        }
      },
      {
        "condition": "q.block_state('fnar:color') == 2",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "fnar_play_tube_yellow",
              "render_method": "alpha_test"
            }
          }
        }
      },
      {
        "condition": "q.block_state('fnar:color') == 3",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "fnar_play_tube_green",
              "render_method": "alpha_test"
            }
          }
        }
      },
      {
        "condition": "q.block_state('fnar:window') == true",
        "components": {
          "minecraft:geometry": "geometry.fnar.play_tube_window"
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              0,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              90,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              180,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              -90,
              0
            ]
          }
        }
      }
    ]
  }
}
