{
  "namespace": "hud",
  "boss_health_panel": {
    "type": "panel",
    "size": [
      182,
      20
    ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "$progress_bar_collection": "boss_bars",
    "controls": [
      {
        "boss_name@boss_name_panel": {}
      },
      {
        "progress_bar_for_collections@common.progress_bar_for_collections": {
          "offset": [
            0,
            10
          ]
        }
      },
      {
        "basiliskra_boss_bar@hud.basiliskra_boss_bar": {}
      }
    ],
    "bindings": [
      {
        "binding_name": "#bar_visible",
        "binding_type": "collection",
        "binding_collection_name": "boss_bars",
        "binding_name_override": "#visible"
      }
    ]
  },
  "basiliskra_boss_bar": {
    "type": "panel",
    "size": [
      182,
      20
    ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "layer": 50,
    "controls": [
      {
        "basiliskra_frame": {
          "type": "image",
          "texture": "textures/ui/basiliskra_boss_frame",
          "size": [
            182,
            20
          ],
          "layer": 1
        }
      },
      {
        "basiliskra_fill": {
          "type": "image",
          "texture": "textures/ui/basiliskra_boss_fill",
          "size": [
            170,
            6
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [
            6,
            12
          ],
          "layer": 2,
          "clip_direction": "left",
          "clip_pixelperfect": false,
          "bindings": [
            {
              "binding_name": "#progress_percentage",
              "binding_name_override": "#clip_ratio",
              "binding_type": "collection",
              "binding_collection_name": "boss_bars"
            }
          ]
        }
      },
      {
        "basiliskra_name": {
          "type": "label",
          "text": "#bossName",
          "color": [
            1.0,
            0.8,
            0.64
          ],
          "shadow": true,
          "enable_profanity_filter": true,
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [
            0,
            2
          ],
          "layer": 3,
          "bindings": [
            {
              "binding_name": "#bossName",
              "binding_type": "collection",
              "binding_collection_name": "boss_bars"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#bossName",
        "binding_type": "collection",
        "binding_collection_name": "boss_bars"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#bossName = 'Basiliskra') or (#bossName = 'Basiliskra I') or (#bossName = 'Basiliskra II') or (#bossName = 'Basiliskra III') or (#bossName = 'Basiliskra IV'))",
        "target_property_name": "#visible"
      }
    ]
  }
}
