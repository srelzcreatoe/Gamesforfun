      "minecraft:particle_initial_speed": "v.puff.speed * (0.6 + v.particle_random_2 * 0.6)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.25,
          0
        ],
        "linear_drag_coefficient": 2.6
