{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "goatwalker:breath",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/goatwalker_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 3
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "v.puff.direction_x + (v.emitter_random_1 - 0.5) * 0.3",
          "v.puff.direction_y + 0.1",
          "v.puff.direction_z + (v.emitter_random_2 - 0.5) * 0.3"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "1.4 + v.particle_random_1 * 0.6"
