{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "wmire:falling_leaf",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/wmire_wind"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_box": {
        "offset": [
          0,
          0,
          0
        ],
        "half_dimensions": [
          0.4,
          0,
          0.4
        ],
        "direction": [
          0,
          -1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 9
      },
      "minecraft:particle_initial_speed": 0.05,
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-90, 90)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "variable.wind_x * variable.speed * 0.35 + math.sin(variable.particle_age * 140 + variable.particle_random_3 * 360) * 0.8",
          -0.5,
          "variable.wind_z * variable.speed * 0.35 + math.cos(variable.particle_age * 120 + variable.particle_random_4 * 360) * 0.8"
        ],
        "linear_drag_coefficient": 0.9
      },
      "minecraft:particle_motion_collision": {
        "collision_drag": 10,
        "collision_radius": 0.05,
        "expire_on_contact": true
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.08 + variable.particle_random_1 * 0.04",
          "0.08 + variable.particle_random_1 * 0.04"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            "math.floor(variable.particle_random_2 * 4) * 8",
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "math.clamp((variable.particle_lifetime - variable.particle_age) * 1.5, 0, 1) * math.clamp(variable.particle_age * 3, 0, 1)"
        ]
      }
    }
  }
}
