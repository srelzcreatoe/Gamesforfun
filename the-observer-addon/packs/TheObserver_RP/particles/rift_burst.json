{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "observer:rift_burst",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/observer/rift_spark"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 90
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_box": {
        "offset": [
          0,
          3.5,
          0
        ],
        "half_dimensions": [
          1.2,
          3.5,
          1.2
        ],
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.6, 1.6)"
      },
      "minecraft:particle_initial_speed": "math.random(3, 9)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 3.5,
        "linear_acceleration": [
          0,
          -1.5,
          0
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.1 + v.particle_random_2 * 0.14",
          "0.1 + v.particle_random_2 * 0.14"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 8,
          "uv": [
            "math.floor(v.particle_random_1 * 4) * 8",
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.particle_random_3 > 0.75 ? 1.0 : 0.72",
          "v.particle_random_3 > 0.75 ? 0.15 : 0.42",
          "v.particle_random_3 > 0.75 ? 0.25 : 1.0",
          "1 - v.particle_age / v.particle_lifetime"
        ]
      }
    }
  }
}
