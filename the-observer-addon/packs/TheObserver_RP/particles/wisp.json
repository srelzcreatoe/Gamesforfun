{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "observer:wisp",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/observer/wisp"
      }
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": false
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 16,
        "max_particles": 64
      },
      "minecraft:emitter_lifetime_looping": {
        "active_time": 1
      },
      "minecraft:emitter_shape_box": {
        "offset": [
          0,
          1.8,
          0
        ],
        "half_dimensions": [
          0.5,
          1.8,
          0.5
        ],
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.4, 2.6)"
      },
      "minecraft:particle_initial_speed": "math.random(0.1, 0.35)",
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-40, 40)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(variable.particle_age * 160 + variable.particle_random_1 * 360) * 0.5",
          0.35,
          "math.cos(variable.particle_age * 160 + variable.particle_random_2 * 360) * 0.5"
        ],
        "linear_drag_coefficient": 0.9
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.7 + variable.particle_random_3 * 0.45) * math.min(1, variable.particle_age * 3)",
          "(0.7 + variable.particle_random_3 * 0.45) * math.min(1, variable.particle_age * 3)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 128,
          "uv": [
            "math.floor(variable.particle_random_1 * 4) * 64",
            "math.floor(variable.particle_random_2 * 2) * 64"
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.86,
          0.9,
          1.0,
          "0.8 * math.min(1, variable.particle_age / (variable.particle_lifetime * 0.2)) * math.clamp((1 - variable.particle_age / variable.particle_lifetime) / 0.4, 0, 1)"
        ]
      }
    }
  }
}