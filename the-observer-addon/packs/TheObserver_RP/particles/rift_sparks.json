{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "observer:rift_sparks",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/observer/rift_spark"
      }
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": true
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 34,
        "max_particles": 120
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 2.0
      },
      "minecraft:emitter_shape_custom": {
        "offset": [
          "math.cos(v.emitter_random_1 * 360 + v.particle_random_4 * 360) * 2.45",
          "math.sin(v.emitter_random_1 * 360 + v.particle_random_4 * 360) * 3.45",
          0
        ],
        "direction": [
          "math.cos(v.particle_random_4 * 360) * 0.6",
          "math.sin(v.particle_random_4 * 360) * 0.6 + 0.4",
          "math.random(-0.6, 0.6)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.9, 1.8)"
      },
      "minecraft:particle_initial_speed": "math.random(0.4, 1.3)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.25,
          0
        ],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.07 + v.particle_random_2 * 0.08",
          "0.07 + v.particle_random_2 * 0.08"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 8,
          "uv": [
            "math.floor(v.particle_random_1 * 4) * 8",
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.particle_random_3 > 0.7 ? 1.0 : 0.78",
          "v.particle_random_3 > 0.7 ? 0.16 : 0.48",
          "v.particle_random_3 > 0.7 ? 0.28 : 1.0",
          "1 - v.particle_age / v.particle_lifetime"
        ]
      }
    }
  }
}
