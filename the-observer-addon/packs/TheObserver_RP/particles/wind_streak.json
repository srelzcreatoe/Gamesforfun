{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "wmire:wind_streak",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/wmire_wind"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.count"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_box": {
        "offset": [
          0,
          0,
          0
        ],
        "half_dimensions": [
          10,
          5,
          10
        ],
        "direction": [
          "variable.wind_x",
          0,
          "variable.wind_z"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.8 + variable.particle_random_1 * 0.6"
      },
      "minecraft:particle_initial_speed": "variable.speed * 2.2",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 0.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.8 + variable.particle_random_2 * 0.6",
          0.03
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.01
        },
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            16
          ],
          "uv_size": [
            32,
            4
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.85,
          0.87,
          0.92,
          "0.22 * math.clamp((variable.particle_lifetime - variable.particle_age) * 1.5, 0, 1) * math.clamp(variable.particle_age * 3, 0, 1)"
        ]
      }
    }
  }
}
