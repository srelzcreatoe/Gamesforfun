{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "wmire:wind_motes",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/wmire_wind"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.count"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_box": {
        "offset": [
          0,
          0,
          0
        ],
        "half_dimensions": [
          12,
          5,
          12
        ],
        "direction": [
          "variable.wind_x",
          0.05,
          "variable.wind_z"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "5 + variable.particle_random_1 * 4"
      },
      "minecraft:particle_initial_speed": "0.25 + variable.speed * 0.25",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(variable.particle_age * 40 + variable.particle_random_3 * 360) * 0.15",
          "math.cos(variable.particle_age * 55 + variable.particle_random_4 * 360) * 0.1",
          "math.cos(variable.particle_age * 35 + variable.particle_random_2 * 360) * 0.15"
        ],
        "linear_drag_coefficient": 0.05
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.025 + variable.particle_random_2 * 0.03",
          "0.025 + variable.particle_random_2 * 0.03"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            8
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.8,
          0.82,
          0.86,
          "0.45 * math.clamp((variable.particle_lifetime - variable.particle_age) * 1.5, 0, 1) * math.clamp(variable.particle_age * 3, 0, 1)"
        ]
      }
    }
  }
}
