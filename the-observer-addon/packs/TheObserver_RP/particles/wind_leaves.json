{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "wmire:wind_leaves",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/wmire_wind"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.count"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_box": {
        "offset": [
          0,
          0,
          0
        ],
        "half_dimensions": [
          14,
          6,
          14
        ],
        "direction": [
          "variable.wind_x",
          -0.12,
          "variable.wind_z"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "4 + variable.particle_random_1 * 3"
      },
      "minecraft:particle_initial_speed": "variable.speed * (0.7 + variable.particle_random_2 * 0.6)",
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-240, 240)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(variable.particle_age * 160 + variable.particle_random_3 * 360) * 1.4",
          -0.35,
          "math.cos(variable.particle_age * 130 + variable.particle_random_4 * 360) * 1.4"
        ],
        "linear_drag_coefficient": 0.12
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.07 + variable.particle_random_1 * 0.05",
          "0.07 + variable.particle_random_1 * 0.05"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            "math.floor(variable.particle_random_2 * 4) * 8",
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "math.clamp((variable.particle_lifetime - variable.particle_age) * 1.5, 0, 1) * math.clamp(variable.particle_age * 3, 0, 1)"
        ]
      }
    }
  }
}
