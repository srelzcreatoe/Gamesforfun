{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.observer.the_observer": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": "q.property('observer:state') != 'hidden'"
        }
      ]
    },
    "controller.render.observer.eyes": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.eyes"
        }
      ],
      "textures": [
        "Texture.eyes"
      ],
      "ignore_lighting": true,
      "part_visibility": [
        {
          "*": false
        },
        {
          "head": "q.property('observer:state') != 'hidden'"
        }
      ]
    }
  }
}