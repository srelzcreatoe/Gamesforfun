{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sg:arc",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/sg/bolt"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          "variable.dx*variable.len*0.5",
          "variable.dy*variable.len*0.5",
          "variable.dz*variable.len*0.5"
        ],
        "direction": [
          "variable.dx",
          "variable.dy",
          "variable.dz"
        ]
      },
      "minecraft:particle_initial_speed": 0.05,
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.1
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.len*0.5",
          "variable.len*0.2+0.4"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.001
        },
        "uv": {
          "texture_width": 256,
          "texture_height": 64,
          "uv": [
            "math.floor(v.particle_random_1*3.99)*64",
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.9,
          0.8,
          1.0,
          1.0
        ]
      }
    }
  }
}