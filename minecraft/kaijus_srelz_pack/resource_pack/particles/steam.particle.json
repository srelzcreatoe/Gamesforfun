{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sg:steam",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/sg/smoke"
      }
    },
    "components": {
