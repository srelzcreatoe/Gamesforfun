{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sg:beam_wisp",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/sg/smoke"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 5
      },
      "minecraft:particle_initial_speed": "math.random(0.03,1.0)*variable.len*4",
      "minecraft:emitter_shape_point": {
        "direction": [
          "variable.dx+math.random(-0.1,0.1)",
          "variable.dy+math.random(-0.1,0.1)",
          "variable.dz+math.random(-0.1,0.1)"
        ]
      },
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 4.0,
        "linear_acceleration": [
          0,
          1.8,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.4,2.6)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.5+1.2*v.particle_age/v.particle_lifetime)*variable.width*(0.75+0.5*v.particle_random_1)",
          "(0.5+1.2*v.particle_age/v.particle_lifetime)*variable.width*(0.75+0.5*v.particle_random_1)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 512,
          "texture_height": 128,
          "uv": [
            "math.floor(v.particle_random_1*3.99)*128",
            0
          ],
          "uv_size": [
            128,
            128
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age/v.particle_lifetime",
          "gradient": {
            "0.0": "#00402060",
            "0.1": "#B0301848",
            "0.5": "#80201820",
            "1.0": "#00100C10"
          }
        }
      }
    }
  }
}