        "size": [
          "(0.8+1.6*v.particle_age/v.particle_lifetime)*variable.width*(0.75+0.5*v.particle_random_1)",
          "(0.8+1.6*v.particle_age/v.particle_lifetime)*variable.width*(0.75+0.5*v.particle_random_1)"
