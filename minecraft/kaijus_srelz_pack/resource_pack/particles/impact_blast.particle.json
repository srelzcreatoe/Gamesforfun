{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sg:impact_blast",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/sg/fire"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 5
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "variable.size*0.4",
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "math.random(1,4)*variable.size*0.5",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 2.0
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.35,0.65)"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0,360)",
        "rotation_rate": "math.random(-60,60)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.9+1.7*v.particle_age/v.particle_lifetime)*variable.size*(0.75+0.5*v.particle_random_1)",
          "(0.9+1.7*v.particle_age/v.particle_lifetime)*variable.size*(0.75+0.5*v.particle_random_1)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 512,
          "texture_height": 128,
          "uv": [
            "math.floor(v.particle_random_1*3.99)*128",
            0
          ],
          "uv_size": [
            128,
            128
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age/v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.25": "#FFF0C0FF",
            "0.6": "#E0B050F0",
            "1.0": "#00401080"
          }
        }
      }
    }
  }
}