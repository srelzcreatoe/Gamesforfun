{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sg:beam_ring",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/sg/ring"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "variable.dx",
          "variable.dy",
          "variable.dz"
        ]
      },
      "minecraft:particle_initial_speed": 55,
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.clamp(variable.len/55, 0.1, 0.55)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.width*(1.2+2.6*v.particle_age/v.particle_lifetime)",
          "variable.width*(1.2+2.6*v.particle_age/v.particle_lifetime)"
        ],
        "facing_camera_mode": "direction_z",
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.001
        },
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            128,
            128
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.cr",
          "variable.cg",
          "variable.cb",
          "0.8*(1-v.particle_age/v.particle_lifetime)"
        ]
      }
    }
  }
}