{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "brine:brinesleeper",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "brine:wet": {
        "minecraft:mark_variant": {
          "value": 0
        }
      },
      "brine:dryland_hunt": {
        "minecraft:mark_variant": {
          "value": 1
        },
        "minecraft:timer": {
          "looping": false,
          "time": [
            15,
            20
          ],
          "randomInterval": true,
          "time_down_event": {
            "event": "brine:dried_out",
            "target": "self"
          }
        }
      },
      "brine:dried_out": {
        "minecraft:mark_variant": {
          "value": 2
        },
        "minecraft:behavior.move_to_water": {
          "priority": 0,
          "search_range": 24,
          "search_height": 8,
          "search_count": 1,
          "goal_radius": 1.5,
          "speed_multiplier": 1.4
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "brinesleeper",
          "monster",
          "mob"
        ]
      },
      "minecraft:health": {
        "value": 40,
        "max": 40
      },
      "minecraft:attack": {
        "damage": 6
      },
      "minecraft:collision_box": {
        "width": 1.1,
        "height": 3.4
      },
      "minecraft:movement": {
        "value": 0.25
      },
      "minecraft:underwater_movement": {
        "value": 0.15
      },
      "minecraft:navigation.generic": {
        "is_amphibious": true,
        "can_path_over_water": false,
        "can_swim": true,
        "can_walk": true,
        "can_breach": true,
        "avoid_damage_blocks": true
      },
      "minecraft:movement.amphibious": {
        "max_turn": 10
      },
      "minecraft:jump.static": {},
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_water": true,
        "breathes_air": true
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:nameable": {},
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:follow_range": {
        "value": 32,
        "max": 32
      },
      "minecraft:environment_sensor": {
        "triggers": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "in_water",
                  "subject": "self",
                  "operator": "==",
                  "value": false
                },
                {
                  "test": "is_mark_variant",
                  "subject": "self",
                  "operator": "==",
                  "value": 0
                }
              ]
            },
            "event": "brine:left_water"
          },
          {
            "filters": {
              "all_of": [
                {
                  "test": "in_water",
                  "subject": "self",
                  "operator": "==",
                  "value": true
                },
                {
                  "test": "is_mark_variant",
                  "subject": "self",
                  "operator": "!=",
                  "value": 0
                }
              ]
            },
            "event": "brine:entered_water"
          }
        ]
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "must_see": true,
        "reselect_targets": true,
        "within_radius": 24,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "player"
            },
            "max_dist": 24
          }
        ]
      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "speed_multiplier": 1.5,
        "track_target": true
      },
      "minecraft:behavior.random_swim": {
        "priority": 6,
        "speed_multiplier": 1.0,
        "xz_dist": 10,
        "y_dist": 5
      },
      "minecraft:behavior.random_stroll": {
        "priority": 7,
        "speed_multiplier": 0.6
      },
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 16,
        "probability": 0.05
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "brine:wet"
          ]
        }
      },
      "brine:left_water": {
        "remove": {
          "component_groups": [
            "brine:wet"
          ]
        },
        "add": {
          "component_groups": [
            "brine:dryland_hunt"
          ]
        }
      },
      "brine:dried_out": {
        "remove": {
          "component_groups": [
            "brine:dryland_hunt"
          ]
        },
        "add": {
          "component_groups": [
            "brine:dried_out"
          ]
        }
      },
      "brine:entered_water": {
        "remove": {
          "component_groups": [
            "brine:dryland_hunt",
            "brine:dried_out"
          ]
        },
        "add": {
          "component_groups": [
            "brine:wet"
          ]
        }
      }
    }
  }
}
