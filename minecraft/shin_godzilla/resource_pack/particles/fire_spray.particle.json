{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sg:fire_spray",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/sg/flame"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 10
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.5,
        "direction": [
          "variable.dx+math.random(-0.16,0.16)",
          "variable.dy+math.random(-0.16,0.16)",
          "variable.dz+math.random(-0.16,0.16)"
        ]
      },
      "minecraft:particle_initial_speed": "variable.spd*math.random(0.6,1.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          2,
          0
        ],
        "linear_drag_coefficient": 0.9
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.7,1.1)"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0,360)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.6+v.particle_age*4",
          "0.6+v.particle_age*4"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 32,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              32,
              32
            ],
            "step_UV": [
              32,
              0
            ],
            "frames_per_second": 8,
            "max_frame": 8,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age/v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFF0D0",
            "0.25": "#FFFF9A30",
            "0.7": "#C0E03010",
            "1.0": "#00401008"
          }
        }
      }
    }
  }
}