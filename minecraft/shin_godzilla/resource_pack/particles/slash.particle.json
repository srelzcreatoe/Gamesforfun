{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sg:slash",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/sg/slash"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "variable.dx",
          "variable.dy",
          "variable.dz"
        ]
      },
      "minecraft:particle_initial_speed": "variable.size*1.5",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 3
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.3
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size*(0.7+0.6*v.particle_age/v.particle_lifetime)",
          "variable.size*(0.7+0.6*v.particle_age/v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.001
        },
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1.0,
          0.92,
          0.98,
          "0.9*(1-v.particle_age/v.particle_lifetime)"
        ]
      }
    }
  }
}