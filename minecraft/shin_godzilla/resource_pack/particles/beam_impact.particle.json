{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sg:beam_impact",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/sg/spark"
      }
    },
    "components": {
