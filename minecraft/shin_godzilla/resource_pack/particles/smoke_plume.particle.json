{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sg:smoke_plume",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/sg/smoke"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 5
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.8,
        "direction": [
          "variable.dx+math.random(-0.25,0.25)",
          "variable.dy+math.random(-0.25,0.25)",
          "variable.dz+math.random(-0.25,0.25)"
        ]
      },
      "minecraft:particle_initial_speed": "variable.spd*math.random(0.5,1.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          1.2,
          0
        ],
        "linear_drag_coefficient": 1.6
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(2.0,3.2)"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0,360)",
        "rotation_rate": "math.random(-30,30)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "1.2+v.particle_age*2.6",
          "1.2+v.particle_age*2.6"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 64,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              64,
              64
            ],
            "step_UV": [
              64,
              0
            ],
            "frames_per_second": 1.5,
            "max_frame": 4,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age/v.particle_lifetime",
          "gradient": {
            "0.0": "#E0201418",
            "0.6": "#B01A1416",
            "1.0": "#00100C0C"
          }
        }
      },
      "minecraft:particle_appearance_lighting": {}
    }
