{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sg:soot_stream",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/sg/smoke"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 4
      },
      "minecraft:emitter_shape_sphere": {
        "radius": "variable.width*0.25",
        "direction": [
          "variable.dx+math.random(-0.22,0.22)",
          "variable.dy+math.random(-0.16,0.16)",
          "variable.dz+math.random(-0.22,0.22)"
        ]
      },
      "minecraft:particle_initial_speed": "variable.spd*math.random(0.55,1.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.8,
          0
        ],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.9,1.5)"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0,360)",
        "rotation_rate": "math.random(-40,40)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.45+1.05*v.particle_age/v.particle_lifetime)*variable.width*(0.75+0.5*v.particle_random_1)",
          "(0.45+1.05*v.particle_age/v.particle_lifetime)*variable.width*(0.75+0.5*v.particle_random_1)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 512,
          "texture_height": 128,
          "uv": [
            "math.floor(v.particle_random_1*3.99)*128",
            0
          ],
          "uv_size": [
            128,
            128
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age/v.particle_lifetime",
          "gradient": {
            "0.0": "#00080608",
            "0.1": "#F00E0A0C",
            "0.6": "#D0181416",
            "1.0": "#00282426"
          }
        }
      }
    }
  }
}