{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sg:breath_stream",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/sg/glow"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 9
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.5,
        "direction": [
          "variable.dx+math.random(-variable.spread,variable.spread)",
          "variable.dy+math.random(-variable.spread,variable.spread)",
          "variable.dz+math.random(-variable.spread,variable.spread)"
        ]
      },
      "minecraft:particle_initial_speed": "variable.spd*math.random(0.7,1.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 0.5
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.7,1.1)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size*(0.7+v.particle_age*2.4)",
          "variable.size*(0.7+v.particle_age*2.4)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.cr",
          "variable.cg",
          "variable.cb",
          "1-v.particle_age/v.particle_lifetime"
        ]
      }
    }
  }
}