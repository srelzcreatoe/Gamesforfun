{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "tailwail:tall_wail",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/tall_wail/tall_wail"
      },
      "geometry": {
        "default": "geometry.tall_wail"
      },
      "render_controllers": [
        "controller.render.tall_wail"
      ],
      "spawn_egg": {
        "texture": "tailwail_spawn_egg",
        "texture_index": 0
      },
      "enable_attachables": false,
      "scripts": {
        "scale": "1.5",
        "initialize": [
          "v.walk = 0.0; v.move = 0.0; v.fast = 0.0; v.crawl = 0.0; v.climb_t = 0.0;",
          "v.look_x = 0.0; v.look_y = 0.0; v.jaw = 0.0; v.last_dist = q.modified_distance_moved;",
          "v.mimic_crouch = 0.0; v.mimic_step = 0.0; v.mimic_shrug = 0.0; v.mimic_roll = 0.0; v.mimic_pitch = 0.0;",
          "v.menace_w = 0.0;"
        ],
        "pre_animation": [
          "v.dt = math.clamp(q.delta_time, 0.0, 0.1);",
          "v.inc = math.clamp(q.modified_distance_moved - v.last_dist, 0.0, 1.0); v.last_dist = q.modified_distance_moved;",
          "v.move = v.move + (math.clamp(q.ground_speed / 1.6, 0.0, 1.0) - v.move) * math.clamp(v.dt * 6.0, 0.0, 1.0);",
          "v.fast = v.fast + (math.clamp((q.ground_speed - 2.0) / 1.2, 0.0, 1.0) - v.fast) * math.clamp(v.dt * 4.0, 0.0, 1.0);",
          "v.walk = math.mod(v.walk + v.inc * 360.0 / math.lerp(2.17, 2.89, v.fast), 360.0);",
          "v.crawl = math.mod(v.crawl + v.inc / 1.62, 1.0);",
          "v.climb_t = 0.0;",
          "v.look_y = v.look_y + (math.clamp(q.property('tailwail:look_yaw'), -80.0, 80.0) - v.look_y) * math.clamp(v.dt * 4.0, 0.0, 1.0);",
          "v.look_x = v.look_x + (math.clamp(q.property('tailwail:look_pitch'), -45.0, 45.0) - v.look_x) * math.clamp(v.dt * 4.0, 0.0, 1.0);",
          "v.voice_wail = q.property('tailwail:voice') == 'wail'; v.voice_snarl = q.property('tailwail:voice') == 'snarl'; v.voice_inhale = q.property('tailwail:voice') == 'inhale'; v.voice_breath = q.property('tailwail:voice') == 'breath'; v.voice_click = q.property('tailwail:voice') == 'click';",
          "v.jaw_t = v.voice_wail ? (34.0 + 3.0 * math.sin(q.life_time * 900.0)) : (v.voice_snarl ? 18.0 : (v.voice_inhale ? 12.0 : (v.voice_breath ? (2.0 + 2.0 * math.sin(q.life_time * 45.0)) : (v.voice_click ? 3.0 : 0.0))));",
          "v.jaw_t = (q.property('tailwail:state') == 'death') ? 22.0 : ((q.property('tailwail:state') == 'windup' && !v.voice_wail) ? math.max(v.jaw_t, 16.0) : v.jaw_t);",
          "v.jaw = math.clamp(v.jaw + (v.jaw_t - v.jaw) * math.clamp(v.dt * 8.0, 0.0, 1.0), -2.0, 40.0);",
          "v.m_on = (q.property('tailwail:state') == 'stalk' || q.property('tailwail:state') == 'standoff');",
          "v.m_amt = math.clamp(q.property('tailwail:mimic_amt'), 0.0, 2.0) * v.m_on;",
          "v.m_k = math.clamp(v.dt * 2.2, 0.0, 1.0);",
          "v.mimic_crouch = v.mimic_crouch + (((q.property('tailwail:mimic') == 'crouch') ? math.min(v.m_amt, 1.6) : 0.0) - v.mimic_crouch) * v.m_k;",
          "v.mimic_step = v.mimic_step + (((q.property('tailwail:mimic') == 'step') ? 0.5 * math.min(v.m_amt, 1.0) : 0.0) - v.mimic_step) * v.m_k;",
          "v.mimic_shrug = v.mimic_shrug + (((q.property('tailwail:mimic') == 'shrug') ? math.min(v.m_amt, 1.5) : 0.0) - v.mimic_shrug) * v.m_k;",
          "v.mimic_roll = v.mimic_roll + (((q.property('tailwail:mimic') == 'tilt') ? 22.0 * v.m_amt : 0.0) - v.mimic_roll) * v.m_k;",
          "v.mimic_pitch = v.mimic_pitch + (((q.property('tailwail:mimic') == 'tilt') ? math.clamp(q.property('tailwail:mimic_pitch'), -45.0, 45.0) * math.min(v.m_amt, 1.4) : 0.0) - v.mimic_pitch) * v.m_k;",
          "v.menace_w = v.menace_w + ((((q.property('tailwail:agit') == 2) && v.m_on) ? 0.45 : 0.0) - v.menace_w) * math.clamp(v.dt * 1.5, 0.0, 1.0);"
        ],
        "animate": [
          "ctrl_body",
          "ctrl_tail",
          "ctrl_face",
          "ctrl_mimic",
          "ctrl_agitation",
          "ctrl_hurt"
        ]
      },
