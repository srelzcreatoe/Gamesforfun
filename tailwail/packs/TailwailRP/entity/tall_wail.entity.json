    "scale": "1.5",
    "pre_animation": [
     "v.dt = math.clamp(q.delta_time, 0.0, 0.1);",
     "v.k2 = math.clamp(v.dt * 2.2, 0.0, 1.0); v.k4 = math.clamp(v.dt * 4.0, 0.0, 1.0); v.k6 = math.clamp(v.dt * 6.0, 0.0, 1.0); v.k9 = math.clamp(v.dt * 9.0, 0.0, 1.0);",
     "v.act = q.property('tailwail:act');",
     "v.gs = (v.gs ?? 0.0) + ((math.clamp(q.ground_speed, 0.0, 14.0)) - (v.gs ?? 0.0)) * v.k6;",
     "v.mv = math.clamp(v.gs / 1.2, 0.0, 1.0); v.run = math.clamp((v.gs - 3.6) / 1.6, 0.0, 1.0);",
     "v.w_idle = 1.0 - v.mv; v.w_walk = v.mv * (1.0 - v.run); v.w_run = v.mv * v.run; v.spd = math.clamp(v.gs / 7.0, 0.0, 1.0);",
     "v.ov = (v.act == 18) ? 0.0 : 1.0; v.inv = (v.act == 8) ? 1.0 : 0.0; v.mim = (v.act == 0 || v.act == 3 || v.act == 5) ? 1.0 : 0.0;",
     "v.look_y = (v.look_y ?? 0.0) + ((math.clamp(q.property('tailwail:look_yaw'), -178.0, 178.0)) - (v.look_y ?? 0.0)) * math.clamp(v.dt * 7.0, 0.0, 1.0);",
     "v.look_x = (v.look_x ?? 0.0) + ((math.clamp(q.property('tailwail:look_pitch'), -55.0, 55.0)) - (v.look_x ?? 0.0)) * math.clamp(v.dt * 7.0, 0.0, 1.0);",
     "v.br = q.property('tailwail:breath');",
     "v.br_amp = (v.br_amp ?? 0.0) + ((v.br == 1 ? 3.0 : (v.br == 2 ? 6.0 : (v.br == 3 ? 8.0 : 0.0))) - (v.br_amp ?? 0.0)) * v.k2;",
     "v.br_ph = math.mod((v.br_ph ?? 0.0) + (v.br == 1 ? 110.0 : (v.br == 2 ? 230.0 : (v.br == 3 ? 470.0 : 60.0))) * v.dt, 360.0);",
     "v.tremor = (v.tremor ?? 0.0) + ((q.property('tailwail:tremor') / 3.0) - (v.tremor ?? 0.0)) * v.k4;",
     "v.jaw_t = math.clamp(q.property('tailwail:jaw'), 0.0, 60.0);",
     "v.jaw = (v.jaw ?? 4.0) + ((v.jaw_t + (v.jaw_t > 30.0 ? 3.0 * math.sin(q.life_time * 900.0) : 0.0)) - (v.jaw ?? 4.0)) * v.k9;",
     "v.tm = (v.act == 2 || v.act == 17) ? 4 : q.property('tailwail:tail');",
     "v.tw0 = (v.tw0 ?? 1.0) + ((v.tm == 0 ? 1.0 : 0.0) - (v.tw0 ?? 1.0)) * v.k4;",
     "v.tw1 = (v.tw1 ?? 0.0) + ((v.tm == 1 ? 1.0 : 0.0) - (v.tw1 ?? 0.0)) * v.k4;",
     "v.tw2 = (v.tw2 ?? 0.0) + ((v.tm == 2 ? 1.0 : 0.0) - (v.tw2 ?? 0.0)) * v.k4;",
     "v.tw3 = (v.tw3 ?? 0.0) + ((v.tm == 3 ? 1.0 : 0.0) - (v.tw3 ?? 0.0)) * v.k4;",
     "v.tw4 = (v.tw4 ?? 0.0) + ((v.tm == 4 ? 1.0 : 0.0) - (v.tw4 ?? 0.0)) * v.k4;",
     "v.m = q.property('tailwail:mimic'); v.m_amt = math.clamp(q.property('tailwail:mimic_amt'), 0.0, 2.0);",
     "v.mimic_crouch = (v.mimic_crouch ?? 0.0) + ((v.m == 1 ? math.min(v.m_amt, 1.6) : 0.0) - (v.mimic_crouch ?? 0.0)) * v.k2;",
     "v.mimic_shrug = (v.mimic_shrug ?? 0.0) + ((v.m == 4 ? math.min(v.m_amt, 1.5) : 0.0) - (v.mimic_shrug ?? 0.0)) * v.k2;",
     "v.mimic_roll = (v.mimic_roll ?? 0.0) + ((v.m == 2 ? 26.0 * v.m_amt : 0.0) - (v.mimic_roll ?? 0.0)) * v.k2;",
     "v.mimic_pitch = (v.mimic_pitch ?? 0.0) + ((v.m == 2 ? math.clamp(q.property('tailwail:mimic_pitch'), -45.0, 45.0) * math.min(v.m_amt, 1.4) : 0.0) - (v.mimic_pitch ?? 0.0)) * v.k2;"
    ],
