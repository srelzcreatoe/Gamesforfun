; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but this file is written by the project skeleton on purpose so that
; every setting is explicit and reviewable.

config_version=5

[application]

config/name="Dragon Block Sagas"
config/description="A Dragon Block C inspired voxel action RPG for Android built with Godot 4."
config/version="0.1.0"
run/main_scene="res://scenes/main/Main.tscn"
run/max_fps=60
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.03, 0.03, 0.06, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"
driver/mix_rate=44100
driver/output_latency=15

[autoload]

Events="*res://autoload/Events.gd"
Registry="*res://autoload/Registry.gd"
Textures="*res://autoload/Textures.gd"
Audio="*res://autoload/Audio.gd"
Game="*res://autoload/Game.gd"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/inference_on_variant=1
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_call_argument=0
gdscript/warnings/return_value_discarded=0
gdscript/warnings/integer_division=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/unused_signal=0
gdscript/warnings/unused_parameter=0
settings/stdout/print_fps=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"
window/handheld/orientation=4
window/vsync/vsync_mode=1
window/dpi/allow_hidpi=true

[gui]

theme/custom="res://assets/misc/theme.tres"
theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0
common/snap_controls_to_pixels=true

