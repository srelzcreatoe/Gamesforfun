[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true
pointing/android/enable_long_press_as_right_click=false

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
3d/physics_engine="Dummy"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=false
textures/default_filters/anisotropic_filtering_level=0
textures/default_filters/use_nearest_mipmap_filter=true
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.03, 0.03, 0.06, 1)
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=0
limits/opengl/max_renderable_elements=32768
limits/opengl/max_renderable_lights=8
limits/opengl/max_lights_per_object=4
viewport/transparent_background=false
